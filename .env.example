# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server only — never expose to the browser

# Public URL of this app (used in invitation / password-reset links)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- AI quote verification & sourcing briefs (optional) ---
# Without a key the app still runs rule-based checks (min margin, zero cost, logistics > price).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sign-in ---
# Every sign-in asks for a one-time code sent by email. Set to "off" only in an emergency (email not working).
LOGIN_2FA=on
# Secret for signing short-lived cookies (any long random string). Defaults to one derived from the service key.
SESSION_SECRET=
