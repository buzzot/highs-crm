<%- include('../partials/head') %>
<% const itemList = (typeof items !== 'undefined' && items.length) ? items : [{}];
   const unitList = typeof units !== 'undefined' ? units : ['pcs'];
   const cur = form.target_currency || 'USD';
   const editing = typeof mode !== 'undefined' && mode === 'edit';
   const fileList = typeof files !== 'undefined' ? files : [];
   const filesOf = it => fileList.filter(f => f.item && (f.item === it.id || f.item === it.tmp));
   const generalFiles = fileList.filter(f => !f.item);
   const dm = form.delivery_mode || ''; %>
<form method="post" action="<%= editing ? '/portal/requests/' + request.id + '/edit' : '/portal/requests' %>" enctype="multipart/form-data" class="rqform" id="rqForm">
  <div class="card">
    <% if (editing) { %>
      <a class="back" href="/portal/requests/<%= request.id %>">← <%= request.ref %></a>
      <h1>Edit request</h1>
      <div class="alert info">Your changes are sent to our team for approval. Until then the current version stays in place<%= request.status === 'quoted' ? ' and offers already sent remain valid' : '' %>. Once approved, we prepare an updated offer.</div>
    <% } else { %>
      <h1>New sourcing request</h1>
      <p class="muted">Add every product you need — one request can hold several. Photos, links or reference samples help us source faster.</p>
    <% } %>
    <% if (error) { %><div class="alert err"><%= error %></div><% if ((typeof items !== 'undefined') && items.length) { %><p class="muted small">Files are not kept after an error — please add them again.</p><% } } %>
    <label>Request name <span class="muted small">— optional, e.g. "Spring kitchen range"</span>
      <input name="title" value="<%= form.title || '' %>" placeholder="Leave empty to use the first product name"></label>
    <div class="row">
      <label>Destination country <input name="destination_country" value="<%= form.destination_country || '' %>"></label>
      <label>Destination city / port <input name="destination_city" value="<%= form.destination_city || '' %>"></label>
      <label>Needed by <input type="date" name="needed_by" value="<%= form.needed_by || '' %>"></label>
      <label>Price currency <select name="target_currency" id="rqCur"><% ['USD','EUR','GBP','CNY'].forEach(c => { %><option <%= cur === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
    </div>
    <fieldset class="seg">
      <legend>Preferred delivery</legend>
      <% [['sea', 'Sea', 'ship'], ['air', 'Air', 'plane'], ['land', 'Land', 'truck'], ['any', 'No preference', 'dots']].forEach(([v, label, ic]) => { %>
        <label class="segopt"><input type="radio" name="delivery_mode" value="<%= v %>" <%= dm === v ? 'checked' : '' %>><span><%- icon(ic) %><%= label %><% if (v === 'land') { %><small>rail / truck</small><% } %></span></label>
      <% }) %>
    </fieldset>
  </div>

  <div class="rqhead">
    <h2>Products <span class="count" id="rqCount"><%= itemList.length %></span></h2>
  </div>

  <div id="rqItems">
    <% itemList.forEach((it, i) => { %>
      <%- include('_request_item', { it, i, unitList, cur, itemFiles: filesOf(it) }) %>
    <% }) %>
  </div>

  <button type="button" class="rqadd" id="rqAdd">
    <%- icon('plus') %> Add another product
  </button>

  <div class="card">
    <h2>General notes &amp; files <span class="muted small">— optional, for the whole request</span></h2>
    <label>Notes <textarea name="description" rows="3" placeholder="Packaging or labelling for all products, certifications, shipping preferences…"><%= form.description || '' %></textarea></label>
    <%- include('_existing_files', { list: generalFiles }) %>
    <div class="dropwrap">
      <div class="filedrop" data-dropzone data-max="10" data-max-mb="20" tabindex="0">
        <input type="file" name="files" multiple accept="image/*,.pdf,.xlsx,.xls,.docx,.doc,.csv" aria-label="General files">
        <span class="dicon"><%- icon('upload') %></span>
        <strong data-drop-count>Drag files here or <span class="dlink">browse</span></strong>
        <span class="muted small dsub">e.g. a product list in Excel, a catalogue PDF · up to 10 files, 20 MB each</span>
      </div>
      <div class="fgrid" data-drop-list></div>
    </div>
    <div class="actions"><button class="btn primary lg"><%= editing ? 'Send changes for approval' : 'Submit request' %></button> <a class="btn" href="<%= editing ? '/portal/requests/' + request.id : '/portal/requests' %>">Cancel</a></div>
  </div>
</form>

<template id="rqTemplate"><%- include('_request_item', { it: {}, i: '__I__', unitList, cur, itemFiles: [] }) %></template>
<script>
(function () {
  const list = document.getElementById('rqItems'), tpl = document.getElementById('rqTemplate');
  let next = list.children.length;
  const renumber = () => {
    const blocks = [...list.querySelectorAll('.rqitem')];
    blocks.forEach((b, k) => { b.querySelector('.rqnum').textContent = k + 1; b.querySelector('.rqdel').hidden = blocks.length < 2; });
    document.getElementById('rqCount').textContent = blocks.length;
    document.getElementById('rqAdd').hidden = blocks.length >= 30;
  };
  document.getElementById('rqAdd').addEventListener('click', () => {
    const html = tpl.innerHTML.replace(/__I__/g, String(next++));
    const wrap = document.createElement('div'); wrap.innerHTML = html.trim();
    const block = wrap.firstElementChild;
    list.appendChild(block);
    window.initDropzones && window.initDropzones(block);
    renumber();
    block.querySelector('input[name$="[name]"]').focus();
    block.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  list.addEventListener('click', e => {
    const del = e.target.closest('.rqdel');
    if (!del) return;
    const block = del.closest('.rqitem');
    const filled = [...block.querySelectorAll('input:not([type=file]):not([type=hidden]), textarea')].some(x => x.value.trim()) || block.querySelector('.fitem');
    if (filled && !block.classList.contains('confirm')) { block.classList.add('confirm'); del.textContent = 'Click again to remove'; setTimeout(() => { block.classList.remove('confirm'); del.innerHTML = '&times;'; }, 3000); return; }
    block.remove(); renumber();
  });
  // optional AI fill from the product's photos / PDF
  const aiBlocks = () => list.querySelectorAll('.rqitem');
  const syncAi = block => { const bar = block.querySelector('.aifill'); if (!bar) return; const has = [...(block.querySelector('input[type=file]')?.files || [])].some(f => /^image\/|pdf$/i.test(f.type) || /\.pdf$/i.test(f.name)); bar.hidden = !has; };
  list.addEventListener('change', e => { if (e.target.type === 'file') syncAi(e.target.closest('.rqitem')); });
  new MutationObserver(() => aiBlocks().forEach(syncAi)).observe(list, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
  list.addEventListener('click', async e => {
    const btn = e.target.closest('[data-aifill]'); if (!btn) return;
    const block = btn.closest('.rqitem'), stat = block.querySelector('.aistat');
    const files = [...block.querySelector('input[type=file]').files].filter(f => /^image\//.test(f.type) || /\.pdf$/i.test(f.name)).slice(0, 4);
    const f = n => block.querySelector('[name$="[' + n + ']"]');
    const fd = new FormData(); files.forEach(x => fd.append('files', x)); fd.append('name', f('name').value); fd.append('description', f('description').value);
    btn.disabled = true; stat.textContent = 'Reading the files…';
    try {
      const r = await fetch('/portal/requests/ai-fill', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'AI could not read the files.');
      const have = ['name', 'sku', 'description'].filter(k => j[k] && f(k).value.trim() && f(k).value.trim() !== j[k]);
      const overwrite = !have.length || confirm('Replace what you typed (' + have.join(', ') + ') with the AI suggestion?');
      let n = 0;
      for (const k of ['name', 'sku', 'description']) if (j[k] && (overwrite || !f(k).value.trim())) { f(k).value = j[k]; n++; }
      stat.textContent = n ? 'Filled from your files — please check it.' : 'Nothing new found in the files.';
    } catch (err) { stat.textContent = err.message; }
    btn.disabled = false;
  });
  document.getElementById('rqCur').addEventListener('change', e => document.querySelectorAll('.rqcur').forEach(s => { s.textContent = e.target.value; }));
  renumber();
})();
</script>
<%- include('../partials/foot') %>
