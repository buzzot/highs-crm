<%- include('../partials/head') %>
<% const pend = typeof pending !== 'undefined' ? pending : null; const editable = typeof canEdit !== 'undefined' && canEdit; const decided = typeof lastDecision !== 'undefined' ? lastDecision : null; %>
<div class="pagehead">
  <div><a class="back" href="/portal/requests">← Requests</a><h1><%= request.ref %> · <%= request.title %></h1></div>
  <div class="headactions">
    <% if (editable && !pend) { %><a class="btn" href="/portal/requests/<%= request.id %>/edit"><%- icon('edit') %> Edit request</a><% } %>
    <span class="pill lg <%= request.status %>"><%= fmt.status(request.status) %></span>
  </div>
</div>
<% if (pend) { %>
  <div class="card pending">
    <h2><%- icon('clock') %> Your changes are waiting for approval <span class="pill pending">Pending</span></h2>
    <p class="muted">Sent <%= fmt.datetime(pend.updated_at || pend.created_at) %>. The request below still shows the current version<%= quotes.some(q => q.status === 'sent') ? ' and the offers already sent stay valid until we approve' : '' %>.</p>
    <%- include('../partials/request_diff', { d: pendingDiff, cur: pend.data.target_currency || request.target_currency }) %>
    <div class="actions">
      <a class="btn" href="/portal/requests/<%= request.id %>/edit"><%- icon('edit') %> Change again</a>
      <form method="post" action="/portal/requests/<%= request.id %>/edit/withdraw" class="inline"><button class="btn">Withdraw changes</button></form>
    </div>
  </div>
<% } else if (decided && decided.status === 'rejected') { %>
  <div class="alert warn"><strong>Your last changes were not accepted</strong><%= decided.admin_note ? ' — ' + decided.admin_note : '.' %></div>
<% } %>
<div class="grid2">
  <div>
    <div class="card">
      <h2>Products <span class="muted small"><%= items.length || 1 %></span></h2>
      <dl class="dl">
        <dt>Destination</dt><dd><%= [request.destination_city, request.destination_country].filter(Boolean).join(', ') || '—' %></dd>
        <dt>Needed by</dt><dd><%= fmt.date(request.needed_by) %></dd>
        <dt>Delivery</dt><dd><%= deliveryLabel(request.delivery_mode) %></dd>
      </dl>
      <%- include('../partials/request_items', { request, items, docs, base: '/portal', quotes }) %>
    </div>
    <div class="card">
      <h2>Quotes</h2>
      <% if (!quotes.length) { %><p class="muted">We're working on it — quotes will appear here.</p><% } %>
      <% const bd = typeof bundles !== 'undefined' ? bundles : {}, inBundle = new Set([...(bd.sent?.ids || []), ...(bd.accepted?.ids || [])]); %>
      <% ['sent', 'accepted'].forEach(st => { const c = bd[st]; if (!c) return; const money = (v, d) => fmt.money(v, c.currency, d); %>
        <div class="quote <%= st %>">
          <div class="qhead"><strong>Quotation · <%= c.count %> products</strong> <span class="pill <%= st %>"><%= fmt.status(st) %></span> <span class="muted">valid until <%= fmt.date(c.valid_until) %></span> <a class="more" href="/portal/requests/<%= request.id %>/quote.pdf" target="_blank">PDF</a></div>
          <table class="tbl compact quotesum">
            <thead><tr><th>Product</th><th class="right">Qty</th><th class="right">Unit price</th><th class="right">Goods</th></tr></thead>
            <tbody><% c.lines.forEach(l => { %><tr><td><strong><%= l.name %></strong></td><td class="right"><%= l.quantity.toLocaleString('en-US') %></td><td class="right"><%= money(l.shown.unit_price, 4) %></td><td class="right"><%= money(l.shown.goods) %></td></tr><% }) %></tbody>
            <tfoot>
              <% if (!c.included && !c.none) { %>
              <tr><td colspan="3" class="right muted">Goods</td><td class="right"><%= money(c.shown.goodsTotal) %></td></tr>
              <tr><td colspan="3" class="right muted">Freight &amp; logistics (estimate)</td><td class="right"><%= money(c.shown.logisticsTotal) %></td></tr>
              <% } %>
              <tr class="grand"><td colspan="3" class="right"><strong>Total<%= c.incoterm ? ' (' + c.incoterm + ')' : '' %></strong></td><td class="right"><strong><%= money(c.shown.grandTotal) %></strong></td></tr>
            </tfoot>
          </table>
          <p class="muted small">Lead time <%= c.lead_time_days ? c.lead_time_days + ' days' : '—' %>. <%= c.none ? 'Freight is not included.' : c.included ? 'Prices include freight to the destination.' : 'Freight is an estimate until the shipment is booked.' %></p>
          <% if (st === 'sent') { %>
            <div class="actions">
              <form method="post" action="/portal/requests/<%= request.id %>/quotes/accept"><button class="btn primary">Accept quotation</button></form>
              <form method="post" action="/portal/requests/<%= request.id %>/quotes/reject" onsubmit="return confirm('Reject this quotation?')"><button class="btn">Reject</button></form>
            </div>
          <% } else { const po = (typeof pos !== 'undefined' ? pos : []).find(p => !p.quote_id); %>
            <div class="actions">
              <% if (!po) { %><a class="btn primary" href="/portal/requests/<%= request.id %>/po">Send PO</a><span class="muted small">Quotation accepted — send one purchase order for all products.</span>
              <% } else { %><a class="btn" href="/portal/po/<%= po.id %>"><%= po.po_no %></a> <span class="pill <%= po.status %>"><%= ({ draft: 'Draft — not sent', submitted: 'Sent — awaiting approval', approved: 'Approved' })[po.status] %></span><% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
      <% quotes.forEach(q => { if (inBundle.has(q.id)) return; %>
        <div class="quote <%= q.status %>">
          <% const qi = items.find(i => i.id === q.request_item_id); %>
          <div class="qhead"><strong><%= qi ? qi.name : 'Quote' %></strong> <span class="pill <%= q.status %>"><%= q.status === 'superseded' ? 'Replaced — updated offer coming' : fmt.status(q.status) %></span> <span class="muted">valid until <%= fmt.date(q.valid_until) %></span></div>
          <dl class="dl">
            <dt>Quantity</dt><dd><%= q.quantity %></dd>
            <dt>Unit price (<%= q.incoterm %><%= q.shown.included ? ', freight included' : q.shown.none ? ', freight not included' : '' %>)</dt><dd><%= fmt.money(q.shown.unit_price, q.sell_currency, 4) %></dd>
            <% if (q.shown.included || q.shown.none) { %><dt>Total</dt><dd><strong><%= fmt.money(q.shown.total, q.sell_currency) %></strong></dd><% } else { %>
            <dt>Estimated logistics</dt><dd><%= fmt.money((Number(q.freight_estimate)||0)+(Number(q.duties_estimate)||0)+(Number(q.other_costs)||0), q.sell_currency) %> total</dd>
            <dt>Landed unit price</dt><dd><strong><%= fmt.money(q.landed_unit_price, q.sell_currency, 4) %></strong></dd>
            <dt>Goods total</dt><dd><%= fmt.money(q.unit_price * q.quantity, q.sell_currency) %></dd><% } %>
            <dt>Lead time</dt><dd><%= q.lead_time_days ? q.lead_time_days + ' days' : '—' %></dd>
          </dl>
          <% if (q.notes) { %><p class="pre"><%= q.notes %></p><% } %>
          <% if (q.status === 'sent') { %>
            <div class="actions">
              <form method="post" action="/portal/quotes/<%= q.id %>/accept"><button class="btn primary">Accept quote</button></form>
              <form method="post" action="/portal/quotes/<%= q.id %>/reject" onsubmit="return confirm('Reject this quote?')"><button class="btn">Reject</button></form>
            </div>
          <% } %>
          <% if (q.status === 'accepted') { const po = (typeof pos !== 'undefined' ? pos : []).find(p => p.quote_id === q.id); %>
            <div class="actions">
              <% if (!po) { %><a class="btn primary" href="/portal/quotes/<%= q.id %>/po">Send PO</a><span class="muted small">Quote accepted — send your purchase order so we can confirm the order.</span>
              <% } else { %><a class="btn" href="/portal/po/<%= po.id %>"><%= po.po_no %></a> <span class="pill <%= po.status %>"><%= ({ draft: 'Draft — not sent', submitted: 'Sent — awaiting approval', approved: 'Approved' })[po.status] %></span><% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="card">
    <h2>Timeline</h2>
    <ul class="timeline">
      <% events.forEach(e => { %><li><span class="t"><%= fmt.datetime(e.created_at) %></span> <%= fmt.status(e.action) %></li><% }) %>
      <li><span class="t"><%= fmt.datetime(request.created_at) %></span> submitted</li>
    </ul>
  </div>
</div>
<%- include('../partials/foot') %>
