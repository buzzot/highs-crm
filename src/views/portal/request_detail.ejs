<%- include('../partials/head') %>
<% const pend = typeof pending !== 'undefined' ? pending : null; const editable = typeof canEdit !== 'undefined' && canEdit; const decided = typeof lastDecision !== 'undefined' ? lastDecision : null; %>
<div class="pagehead">
  <div><a class="back" href="/portal/requests">← Requests</a><h1><%= request.ref %> · <%= request.title %></h1></div>
  <div class="headactions">
    <% if (editable && !pend) { %><a class="btn" href="/portal/requests/<%= request.id %>/edit"><%- icon('edit') %> Edit request</a><% } %>
    <span class="pill lg <%= request.status %>"><%= fmt.status(request.status) %></span>
  </div>
</div>
<% if (pend) { %>
  <div class="card pending">
    <h2><%- icon('clock') %> Your changes are waiting for approval <span class="pill pending">Pending</span></h2>
    <p class="muted">Sent <%= fmt.datetime(pend.updated_at || pend.created_at) %>. The request below still shows the current version<%= quotes.some(q => q.status === 'sent') ? ' and the offers already sent stay valid until we approve' : '' %>.</p>
    <%- include('../partials/request_diff', { d: pendingDiff, cur: pend.data.target_currency || request.target_currency }) %>
    <div class="actions">
      <a class="btn" href="/portal/requests/<%= request.id %>/edit"><%- icon('edit') %> Change again</a>
      <form method="post" action="/portal/requests/<%= request.id %>/edit/withdraw" class="inline"><button class="btn">Withdraw changes</button></form>
    </div>
  </div>
<% } else if (decided && decided.status === 'rejected') { %>
  <div class="alert warn"><strong>Your last changes were not accepted</strong><%= decided.admin_note ? ' — ' + decided.admin_note : '.' %></div>
<% } %>
<div class="grid2">
  <div>
    <div class="card">
      <h2>Products <span class="muted small"><%= items.length || 1 %></span></h2>
      <dl class="dl">
        <dt>Destination</dt><dd><%= [request.destination_city, request.destination_country].filter(Boolean).join(', ') || '—' %></dd>
        <dt>Needed by</dt><dd><%= fmt.date(request.needed_by) %></dd>
        <dt>Delivery</dt><dd><%= deliveryLabel(request.delivery_mode) %></dd>
      </dl>
      <%- include('../partials/request_items', { request, items, docs, base: '/portal', quotes }) %>
    </div>
    <div class="card">
      <h2>Quotes</h2>
      <% if (!quotes.length) { %><p class="muted">We're working on it — quotes will appear here.</p><% } %>
      <% quotes.forEach(q => { %>
        <div class="quote <%= q.status %>">
          <% const qi = items.find(i => i.id === q.request_item_id); %>
          <div class="qhead"><strong><%= qi ? qi.name : 'Quote' %></strong> <span class="pill <%= q.status %>"><%= q.status === 'superseded' ? 'Replaced — updated offer coming' : fmt.status(q.status) %></span> <span class="muted">valid until <%= fmt.date(q.valid_until) %></span></div>
          <dl class="dl">
            <dt>Quantity</dt><dd><%= q.quantity %></dd>
            <dt>Unit price (<%= q.incoterm %>)</dt><dd><%= fmt.money(q.unit_price, q.sell_currency, 4) %></dd>
            <dt>Estimated logistics</dt><dd><%= fmt.money((Number(q.freight_estimate)||0)+(Number(q.duties_estimate)||0)+(Number(q.other_costs)||0), q.sell_currency) %> total</dd>
            <dt>Landed unit price</dt><dd><strong><%= fmt.money(q.landed_unit_price, q.sell_currency, 4) %></strong></dd>
            <dt>Goods total</dt><dd><%= fmt.money(q.unit_price * q.quantity, q.sell_currency) %></dd>
            <dt>Lead time</dt><dd><%= q.lead_time_days ? q.lead_time_days + ' days' : '—' %></dd>
          </dl>
          <% if (q.notes) { %><p class="pre"><%= q.notes %></p><% } %>
          <% if (q.status === 'sent') { %>
            <div class="actions">
              <form method="post" action="/portal/quotes/<%= q.id %>/accept"><button class="btn primary">Accept quote</button></form>
              <form method="post" action="/portal/quotes/<%= q.id %>/reject" onsubmit="return confirm('Reject this quote?')"><button class="btn">Reject</button></form>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
  <div class="card">
    <h2>Timeline</h2>
    <ul class="timeline">
      <% events.forEach(e => { %><li><span class="t"><%= fmt.datetime(e.created_at) %></span> <%= fmt.status(e.action) %></li><% }) %>
      <li><span class="t"><%= fmt.datetime(request.created_at) %></span> submitted</li>
    </ul>
  </div>
</div>
<%- include('../partials/foot') %>
