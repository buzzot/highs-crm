<%- include('../partials/head') %>
<% const isReview = typeof review !== 'undefined' && !!review; const portalRows = typeof orderRows !== 'undefined' ? orderRows : []; const steps = ['new','confirmed','deposit_paid','in_production','qc','packed','shipped','in_transit','customs','delivered','closed']; const idx = steps.indexOf(order.status); %>
<div class="pagehead">
  <div><a class="back" href="/portal/orders">← Orders</a><h1>Order <%= order.order_no %></h1></div>
  <div class="headactions"><% if (Number(order.amount_due) > 0) { %><span class="pill lg pay-<%= order.payment_status %>"><%= ({ unpaid: 'Unpaid', partial: 'Partially paid', paid: 'Paid' })[order.payment_status] %></span><% } %>
  <span class="pill lg <%= order.status %>"><%= isReview && order.status === 'new' ? 'Under review' : fmt.status(order.status) %></span></div>
</div>
<% if (typeof msg !== 'undefined' && msg) { %><div class="alert ok"><%= msg %></div><% } %>
<% if (typeof err !== 'undefined' && err) { %><div class="alert err"><%= err %></div><% } %>
<div class="card">
  <ol class="steps">
    <% steps.forEach((s, i) => { %><li class="<%= i < idx ? 'done' : i === idx ? 'now' : '' %>"><%= isReview && s === 'new' ? 'Under review' : fmt.status(s) %></li><% }) %>
  </ol>
</div>
<div class="grid2">
  <div>
    <% if (isReview) { %>
    <div class="alert info"><strong>We are checking your order.</strong> We will confirm prices, freight and the proforma invoice — usually within one business day. You can follow it here.</div>
    <% } %>
    <div class="card">
      <h2>Items</h2>
      <% if (isReview) { %>
      <table class="tbl"><thead><tr><th>Product</th><th>Qty</th><th class="right">Your target price</th></tr></thead><tbody>
      <% order.order_items.forEach(i => { %><tr><td><%= i.description %><% if (i.sku) { %><div class="muted small"><%= i.sku %></div><% } %></td><td><%= i.quantity %><%= i.unit ? ' ' + i.unit : '' %></td><td class="right"><%= i.target_unit_price != null ? fmt.money(i.target_unit_price, order.currency, 4) : '—' %></td></tr><% }) %>
      </tbody></table>
      <% } else { %>
      <table class="tbl"><thead><tr><th>Description</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody>
      <% order.order_items.forEach(i => { %><tr><td><%= i.description %></td><td><%= i.quantity %></td><td><%= fmt.money(i.unit_price, order.currency, 4) %></td><td><%= fmt.money(i.quantity * i.unit_price, order.currency) %></td></tr><% }) %>
      <tr class="total"><td colspan="3">Goods total</td><td><%= fmt.money(order.subtotal, order.currency) %></td></tr>
      </tbody></table>
      <% } %>
      <% if (order.client_notes) { %><p class="pre"><%= order.client_notes %></p><% } %>
    </div>
    <% if (portalRows.length) { %><div class="card"><h2>Order details</h2><%- include('../partials/order_details', { rows: portalRows }) %></div><% } %>
    <% const due = Number(order.amount_due) > 0; const sched = order.payment_schedule || []; const left = due ? Math.round((Number(order.amount_due) - Number(order.amount_paid)) * 100) / 100 : 0; %>
    <% if (!isReview) { %>
    <div class="card" id="pay">
      <h2>Payment</h2>
      <% if (!due) { %><p class="muted">The payment details will appear here when we send you the proforma invoice.</p>
      <% } else { %>
        <div class="pay-kpis">
          <div><span class="muted small">Invoice total</span><strong><%= fmt.money(order.amount_due, order.currency) %></strong></div>
          <div><span class="muted small">Reported paid</span><strong><%= fmt.money(order.amount_paid, order.currency) %></strong></div>
          <div><span class="muted small">Still to pay</span><strong class="<%= left > 0 ? 'bad' : 'ok' %>"><%= fmt.money(left, order.currency) %></strong></div>
          <% if (open && open.due) { %><div><span class="muted small">Next payment due</span><strong><%= fmt.date(open.due) %></strong></div><% } %>
        </div>
        <% if (sched.length) { %>
        <table class="tbl compact"><thead><tr><th>Instalment</th><th class="right">%</th><th class="right">Amount</th><th>Due</th></tr></thead><tbody>
        <% sched.forEach(x => { %><tr><td><%= x.label %></td><td class="right"><%= Number(x.percent) %>%</td><td class="right num"><%= fmt.money(x.amount, order.currency) %></td><td><%= x.due ? fmt.date(x.due) : '—' %></td></tr><% }) %>
        </tbody></table>
        <% } %>
        <% if (payments.length) { %>
        <h3>Your payments</h3>
        <table class="tbl compact"><tbody>
        <% payments.forEach(x => { %><tr>
          <td><%= fmt.date(x.paid_on || x.created_at) %></td>
          <td class="right num"><%= fmt.money(x.amount, x.currency) %></td>
          <td><%= x.label || '' %><% if (x.reference) { %> <span class="muted small">· <%= x.reference %></span><% } %></td>
          <td><% proofDocs.filter(d => (x.proof_doc_ids || []).includes(d.id)).forEach(d => { %><a href="/portal/documents/<%= d.id %>/download" target="_blank"><%- icon('file') %> proof</a> <% }) %></td>
          <td><span class="pill <%= ({ submitted: 'pending', confirmed: 'ok', rejected: 'bad' })[x.status] %>"><%= ({ submitted: 'To confirm', confirmed: 'Confirmed', rejected: 'Not accepted' })[x.status] %></span><% if (x.status === 'rejected' && x.admin_note) { %><div class="muted small"><%= x.admin_note %></div><% } %></td>
        </tr><% }) %>
        </tbody></table>
        <% } %>
        <% if (left > 0.004) { %>
        <h3>I have paid</h3>
        <p class="muted small">Follow the payment terms and bank details on the proforma invoice (see Documents). After paying, upload the proof and enter the amount — we confirm it as soon as it reaches our account.</p>
        <form method="post" action="/portal/orders/<%= order.id %>/payments" enctype="multipart/form-data" class="payform">
          <div class="row">
            <label>Amount paid (<%= order.currency %>) <input name="amount" type="number" step="0.01" min="0.01" max="<%= left %>" value="<%= open ? open.amount : left %>" required></label>
            <label>Payment date <input name="paid_on" type="date" value="<%= new Date().toISOString().slice(0, 10) %>"></label>
            <label>Bank reference <span class="muted small">optional</span><input name="reference" maxlength="120"></label>
          </div>
          <div class="row">
            <div class="fld"><div class="fieldlbl">Proof of payment <span class="muted small">bank receipt, screenshot or PDF</span></div><div class="dropwrap"><div class="filedrop compact" data-dropzone data-max="10" data-max-mb="20" tabindex="0"><input type="file" name="proofs" multiple required accept="image/*,application/pdf" aria-label="Proof of payment"><span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop files here, or <span class="dlink">browse</span></strong><span class="muted small dsub">Bank receipt, screenshot or PDF · up to 10 files, 20 MB each · paste a screenshot with ⌘/Ctrl V</span></div><div class="fgrid" data-drop-list></div></div></div>
            <label>Note <span class="muted small">optional</span><input name="note" maxlength="500"></label>
          </div>
          <button class="btn primary">Submit payment</button>
        </form>
        <% } else { %><p class="ok">Fully paid — thank you.</p><% } %>
      <% } %>
    </div>
    <% } %>
    <div class="card">
      <h2>Shipments</h2>
      <% if (!shipments.length) { %><p class="muted">Not shipped yet.</p><% } %>
      <% shipments.forEach(s => { %>
        <div class="quote">
          <div class="qhead"><strong><%= fmt.status(s.mode).toUpperCase() %></strong> <span class="pill <%= s.status %>"><%= fmt.status(s.status) %></span></div>
          <dl class="dl">
            <dt>Route</dt><dd><%= s.origin_port || '—' %> → <%= s.destination_port || '—' %> (<%= s.incoterm %>)</dd>
            <dt>Tracking / B/L</dt><dd><%= s.tracking_no || s.bl_no || '—' %></dd>
            <dt>Container</dt><dd><%= s.container_no || '—' %></dd>
            <dt>ETD / ETA</dt><dd><%= fmt.date(s.etd) %> / <%= fmt.date(s.eta) %></dd>
            <dt>Export declaration</dt><dd><%= s.export_declaration_no || (s.export_official ? 'pending' : '—') %></dd>
            <dt>Cargo</dt><dd><%= s.cartons || '—' %> ctns · <%= fmt.num(s.gross_weight_kg,1) %> kg · <%= fmt.num(s.volume_cbm,3) %> cbm</dd>
          </dl>
        </div>
      <% }) %>
    </div>
    <% if (packing.length) { %>
    <div class="card">
      <% const pc = p => Number(p.cartons || 1); const ptot = packing.reduce((a, p) => ({ c: a.c + pc(p), q: a.q + (Number(p.quantity) || 0) * pc(p), g: a.g + (Number(p.gross_weight_kg) || 0) * pc(p), v: a.v + (Number(p.cbm) || 0) * pc(p) }), { c: 0, q: 0, g: 0, v: 0 }); %>
      <h2>Packing list <span class="muted small"><%= ptot.c %> cartons · <%= Number(ptot.q).toLocaleString('en-US') %> pcs · <%= fmt.num(ptot.g, 1) %> kg · <%= fmt.num(ptot.v, 3) %> cbm</span></h2>
      <table class="tbl"><thead><tr><th>Carton</th><th class="right">Ctns</th><th>Description</th><th class="right">Pcs/ctn</th><th>Dims (cm)</th><th class="right">GW/ctn kg</th><th class="right">CBM</th></tr></thead><tbody>
      <% packing.forEach(p => { %><tr><td><%= p.carton_no %></td><td class="right"><%= pc(p) %></td><td><%= p.description %></td><td class="right"><%= p.quantity ?? '—' %></td><td><%= p.length_cm ? Number(p.length_cm) + '×' + Number(p.width_cm) + '×' + Number(p.height_cm) : '—' %></td><td class="right"><%= fmt.num(p.gross_weight_kg,1) %></td><td class="right"><%= fmt.num((Number(p.cbm) || 0) * pc(p),3) %></td></tr><% }) %>
      </tbody></table>
    </div>
    <% } %>
  </div>
  <div>
    <div class="card">
      <h2>Documents & photos</h2>
      <% if (!documents.length) { %><p class="muted">Nothing uploaded yet.</p><% } %>
      <ul class="files">
      <% documents.forEach(d => { %><li><span class="tag"><%= fmt.status(d.kind) %></span> <a href="/portal/documents/<%= d.id %>/download" target="_blank"><%= d.title %></a> <span class="muted small"><%= fmt.date(d.created_at) %></span></li><% }) %>
      </ul>
    </div>
    <div class="card">
      <h2>Timeline</h2>
      <ul class="timeline">
        <% events.forEach(e => { %><li><span class="t"><%= fmt.datetime(e.created_at) %></span> <%= fmt.status(e.action) %><% if (e.detail?.note) { %> — <%= e.detail.note %><% } %></li><% }) %>
        <% if (!(typeof fromPortal !== 'undefined' && fromPortal && events.some(e => e.action === 'order_placed'))) { %><li><span class="t"><%= fmt.datetime(order.created_at) %></span> <%= typeof fromPortal !== 'undefined' && fromPortal ? 'order sent' : 'order confirmed' %></li><% } %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
