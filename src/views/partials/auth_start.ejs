<%# Shared layout for sign-in / invitation / password pages. Close with partials/auth_end. %>
<%
  const letters = (word, cls, start) => [...word].map((ch, k) => `<span class="ch" style="--i:${start + k}">${ch}</span>`).join('');
  const morph = (extra) => `<a class="ab-logo morph ${extra}" href="/login" aria-label="Lumi Trade">
      <span class="m-from" aria-hidden="true"><span class="w1">${letters('Highs', 'w1', 0)}</span><span class="w2">${letters('Business', 'w2', 5)}</span></span>
      <span class="m-to" aria-hidden="true"><span class="w1">${letters('Lumi', 'w1', 0)}</span><span class="w2">${letters('Trade', 'w2', 4)}</span></span>
    </a>`;
%>

<div class="authwrap">
  <aside class="authbrand" aria-hidden="true">
    <%- morph('') %>
    <div class="ab-mid">
      <svg class="ab-route" viewBox="0 0 320 120" fill="none">
        <path d="M14 96 C 90 10, 230 10, 306 70" stroke="currentColor" stroke-width="2" stroke-dasharray="5 7" opacity=".55"/>
        <circle cx="14" cy="96" r="6" fill="#6fd3c4"/><circle cx="306" cy="70" r="6" fill="#ffd65c"/>
        <text x="4" y="118" fill="currentColor" opacity=".7" font-size="11" font-family="Arial">Shenzhen</text>
        <text x="262" y="96" fill="currentColor" opacity=".7" font-size="11" font-family="Arial">Your door</text>
      </svg>
      <h2>Sourcing, orders and shipments — in one place.</h2>
      <ul>
        <li>Send sourcing requests and approve quotes</li>
        <li>Follow production and shipping step by step</li>
        <li>Product photos, packing lists and shipping documents</li>
      </ul>
    </div>
    <p class="ab-foot">🔒 Protected sign-in · one-time code by email</p>
  </aside>
  <section class="authpanel">
    <% const _l = typeof lang === 'undefined' ? 'en' : lang, _h = encodeURIComponent(typeof here === 'undefined' ? '/login' : here); %>
    <span class="langsw authlang" role="group" aria-label="Language"><a href="/lang/en?to=<%= _h %>" class="<%= _l === 'en' ? 'on' : '' %>">EN</a><a href="/lang/ru?to=<%= _h %>" class="<%= _l === 'ru' ? 'on' : '' %>">РУ</a></span>
    <%- morph('mobile') %>
    <div class="authcard">
