<%# The supplier's proforma invoice (PI) + our payments to the supplier, on a supplier PO. locals: po, spis, spays, sdocs, products, aiOn %>
<%
  const pis = typeof spis !== 'undefined' ? spis : [], pays = typeof spays !== 'undefined' ? spays : [], sd = typeof sdocs !== 'undefined' ? sdocs : [], prods = typeof products !== 'undefined' ? products : [];
  const pi = pis[0] || null, hist = pis.slice(1);
  const chk = pi ? checkPi({ lines: pi.lines, declared: pi.declared_total, poTotal: po.total }) : null;
  const plan = pi ? paymentPlan(pi.total, pays) : null, cur = pi ? pi.currency : po.currency;
  const M = v => fmt.money(v, cur);
  const newLines = pi ? (pi.lines || []).map((l, i) => ({ l, i })).filter(x => !x.l.product_id) : [];   // PI lines that are not in our product list yet
  const fromPo = !pi && Array.isArray(po.lines) && po.lines.length > 0;                  // no PI yet: start from our PO, editable
  const base = pi ? pi.lines : (fromPo ? po.lines : []), shown = Math.max(base.length, 1);   // manual entry starts with one line
  const ROWS = Math.max(30, base.length + 10);
  const rowsAll = Array.from({ length: ROWS }, (_, i) => base[i] || {});
  const recv = (typeof docs !== 'undefined' ? docs : []).filter(d => !((pi && pi.file_doc_ids) || []).includes(d.id));   // files the supplier already sent us
  const docT = ids => (ids || []).map(i => sd.find(z => z.id === i)).filter(Boolean);
%>
<div class="card" id="supplier-pi">
  <h2>Supplier PI <span class="muted small">— the supplier's proforma invoice; it sets what we owe</span>
    <% if (pi) { %><span class="pill <%= pi.status === 'confirmed' ? 'ok' : 'pending' %>"><%= pi.status === 'confirmed' ? 'Checked' : 'Draft' %></span><% } %></h2>

  <% if (pi) { %>
    <div class="pisum">
      <div><span class="muted small">PI no.</span><strong><%= pi.pi_no || '—' %></strong><span class="muted small"><%= pi.pi_date ? fmt.date(pi.pi_date) : '' %></span></div>
      <div><span class="muted small">PI total</span><strong class="big"><%= M(pi.total) %></strong></div>
      <div><span class="muted small">Printed on the PI</span><strong><%= chk.declared != null ? M(chk.declared) : '—' %></strong></div>
      <div><span class="muted small">Our PO</span><strong><%= fmt.money(po.total, po.currency) %></strong></div>
    </div>
    <% if (chk.declared == null) { %><div class="alert warn">Enter the total printed on the supplier's PI to check it.</div>
    <% } else if (!chk.matches) { %><div class="alert err"><strong>The lines add up to <%= M(chk.total) %> but the supplier's PI says <%= M(chk.declared) %></strong> (difference <%= M(chk.diff) %>). Check quantities and prices against the file.</div><% } %>
    <% if (chk.samePo === false && pi.currency === po.currency) { %><div class="alert warn small">PI is <%= M(Math.abs(chk.vsPo)) %> <%= chk.vsPo > 0 ? 'higher' : 'lower' %> than our PO to the supplier.</div><% } %>
    <% if (pi.currency !== po.currency) { %><div class="alert warn small">The PI is in <%= pi.currency %>, our PO in <%= po.currency %> — amounts can't be compared directly.</div><% } %>
    <% const pf0 = docT(pi.file_doc_ids); %>
    <% if (pf0.length) { %>
    <div class="spifiles">
      <% pf0.forEach(dd => { %><div class="spifile"><%- icon('file') %><span class="nm" title="<%= dd.title %>"><%= dd.title %></span>
        <a class="link small" href="/admin/documents/<%= dd.id %>/download" target="_blank">View</a>
        <button type="button" class="link small" onclick="var d=document.getElementById('spifile');d.querySelector('[name=replace]').value='<%= dd.id %>';d.querySelector('h2').textContent='Replace the supplier\u2019s PI file';d.showModal()">Replace</button>
        <form method="post" action="/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/files/<%= dd.id %>/remove" class="inline" onsubmit="return confirm('Remove this file from the PI? It stays in the documents.')"><button class="link small danger">Remove</button></form></div><% }) %>
      <button type="button" class="link small" onclick="var d=document.getElementById('spifile');d.querySelector('[name=replace]').value='';d.querySelector('h2').textContent='Add another file';d.showModal()">+ Add another file</button>
    </div>
    <% } else { %>
    <form method="post" action="/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/files" enctype="multipart/form-data" class="spiread">
      <div class="dropwrap"><div class="filedrop compact slim" data-dropzone data-max="8" data-max-mb="20" tabindex="0"><input type="file" name="files" multiple aria-label="Supplier PI file"><span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop the supplier's PI file here, or <span class="dlink">browse</span></strong></div><div class="fgrid" data-drop-list></div></div>
      <button class="btn">Attach</button>
      <%- include('supplier_pi_recv', { recv, pre: true }) %>
    </form>
    <% } %>
    <% if (newLines.length) { %><div class="alert warn"><strong><%= newLines.length === 1 ? '1 product on this PI is' : newLines.length + ' products on this PI are' %> not in your product list yet.</strong> Add <%= newLines.length === 1 ? 'it' : 'them' %> first — a PI can be approved only when every line is a product record. <%= newLines.map(x => x.l.description).join(' · ').slice(0, 160) %></div><% } %>
    <%- include('po_lines', { lines: pi.lines, currency: pi.currency, edit: false, flagNew: true }) %>
    <div class="spiacts">
      <button type="button" class="btn" onclick="var d=document.querySelector('#supplier-pi details.spiedit');d.open=true;d.scrollIntoView({behavior:'smooth',block:'nearest'})">Edit PI</button>
      <% if (typeof aiOn !== 'undefined' && aiOn) { %><button type="button" class="btn" onclick="document.getElementById('spiai').showModal()">Read a new file with AI</button><% } %>
      <% if (pi.status !== 'confirmed') { %><% if (chk.matches && !newLines.length) { %><form method="post" action="/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/approve" class="inline"><button class="btn primary">Approve PI</button></form><% } else { %><button type="button" class="btn primary" disabled title="The lines must match the total printed on the supplier's PI">Approve PI</button><span class="muted small"><%= newLines.length ? 'Add the new products first.' : 'Approve once the lines match the printed total.' %></span><% } %><% } %>
    </div>
    <% if (pi.notes) { %><p class="muted small">Note: <%= pi.notes %></p><% } %>
    <% if (hist.length) { %><p class="muted small">Earlier versions: <%= hist.map(h => (h.pi_no || 'PI') + ' · ' + fmt.money(h.total, h.currency) + ' · ' + fmt.date(h.created_at)).join('  |  ') %></p><% } %>
  <% } else { %>
    <p class="muted small">Attach the supplier's proforma invoice and enter its lines — or let AI read the file. Everything we pay is then counted from this PI.<%= fromPo ? ' The lines below start from our PO — change them to match what the supplier invoiced.' : '' %></p>
  <% } %>

  <% if (!pi) { %>
  <form method="post" action="/admin/purchasing/<%= po.id %>/pi" enctype="multipart/form-data" id="spiform">
  <div class="spiread">
    <div class="dropwrap"><div class="filedrop compact slim" data-dropzone data-max="8" data-max-mb="20" tabindex="0">
      <input type="file" name="files" multiple aria-label="Supplier PI file" accept=".pdf,.xlsx,.xlsm,.csv,.txt,image/*">
      <span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop the supplier's PI here, or <span class="dlink">browse</span></strong>
      <span class="muted small dsub">PDF, Excel or screenshot<%= typeof aiOn !== 'undefined' && aiOn ? ' — AI can fill the lines, you check them' : '' %></span></div><div class="fgrid" data-drop-list></div></div>
  </div>
  <%- include('supplier_pi_recv', { recv, pre: true }) %>
  <div class="spiacts">
    <button type="button" class="btn" id="spiman" onclick="var d=document.querySelector('#supplier-pi details.spiedit');d.open=true;d.scrollIntoView({behavior:'smooth',block:'nearest'})">Enter manually</button>
    <% if (typeof aiOn !== 'undefined' && aiOn) { %><button type="button" class="btn" id="spiaibtn" data-url="/admin/purchasing/<%= po.id %>/pi/read">Read with AI</button><% } %>
    <span class="muted small"><%= fromPo ? 'Manual entry starts from our PO lines.' : '' %> Nothing is overwritten until you save.</span>
  </div>
  <% } %>

  <details class="spiedit<%= pi ? '' : ' nosum' %>">
    <summary class="btn small">Edit PI</summary>
    <% if (pi) { %><form method="post" action="/admin/purchasing/<%= po.id %>/pi" enctype="multipart/form-data" id="spiform"><% } %>
      <% if (pi) { %><input type="hidden" name="pid" value="<%= pi.id %>"><% } %>
      <% if (!pi && fromPo) { %><p class="muted small">The lines start from our PO — change them to match what the supplier invoiced. Save draft keeps your work; Approve PI is available once the lines match the total printed on the PI.</p><% } %>
      <div class="row">
        <label>Supplier's PI no. <input name="pi_no" value="<%= pi?.pi_no || '' %>"></label>
        <label>Date <input type="date" name="pi_date" value="<%= pi?.pi_date || new Date().toISOString().slice(0, 10) %>"></label>
        <label>Currency <select name="currency"><% ['CNY', 'USD', 'EUR', 'GBP'].forEach(c => { %><option <%= c === cur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
        <label>Total printed on the PI <input name="declared_total" type="number" step="0.01" min="0" value="<%= pi && pi.declared_total != null ? pi.declared_total : '' %>" placeholder="must match the lines"></label>
      </div>
      <div class="tablewrap"><table class="tbl compact spilines">
        <thead><tr><th class="c-prod">Product</th><th class="c-desc">Description</th><th class="c-sku">SKU</th><th class="c-qty right">Qty</th><th class="c-unit">Unit</th><th class="c-price right">Unit price</th><th class="c-amt right">Amount</th></tr></thead>
        <tbody>
        <% rowsAll.forEach((l, i) => { %>
          <tr class="spirow" <%= i >= shown ? 'hidden' : '' %>>
            <td><select data-picker="Product" data-new-first name="lines[<%= i %>][product_id]"><option value="">— choose —</option><option value="__new">+ New product…</option><% prods.forEach(p => { %><option value="<%= p.id %>" data-name="<%= p.name %>" data-sku="<%= p.sku || '' %>" data-cost="<%= p.unit_cost ?? '' %>" data-cur="<%= p.cost_currency || '' %>" <%= l.product_id === p.id ? 'selected' : '' %>><%= p.name %><%= p.sku ? ' · ' + p.sku : '' %></option><% }) %></select></td>
            <td><input name="lines[<%= i %>][description]" value="<%= l.description || '' %>"></td>
            <td><input name="lines[<%= i %>][sku]" value="<%= l.sku || '' %>" class="short"></td>
            <td class="right"><input type="number" step="any" min="0" name="lines[<%= i %>][quantity]" value="<%= l.quantity ?? '' %>" class="short"></td>
            <td><input name="lines[<%= i %>][unit]" value="<%= l.unit || 'pcs' %>" class="short"></td>
            <td class="right"><input type="number" step="0.0001" min="0" name="lines[<%= i %>][unit_price]" value="<%= l.unit_price ?? '' %>" class="short"></td>
            <td class="right num spiamt">0.00</td>
          </tr>
        <% }) %>
        </tbody>
        <tfoot><tr><td colspan="6" class="right"><strong>Lines total</strong> <span class="spidiff small"></span></td><td class="right num"><strong id="spitotal">0.00</strong></td></tr></tfoot>
      </table></div>
      <div class="spiactions"><button type="button" class="link small" id="spimore">+ Add line</button>
        <span class="muted small">New product? Choose “+ New product…” in the Product list.</span></div>
      <label>Notes <input name="notes" value="<%= pi?.notes || '' %>"></label>
      <div class="actions"><% if (pi) { %><label class="check small"><input type="checkbox" onchange="this.form.pid.disabled = this.checked"> save as a new revision (keep the old PI in the history)</label><% } %><button class="btn" name="act" value="draft">Save draft</button><button class="btn primary" name="act" value="approve" title="Approve only when the lines match the total printed on the supplier's PI">Approve PI</button></div>
    <% if (pi) { %></form><% } %>
    <% if (pi) { %><form method="post" action="/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/delete" onsubmit="return confirm('Delete this supplier PI? The files stay in the documents.')" class="inline"><button class="link small danger">Delete this PI</button></form><% } %>
  </details>
  <% if (!pi) { %></form><% } %>

  <% if (pi) { %>
  <h3 class="spih">Payments to the supplier</h3>
  <div class="pay-kpis">
    <div><span class="muted small">PI total</span><strong><%= M(plan.total) %></strong></div>
    <div><span class="muted small">Paid</span><strong><%= M(plan.paid) %> <span class="muted small">(<%= plan.pctPaid %>%)</span></strong></div>
    <div><span class="muted small">Open</span><strong class="<%= plan.open > 0.004 ? 'bad' : 'ok' %>"><%= M(Math.max(0, plan.open)) %></strong></div>
    <div><span class="muted small">Status</span><strong><%= ({ unpaid: 'Unpaid', partial: 'Partially paid', paid: 'Paid', over: 'Overpaid' })[plan.status] %></strong></div>
  </div>
  <div class="paylist">
    <% plan.rows.forEach(x => { const pf = docT(x.proof_doc_ids); %>
    <div class="payrow"><div class="payline">
      <strong class="payamt"><%= M(x.amount) %></strong>
      <span class="paymeta"><b><%= x.label || 'Payment' %><%= x.pct != null ? ' · ' + x.pct + '% of PI' : '' %></b><span><%= fmt.date(x.paid_on || x.created_at) %><%= x.reference ? ' · ref ' + x.reference : '' %></span></span>
      <span></span>
      <span class="payfiles"><% pf.forEach((dd, i) => { %><a class="fchip" href="/admin/documents/<%= dd.id %>/download" target="_blank" title="<%= dd.title %>"><%- icon('file') %>&nbsp;Proof<%= pf.length > 1 ? ' ' + (i + 1) : '' %></a><% }) %><button type="button" class="link small" onclick="document.getElementById('spf-<%= x.id %>').showModal()"><%= pf.length ? '+' : '+ Proof' %></button></span>
      <button type="button" class="link small payedit" onclick="document.getElementById('spe-<%= x.id %>').showModal()">Edit</button>
    </div></div>
    <% }) %>
  </div>
  <button type="button" class="btn primary payadd" onclick="document.getElementById('sprec').showModal()">+ Record a payment to the supplier</button>

  <dialog id="sprec" class="bookdlg">
    <h2>Payment to supplier <span class="muted small">PI total <%= M(plan.total) %> · open <%= M(Math.max(0, plan.open)) %></span></h2>
    <form method="post" action="/admin/purchasing/<%= po.id %>/payments" class="payrec dlg">
      <label class="wide">Amount (<%= cur %>) <input name="amount" id="spamt" type="number" step="0.01" min="0.01" required></label>
      <div class="wide presets"><% [30, 50, 70].forEach(p => { %><button type="button" class="btn small" data-v="<%= (plan.total * p / 100).toFixed(2) %>" data-l="<%= p %>%"><%= p %>% = <%= M(plan.total * p / 100) %></button><% }) %><% if (plan.open > 0.004) { %><button type="button" class="btn small" data-v="<%= plan.open.toFixed(2) %>" data-l="Balance">Open balance = <%= M(plan.open) %></button><% } %></div>
      <label>Date <input type="date" name="paid_on" value="<%= new Date().toISOString().slice(0, 10) %>"></label>
      <label>Instalment <input name="label" id="splabel" placeholder="Deposit / Balance" autocomplete="off"></label>
      <label class="wide">Reference <input name="reference" placeholder="Bank ref / invoice no"></label>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Record</button></div>
    </form>
  </dialog>
  <% plan.rows.forEach(x => { %>
  <dialog id="spe-<%= x.id %>" class="bookdlg">
    <h2>Edit payment</h2>
    <form method="post" action="/admin/purchasing/<%= po.id %>/payments/<%= x.id %>/edit" class="payrec dlg">
      <label>Amount (<%= cur %>) <input name="amount" type="number" step="0.01" min="0.01" required value="<%= x.amount %>"></label>
      <label>Date <input type="date" name="paid_on" value="<%= String(x.paid_on || x.created_at || '').slice(0, 10) %>"></label>
      <label>Instalment <input name="label" value="<%= x.label || '' %>" autocomplete="off"></label>
      <label>Reference <input name="reference" value="<%= x.reference || '' %>"></label>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Save</button></div>
    </form>
    <form method="post" action="/admin/purchasing/<%= po.id %>/payments/<%= x.id %>/delete" onsubmit="return confirm('Delete this payment record? The uploaded files stay in the documents.')" class="inline"><button class="link small danger">Delete this record</button></form>
  </dialog>
  <dialog id="spf-<%= x.id %>" class="bookdlg">
    <h2>Proof of payment <span class="muted small"><%= M(x.amount) %></span></h2>
    <form method="post" action="/admin/purchasing/<%= po.id %>/payments/<%= x.id %>/files" enctype="multipart/form-data">
      <div class="dropwrap"><div class="filedrop compact" data-dropzone data-max="8" data-max-mb="20" tabindex="0"><input type="file" name="files" multiple aria-label="Proof of payment"><span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop files here, or <span class="dlink">browse</span></strong><span class="muted small dsub">Bank slip, transfer confirmation, screenshot · paste with ⌘/Ctrl V</span></div><div class="fgrid" data-drop-list></div></div>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Upload</button></div>
    </form>
  </dialog>
  <% }) %>
  <% } %>

  <dialog id="spnew" class="bookdlg">
    <h2>New product</h2>
    <form id="spnewform" class="payrec dlg">
      <label class="wide">Name <input name="name" required maxlength="200" autocomplete="off"></label>
      <label>SKU <input name="sku" maxlength="80" autocomplete="off"></label>
      <label>Unit price (from the supplier) <input name="unit_cost" type="number" step="0.0001" min="0"></label>
      <label>Currency <select name="cost_currency"><% ['CNY', 'USD', 'EUR'].forEach(c => { %><option <%= c === cur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>MOQ <input name="moq" type="number" min="0"></label>
      <input type="hidden" name="supplier_id" value="<%= po.supplier_id || '' %>">
      <div class="wide small" id="spnewerr" style="color:#b42318" hidden></div>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Create product</button></div>
    </form>
    <p class="muted small">A simple card — add photos, packing and specs later on the product page.</p>
  </dialog>
  <% if (pi && newLines.length) { %>
  <dialog id="spaddp" class="bookdlg">
    <h2>Add to my products</h2>
    <p class="muted small">Creates a simple product card for <strong><%= supplier ? supplier.name : 'this supplier' %></strong> and links this PI line to it. Add photos, packing and specs later on the product page.</p>
    <form method="post" id="spaddpform" class="payrec dlg" action="">
      <label class="wide">Name <input name="name" required maxlength="200" autocomplete="off"></label>
      <label>Our SKU <input name="sku" maxlength="80" placeholder="optional" autocomplete="off"></label>
      <label>Supplier's part no. <input name="supplier_sku" maxlength="80" autocomplete="off"></label>
      <label>Unit price (from the PI) <input name="unit_cost" type="number" step="0.0001" min="0"></label>
      <label>Currency <select name="cost_currency"><% ['CNY', 'USD', 'EUR'].forEach(c => { %><option <%= c === cur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label class="wide">Description <input name="description" maxlength="1000" autocomplete="off"></label>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Create product &amp; link</button></div>
    </form>
  </dialog>
  <script>
  (function () {
    const lines = <%- JSON.stringify((pi.lines || []).map(l => ({ d: l.description || '', s: l.sku || '', p: l.unit_price ?? '' }))).replace(/</g, '\\u003c') %>;
    const d = document.getElementById('spaddp'), f = document.getElementById('spaddpform');
    document.querySelectorAll('#supplier-pi [data-addprod]').forEach(b => b.addEventListener('click', () => {
      const i = Number(b.dataset.addprod), l = lines[i] || {};
      f.action = '/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/line/' + i + '/product';
      f.reset(); f.name.value = l.d; f.supplier_sku.value = l.s; f.unit_cost.value = l.p; f.description.value = l.d; d.showModal(); f.name.focus();
    }));
  })();
  </script>
  <% } %>
  <% if (pi) { %>
  <% if (typeof aiOn !== 'undefined' && aiOn) { %>
  <dialog id="spiai" class="bookdlg">
    <h2>Read a new file with AI</h2>
    <p class="muted small">This adds a <strong>new draft revision</strong> from the file. The current PI and your edits are not changed — they stay in the history.</p>
    <form method="post" action="/admin/purchasing/<%= po.id %>/pi/read" enctype="multipart/form-data">
      <div class="dropwrap"><div class="filedrop compact" data-dropzone data-max="1" data-max-mb="20" tabindex="0"><input type="file" name="files" aria-label="Supplier PI file" accept=".pdf,.xlsx,.xlsm,.csv,.txt,image/*"><span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop the file here, or <span class="dlink">browse</span></strong></div><div class="fgrid" data-drop-list></div></div>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Read with AI</button></div>
    </form>
  </dialog>
  <% } %>
  <dialog id="spifile" class="bookdlg">
    <h2>Attach the supplier's PI file</h2>
    <form method="post" action="/admin/purchasing/<%= po.id %>/pi/<%= pi.id %>/files" enctype="multipart/form-data">
      <input type="hidden" name="replace" value="">
      <%- include('supplier_pi_recv', { recv, pre: false }) %>
      <div class="dropwrap"><div class="filedrop compact" data-dropzone data-max="8" data-max-mb="20" tabindex="0"><input type="file" name="files" multiple aria-label="PI file"><span class="dicon"><%- icon('upload') %></span><strong data-drop-count>Drop files here, or <span class="dlink">browse</span></strong></div><div class="fgrid" data-drop-list></div></div>
      <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Upload</button></div>
    </form>
  </dialog>
  <% } %>
  <script>
  (function () {
    const root = document.getElementById('supplier-pi');
    root.querySelectorAll('dialog.bookdlg').forEach(d => d.addEventListener('click', e => { if (e.target === d) d.close(); }));
    const form = document.getElementById('spiform'); if (!form) return;
    let dirty = false; form.addEventListener('input', e => { if (e.target.type !== 'file') dirty = true; });
    const aib = document.getElementById('spiaibtn');
    if (aib) aib.addEventListener('click', () => {
      if (dirty && !confirm('You have typed changes in the lines. Reading a file with AI creates a separate draft from the file — your typed changes on this form will not be saved. Continue?')) return;
      form.action = aib.dataset.url; form.submit();
    });
    const rows = [...form.querySelectorAll('tr.spirow')], tot = document.getElementById('spitotal'), diff = form.querySelector('.spidiff'), decl = form.querySelector('[name=declared_total]');
    const f2 = v => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    function calc() {
      let t = 0;
      rows.forEach(r => { const q = parseFloat(r.querySelector('[name$="[quantity]"]').value) || 0, p = parseFloat(r.querySelector('[name$="[unit_price]"]').value) || 0, a = Math.round(q * p * 100) / 100; t += a; r.querySelector('.spiamt').textContent = a ? f2(a) : ''; });
      t = Math.round(t * 100) / 100; tot.textContent = f2(t);
      const d = decl.value === '' ? null : Math.round((parseFloat(decl.value) - t) * 100) / 100;
      diff.textContent = d == null ? '' : Math.abs(d) < 0.01 ? '✓ matches the printed total' : '⚠ differs from the printed total by ' + f2(d);
      diff.style.color = d == null ? '' : Math.abs(d) < 0.01 ? '#0b8a7a' : '#b42318';
    }
    let target = null;
    const nd = document.getElementById('spnew'), nf = document.getElementById('spnewform'), ne = document.getElementById('spnewerr');
    rows.forEach(r => {
      r.addEventListener('input', calc);
      r.querySelector('select').addEventListener('change', e => {
        const o = e.target.selectedOptions[0]; if (!o || !o.value) return;
        if (o.value === '__new') { e.target.value = ''; target = e.target; nf.reset(); ne.hidden = true; nd.showModal(); nf.name.focus(); return; }
        const set = (sel, v) => { const i = r.querySelector(sel); if (i && v !== '') i.value = v; };
        set('[name$="[description]"]', o.dataset.name || ''); set('[name$="[sku]"]', o.dataset.sku || '');
        const price = r.querySelector('[name$="[unit_price]"]'); if (o.dataset.cost) { price.value = o.dataset.cost; price.title = 'Price from the product record (' + (o.dataset.cur || '') + ') — change it if the supplier quoted differently'; }
        calc();
      });
    });
    nf.addEventListener('submit', async e => {
      e.preventDefault(); ne.hidden = true;
      const body = Object.fromEntries(new FormData(nf).entries());
      try {
        const res = await fetch('/admin/products/quick', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
        const p = await res.json(); if (!res.ok) throw new Error(p.error || 'Could not create the product.');
        form.querySelectorAll('tr.spirow select').forEach(sel => {   // the new product is available in every row
          const op = new Option(p.name + (p.sku ? ' · ' + p.sku : ''), p.id); op.dataset.name = p.name; op.dataset.sku = p.sku || ''; op.dataset.cost = p.unit_cost ?? ''; op.dataset.cur = p.cost_currency || '';
          sel.add(op, sel.options[2] || null);
        });
        if (target) { target.value = p.id; target.dispatchEvent(new Event('change', { bubbles: true })); }
        nd.close();
      } catch (err) { ne.textContent = err.message; ne.hidden = false; }
    });
    decl.addEventListener('input', calc);
    document.getElementById('spimore').addEventListener('click', e => { const h = rows.find(r => r.hidden); if (h) h.hidden = false; if (!rows.some(r => r.hidden)) e.target.hidden = true; });
    calc();
    root.querySelectorAll('.presets button').forEach(b => b.addEventListener('click', () => { document.getElementById('spamt').value = b.dataset.v; const l = document.getElementById('splabel'); if (!l.value) l.value = b.dataset.l; }));
  })();
  </script>
</div>
