<%# Owner of a record (clients, requests, quotes, RFQs, orders, shipments). Rendered only when the access-levels migration (0036) is in place. %>
<% if (typeof ownerBox !== 'undefined' && ownerBox) { const ob = ownerBox; %>
<div class="ownerbox<%= typeof inline !== 'undefined' && inline ? ' inline' : '' %>">
  <span class="muted"><%= typeof inline !== 'undefined' && inline ? 'Account owner' : 'Owner:' %></span>
  <% if (canAssign) { %>
  <form method="post" action="/admin/owner" class="inline ownerform">
    <input type="hidden" name="table" value="<%= ob.table %>"><input type="hidden" name="id" value="<%= ob.id %>"><input type="hidden" name="redirect" value="<%= ob.redirect %>">
    <% if (['organizations', 'requests', 'orders'].includes(ob.table)) { %><input type="hidden" name="cascade" value="1"><% } %>
    <select name="owner_id" aria-label="Owner" title="Change owner (also moves what belongs to this record)" onchange="this.form.submit()">
      <option value="">— nobody —</option>
      <% ob.staff.forEach(p => { %><option value="<%= p.id %>" <%= p.id === ob.ownerId ? 'selected' : '' %>><%= p.full_name || p.email %></option><% }) %>
    </select>
  </form>
  <% } else { %><strong><%= ob.ownerName || '—' %></strong><% } %>
  <% if (ob.createdByName) { %><span class="muted">· created by <%= ob.createdByName %></span><% } %>
</div>
<% } %>
