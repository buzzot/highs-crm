<%# Lines of a PO / PI. locals: lines, currency, [edit] (admin can change them) %>
<% const ed = typeof edit !== 'undefined' && edit; const money = v => Number(v || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
   const total = lines.reduce((t, l) => t + Number(l.quantity || 0) * Number(l.unit_price || 0), 0); %>
<div class="tablewrap"><table class="tbl compact polines">
  <thead><tr><th>#</th><th>Description</th><th>SKU / part no.</th><th class="right">Qty</th><th>Unit</th><th class="right">Unit price (<%= currency %>)</th><th class="right">Amount</th></tr></thead>
  <tbody id="poLines">
  <% lines.forEach((l, i) => { %>
    <tr>
      <td class="muted"><%= i + 1 %></td>
      <% if (ed) { %>
        <td><input name="lines[<%= i %>][description]" value="<%= l.description %>" required><% if (l.product_id) { %><input type="hidden" name="lines[<%= i %>][product_id]" value="<%= l.product_id %>"><% } %></td>
        <td><input name="lines[<%= i %>][sku]" value="<%= l.sku || '' %>"></td>
        <td class="right"><input type="number" step="any" min="0" name="lines[<%= i %>][quantity]" value="<%= l.quantity %>" class="short"></td>
        <td><input name="lines[<%= i %>][unit]" value="<%= l.unit || 'pcs' %>" class="short"></td>
        <td class="right"><input type="number" step="0.0001" min="0" name="lines[<%= i %>][unit_price]" value="<%= l.unit_price %>" class="short"></td>
      <% } else { %>
        <td><%= l.description %><% if (typeof flagNew !== 'undefined' && flagNew && !l.product_id) { %><div class="newprod"><span class="tag warn">New product</span> <button type="button" class="link small" data-addprod="<%= i %>">+ Add to my products</button></div><% } %></td><td class="muted"><%= l.sku || '—' %></td>
        <td class="right num"><%= Number(l.quantity).toLocaleString('en-US') %></td><td><%= l.unit || 'pcs' %></td>
        <td class="right num"><%= Number(l.unit_price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: Number(l.unit_price) !== 0 && Math.abs(Number(l.unit_price)) < 0.1 ? 4 : 2 }) %></td>
      <% } %>
      <td class="right num"><strong><%= money(Number(l.quantity || 0) * Number(l.unit_price || 0)) %></strong></td>
    </tr>
  <% }) %>
  </tbody>
  <tfoot><tr><td colspan="6" class="right"><strong>Total</strong></td><td class="right num"><strong><%= currency %> <%= money(total) %></strong></td></tr></tfoot>
</table></div>
