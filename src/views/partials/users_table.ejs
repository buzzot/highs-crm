<%#
  Portal users with invitation status and last sign-in, plus the invite box.
  locals: members (memberRows), base (e.g. /admin/clients/<id>) — posts to base/invite, base/invites/cancel, base/users/<uid>/toggle
          emptyText, firstPlaceholder, firstValue, otherPlaceholder
%>
<%
  const ago = d => { if (!d) return ''; const days = Math.floor((Date.now() - new Date(d)) / 864e5); return days <= 0 ? 'today' : days === 1 ? 'yesterday' : days < 30 ? days + ' days ago' : fmt.date(d); };
%>
<% if (typeof invShow !== 'undefined' && invShow) { %>
<div class="invshow">
  <div class="invshow-head"><strong>Invitation for <%= invShow.email %></strong>
    <% if (invShow.err) { %><span class="badge warn">Email failed — <%= invShow.err %></span><% } else if (!invShow.mailed) { %><span class="muted small">No email was sent.</span><% } %>
    <span class="muted small">Shown only once — copy it now. Valid 14 days.</span></div>
  <div class="invshow-row"><span class="invshow-lbl">Link</span><input class="invshow-val" readonly value="<%= invShow.link %>" aria-label="Invitation link"><button type="button" class="btn small" data-copy="<%= invShow.link %>">Copy link</button></div>
  <div class="invshow-row"><span class="invshow-lbl">Code</span><input class="invshow-val invshow-code" readonly value="<%= invShow.code %>" aria-label="Confirmation code"><button type="button" class="btn small" data-copy="<%= invShow.code %>">Copy code</button></div>
  <div class="invshow-row"><span class="invshow-lbl">Message</span><input class="invshow-val" readonly value="Please open <%= invShow.link %> and enter code <%= invShow.code %> to set up your account." aria-label="Ready message"><button type="button" class="btn small" data-copy="Please open <%= invShow.link %> and enter code <%= invShow.code %> to set up your account.">Copy message</button></div>
  <p class="muted small">The supplier opens the link, types the code, then fills in their details and sets a password. Lost it? Use “New link (no email)” on their row.</p>
</div>
<% } %>
<%
  const rich = typeof inviteDialog !== 'undefined' && inviteDialog;
  const stOf = m => m.state === 'accepted' ? (m.active === false ? 'disabled' : 'active') : m.state === 'pending' ? 'pending' : m.state === 'expired' ? 'expired' : (m.active === false ? 'cancelled' : 'manual');
  const cnt = {}; members.forEach(m => { const k = stOf(m); cnt[k] = (cnt[k] || 0) + 1; });
  const LBL = { active: 'Active', pending: 'Pending invitation', expired: 'Expired invitation', disabled: 'Disabled', cancelled: 'Cancelled', manual: 'No invitation' };
  const cf = (title, text, ok, danger) => `data-confirm-title="${title}" data-confirm-text="${text}" data-confirm-ok="${ok}"${danger ? ' data-confirm-danger="1"' : ''}`;
%>
<% if (members.length) { %>
<% if (rich && Object.keys(cnt).length > 1) { %>
<div class="ufilter" role="group" aria-label="Filter users by status">
  <button type="button" class="on" data-ustate="all">All <span><%= members.length %></span></button>
  <% ['active', 'pending', 'expired', 'disabled', 'cancelled', 'manual'].filter(k => cnt[k]).forEach(k => { %><button type="button" data-ustate="<%= k %>"><%= LBL[k] %> <span><%= cnt[k] %></span></button><% }) %>
</div>
<% } %>
<table class="tbl users" id="utable">
  <thead><tr><th>Email (login)</th><th>Name</th><th>Status</th><th>Last sign-in</th><th class="right">Actions</th></tr></thead>
  <tbody>
  <% members.forEach(m => { const k = stOf(m); %>
    <tr class="<%= k === 'disabled' || k === 'cancelled' ? 'dim' : '' %>" data-ustate="<%= k %>">
      <td><strong class="uemail"><%= m.email %></strong></td>
      <td data-l="Name"><%= m.full_name || '—' %><% if (m.job_title) { %><div class="muted small"><%= m.job_title %></div><% } %></td>
      <td data-l="Status">
        <% if (k === 'active') { %><span class="badge ok">Active</span><div class="muted small">joined <%= fmt.date(m.accepted_at) %></div>
        <% } else if (k === 'disabled') { %><span class="badge off">Disabled</span><div class="muted small">cannot sign in</div>
        <% } else if (k === 'pending') { %><span class="badge info">Pending invitation</span><div class="muted small">sent <%= fmt.date(m.sent_at) %> · <%= m.days_left %> day<%= m.days_left === 1 ? '' : 's' %> left</div>
        <% } else if (k === 'expired') { %><span class="badge warn">Expired invitation</span><div class="muted small">sent <%= fmt.date(m.sent_at) %> · link no longer works</div>
        <% } else if (k === 'cancelled') { %><span class="badge off">Invitation cancelled</span><div class="muted small">link no longer works</div>
        <% } else { %><span class="badge off">No invitation</span><% } %>
      </td>
      <td data-l="Last sign-in"><% if (m.accepted_at || k === 'active') { %><% if (m.last_login_at) { %><%= fmt.datetime(m.last_login_at) %><div class="muted small"><%= ago(m.last_login_at) %></div><% } else { %><span class="muted">Never signed in</span><% } %><% } else { %><span class="muted">—</span><% } %></td>
      <td class="right nowrap uact">
        <% if (k === 'pending' || k === 'expired' || k === 'cancelled' || k === 'manual') { %>
          <form method="post" action="<%= base %>/invite" class="inline" <%- cf('Send a new invitation?', 'A new email goes to ' + m.email + '. The previous link and code stop working.', 'Send invitation') %>><input type="hidden" name="email" value="<%= m.email %>"><button class="btn small <%= k === 'expired' ? 'primary' : '' %>" title="Emails a new link and code; the previous ones stop working"><%= k === 'pending' ? 'Resend' : k === 'expired' ? 'Resend' : 'Invite again' %></button></form>
          <form method="post" action="<%= base %>/invite" class="inline" <%- cf('Create a new link?', 'No email is sent. A new link and code are shown once; the previous link and code stop working.', 'Create new link') %>><input type="hidden" name="email" value="<%= m.email %>"><input type="hidden" name="no_email" value="1"><button class="link small" title="Create a fresh link and code without sending an email">New link</button></form>
          <% if (k === 'manual' && m.id) { %><form method="post" action="<%= base %>/users/<%= m.id %>/toggle" class="inline" <%- cf('Disable portal access?', m.email + ' will not be able to sign in until you enable them again.', 'Disable user', true) %>><button class="link small danger">Disable</button></form><% } %>
          <% if (k === 'pending' || k === 'expired') { %><form method="post" action="<%= base %>/invites/cancel" class="inline" <%- cf('Cancel this invitation?', 'The invitation for ' + m.email + ' stops working immediately. You can invite them again later.', 'Cancel invitation', true) %>><input type="hidden" name="email" value="<%= m.email %>"><button class="link small danger">Cancel</button></form><% } %>
        <% } else if (m.id && k === 'active') { %>
          <form method="post" action="<%= base %>/users/<%= m.id %>/toggle" class="inline" <%- cf('Disable portal access?', m.email + ' will be signed out and cannot sign in until you enable them again. Their requests and orders are kept.', 'Disable user', true) %>><button class="link small danger">Disable</button></form>
        <% } else if (m.id && k === 'disabled') { %>
          <form method="post" action="<%= base %>/users/<%= m.id %>/toggle" class="inline" <%- cf('Enable portal access?', m.email + ' will be able to sign in again.', 'Enable user') %>><button class="link small">Enable</button></form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% if (rich) { %><p class="muted small ufoot">Sending a new invitation or link replaces the previous one — the earlier link and code stop working straight away. Links and codes are shown once and are never stored in the activity history.</p><% } %>
<% } else { %>
  <p class="muted"><%= emptyText %></p>
<% } %>
<dialog class="modaldlg" id="cfmdlg" aria-labelledby="cfmtitle">
  <h2 id="cfmtitle">Are you sure?</h2><p id="cfmtext" class="cfmtext"></p>
  <div class="actions"><button type="button" class="btn" id="cfmno">Keep as is</button><button type="button" class="btn primary" id="cfmok">Confirm</button></div>
</dialog>
<script>
(function () {
  var dlg = document.getElementById('cfmdlg'), pending = null; if (!dlg) return;
  document.addEventListener('submit', function (e) {
    var f = e.target; if (!f.dataset || !f.dataset.confirmText || f.dataset.confirmed) return;
    e.preventDefault(); pending = f;
    document.getElementById('cfmtitle').textContent = f.dataset.confirmTitle || 'Are you sure?';
    document.getElementById('cfmtext').textContent = f.dataset.confirmText;
    var ok = document.getElementById('cfmok'); ok.textContent = f.dataset.confirmOk || 'Confirm'; ok.classList.toggle('danger', !!f.dataset.confirmDanger);
    if (dlg.showModal) dlg.showModal(); else if (confirm(f.dataset.confirmText)) { f.dataset.confirmed = 1; f.submit(); }
  }, true);
  document.getElementById('cfmno').addEventListener('click', function () { pending = null; dlg.close(); });
  document.getElementById('cfmok').addEventListener('click', function () { var f = pending; dlg.close(); if (f) { f.dataset.confirmed = 1; f.submit(); } });
  document.querySelectorAll('.ufilter [data-ustate]').forEach(function (b) { b.addEventListener('click', function () {
    document.querySelectorAll('.ufilter [data-ustate]').forEach(function (x) { x.classList.toggle('on', x === b); });
    document.querySelectorAll('#utable tbody tr').forEach(function (tr) { tr.hidden = b.dataset.ustate !== 'all' && tr.dataset.ustate !== b.dataset.ustate; });
  }); });
})();
</script>
<% if (typeof inviteDialog !== 'undefined' && inviteDialog) { %>
<dialog class="modaldlg" id="invitedlg" aria-labelledby="invtitle">
  <form method="post" action="<%= base %>/invite" class="modalform">
    <h2 id="invtitle">Invite a user</h2>
    <label>Email <input type="email" name="email" required placeholder="<%= members.length ? otherPlaceholder : firstPlaceholder %>" value="<%= members.length ? '' : firstValue %>" autocomplete="off"></label>
    <label class="chk"><input type="checkbox" name="no_email" value="1"> Can't receive email? Don't send — give me the link</label>
    <p class="muted small">The invitation is valid 14 days. They confirm their email, fill in the company details and create a password.</p>
    <div class="actions"><button type="button" class="btn" data-close>Cancel</button><button class="btn primary"><%- icon('mail') %> Send invitation</button></div>
  </form>
</dialog>
<% } else { %>
<form method="post" action="<%= base %>/invite" class="row tight inviteform">
  <input type="email" name="email" required placeholder="<%= members.length ? otherPlaceholder : firstPlaceholder %>" value="<%= members.length ? '' : firstValue %>" aria-label="Email to invite">
  <button class="btn primary"><%- icon('mail') %> <%= members.length ? 'Invite another user' : 'Send invitation' %></button>
  <label class="chk"><input type="checkbox" name="no_email" value="1"> Can't receive email? Don't send — give me the link</label>
  <span class="muted small">The invitation is valid 14 days.</span>
</form>
<% } %>
