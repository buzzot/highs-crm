<%#
  People + invitation status. locals: members (from memberRows), inviteAction (POST url for (re)sending),
  [cancelAction] (POST url to cancel an open invite), [toggleBase] (url prefix + /<uid>/toggle), [showRole]
%>
<ul class="members">
  <% if (!members.length) { %><li class="muted small">Nobody yet — send the first invitation below.</li><% } %>
  <% members.forEach(m => { %>
    <li class="<%= m.active === false && m.state === 'accepted' ? 'dim' : '' %>">
      <span class="avatar <%= m.state %>"><%= (m.full_name || m.email || '?').trim().charAt(0).toUpperCase() %></span>
      <div class="who">
        <div class="name"><%= m.full_name || m.email %><% if (typeof showRole !== 'undefined' && showRole && m.role) { %> <span class="tag"><%= m.role === 'admin' ? 'Admin' : m.staff_level === 'manager' ? 'Manager' : m.role === 'staff' ? 'Director' : m.role %></span><% } %></div>
        <% if (m.full_name) { %><div class="muted small"><%= m.email %></div><% } %>
        <% if (m.id && typeof levelAction !== 'undefined' && levelAction && m.state === 'accepted') { %><button type="button" class="link small" onclick="document.getElementById('nm-<%= m.id %>').showModal()"><%= m.full_name ? 'Rename' : '+ Add name' %></button>
          <dialog id="nm-<%= m.id %>" class="bookdlg"><h2>Name</h2><p class="muted small">Shown as the owner of records instead of the email.</p>
            <form method="post" action="<%= levelAction %>/<%= m.id %>/name"><label>Full name <input name="full_name" value="<%= m.full_name || '' %>" maxlength="80" required autocomplete="off"></label>
              <div class="actions"><button type="button" class="btn" onclick="this.closest('dialog').close()">Cancel</button><button class="btn primary">Save</button></div></form></dialog><% } %>
        <div class="istate small">
          <% if (m.state === 'accepted') { %>
            <% if (m.active === false) { %><span class="badge">Disabled</span><% } else { %><span class="badge ok">✓ Active</span><% } %> <span class="muted">joined <%= fmt.date(m.accepted_at) %> · <%= m.last_login_at ? 'last sign-in ' + fmt.datetime(m.last_login_at) : 'not signed in yet' %></span>
          <% } else if (m.state === 'pending') { %>
            <span class="badge info">Invitation sent</span> <span class="muted"><%= fmt.date(m.sent_at) %> · not accepted yet · link valid <%= m.days_left %> more day<%= m.days_left === 1 ? '' : 's' %></span>
          <% } else if (m.state === 'expired') { %>
            <span class="badge warn">Invitation expired</span> <span class="muted">sent <%= fmt.date(m.sent_at) %> · not accepted within 14 days</span>
          <% } else { %>
            <span class="badge">No invitation</span> <span class="muted">account created manually</span>
          <% } %>
        </div>
      </div>
      <div class="mact">
        <% if (m.state === 'pending' || m.state === 'expired') { %>
          <form method="post" action="<%= inviteAction %>" class="inline"><input type="hidden" name="email" value="<%= m.email %>"><button class="btn small <%= m.state === 'expired' ? 'primary' : '' %>">Resend</button></form>
          <% if (typeof cancelAction !== 'undefined' && cancelAction) { %>
          <form method="post" action="<%= cancelAction %>" class="inline" onsubmit="return confirm('Cancel the invitation for <%= m.email %>?')"><input type="hidden" name="email" value="<%= m.email %>"><button class="link small danger">Cancel</button></form>
          <% } %>
        <% } else if (m.id && typeof levelAction !== 'undefined' && levelAction && m.state === 'accepted' && ['admin', 'staff'].includes(m.role)) { const _lv = m.role === 'admin' ? 'admin' : m.staff_level === 'manager' ? 'manager' : 'director'; %>
          <form method="post" action="<%= levelAction %>/<%= m.id %>/level" class="inline"><select name="level" class="lvlsel" aria-label="Access level" onchange="this.form.submit()"><option value="admin" <%= _lv === 'admin' ? 'selected' : '' %>>Admin</option><option value="director" <%= _lv === 'director' ? 'selected' : '' %>>Director</option><option value="manager" <%= _lv === 'manager' ? 'selected' : '' %>>Manager</option></select></form>
          <% if (typeof toggleBase !== 'undefined' && toggleBase) { %><form method="post" action="<%= toggleBase %>/<%= m.id %>/toggle" class="inline"><button class="link small"><%= m.active === false ? 'Enable' : 'Disable' %></button></form><% } %>
        <% } else if (m.id && typeof toggleBase !== 'undefined' && toggleBase) { %>
          <form method="post" action="<%= toggleBase %>/<%= m.id %>/toggle" class="inline"><button class="link small"><%= m.active === false ? 'Enable' : 'Disable' %></button></form>
        <% } %>
      </div>
    </li>
  <% }) %>
</ul>
