<%- include('../partials/head') %>
<div class="pagehead"><div><h1>My products</h1><p class="muted">Products Lumi Trade buys from you, as we have them on file. Add new ones yourself, or send us your latest price list for changes.</p></div>
  <a class="btn primary" href="/supplier/products/new"><%- icon('plus') %> Add product</a></div>
<% if (subs && subs.length) { %>
<div class="card">
  <h2>Your submissions <span class="count"><%= subs.length %></span></h2>
  <table class="tbl">
    <thead><tr><th></th><th>Product</th><th>Status</th><th>Updated</th><th></th></tr></thead>
    <tbody>
    <% subs.forEach(x => { const ph = (x.data && x.data.photo_ids || [])[0]; const label = { draft: 'Draft', submitted: 'With Lumi Trade for review', returned: 'Sent back to you' }[x.status] || x.status; %>
      <tr>
        <td class="thumbcell"><% if (ph) { %><img class="pthumbsm" src="/supplier/photos/<%= ph %>" alt="" loading="lazy"><% } %></td>
        <td><strong><%= x.data && x.data.name || '(no name)' %></strong><% if (x.status === 'returned' && x.review_note) { %><div class="small bad"><%= x.review_note %></div><% } %></td>
        <td><span class="pill <%= x.status === 'returned' ? 'bad' : x.status === 'submitted' ? 'quoted' : 'new' %>"><%= label %></span></td>
        <td class="small muted"><%= fmt.date(x.updated_at) %></td>
        <td class="right nowrap"><% if (x.status === 'draft' || x.status === 'returned') { %><a class="btn small" href="/supplier/products/<%= x.id %>/edit"><%= x.status === 'returned' ? 'Fix and resubmit' : 'Continue' %></a>
          <form method="post" action="/supplier/products/<%= x.id %>/delete" class="inline" onsubmit="return confirm('Delete this draft?')"><button class="link small danger">Delete</button></form><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<div class="card">
  <% if (!products.length) { %><p class="muted">No products on file yet.</p><% } else { %>
  <table class="tbl">
    <thead><tr><th></th><th>Product</th><th>Your SKU</th><th>Category</th><th class="right">Price</th><th>MOQ</th><th>Carton</th></tr></thead>
    <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td class="thumbcell"><% if (photoOf[p.id]) { %><img class="pthumbsm" src="/supplier/photos/<%= photoOf[p.id] %>" alt="" loading="lazy"><% } %></td>
        <td><strong><%= p.name %></strong><% if (p.hs_code) { %><div class="muted small">HS <%= p.hs_code %></div><% } %></td>
        <td><%= p.supplier_sku || '—' %></td>
        <td><%= p.category || '—' %></td>
        <td class="right"><%= p.unit_cost != null ? fmt.money(p.unit_cost, p.cost_currency, 2) : '—' %></td>
        <td><%= p.moq ?? '—' %></td>
        <td class="small"><%= p.carton_qty ? p.carton_qty + ' pcs' : '' %><% if (p.carton_length_cm) { %><div class="muted"><%= [p.carton_length_cm, p.carton_width_cm, p.carton_height_cm].map(Number).join('×') %> cm<%= p.carton_weight_kg ? ' · ' + Number(p.carton_weight_kg) + ' kg' : '' %></div><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/foot') %>
