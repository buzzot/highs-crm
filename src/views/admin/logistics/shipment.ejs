<%- include('../../partials/head') %>
<%
  const cur = s.orders?.currency || 'USD';
  const air = s.mode === 'air' || s.mode === 'express';
  const chg = s.gross_weight_kg || s.volume_cbm ? Math.max(Number(s.gross_weight_kg || 0), Number(s.volume_cbm || 0) * (air ? 167 : 1000)) : 0;
  const unpaid = costs.filter(c => !c.paid).reduce((t, c) => t + Number(c.amount) * Number(c.fx_to_order || 1), 0);
  const orderFreight = Number(order.freight_total || 0);
  const goods = Number(order.subtotal || 0), cost = Number(order.cost_total || 0);
  const profitAfter = goods - cost - orderFreight;
  const logisticsPct = cost > 0 ? orderFreight / cost * 100 : null;
%>
<div class="pagehead">
  <div><a class="back" href="/admin/logistics">← Logistics</a>
    <h1><%= fmt.status(s.mode).toUpperCase() %> shipment · <a href="/admin/orders/<%= s.order_id %>"><%= s.orders?.order_no %></a></h1>
    <p class="muted"><%= s.orders?.organizations?.name %> · <%= s.origin_port || '—' %> → <%= s.destination_port || '—' %> · <%= s.incoterm %> · <%= s.forwarders?.name || 'no forwarder' %></p></div>
  <div class="actions"><span class="pill lg <%= s.status %>"><%= fmt.status(s.status) %></span><a class="btn" href="/admin/logistics/shipments/<%= s.id %>/edit">Edit</a><form method="post" action="/admin/logistics/shipments/<%= s.id %>/delete" class="inline" onsubmit="return confirm('Delete this shipment and its costs? This cannot be undone.')"><button class="btn danger">Delete</button></form></div>
</div>
<% if (s.export_official && !s.export_declaration_no) { %>
  <div class="alert warn">Export declaration number not recorded yet. Ask the forwarder / customs broker for the 报关单 and upload it below.</div>
<% } %>

<%
  const pctOrX = v => v == null ? '—' : v >= 1000 ? (v / 100).toFixed(0) + '×' : fmt.pct(v);
  const steps = ['planned', 'booked', 'picked_up', 'departed', 'arrived', 'customs', 'delivered'];
  const si = steps.indexOf(s.status);
  const today = new Date().toISOString().slice(0, 10);
  const late = s.eta && s.eta < today && s.status !== 'delivered';
  const daysTo = d => d ? Math.round((new Date(d) - new Date(today)) / 864e5) : null;
  const etaIn = daysTo(s.eta);
  const icon = { air: '✈', express: '✈', sea_fcl: '⛴', sea_lcl: '⛴', rail: '🚆', truck: '🚚' }[s.mode] || '→';
  // reference numbers relevant to this mode (container only for FCL unless filled in)
  const refs = [[air ? 'Air waybill' : 'Bill of lading', s.bl_no], ['Tracking', s.tracking_no]];
  if (s.container_no || s.mode === 'sea_fcl') refs.push(['Container', s.container_no]);
  const docChecklist = [
    { kind: 'commercial_invoice', label: 'Commercial invoice' },
    { kind: 'packing_list', label: 'Packing list' },
    air ? { kind: 'airway_bill', label: 'Air waybill' } : { kind: 'bill_of_lading', label: 'Bill of lading' },
    ...(s.export_official ? [{ kind: 'export_declaration', label: 'Export declaration' }] : []),
  ];
%>
<div class="kpis five">
  <div class="kpi"><span class="n"><%= fmt.money(totalCost, cur, 0) %></span><span class="l">Logistics · this shipment</span><span class="s"><%= costs.length %> cost line<%= costs.length === 1 ? '' : 's' %></span></div>
  <div class="kpi <%= unpaid > 0 ? 'bad' : 'good' %>"><span class="n"><%= unpaid > 0 ? fmt.money(unpaid, cur, 0) : (costs.length ? 'All paid' : '—') %></span><span class="l">Owed to forwarder</span><span class="s"><%= costs.filter(c => !c.paid).length %> unpaid invoice<%= costs.filter(c => !c.paid).length === 1 ? '' : 's' %></span></div>
  <div class="kpi"><span class="n"><%= fmt.money(land.freightPerUnit, cur, land.freightPerUnit >= 100 ? 0 : 2) %></span><span class="l">Logistics per unit</span><span class="s">over <%= land.qty %> units on the order</span></div>
  <div class="kpi <%= logisticsPct != null && logisticsPct > 30 ? 'warn' : '' %>"><span class="n"><%= pctOrX(logisticsPct) %></span><span class="l">Logistics vs product cost</span><span class="s"><%= logisticsPct == null ? 'no product cost yet' : logisticsPct > 30 ? 'high — check freight or quantity' : 'within normal range' %></span></div>
  <div class="kpi <%= profitAfter < 0 ? 'bad' : 'good' %>"><span class="n"><%= fmt.money(profitAfter, cur, 0) %></span><span class="l">Order profit after logistics</span><span class="s"><%= profitAfter < 0 ? 'loss — logistics exceeds margin' : 'goods − cost − logistics' %></span></div>
</div>

<div class="grid2">
  <div class="card">
    <h2>Shipment <a class="more" href="/admin/logistics/shipments/<%= s.id %>/edit">edit details</a></h2>

    <div class="route">
      <div class="pt"><span class="city"><%= s.origin_port || 'Origin?' %></span><span class="when">ETD <%= fmt.date(s.etd) %><% if (s.atd) { %> · left <%= fmt.date(s.atd) %><% } %></span></div>
      <div class="line"><span class="ic"><%= icon %></span><span class="mode"><%= fmt.status(s.mode).toUpperCase() %> · <%= s.incoterm %></span></div>
      <div class="pt end"><span class="city"><%= s.destination_port || 'Destination?' %></span>
        <span class="when <%= late ? 'bad' : '' %>">ETA <%= fmt.date(s.eta) %><% if (s.ata) { %> · arrived <%= fmt.date(s.ata) %><% } else if (etaIn != null && s.status !== 'delivered') { %> · <%= late ? Math.abs(etaIn) + ' days late' : etaIn === 0 ? 'today' : 'in ' + etaIn + ' days' %><% } %></span></div>
    </div>

    <ol class="tracker">
      <% steps.forEach((st, i) => { %>
        <li class="<%= i < si ? 'done' : i === si ? 'now' : '' %>">
          <% if (i > si) { %>
            <form method="post" action="/admin/logistics/shipments/<%= s.id %>/status"><input type="hidden" name="status" value="<%= st %>"><input type="hidden" name="redirect" value="/admin/logistics/shipments/<%= s.id %>"><button title="Mark as <%= fmt.status(st) %>"><%= fmt.status(st) %></button></form>
          <% } else { %><span><%= fmt.status(st) %></span><% } %>
        </li>
      <% }) %>
    </ol>
    <p class="hint">Click a later step to move the shipment forward — the client sees the update.</p>

    <div class="facts">
      <% refs.forEach(([k, v]) => { %><div><span><%= k %></span><strong class="<%= v ? 'mono' : 'muted' %>"><%= v || 'not set' %></strong></div><% }) %>
      <div><span>Export declaration</span><strong class="<%= s.export_declaration_no ? 'mono' : s.export_official ? 'bad' : 'muted' %>"><%= s.export_declaration_no || (s.export_official ? 'pending' : 'unofficial export') %></strong></div>
      <div><span>Cargo</span><strong><%= s.cartons || '—' %> ctns · <%= fmt.num(s.gross_weight_kg, 1) %> kg · <%= fmt.num(s.volume_cbm, 3) %> cbm</strong></div>
      <div><span>Chargeable</span><strong><%= chg ? fmt.num(chg, 1) + (air ? ' kg' : ' kg W/M') : '—' %></strong><em><%= chg ? (air ? '1 cbm = 167 kg' : '1 cbm = 1 t') : '' %></em></div>
    </div>
    <% if (s.notes) { %><p class="pre muted small"><%= s.notes %></p><% } %>
  </div>
  <%- include('../../partials/docs', { docs, entityType: 'shipment', entityId: s.id, redirect: '/admin/logistics/shipments/' + s.id, kinds: ['bill_of_lading','airway_bill','export_declaration','commercial_invoice','packing_list','certificate','packing_photo','other'], heading: 'Shipping documents', defaultKind: docChecklist.find(c => !docs.some(d => d.kind === c.kind))?.kind || 'other', checklist: docChecklist }) %>
</div>

<div class="card" id="costs">
  <h2>Freight & logistics costs <span class="muted small">converted to <%= cur %></span></h2>
  <div class="split">
    <div>
      <table class="tbl compact">
        <thead><tr><th>Type</th><th>Description</th><th class="right">Amount</th><th class="right">FX</th><th class="right">In <%= cur %></th><th>Invoice</th><th>Paid</th><th></th></tr></thead>
        <tbody>
        <% if (!costs.length) { %><tr><td colspan="8" class="muted">No costs recorded yet — add forwarder invoices below.</td></tr><% } %>
        <% costs.forEach(c => { %>
          <tr>
            <td><span class="tag"><%= fmt.status(c.type) %></span></td>
            <td class="small"><%= c.description || '' %></td>
            <td class="right nowrap"><%= fmt.money(c.amount, c.currency) %></td>
            <td class="right small muted"><%= Number(c.fx_to_order) === 1 ? '' : fmt.num(c.fx_to_order, 4) %></td>
            <td class="right nowrap"><strong><%= fmt.money(Number(c.amount) * Number(c.fx_to_order || 1), cur) %></strong></td>
            <td class="small"><%= c.invoice_ref || '' %></td>
            <td><form method="post" action="/admin/logistics/costs/<%= c.id %>/paid" class="inline"><button class="link small <%= c.paid ? 'ok' : 'bad' %>"><%= c.paid ? '✓ ' + fmt.date(c.paid_at) : 'unpaid' %></button></form></td>
            <td class="right"><form method="post" action="/admin/logistics/costs/<%= c.id %>/delete" class="inline" onsubmit="return confirm('Delete this cost?')"><button class="link small danger" title="Delete">×</button></form></td>
          </tr>
        <% }) %>
        <% if (costs.length) { %><tr class="total"><td colspan="4">Total this shipment</td><td class="right nowrap"><%= fmt.money(totalCost, cur) %></td><td colspan="3"></td></tr><% } %>
        </tbody>
      </table>
      <details <%= costs.length ? '' : 'open' %>>
        <summary class="btn small">+ Add cost</summary>
        <form method="post" action="/admin/logistics/shipments/<%= s.id %>/costs" class="sub">
          <div class="row">
            <label>Type <select name="type"><% freightTypes.forEach(t => { %><option value="<%= t %>"><%= fmt.status(t) %></option><% }) %></select></label>
            <label class="grow2">Description <input name="description"></label>
            <label>Invoice ref <input name="invoice_ref"></label>
          </div>
          <div class="row">
            <label>Amount <input type="number" step="0.01" name="amount" required></label>
            <label>Currency <select name="currency" data-fx-target="fx_to_order"><% currencies.forEach(c => { %><option value="<%= c %>" data-fx="<%= defaultFx(c) %>" <%= c === cur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
            <label>FX → <%= cur %> <input type="number" step="0.000001" name="fx_to_order" id="fx_to_order" value="1"></label>
            <label class="check"><input type="checkbox" name="paid"> paid</label>
          </div>
          <button class="btn primary">Add cost</button>
        </form>
      </details>
    </div>
    <div class="breakdown">
      <h3>By cost type</h3>
      <% if (!Object.keys(byType).length) { %><p class="muted small">Nothing yet.</p><% } else { %>
      <div class="bars">
        <% const mx = Math.max(...Object.values(byType)); Object.entries(byType).sort((a, b) => b[1] - a[1]).forEach(([t, v]) => { %>
          <div class="bar"><span class="bl"><%= fmt.status(t) %></span><span class="bt"><span class="bf" style="width: <%= (v / mx * 100).toFixed(1) %>%"></span></span><span class="bn"><%= fmt.money(v, cur, 0) %></span></div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<div class="card" id="landed">
  <h2>Landed price for this order</h2>
  <p class="muted small">All logistics recorded on order <%= s.orders?.order_no %> (every shipment, <%= fmt.money(orderFreight, cur) %>) spread evenly across <%= land.qty %> units = <strong><%= fmt.money(land.freightPerUnit, cur, 2) %></strong> per unit.</p>
  <div class="tblwrap">
  <table class="tbl landed">
    <thead>
      <tr class="group"><th></th><th></th><th colspan="3" class="gcost">Our cost per unit</th><th colspan="2" class="gsell">Client per unit</th><th></th></tr>
      <tr>
        <th>Item</th><th class="right">Qty</th>
        <th class="right gcost">Product</th><th class="right gcost">+ Logistics</th><th class="right gcost">= Landed</th>
        <th class="right gsell">Price</th><th class="right gsell">Landed price</th>
        <th class="right">Margin after logistics</th>
      </tr>
    </thead>
    <tbody>
    <% if (!land.items.length) { %><tr><td colspan="8" class="muted">No items on this order yet.</td></tr><% } %>
    <% land.items.forEach(i => {
         const lc = i.landed_unit_cost, p = Number(i.unit_price || 0);
         const m = lc > 0 ? (p - lc) / lc * 100 : null; %>
      <tr>
        <td><strong><%= i.description %></strong><% if (i.hs_code) { %><div class="muted small">HS <%= i.hs_code %></div><% } %></td>
        <td class="right"><%= i.quantity %></td>
        <td class="right gcost"><%= fmt.money(i.unit_cost, cur, 2) %></td>
        <td class="right gcost muted"><%= fmt.money(land.freightPerUnit, cur, 2) %></td>
        <td class="right gcost"><strong><%= fmt.money(lc, cur, 2) %></strong></td>
        <td class="right gsell"><%= fmt.money(p, cur, 2) %></td>
        <td class="right gsell"><strong><%= fmt.money(i.landed_unit_price, cur, 2) %></strong></td>
        <td class="right <%= m != null && m < 0 ? 'bad' : '' %>"><%= m == null ? '—' : fmt.pct(m) %></td>
      </tr>
    <% }) %>
    </tbody>
    <% if (land.items.length) { %>
    <tfoot>
      <tr class="total">
        <td>Order total</td><td class="right"><%= land.qty %></td>
        <td class="right gcost"><%= fmt.money(cost, cur) %></td><td class="right gcost"><%= fmt.money(orderFreight, cur) %></td><td class="right gcost"><%= fmt.money(land.landedCostTotal, cur) %></td>
        <td class="right gsell"><%= fmt.money(goods, cur) %></td><td class="right gsell"><%= fmt.money(land.landedSellTotal, cur) %></td>
        <td class="right <%= profitAfter < 0 ? 'bad' : '' %>"><%= land.landedCostTotal > 0 ? fmt.pct(profitAfter / land.landedCostTotal * 100) : '—' %></td>
      </tr>
    </tfoot>
    <% } %>
  </table>
  </div>
  <p class="muted small legendline"><span class="sw gcost"></span> what it costs us delivered &nbsp; <span class="sw gsell"></span> what the client pays delivered (logistics passed through)</p>
</div>
<%- include('../../partials/foot') %>
