    <div class="actions"><button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn primary" id="sdcfmok">Confirm</button></div></div>
</dialog>

<script>
(function () {
  var INIT_TAB = <%- JSON.stringify(TAB || '') %>, OPEN = <%- JSON.stringify(OPEN || '') %>;
  var tabs = [].slice.call(document.querySelectorAll('[data-tab]')), names = tabs.map(function (b) { return b.dataset.tab; });
  function show(name) {
    if (name === 'docs') name = 'overview';
    if (names.indexOf(name) < 0) name = 'overview';
    tabs.forEach(function (b) { var on = b.dataset.tab === name; b.classList.toggle('on', on); b.setAttribute('aria-selected', on); b.tabIndex = on ? 0 : -1; });
    names.forEach(function (n) { document.getElementById('tab-' + n).hidden = n !== name; });
  }
  tabs.forEach(function (b) { b.addEventListener('click', function () { history.replaceState(null, '', '#' + b.dataset.tab); show(b.dataset.tab); }); });
  document.querySelector('.cd-tabs').addEventListener('keydown', function (e) {
    var i = names.indexOf(document.activeElement.dataset && document.activeElement.dataset.tab); if (i < 0 || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End')) return;
    var j = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
    e.preventDefault(); tabs[j].focus(); tabs[j].click();
  });
  window.addEventListener('hashchange', function () { show(location.hash.slice(1)); });
  show(INIT_TAB || location.hash.slice(1));

  function openDlg(id, focusName) {
    var d = document.getElementById(id); if (!d || !d.showModal) return;
    if (!d.open) d.showModal();
    var t = focusName && d.querySelector('[name="' + focusName + '"]'); if (t) { t.focus(); if (t.select) t.select(); }
  }
  document.querySelectorAll('[data-open]').forEach(function (b) { b.addEventListener('click', function () { openDlg(b.dataset.open, b.dataset.focus); }); });
  document.querySelectorAll('dialog.modaldlg [data-close]').forEach(function (b) { b.addEventListener('click', function () { b.closest('dialog').close(); }); });
  document.querySelectorAll('dialog.modaldlg').forEach(function (d) { d.addEventListener('click', function (e) { if (e.target === d) d.close(); }); });

  // ---- drawers: fixed header and footer, only the body scrolls; closing with unsaved changes asks first ----
  var RULES = {
    required: function (v) { return v.trim() ? '' : 'This field is required.'; },
    email: function (v) { return !v.trim() || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v.trim()) ? '' : 'Enter a valid email address, e.g. sales@factory.com.'; },
    phone: function (v) { v = v.trim().replace(/\s*(ext\.?|x)\s*\d{1,6}$/i, ''); return !v || (/^[+()\-.\s\/#0-9]{5,40}$/.test(v) && (v.match(/\d/g) || []).length >= 5) ? '' : 'Enter a valid phone number, e.g. +86 138 2581 4890.'; },
    website: function (v) { v = v.trim(); return !v || (!/\s/.test(v) && /^(https?:\/\/)?[^\s\/.]+(\.[^\s\/.]+)+([\/?#]\S*)?$/i.test(v)) ? '' : 'Enter a web address like www.factory.com.'; }
  };
  function setErr(input, msg) {
    var box = document.getElementById(input.id + '-e'), fld = input.closest('.fld');
    if (box) box.textContent = msg || ''; if (fld) fld.classList.toggle('has-err', !!msg);
    if (msg) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
  }
  function checkField(input) {
    var msg = '', r = (input.dataset.rule || '').split(' ');
    for (var i = 0; i < r.length && !msg; i++) if (RULES[r[i]]) msg = RULES[r[i]](input.value);
    setErr(input, msg); return !msg;
  }
  function ser(f) { return new URLSearchParams(new FormData(f)).toString(); }
  document.querySelectorAll('dialog.drawer').forEach(function (d) {
    var f = d.querySelector('form'), cf = d.querySelector('.dconfirm'), snap = ser(f), invalid = !!d.dataset.invalid, sum = d.querySelector('.dsum');
    var dirty = function () { return invalid || ser(f) !== snap; };
    function attemptClose() { if (!cf.hidden) return keep(); if (dirty()) { cf.hidden = false; cf.querySelector('[data-keep]').focus(); } else d.close(); }
    function keep() { cf.hidden = true; var t = f.querySelector('input:not([type=hidden]),textarea,select'); if (t) t.focus(); }
    d.addEventListener('cancel', function (e) { e.preventDefault(); attemptClose(); });
    d.addEventListener('click', function (e) { if (e.target === d) attemptClose(); });
    d.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', attemptClose); });
    cf.querySelector('[data-keep]').addEventListener('click', keep);
    cf.querySelector('[data-discard]').addEventListener('click', function () { cf.hidden = true; f.reset(); f.querySelectorAll('.has-err').forEach(function (x) { x.classList.remove('has-err'); }); f.querySelectorAll('.ferr').forEach(function (x) { x.textContent = ''; }); if (sum) sum.hidden = true; invalid = false; d.close(); });
    f.querySelectorAll('[data-rule]').forEach(function (i) { i.addEventListener('blur', function () { if (i.value || i.closest('.has-err')) checkField(i); }); i.addEventListener('input', function () { if (i.closest('.has-err')) checkField(i); }); });
    f.addEventListener('submit', function (e) {
      var bad = null;
      f.querySelectorAll('[data-rule]').forEach(function (i) { if (!checkField(i) && !bad) bad = i; });
      var fu = f.querySelector('[name="follow_up"]'), dt = f.querySelector('[name="date"]');
      if (fu && dt && fu.value && dt.value && fu.value < dt.value) { setErr(fu, 'The follow-up cannot be before the activity date.'); bad = bad || fu; }
      if (bad) { e.preventDefault(); if (sum) sum.hidden = false; bad.focus(); } else { invalid = false; }
    });
    d.addEventListener('close', function () { cf.hidden = true; });
  });
  if (OPEN) { openDlg(OPEN); var bad = document.querySelector('#' + OPEN + ' .has-err input, #' + OPEN + ' .has-err textarea, #' + OPEN + ' .has-err select'); if (bad) bad.focus(); }

  // ---- reschedule the follow-up ----
  document.querySelectorAll('[data-resched]').forEach(function (b) { b.addEventListener('click', function () { var di = document.getElementById('resdate'); di.value = b.dataset.due; openDlg('resdlg'); di.focus(); }); });

  // ---- confirmations for sensitive form actions ----
  var cfm = document.getElementById('sdcfm'), pend = null;
  document.addEventListener('submit', function (e) {
    var f = e.target; if (!f.dataset || !f.dataset.sdconfirm || f.dataset.sdok2) return;
    e.preventDefault(); pend = f;
    document.getElementById('sdcfmt').textContent = f.dataset.sdconfirm; document.getElementById('sdcfmx').textContent = f.dataset.sdtext || '';
    var ok = document.getElementById('sdcfmok'); ok.textContent = f.dataset.sdok || 'Confirm'; ok.classList.toggle('danger', !!f.dataset.sddanger);
    cfm.showModal();
  });
  document.getElementById('sdcfmok').addEventListener('click', function () { var f = pend; cfm.close(); if (f) { f.dataset.sdok2 = 1; f.submit(); } });

  // ---- typed confirmation before deleting a supplier ----
  var dn = document.getElementById('delname'), dg = document.getElementById('delgo');
  if (dn) dn.addEventListener('input', function () { dg.disabled = dn.value.trim().toLowerCase() !== dn.dataset.want; });

  // ---- search this supplier's products ----
  var pf = document.getElementById('pfind');
  if (pf) pf.addEventListener('input', function () {
    var words = pf.value.toLowerCase().split(/\s+/).filter(Boolean), rows = [].slice.call(document.querySelectorAll('#ptbl tbody tr')), n = 0;
    rows.forEach(function (r) { var ok = words.every(function (w) { return r.dataset.hay.indexOf(w) >= 0; }); r.hidden = !ok; if (ok) n++; });
    document.getElementById('pcount').textContent = n + ' of ' + rows.length; document.getElementById('pnone').hidden = n > 0;
  });

  // ---- timeline filter ----
  document.querySelectorAll('.cd-filter button').forEach(function (b) { b.addEventListener('click', function () {
    document.querySelectorAll('.cd-filter button').forEach(function (x) { x.classList.toggle('on', x === b); });
    document.querySelectorAll('#cdtl > li').forEach(function (li) { li.hidden = b.dataset.show !== 'all' && !li.classList.contains(b.dataset.show); });
  }); });
})();
</script>
