<%- include('../../partials/head') %>
<%
  const mem = typeof members !== 'undefined' ? members : [];
  const ty = typeof types !== 'undefined' ? types : {};
  const crm = typeof crmStatuses !== 'undefined' ? crmStatuses : {};
  const acts = typeof activityTypes !== 'undefined' ? activityTypes : {};
  const evs = typeof events !== 'undefined' ? events : [];
  const photos = typeof photoOf !== 'undefined' ? photoOf : {};
  const P = typeof purch !== 'undefined' ? purch : { rows: [], owed: {}, open: 0, nLive: 0 };
  const PAYL = { no_pi: 'No PI yet', pi_draft: 'PI not confirmed', unpaid: 'Unpaid', partial: 'Part paid', paid: 'Paid', over: 'Overpaid' };
  const PIL = { none: 'No PI', draft: 'PI draft', confirmed: 'PI confirmed' };
  const SPOL = { draft: 'Draft', sent: 'Sent', replied: 'Replied', confirmed: 'Confirmed', declined: 'Declined', cancelled: 'Cancelled' };
  const E = typeof edit !== 'undefined' ? edit : null, A = typeof act !== 'undefined' ? act : null, OPEN = typeof openDlg !== 'undefined' ? openDlg : null, TAB = typeof tab !== 'undefined' ? tab : null;
  const evCap = typeof eventLimit !== 'undefined' ? eventLimit : 200, nSub = typeof nSubmitted !== 'undefined' ? nSubmitted : 0;
  const mayDelete = typeof isAdmin !== 'undefined' ? isAdmin : user.role === 'admin';
  const placeholder = /^\(.*\)$/.test(s.name || '');
  const today = new Date().toISOString().slice(0, 10);
  const overdue = s.next_follow_up && s.next_follow_up < today;
  const v = f => (E ? E.vals[f] : s[f]) ?? '';
  const ee = f => (E && E.errors && E.errors[f]) || '';
  const place = [s.city, s.country].filter(Boolean).join(', ');
  const asDate = d => d ? fmt.date(d) : '—';
  const daysLate = d => Math.max(0, Math.round((Date.parse(today) - Date.parse(d)) / 864e5));
  // portal people: active / pending invitation / expired invitation / disabled (a separate thing from the relationship status)
  const mst = m => m.state === 'accepted' ? (m.active === false ? 'disabled' : 'active') : m.state;
  const uc = { active: 0, pending: 0, expired: 0, disabled: 0 }; mem.forEach(m => { const x = mst(m); if (x in uc) uc[x]++; });
  const portalTxt = uc.active ? 'Portal: active' : uc.pending ? 'Portal: invited' : uc.expired ? 'Portal: invitation expired' : uc.disabled ? 'Portal: disabled' : 'Portal: none';
  const lastSeenRow = mem.filter(m => m.last_login_at).sort((a, b) => String(b.last_login_at).localeCompare(String(a.last_login_at)))[0] || null;
  const SYS = { supplier_invited: 'Supplier added by invitation', invite_accepted: 'Invitation accepted', details_completed: 'Company details completed by the supplier', details_updated: 'Company details updated', portal_blocked: 'Portal access blocked', portal_restored: 'Portal access restored',
    crm_status: 'Relationship status changed', ai_enabled: 'AI access switched on', ai_disabled: 'AI access switched off', followup_done: 'Follow-up completed', followup_rescheduled: 'Follow-up rescheduled', invite_sent: 'Invitation sent', invite_resent: 'New invitation sent',
    invite_cancelled: 'Invitation cancelled', products_imported: 'Products imported', supplier_deleted: 'Supplier deleted' };
  const label = e => e.action.startsWith('crm_') && e.action !== 'crm_status' ? (acts[e.action.slice(4)] || 'Note') : (SYS[e.action] || fmt.status(e.action));
  // identical system events in a row (same person, same text, within 2 minutes) are shown once as "×N"
  const tl = [];
  evs.forEach(e => {
    const crmEv = e.action.startsWith('crm_') && e.action !== 'crm_status', who = e.profiles?.full_name || e.profiles?.email || (crmEv ? '' : 'System'), prev = tl[tl.length - 1];
    const note = e.detail?.from !== undefined && e.detail?.to ? (e.detail.note || '') + ' · ' + asDate(e.detail.from) + ' → ' + fmt.date(e.detail.to) : e.detail?.note;
    if (!crmEv && prev && !prev.crm && prev.text === label(e) && prev.who === who && prev.note === note && Math.abs(new Date(prev.at) - new Date(e.created_at)) < 120000) { prev.n++; prev.times.push(e.created_at); return; }
    tl.push({ id: e.id, crm: crmEv, text: label(e), who, at: e.created_at, times: [e.created_at], date: e.detail?.date, note, next: e.detail?.next_action, follow: e.detail?.follow_up, n: 1 });
  });
  const nCrm = tl.filter(x => x.crm).length;
  const DOC_KINDS = ['certificate', 'qc_report', 'other'];
  const money = (n, c) => fmt.money(n, c, 0);
  const owedTxt = Object.entries(P.owed).map(([c, n]) => money(n, c)).join(' · ');
  const hasPhone = !!s.phone;
%>
<header class="cd-head">
  <div class="cd-id">
    <a class="back" href="/admin/suppliers">← Suppliers</a>
    <h1 title="<%= s.name %>"><%= placeholder ? 'New supplier ' + s.name : s.name %> <span class="pill crm-<%= s.crm_status || 'active' %>" title="Relationship status"><%= crm[s.crm_status] || 'Active supplier' %></span></h1>
    <div class="cd-meta"><%= place || 'Location not set' %>
      <% if (s.company_type) { %><span class="sep">·</span><span title="Business type"><%= ty[s.company_type] %></span><% } %>
      <span class="sep">·</span><span title="Portal access is separate from the relationship status"><%= portalTxt %></span>
    </div>
    <div class="cd-meta">
      <% if (s.contact_name || s.email || s.phone) { %><span title="Primary contact"><%= s.contact_name || 'Contact' %></span><% if (s.email) { %><span class="sep">·</span><a href="mailto:<%= s.email %>"><%= s.email %></a><% } %><% if (s.phone) { %><span class="sep">·</span><a href="tel:<%= String(s.phone).replace(/[^0-9+]/g, '') %>"><%= s.phone %></a><% } %>
      <% } else { %><span class="muted">No primary contact</span><% } %>
    </div>
  </div>
  <div class="cd-actions">
    <button type="button" class="btn" data-open="editdlg">Edit supplier</button>
    <a class="btn" href="/admin/purchasing/new?supplier=<%= s.id %>">Create purchase order</a>
    <a class="btn primary" href="/admin/products/new?supplier_id=<%= s.id %>">+ Add product</a>
  </div>
</header>

<div class="cd-stats" aria-label="Supplier summary">
  <a href="#products"><b><%= products.length %></b> product<%= products.length === 1 ? '' : 's' %></a>
  <a href="#purchasing" title="Purchase orders we placed with this supplier"><b><%= P.rows.length %></b> purchase order<%= P.rows.length === 1 ? '' : 's' %><%= P.open ? ' · ' + P.open + ' open' : '' %></a>
  <% if (owedTxt) { %><a href="#purchasing" title="Still to pay on confirmed supplier proforma invoices, per currency"><span class="muted">To pay</span> <b><%= owedTxt %></b></a><% } %>
  <a href="#activity" class="<%= overdue ? 'late' : '' %>" title="The next follow-up with this supplier"><span class="muted">Next follow-up</span> <b class="<%= overdue ? 'bad' : '' %>"><%= s.next_follow_up ? fmt.date(s.next_follow_up) + (overdue ? ' · overdue' : '') : 'none' %></b></a>
</div>

<div class="cd-tabs" role="tablist" aria-label="Supplier sections">
  <button type="button" role="tab" id="t-overview" aria-controls="tab-overview" data-tab="overview">Overview</button>
  <button type="button" role="tab" id="t-products" aria-controls="tab-products" data-tab="products">Products <span class="cnt"><%= products.length %></span></button>
  <button type="button" role="tab" id="t-purchasing" aria-controls="tab-purchasing" data-tab="purchasing" title="Purchase orders placed with this supplier">Purchasing <span class="cnt"><%= P.rows.length %></span></button>
  <button type="button" role="tab" id="t-activity" aria-controls="tab-activity" data-tab="activity" title="Calls, WeChat, meetings and notes<%= overdue ? ' · follow-up overdue' : '' %>">Activity <span class="cnt"><%= nCrm %><%= evs.length >= evCap ? '+' : '' %></span><% if (overdue) { %><span class="dotbad" aria-label="Follow-up overdue"></span><% } %></button>
  <button type="button" role="tab" id="t-portal" aria-controls="tab-portal" data-tab="portal" title="Portal users and AI access">Portal &amp; access<% if (uc.active) { %> <span class="cnt"><%= uc.active %></span><% } %></button>
</div>

<%# ---------- Overview ---------- %>
<section class="cd-panel" id="tab-overview" role="tabpanel" aria-labelledby="t-overview" hidden>
  <% if (placeholder) { %><div class="alert warn">Waiting for the supplier to register — they fill in the company details after accepting the invitation. You can also <button type="button" class="cd-edit" data-open="editdlg">enter them yourself</button>.</div><% } %>
  <div class="cd-grid cd-grid-ov">
    <div class="cd-card cd-info">
      <h2>Supplier information <button type="button" class="cd-edit" data-open="editdlg">Edit supplier</button></h2>
      <div class="cd-cols">
        <div>
          <h3 class="first">Company identity</h3>
          <dl class="cd-dl">
            <div><dt>Company name</dt><dd class="<%= placeholder ? 'na' : '' %>"><%= placeholder ? 'Filled in by the supplier' : s.name %></dd></div>
            <div><dt>Registration no.</dt><dd class="<%= s.registration_no ? '' : 'na' %>"><%= s.registration_no || '—' %></dd></div>
            <div><dt>Established</dt><dd class="<%= s.year_established ? '' : 'na' %>"><%= s.year_established || '—' %><%= s.employees ? ' · ' + s.employees + ' staff' : '' %></dd></div>
            <div><dt>Website</dt><dd class="<%= s.website ? '' : 'na' %>"><% if (s.website) { %><a href="<%= /^https?:\/\//i.test(s.website) ? s.website : 'https://' + s.website %>" target="_blank" rel="noopener noreferrer"><%= s.website %></a><% } else { %>—<% } %></dd></div>
          </dl>
          <h3>Contacts</h3>
          <dl class="cd-dl">
            <div><dt>Contact person</dt><dd class="<%= s.contact_name ? '' : 'na' %>"><%= s.contact_name || '—' %></dd></div>
            <div><dt>Email</dt><dd><% if (s.email) { %><a href="mailto:<%= s.email %>"><%= s.email %></a><% } else { %><button type="button" class="cd-add" data-open="editdlg" data-focus="email">+ Add email</button><% } %></dd></div>
            <div><dt>Phone / WhatsApp</dt><dd><% if (s.phone) { %><a href="tel:<%= String(s.phone).replace(/[^0-9+]/g, '') %>"><%= s.phone %></a><% } else { %><button type="button" class="cd-add" data-open="editdlg" data-focus="phone">+ Add phone</button><% } %></dd></div>
            <div><dt>WeChat</dt><dd class="<%= s.wechat ? '' : 'na' %>"><%= s.wechat || '—' %></dd></div>
          </dl>
          <h3>Locations</h3>
          <dl class="cd-dl">
            <div><dt>Factory address</dt><dd class="pre <%= (s.address || place || s.postal_code) ? '' : 'na' %>"><%= [s.address, [s.postal_code, s.city].filter(Boolean).join(' '), s.country].filter(Boolean).join('\n') || '—' %></dd></div>
          </dl>
        </div>
        <div>
          <h3 class="first">Business role &amp; export</h3>
          <dl class="cd-dl">
            <div><dt>Business type</dt><dd class="<%= s.company_type ? '' : 'na' %>"><%= s.company_type ? ty[s.company_type] : 'Not set' %></dd></div>
            <div><dt>Official exporter</dt><dd><% if (s.can_export_official) { %><span class="oktext">✓ Can export officially</span> <span class="muted small">with a government export declaration</span><% } else { %><span class="muted">Not confirmed</span><% } %></dd></div>
            <div><dt>Main products</dt><dd class="<%= s.main_products ? '' : 'na' %>"><%= s.main_products || '—' %></dd></div>
            <div><dt>Certifications</dt><dd class="<%= s.certifications ? '' : 'na' %>"><%= s.certifications || '—' %></dd></div>
          </dl>
          <h3>Commercial terms</h3>
          <dl class="cd-dl">
            <div><dt>Payment terms</dt><dd class="<%= s.payment_terms ? '' : 'na' %>"><%= s.payment_terms || '—' %><% if (s.payment_terms) { %> <span class="muted small">general — each PI sets the real amounts</span><% } %></dd></div>
            <div><dt>Production lead time</dt><dd class="<%= s.lead_time_days != null ? '' : 'na' %>"><%= s.lead_time_days != null ? s.lead_time_days + ' days' : '—' %> <% if (s.lead_time_days != null) { %><span class="muted small">general</span><% } %></dd></div>
            <div><dt>Rating</dt><dd><% if (s.rating) { %><span class="stars"><%= '★'.repeat(s.rating) %></span><span class="muted"><%= '★'.repeat(5 - s.rating) %></span> <span class="muted small">entered by your team</span><% } else { %><span class="na">Not rated</span><% } %></dd></div>
          </dl>
        </div>
      </div>
      <h3>Internal notes</h3>
      <% if (s.notes) { %><p class="pre cd-notes"><%= s.notes %></p><% } else { %><p class="muted small">No notes. Notes are internal and never shown to the supplier.</p><% } %>
    </div>

    <div class="cd-card">
      <h2>Relationship</h2>
      <dl class="cd-dl">
        <div><dt>Status</dt><dd><span class="pill crm-<%= s.crm_status || 'active' %>"><%= crm[s.crm_status] || 'Active supplier' %></span></dd></div>
        <div><dt>Supplier since</dt><dd><%= fmt.date(s.created_at) %></dd></div>
        <div><dt>Company details</dt><dd><% if (s.details_completed_at) { %><span class="oktext">✓ Completed <%= fmt.date(s.details_completed_at) %></span><% } else if (placeholder) { %><span class="warntext">Pending — supplier has not registered</span><% } else { %><span class="muted">Entered by your team</span><% } %></dd></div>
        <div><dt>Portal access</dt><dd><a href="#portal"><%= portalTxt.replace('Portal: ', '').replace(/^./, c => c.toUpperCase()) %></a><%= uc.active ? ' · ' + uc.active + ' user' + (uc.active === 1 ? '' : 's') : '' %></dd></div>
        <div><dt>Products</dt><dd><a href="#products"><%= products.length %></a></dd></div>
        <div><dt>Purchase orders</dt><dd><a href="#purchasing"><%= P.rows.length %></a><%= P.open ? ' · ' + P.open + ' open' : '' %></dd></div>
      </dl>
    </div>
  </div>

  <div class="cd-card" id="docs">
    <h2>Documents &amp; certificates <span class="cnt"><%= docs.length %></span><button type="button" class="btn small primary more" data-open="docdlg">+ Upload</button></h2>
    <p class="muted small cd-sub">Licences, certificates and QC reports for this supplier. Purchase-order documents are kept on the purchase order itself.</p>
    <% if (!docs.length) { %><p class="muted">No documents yet. Documents are internal by default.</p><% } else { %>
    <div class="tblwrap"><table class="cd-tbl sd-docs">
      <thead><tr><th>Document</th><th>Type</th><th class="c-date">Uploaded</th><th>Visibility</th><th class="r">Actions</th></tr></thead>
      <tbody>
      <% docs.forEach(d => { const pub = !!d.client_visible, own = !['cargo_photo', 'cargo_draft'].includes(d.kind); %>
        <tr>
          <td class="c-main"><a href="/admin/documents/<%= d.id %>/download" target="_blank" rel="noopener" title="<%= d.title %>"><strong class="clip"><%= d.title %></strong></a></td>
          <td><span class="tag"><%= fmt.status(d.kind) %></span></td>
          <td class="c-date muted"><%= fmt.date(d.created_at) %></td>
          <td>
            <% if (own) { %><form method="post" action="/admin/documents/<%= d.id %>/toggle" class="inline"<%- pub ? '' : ' data-sdconfirm="Show this document to clients?" data-sdtext="Supplier documents can be confidential. Clients who can see this supplier’s products will be able to open it. Continue only if you are sure." data-sdok="Show to clients"' %>><input type="hidden" name="redirect" value="/admin/suppliers/<%= s.id %>#overview"><button class="vis <%= pub ? 'on' : '' %>" title="<%= pub ? 'Visible to clients — click to make internal' : 'Internal — click to share with clients' %>"><%= pub ? 'Client sees' : 'Internal' %></button></form><% } else { %><span class="tag internal">Internal</span><% } %>
          </td>
          <td class="r">
            <a class="link small" href="/admin/documents/<%= d.id %>/download" target="_blank" rel="noopener">Open</a>
            <form method="post" action="/admin/documents/<%= d.id %>/delete" class="inline" data-sdconfirm="Delete this document?" data-sdtext="<%= d.title %> will be removed for good." data-sdok="Delete" data-sddanger="1"><input type="hidden" name="redirect" value="/admin/suppliers/<%= s.id %>#overview"><button class="link small danger">Delete</button></form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <% } %>
  </div>

  <% if (mayDelete) { %>
  <details class="cd-restricted">
    <summary>Restricted actions <span class="muted small">Admin only</span></summary>
    <div class="body">
      <p class="muted small">Deleting a supplier cannot be undone and is only possible while no orders, quotes or purchase orders refer to it. Its products are kept without a supplier. To stop working with a supplier, set the status to “Blocked” instead.</p>
      <button type="button" class="btn danger-outline" data-open="deldlg">Delete supplier…</button>
    </div>
  </details>
  <% } %>
</section>

<%# ---------- Products ---------- %>
<section class="cd-panel" id="tab-products" role="tabpanel" aria-labelledby="t-products" hidden>
  <div class="cd-card">
    <h2>Products <span class="cnt"><%= products.length %></span>
      <span class="sd-tools"><button type="button" class="btn small" data-open="importdlg">Import products</button><a class="btn small primary" href="/admin/products/new?supplier_id=<%= s.id %>">+ Add product</a></span></h2>
    <% if (nSub) { %><div class="alert info sd-sub"><b><%= nSub %></b> product<%= nSub === 1 ? '' : 's' %> submitted by the supplier <%= nSub === 1 ? 'is' : 'are' %> waiting for your review. <a href="/admin/products/submissions">Review submissions</a></div><% } %>
    <% if (!products.length) { %>
      <p class="muted">No products yet — add one by hand, or import the supplier’s price list. You review everything before it is saved.</p>
    <% } else { %>
    <div class="sd-find"><input type="search" id="pfind" placeholder="Search name, SKU, supplier SKU, category…" aria-label="Search this supplier’s products" autocomplete="off"><span class="muted small" id="pcount"><%= products.length %> of <%= products.length %></span>
      <a class="more small" href="/admin/products?supplier=<%= s.id %>">Open in product list</a></div>
    <div class="tblwrap"><table class="cd-tbl sd-prod" id="ptbl">
      <thead><tr><th class="c-thumb"></th><th>Product</th><th class="c-ssku">Supplier SKU</th><th class="c-cat">Category</th><th class="r">Unit cost</th><th class="r c-moq">MOQ</th><th class="c-pack">Packing</th><th class="r"></th></tr></thead>
      <tbody>
      <% products.forEach(p => { const hay = [p.name, p.sku, p.supplier_sku, p.category].filter(Boolean).join(' ').toLowerCase(); %>
        <tr data-hay="<%= hay %>">
          <td class="c-thumb"><% if (photos[p.id]) { %><img class="pthumbsm" src="/admin/documents/<%= photos[p.id] %>/download" alt="" loading="lazy"><% } else { %><span class="pthumbsm empty"></span><% } %></td>
          <td class="c-main"><a href="/admin/products/<%= p.id %>" title="<%= p.name %>"><strong class="clip"><%= p.name %></strong></a><% if (p.sku) { %><div class="muted small">Our SKU <%= p.sku %></div><% } %></td>
          <td class="c-ssku"><%= p.supplier_sku || '—' %></td>
          <td class="c-cat clip" title="<%= p.category || '' %>"><%= p.category || '—' %></td>
          <td class="r"><%= p.unit_cost != null ? fmt.money(p.unit_cost, p.cost_currency, 2) : '—' %></td>
          <td class="r c-moq"><%= p.moq ?? '—' %></td>
          <td class="c-pack small"><%= p.carton_qty ? p.carton_qty + ' pcs/carton' : '—' %><%= p.carton_cbm ? ' · ' + Number(p.carton_cbm).toFixed(3) + ' cbm' : '' %></td>
          <td class="r"><a class="link small" href="/admin/products/<%= p.id %>/edit">Edit</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <p class="muted small" id="pnone" hidden>No product matches your search.</p>
    <p class="muted small cd-sub">Prices are shown in the currency the supplier quoted. <%= s.lead_time_days != null ? 'General production lead time: ' + s.lead_time_days + ' days.' : '' %></p>
    <% } %>
  </div>
</section>

<%# ---------- Purchasing ---------- %>
<section class="cd-panel" id="tab-purchasing" role="tabpanel" aria-labelledby="t-purchasing" hidden>
  <div class="cd-card">
    <h2>Purchase orders <span class="cnt"><%= P.rows.length %></span>
      <span class="sd-tools"><% if (P.rows.length) { %><a class="more small" href="/admin/purchasing?supplier=<%= s.id %>">Open in Purchasing</a><% } %><a class="btn small primary" href="/admin/purchasing/new?supplier=<%= s.id %>">Create purchase order</a></span></h2>
    <p class="muted small cd-sub">Orders we placed with this supplier. Amounts come from the supplier’s approved proforma invoice, not from payment terms or product prices.</p>
    <% if (!P.rows.length) { %><p class="muted">No purchase orders yet. “Create purchase order” starts one with this supplier already selected.</p><% } else { %>
    <div class="tblwrap"><table class="cd-tbl sd-po">
      <thead><tr><th>Purchase order</th><th>Status</th><th class="r">PO total</th><th>Supplier PI</th><th>Payment</th><th class="c-date">Dates</th></tr></thead>
      <tbody>
      <% P.rows.slice(0, 25).forEach(o => { %>
        <tr>
          <td class="c-main"><a href="/admin/purchasing/<%= o.id %>"><strong><%= o.ref %></strong></a><% if (o.title) { %><div class="muted small clip" title="<%= o.title %>"><%= o.title %></div><% } %></td>
          <td><span class="pill spo-<%= o.status %>"><%= SPOL[o.status] || fmt.status(o.status) %></span></td>
          <td class="r"><%= fmt.money(o.total, o.currency, 2) %></td>
          <td><span class="sd-pi <%= o.piStatus %>"><%= PIL[o.piStatus] %></span><% if (o.piTotal != null) { %><div class="muted small"><%= fmt.money(o.piTotal, o.piCurrency, 2) %></div><% } %></td>
          <td><span class="sd-pay <%= o.pay %>"><%= PAYL[o.pay] %></span><% if (o.open != null && o.open > 0.01) { %><div class="muted small"><%= fmt.money(o.open, o.piCurrency, 2) %> to pay</div><% } %></td>
          <td class="c-date muted small"><div>Created <%= fmt.date(o.created_at) %></div><% if (o.required_date) { %><div>Needed <%= fmt.date(o.required_date) %></div><% } %></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <% if (P.rows.length > 25) { %><p class="muted small">Showing the latest 25 of <%= P.rows.length %>. <a href="/admin/purchasing?supplier=<%= s.id %>">Open all in Purchasing</a></p><% } %>
    <% } %>
  </div>
</section>

<%# ---------- Activity ---------- %>
<section class="cd-panel" id="tab-activity" role="tabpanel" aria-labelledby="t-activity" hidden>
  <div class="cd-grid cd-grid-act">
    <div class="cd-card cd-timeline">
      <h2>Timeline <span class="cd-filter" role="group" aria-label="Show"><button type="button" class="on" data-show="all">All</button><button type="button" data-show="crm">Team</button><button type="button" data-show="sys">System</button></span><button type="button" class="btn small primary more" data-open="actdlg">+ Add activity</button></h2>
      <% if (!tl.length) { %><p class="muted">No activity yet. Log a call, WeChat chat, visit or note to start the history.</p><% } %>
      <ol class="cd-tl" id="cdtl">
        <% tl.forEach(e => { %>
          <li class="<%= e.crm ? 'crm' : 'sys' %>">
            <div class="h"><strong><%= e.text %></strong><% if (e.n > 1) { %> <details class="grp"><summary title="Show every event">×<%= e.n %></summary><ul><% e.times.forEach(t => { %><li><%= fmt.datetime(t) %></li><% }) %></ul></details><% } %> <span class="muted small"><%= e.date ? fmt.date(e.date) : fmt.datetime(e.at) %><%= e.who ? ' · ' + e.who : '' %></span></div>
            <% if (e.note && e.crm) { %><p class="pre"><%= e.note %></p><% } else if (e.note) { %><div class="muted small"><%= e.note %></div><% } %>
            <% if (e.next) { %><div class="small"><span class="muted">Next:</span> <%= e.next %></div><% } %>
            <% if (e.follow) { %><div class="small muted">↻ Follow-up requested for <%= fmt.date(e.follow) %></div><% } %>
          </li>
        <% }) %>
      </ol>
      <% if (evs.length >= evCap) { %><p class="muted small">Showing the latest <%= evCap %> events.</p><% } %>
    </div>
    <aside class="cd-card cd-follow">
      <h2>Next follow-up<% if (overdue) { %> <span class="cnt late">overdue</span><% } %></h2>
      <% if (!s.next_follow_up) { %>
        <p class="muted small">No follow-up planned. Add a follow-up date when logging an activity and it appears here and in the page header.</p>
      <% } else { %>
        <ul><li class="fu <%= overdue ? 'late' : '' %>">
          <span class="d <%= overdue ? 'bad' : '' %>"><%= fmt.date(s.next_follow_up) %><%= overdue ? ' · overdue ' + daysLate(s.next_follow_up) + ' d' : (s.next_follow_up === today ? ' · today' : '') %></span>
          <span class="muted small">The supplier has one next follow-up. Completing it clears the date; the activity it came from stays in the timeline.</span>
          <span class="fu-act">
            <form method="post" action="/admin/suppliers/<%= s.id %>/followup/done" class="inline"><button class="btn small" title="Mark done — clears the date">✓ Done</button></form>
            <button type="button" class="link small" data-resched data-due="<%= s.next_follow_up %>">Reschedule</button>
          </span>
        </li></ul>
      <% } %>
    </aside>
  </div>
</section>

<%# ---------- Portal & access ---------- %>
<section class="cd-panel" id="tab-portal" role="tabpanel" aria-labelledby="t-portal" hidden>
  <div class="cd-card" id="portal">
    <h2>Portal users <span class="cnt"><%= uc.active %> active<%= uc.pending ? ' · ' + uc.pending + ' pending' : '' %><%= uc.expired ? ' · ' + uc.expired + ' expired' : '' %><%= uc.disabled ? ' · ' + uc.disabled + ' disabled' : '' %></span>
      <span class="sd-tools">
        <% if (mem.some(m => m.state === 'accepted')) { %>
        <form method="post" action="/admin/suppliers/<%= s.id %>/portal" class="inline"
          <% if (!portalBlocked) { %>data-sdconfirm="Block portal access for everyone at this supplier?" data-sdtext="Every active user is signed out of the supplier portal until you restore access. Pending invitations are cancelled." data-sdok="Block access" data-sddanger="1"<% } %>>
          <input type="hidden" name="action" value="<%= portalBlocked ? 'restore' : 'block' %>">
          <button class="btn small <%= portalBlocked ? '' : 'danger-outline' %>"><%= portalBlocked ? 'Restore portal access' : 'Block all access' %></button>
        </form>
        <% } %>
        <button type="button" class="btn small primary" data-open="invitedlg">+ Invite user</button>
      </span></h2>
    <p class="muted small cd-sub"><%= lastSeenRow ? 'Last sign-in to the portal: ' + fmt.datetime(lastSeenRow.last_login_at) + ' (' + (lastSeenRow.full_name || lastSeenRow.email) + ').' : 'Nobody has signed in to the portal yet.' %> Portal access is separate from the relationship status.</p>
    <% if (!s.details_completed_at && mem.some(x => x.state === 'pending' || x.state === 'accepted')) { %>
      <div class="alert warn">Waiting for the supplier to register — they fill in the company details after accepting the invitation.</div>
    <% } %>
    <div class="tblwrap"><%- include('../../partials/users_table', { members: mem, base: '/admin/suppliers/' + s.id, inviteDialog: true, emptyText: 'Nobody has portal access yet. Invite the supplier so they register and keep their company details up to date themselves.', firstPlaceholder: 'sales@factory.com', firstValue: s.email || '', otherPlaceholder: 'colleague@factory.com' }) %></div>
  </div>
  <%- include('../../partials/ai_access', { ai: s, use: aiUse, prices: aiPrices, action: '/admin/suppliers/' + s.id + '/ai', who: 'this supplier', compactAi: true }) %>
</section>

<%# ---------- drawers & dialogs ---------- %>
