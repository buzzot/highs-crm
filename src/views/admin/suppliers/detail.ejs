          <%- include('../../partials/cd_field', { name: 'company_type', label: 'Business type', type: 'select', value: v('company_type'), error: ee('company_type'), list: [['', 'Not set'], ...Object.entries(ty)] }) %>
          <%- include('../../partials/cd_field', { name: 'crm_status', label: 'Relationship status', type: 'select', value: E ? E.vals.crm_status : (s.crm_status || 'active'), error: ee('crm_status'), list: Object.entries(crm), hint: 'Separate from portal access.' }) %>
