    <div class="dconfirm" hidden role="alertdialog" aria-labelledby="edconfirm"><div class="box"><h3 id="edconfirm">Discard your changes?</h3><p class="muted small">You have unsaved changes to this supplier.</p><div class="actions"><button type="button" class="btn" data-keep>Keep editing</button><button type="button" class="btn primary danger" data-discard>Discard changes</button></div></div></div>
