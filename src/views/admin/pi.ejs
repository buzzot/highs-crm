<%- include('../partials/head') %>
<% const d = p.data, b = d.buyer || {}; const sent = p.status === 'sent'; %>
<div class="pagehead">
  <div><a class="back" href="/admin/orders/<%= order.id %>">← <%= order.order_no %></a><h1>Proforma invoice <%= p.pi_no %></h1>
    <p class="muted"><%= order.organizations?.name %> · <%= sent ? 'sent ' + fmt.datetime(p.sent_at) : 'draft — not sent' %></p></div>
  <div class="headactions">
    <a class="btn" href="/admin/pi/<%= p.id %>/print" target="_blank"><%- icon('file') %> Print / PDF</a>
    <span class="pill lg <%= sent ? 'ok' : '' %>"><%= sent ? 'Sent' : 'Draft' %></span>
  </div>
</div>
<% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>
<% if (err) { %><div class="alert err"><%= err %></div><% } %>
<% if (sent) { %><div class="alert info">Already sent. You can change it and send it again — the client receives the new PDF.</div><% } %>
<form method="post" action="/admin/pi/<%= p.id %>" class="poform">
  <div class="card">
    <h2>Bill to</h2>
    <div class="row">
      <label>Company <input name="company" value="<%= b.company || '' %>"></label>
      <label>Contact person <input name="contact" value="<%= b.contact || '' %>"></label>
      <label>Email <input name="email" value="<%= b.email || '' %>"></label>
      <label>Phone <input name="phone" value="<%= b.phone || '' %>"></label>
    </div>
    <div class="row">
      <label>Address <textarea name="address" rows="2"><%= b.address || '' %></textarea></label>
      <label>Delivery address <textarea name="delivery_address" rows="2"><%= b.delivery_address || '' %></textarea></label>
    </div>
  </div>
  <div class="card">
    <h2>Lines</h2>
    <%- include('../partials/po_lines', { lines: d.lines, currency: d.currency, edit: true }) %>
    <% const fr = d.freight || { amount: '', mode: 'none' }; const shipCost = Number(order.freight_total || 0); %>
    <div class="row freightrow">
      <label>Freight (<%= d.currency %>) <input type="number" step="0.01" min="0" name="freight_amount" id="fr_amt" value="<%= fr.amount || '' %>" placeholder="0.00"></label>
      <label>+ Buffer % <input type="number" step="0.1" min="0" max="100" name="freight_buffer" id="fr_buf" value="<%= fr.buffer_pct || '' %>" placeholder="0"></label>
      <label>How the client sees it
        <select name="freight_mode">
          <option value="none" <%= fr.mode === 'none' || !fr.mode ? 'selected' : '' %>>No freight on this invoice</option>
          <option value="separate" <%= fr.mode === 'separate' ? 'selected' : '' %>>Show as a separate line</option>
          <option value="included" <%= fr.mode === 'included' ? 'selected' : '' %>>Include in the unit prices (not shown)</option>
        </select></label>
    </div>
    <p class="muted small" id="fr_note">
      <% if (shipCost > 0) { %><button type="button" class="btn small" id="fr_use" data-cost="<%= shipCost %>">Use shipment cost <%= fmt.money(shipCost, order.currency || d.currency) %></button> from the order's shipments, then add a % buffer for surprises if you want. <% } else { %>No shipment cost on the order yet — type the freight, or add it on the shipment page. <% } %>
      <span id="fr_calc"></span>
    </p>
    <% if (fr.amount > 0 && fr.mode !== 'none') { %><p class="muted small">Client sees <%= shown.length %> line<%= shown.length === 1 ? '' : 's' %>, total <strong><%= fmt.money(total, d.currency) %></strong><%= fr.mode === 'included' ? ' — freight is spread over the unit prices in proportion to line value' : ' — with a “Freight & logistics” line' %>. Save to update the preview.</p><% } %>
    <script>
      (function () {
        const amt = document.getElementById('fr_amt'), buf = document.getElementById('fr_buf'), out = document.getElementById('fr_calc'), use = document.getElementById('fr_use');
        const show = () => { const a = Number(amt.value) || 0, b = Number(buf.value) || 0; out.textContent = a > 0 && b > 0 ? 'Freight charged: ' + (a * (1 + b / 100)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' <%= d.currency %>' : ''; };
        if (use) use.addEventListener('click', () => { amt.value = use.dataset.cost; show(); });
        amt.addEventListener('input', show); buf.addEventListener('input', show); show();
      })();
    </script>
    <div class="row">
      <label>Client PO number <input name="po_ref" value="<%= d.po_ref || '' %>"></label>
      <label>Incoterm <input name="incoterm" value="<%= d.incoterm || '' %>"></label>
      <label>Lead time (days) <input type="number" name="lead_time_days" value="<%= d.lead_time_days || '' %>"></label>
      <label>Valid until <input type="date" name="valid_until" value="<%= d.valid_until || '' %>"></label>
    </div>
  </div>
  <div class="card">
    <h2>Payment</h2>
    <label>Payment terms <textarea name="payment_terms" rows="2"><%= d.payment_terms || '' %></textarea></label>
    <p class="muted small">Payment schedule — what the client sees as amounts to pay and due dates. Percentages should add up to 100. Leave a row empty to remove it.</p>
    <table class="tbl compact sched"><thead><tr><th>Instalment</th><th>%</th><th class="right">Amount (<%= d.currency %>)</th><th>Due date</th></tr></thead><tbody>
    <% const sch = (d.schedule && d.schedule.length ? d.schedule : []).slice(0, 4); while (sch.length < 4) sch.push({ label: '', percent: '', due: '' }); %>
    <% sch.forEach((x, i) => { %><tr>
      <td><input name="sched[<%= i %>][label]" value="<%= x.label || '' %>" placeholder="e.g. Deposit"></td>
      <td><input name="sched[<%= i %>][percent]" type="number" step="0.01" min="0" max="100" value="<%= x.percent || '' %>"></td>
      <td class="right num"><%= x.percent ? fmt.money(total * x.percent / 100, d.currency) : '' %></td>
      <td><input name="sched[<%= i %>][due]" type="date" value="<%= x.due || '' %>"></td>
    </tr><% }) %>
    </tbody></table>
    <label>Bank details <textarea name="bank" rows="4"><%= d.bank || '' %></textarea></label>
    <label>Notes <textarea name="notes" rows="2"><%= d.notes || '' %></textarea></label>
  </div>
  <div class="card">
    <h2>Send to the client</h2>
    <div class="row">
      <label>Send to (email) <input name="send_to" value="<%= b.email || '' %>"></label>
    </div>
    <label>Message <span class="muted small">optional, added to the email</span><textarea name="message" rows="2"></textarea></label>
    <div class="actions">
      <button class="btn">Save</button>
      <button class="btn primary" formaction="/admin/pi/<%= p.id %>/send" onclick="return confirm('Send the proforma invoice to the client now?')"><%= sent ? 'Send again' : 'Send to client' %></button>
    </div>
    <p class="muted small">The PDF is emailed and also kept in the order's documents, where the client can download it.</p>
  </div>
</form>
<%- include('../partials/foot') %>
