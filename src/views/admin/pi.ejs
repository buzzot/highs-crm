<%- include('../partials/head') %>
<% const d = p.data, b = d.buyer || {}; const sent = p.status === 'sent'; const cur = d.currency;
   const paid = order.payment_status === 'paid'; const stepNow = paid ? 2 : sent ? 1 : 0;
   const fr = d.freight || { amount: '', mode: 'none' }; const shipCost = Number(order.freight_total || 0);
   const INC = ['EXW', 'FOB', 'CIF', 'DAP']; const incs = d.incoterm && !INC.includes(d.incoterm) ? [...INC, d.incoterm] : INC;
   const lines = d.lines && d.lines.length ? d.lines : [{ description: '', sku: '', quantity: '', unit: 'pcs', unit_price: '' }];
   const sch = (d.schedule && d.schedule.length ? d.schedule : []).map(x => ({ label: x.label || '', percent: x.percent || '', due: x.due || '' }));
   const billRows = [['Company', 'company', b.company], ['Email', 'email', b.email], ['Phone', 'phone', b.phone], ['Contact', 'contact', b.contact]];
   const planKey = JSON.stringify(sch.map(x => Number(x.percent))); %>
<div class="pagehead">
  <div><a class="back" href="/admin/orders/<%= order.id %>">← Order <%= order.order_no %></a><h1>Proforma invoice <%= p.pi_no %></h1>
    <p class="muted"><%= order.organizations?.name %><%= sent ? ' · sent ' + fmt.datetime(p.sent_at) : '' %></p></div>
  <div class="headactions">
    <ol class="pi-steps"><% ['Draft', 'Sent', 'Paid'].forEach((t, i) => { %><li class="<%= i < stepNow ? 'done' : i === stepNow ? 'now' : '' %>"><%= t %></li><% }) %></ol>
    <a class="btn" href="/admin/pi/<%= p.id %>/print" target="_blank"><%- icon('file') %> Preview as client</a>
  </div>
</div>
<% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>
<% if (err) { %><div class="alert err"><%= err %></div><% } %>
<% if (sent) { %><div class="alert info">Already sent. You can change it and send it again — the client receives the new PDF.</div><% } %>
<form method="post" action="/admin/pi/<%= p.id %>" class="poform pi" id="piForm" data-cur="<%= cur %>" data-org="<%= order.org_id %>" data-order="<%= order.id %>" data-minmargin="<%= minMargin %>" data-ship="<%= shipCost > 0 ? shipCost : '' %>">
<button type="submit" class="pi-default" tabindex="-1" aria-hidden="true">Save</button><%# first submit button = what Enter does: it saves, never sends %>
<div class="pi-layout">
<div class="pi-main">

  <section class="card">
    <div class="pi-ch"><span class="n">1</span><h2>Bill to</h2><button type="button" class="link" id="billBtn">Edit</button></div>
    <div class="pi-bill" id="billView">
      <dl><% billRows.forEach(([k, f, v]) => { %><dt><%= k %></dt><dd data-bill="<%= f %>" class="<%= v ? '' : 'none' %>"><%= v || '— not set' %></dd><% }) %></dl>
      <dl><dt>Address</dt><dd data-bill="address" class="<%= b.address ? 'pre' : 'none' %>"><%= b.address || '— not set' %></dd><dt>Delivery</dt><dd data-bill="delivery_address" class="<%= b.delivery_address ? 'pre' : 'none' %>"><%= b.delivery_address || '— not set' %></dd></dl>
    </div>
    <div id="billEdit" hidden>
      <div class="pi-g4">
        <label>Company <input name="company" value="<%= b.company || '' %>"></label>
        <label>Contact person <input name="contact" value="<%= b.contact || '' %>"></label>
        <label>Email <input name="email" value="<%= b.email || '' %>"></label>
        <label>Phone <input name="phone" value="<%= b.phone || '' %>"></label>
      </div>
      <div class="pi-g2 pi-mt">
        <label>Address <textarea name="address" rows="3"><%= b.address || '' %></textarea></label>
        <label>Delivery address <textarea name="delivery_address" rows="3"><%= b.delivery_address || '' %></textarea></label>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="pi-ch"><span class="n">2</span><h2>Items</h2><span class="hint">Pick a product, create a new one, or type a custom line</span></div>
    <div class="pi-items">
      <div class="pi-ih"><span>Product / description</span><span class="r">Qty</span><span>Unit</span><span class="r">Unit price</span><span class="r">Amount</span><span></span></div>
      <div id="piRows">
      <% lines.forEach((l, i) => { %>
        <div class="pi-line" data-row>
          <div class="pi-ir">
            <div class="pi-pb">
              <input name="lines[<%= i %>][description]" value="<%= l.description %>" placeholder="Search a product or SKU — or type a custom description" autocomplete="off" aria-label="Product or description" data-desc>
              <input type="hidden" name="lines[<%= i %>][product_id]" value="<%= l.product_id || '' %>" data-pid>
              <input type="hidden" name="lines[<%= i %>][sku]" value="<%= l.sku || '' %>" data-sku>
              <div class="pi-meta" data-meta><%= l.sku || '' %></div>
              <div class="pi-dd" data-dd hidden></div>
            </div>
            <input name="lines[<%= i %>][quantity]" value="<%= l.quantity %>" class="r num" inputmode="decimal" aria-label="Quantity">
            <input name="lines[<%= i %>][unit]" value="<%= l.unit || 'pcs' %>" aria-label="Unit" list="piUnits">
            <div class="pi-pc">
              <div class="pi-suf"><input name="lines[<%= i %>][unit_price]" value="<%= l.unit_price === 0 ? '' : l.unit_price %>" class="r num" inputmode="decimal" placeholder="0.00" aria-label="Unit price"><em><%= cur %></em></div>
              <button type="button" class="pi-clock" data-clock hidden tabindex="-1" aria-label="Earlier prices">🕘</button>
              <div class="pi-pop" data-pop hidden></div>
            </div>
            <div class="r amt num" data-amt>0.00</div>
            <button type="button" class="pi-rm" title="Remove line" aria-label="Remove line" data-rm>×</button>
          </div>
          <div class="pi-warns" data-warns></div>
        </div>
      <% }) %>
      </div>
    </div>
    <datalist id="piUnits"><option>pcs</option><option>sets</option><option>pairs</option><option>m</option><option>kg</option><option>boxes</option></datalist>
    <div class="pi-add"><button type="button" class="btn small" id="addLine">+ Add line</button><span class="muted small">Currency: <strong><%= cur %></strong></span></div>
  </section>

  <section class="card">
    <div class="pi-ch"><span class="n">3</span><h2>Freight &amp; total</h2></div>
    <div class="pi-g2">
      <div><label>Freight <span class="pi-suf"><input type="number" step="0.01" min="0" max="99999999.99" name="freight_amount" id="fr_amt" value="<%= fr.amount || '' %>" placeholder="0.00"><em><%= cur %></em></span></label>
        <div class="pi-chips"><% if (shipCost > 0) { %><button type="button" class="pc" id="fr_use">Order shipment cost <%= fmt.money(shipCost, order.currency || cur) %></button><% } else { %><span class="pi-hint">No shipment cost on the order yet</span><% } %></div></div>
      <div><label>Buffer <span class="pi-suf"><input type="number" step="0.1" min="0" max="100" name="freight_buffer" id="fr_buf" value="<%= fr.buffer_pct || '' %>" placeholder="0"><em>%</em></span></label>
        <div class="pi-chips"><% [0, 3, 5, 10].forEach(n => { %><button type="button" class="pc" data-buf="<%= n %>"><%= n %>%</button><% }) %><span id="fr_calc" class="pi-hint" hidden></span></div></div>
    </div>
    <div class="pi-g2 pi-mt">
      <div><span class="pi-lab">How the client sees freight</span>
        <div class="pi-seg" role="radiogroup" aria-label="How the client sees freight">
          <% [['none', 'None'], ['separate', 'Separate line'], ['included', 'Included']].forEach(([v, t]) => { %><label><input type="radio" name="freight_mode" value="<%= v %>" <%= (fr.mode || 'none') === v ? 'checked' : '' %>><span><%= t %></span></label><% }) %>
        </div>
        <div class="pi-hint pi-hint-b" id="fr_see"></div></div>
      <div class="pi-tot">
        <div><span>Goods</span><b class="r num" id="tGoods">0.00</b></div>
        <div id="tFrRow" hidden><span id="tFrLbl">Freight</span><b class="r num" id="tFr">0.00</b></div>
        <div class="grand"><span>Total (<%= cur %>)</span><b class="r num" id="tTot">0.00</b></div>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="pi-ch"><span class="n">4</span><h2>Terms</h2></div>
    <div class="pi-g2">
      <div><span class="pi-lab">Incoterm</span>
        <div class="pi-seg" role="radiogroup" aria-label="Incoterm">
          <% incs.forEach(v => { %><label><input type="radio" name="incoterm" value="<%= v %>" <%= d.incoterm === v ? 'checked' : '' %>><span><%= v %></span></label><% }) %>
        </div></div>
      <label>Client PO number <input name="po_ref" value="<%= d.po_ref || '' %>" placeholder="optional"></label>
    </div>
    <div class="pi-g2 pi-mt">
      <div><label>Lead time <span class="pi-suf"><input type="number" min="0" name="lead_time_days" id="lead" value="<%= d.lead_time_days || '' %>" placeholder="e.g. 30"><em>days</em></span></label>
        <div class="pi-chips"><% [15, 30, 45, 60].forEach(n => { %><button type="button" class="pc" data-lead="<%= n %>"><%= n %></button><% }) %></div></div>
      <div><label>Valid until <input type="date" name="valid_until" id="vu" value="<%= d.valid_until || '' %>"></label>
        <div class="pi-chips"><% [14, 30, 60].forEach(n => { %><button type="button" class="pc" data-vu="<%= n %>">+<%= n %> days</button><% }) %></div></div>
    </div>
  </section>

  <section class="card">
    <div class="pi-ch"><span class="n">5</span><h2>Payment</h2><span class="chip ok" id="pctBadge">100% ✓</span></div>
    <span class="pi-lab">Payment plan</span>
    <div class="pi-chips" id="presets">
      <button type="button" class="pc" data-p="30,70">30 / 70</button><button type="button" class="pc" data-p="50,50">50 / 50</button><button type="button" class="pc" data-p="100">100% before shipment</button><button type="button" class="pc" data-p="custom">Custom</button>
    </div>
    <div class="pi-sh"><span>Instalment</span><span>Share</span><span class="r">Amount</span><span>Due date</span><span></span></div>
    <div id="sched">
      <% sch.forEach((x, i) => { %>
      <div class="pi-sr" data-inst>
        <input name="sched[<%= i %>][label]" value="<%= x.label %>" placeholder="e.g. Deposit" aria-label="Instalment">
        <div class="pi-suf"><input name="sched[<%= i %>][percent]" value="<%= x.percent %>" class="r num" inputmode="decimal" aria-label="Share"><em>%</em></div>
        <div class="r amt num" data-iamt>0.00</div>
        <input type="date" name="sched[<%= i %>][due]" value="<%= x.due %>" aria-label="Due date">
        <button type="button" class="pi-rm" title="Remove" aria-label="Remove instalment" data-irm>×</button>
      </div>
      <% }) %>
    </div>
    <div class="pi-add"><button type="button" class="btn small" id="addInst">+ Add instalment</button></div>
    <details class="pi-more" <%= d.payment_terms ? '' : 'open' %>>
      <summary>Payment terms wording</summary>
      <textarea name="payment_terms" id="terms" rows="2"><%= d.payment_terms || '' %></textarea>
      <button type="button" class="link" id="matchTerms">Write it from the plan above</button>
    </details>
    <hr class="pi-hr">
    <div class="pi-ch tight"><h3>Bank details</h3><button type="button" class="link" id="bankBtn">Edit</button></div>
    <div class="pi-bank" id="bankView"><%= d.bank || 'No bank details — add them in Settings or press Edit.' %></div>
    <textarea name="bank" id="bank" rows="5" hidden><%= d.bank || '' %></textarea>
    <details class="pi-more" <%= d.notes ? 'open' : '' %>><summary><%= d.notes ? 'Note for the client' : '+ Add a note for the client' %></summary><textarea name="notes" rows="2" placeholder="Shown at the bottom of the invoice"><%= d.notes || '' %></textarea></details>
  </section>

  <section class="card">
    <div class="pi-ch"><span class="n">6</span><h2>Send to the client</h2></div>
    <div class="pi-g2">
      <label>Send to (email) <input name="send_to" id="sendTo" value="<%= b.email || '' %>"></label>
      <label>Message <span class="muted small">optional, added to the email</span><input name="message" placeholder="Added to the email"></label>
    </div>
    <p class="muted small pi-mt0">The PDF is emailed and also kept in the order's documents, where the client can download it.</p>
  </section>
</div>

<aside class="pi-side">
  <div class="card pi-sum">
    <div class="pi-slbl">Total to pay</div>
    <div class="pi-big num" id="sTot"><%= cur %> 0.00</div>
    <div class="muted small" id="sLines"></div>
    <hr class="pi-hr">
    <div id="sInst"></div>
    <hr class="pi-hr">
    <ul class="pi-ck" id="ck"></ul>
    <div class="pi-stack">
      <button class="btn primary full" id="sendBtn" formaction="/admin/pi/<%= p.id %>/send" disabled><%= sent ? 'Send again' : 'Send to client' %></button>
      <button type="button" class="link center" id="sendAny" hidden>Send anyway…</button>
      <div class="pi-two"><button class="btn full">Save draft</button><a class="btn full" href="/admin/pi/<%= p.id %>/print" target="_blank">Print / PDF</a></div>
    </div>
    <p class="muted small" id="saved">Saved.</p>
  </div>
</aside>
</div>
</form>
<div class="pi-ov" id="npOv" hidden>
  <div class="pi-modal" role="dialog" aria-modal="true" aria-label="New product">
    <h3>New product</h3>
    <p class="muted small">Saved to your product list now. Add photos, packing details and the supplier on the product page later.</p>
    <div class="alert warn" id="npErr" hidden></div>
    <label>Product name <input id="npName" maxlength="200" placeholder="e.g. Steel wire rope 12 mm"></label>
    <div class="pi-g2"><label>SKU <span class="muted small">optional</span><input id="npSku" maxlength="80"></label><label>HS code <span class="muted small">optional</span><input id="npHs" maxlength="40"></label></div>
    <div class="pi-g2"><label>Supplier price <span class="muted small">optional</span><input id="npCost" inputmode="decimal" placeholder="0.00"></label><label>Currency <select id="npCur"><option>CNY</option><option>USD</option><option>EUR</option></select></label></div>
    <div class="pi-modal-acts"><button type="button" class="btn" id="npCancel">Cancel</button><button type="button" class="btn primary" id="npSave">Create and use</button></div>
  </div>
</div>
<script>
(function () {
  const F = document.getElementById('piForm'), $ = id => document.getElementById(id);
  const CUR = F.dataset.cur, SHIP = Number(F.dataset.ship) || 0;
  const num = v => { const x = parseFloat(String(v == null ? '' : v).replace(',', '.')); return Number.isFinite(x) ? x : 0; };
  const fmt = n => Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const TODAY = new Date().toISOString().slice(0, 10);
  let dirty = false, sending = false;
  const q = (s, r) => Array.from((r || F).querySelectorAll(s));
  const renumber = () => {
    q('[data-row]').forEach((row, i) => q('[name^="lines["]', row).forEach(el => { el.name = el.name.replace(/^lines\[\d+\]/, 'lines[' + i + ']'); }));
    q('[data-inst]').forEach((row, i) => q('[name^="sched["]', row).forEach(el => { el.name = el.name.replace(/^sched\[\d+\]/, 'sched[' + i + ']'); }));
  };
  function calc() {
    let goods = 0, unpriced = 0, lines = 0;
    let nDiff = 0, nBad = 0, nInfo = 0;
    q('[data-row]').forEach(row => {
      const [desc, qty, , price] = q('input:not([type=hidden])', row);
      const a = num(qty.value) * num(price.value);
      if (num(qty.value) > 0 || (desc.value || '').trim()) { lines++; goods += a; if (!(num(price.value) > 0)) unpriced++; }
      row.querySelector('[data-amt]').textContent = fmt(a);
      const flags = PF && row._info ? PF.priceFlags({ price: num(price.value), info: row._info, minMargin: MINM }) : [];
      renderWarns(row, flags);
      if (flags.some(f => f.kind === 'bad')) nBad++; else if (flags.some(f => f.kind === 'warn')) nDiff++; if (row._info) nInfo++;
    });
    const mode = (F.querySelector('[name=freight_mode]:checked') || {}).value || 'none';
    const base = num($('fr_amt').value), buf = num($('fr_buf').value);
    const fr = mode === 'none' ? 0 : Math.round(base * (1 + Math.max(0, buf) / 100) * 100) / 100;
    const fc = $('fr_calc'); fc.hidden = !(mode !== 'none' && base > 0 && buf > 0); fc.textContent = '+' + fmt(base * buf / 100) + ' ' + CUR;
    $('tFrLbl').textContent = buf > 0 ? 'Freight (incl. ' + buf + '% buffer)' : 'Freight'; q('[data-buf]').forEach(b => b.classList.toggle('on', num(b.dataset.buf) === buf));
    $('fr_see').innerHTML = mode === 'none' || !(fr > 0) ? '<b>Client sees goods only.</b> No freight on the invoice.' : mode === 'separate' ? '<b>Client sees a separate Freight line</b> of ' + fmt(fr) + ' ' + CUR + '. The buffer is not shown.' : '<b>Freight is spread into the unit prices.</b> Prices rise by about ' + (goods > 0 ? (fr / goods * 100).toFixed(1) : '0') + '% and no freight line appears.';
    const total = Math.round((goods + fr) * 100) / 100;
    $('tGoods').textContent = fmt(mode === 'included' ? goods + fr : goods);
    $('tFrRow').hidden = !(mode === 'separate' && fr > 0); $('tFr').textContent = fmt(fr);
    $('tTot').textContent = fmt(total); $('sTot').textContent = CUR + ' ' + fmt(total);
    $('sLines').textContent = lines + ' line' + (lines === 1 ? '' : 's') + (mode === 'separate' && fr > 0 ? ' · freight as a separate line' : mode === 'included' && fr > 0 ? ' · freight included in the prices' : ' · goods only');
    let sum = 0; const inst = q('[data-inst]');
    inst.forEach(row => { const pc = num(q('input', row)[1].value); sum += pc; row.querySelector('[data-iamt]').textContent = fmt(total * pc / 100); });
    sum = Math.round(sum * 100) / 100;
    const bd = $('pctBadge'); bd.className = 'chip ' + (sum === 100 ? 'ok' : 'bad'); bd.textContent = sum === 100 ? '100% ✓' : sum + '% — must be 100%';
    const esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    $('sInst').innerHTML = inst.map(row => { const ins = q('input', row), pc = num(ins[1].value); return pc > 0 ? '<div class="kv"><span>' + esc(ins[0].value || 'Instalment') + ' · ' + pc + '%</span><b>' + fmt(total * pc / 100) + '</b></div>' : ''; }).join('');
    const key = inst.map(r => num(q('input', r)[1].value)).join(',');
    q('#presets .pc').forEach(b => b.classList.toggle('on', b.dataset.p === key || (b.dataset.p === 'custom' && !['30,70', '50,50', '100'].includes(key))));
    const to = ($('sendTo').value || '').split(/[,;\s]+/).filter(x => /@/.test(x));
    const mailOk = to.length > 0 && to.every(x => /^\S+@\S+\.\S+$/.test(x)), vu = $('vu').value, dateOk = !!vu && vu >= TODAY;
    const checks = [
      [unpriced === 0 && lines > 0, lines === 0 ? 'Add at least one item' : unpriced ? unpriced + ' item' + (unpriced > 1 ? 's have' : ' has') + ' no price — <a href="/admin/orders/<%= order.id %>">check the order</a>' : 'All items have a price'],
      [total > 0, total > 0 ? 'Total is above zero' : 'Total is zero'],
      [inst.length > 0 && sum === 100, !inst.length ? 'Add a payment plan' : sum === 100 ? 'Payment plan adds up to 100%' : 'Payment plan must add up to 100%'],
      [mailOk, mailOk ? 'Client email is set' : 'Enter a valid client email'],
      [dateOk, dateOk ? 'Valid until is in the future' : 'Set a “valid until” date in the future'],
    ];
    const soft = [];   // price review: shown, but never blocks sending
    if (nBad) soft.push(['bad', nBad + ' line' + (nBad > 1 ? 's are' : ' is') + ' priced below the supplier price']);
    if (nDiff) soft.push(['no', nDiff + ' line' + (nDiff > 1 ? 's differ' : ' differs') + ' from an earlier price or the supplier price — review']);
    if (!nBad && !nDiff && nInfo) soft.push(['ok', 'Prices match earlier orders and supplier prices']);
    $('ck').innerHTML = checks.map(([ok, t]) => '<li class="' + (ok ? 'ok' : 'no') + '"><span class="d">' + (ok ? '✓' : '!') + '</span><span>' + t + '</span></li>').join('')
      + soft.map(([k, t]) => '<li class="' + k + ' soft"><span class="d">' + (k === 'ok' ? '✓' : '!') + '</span><span>' + t + '</span></li>').join('');
    const all = checks.every(c => c[0]); $('sendBtn').disabled = !all; $('sendAny').hidden = all;
  }
  const mark = () => { dirty = true; $('saved').textContent = 'Unsaved changes — Print / Preview use the last saved version.'; };
  F.addEventListener('input', () => { mark(); calc(); }); F.addEventListener('change', () => { mark(); calc(); });
  // lines
  $('addLine').onclick = () => {
    const rows = $('piRows'), row = rows.lastElementChild.cloneNode(true);
    q('input', row).forEach(i => { i.value = i.name.endsWith('[unit]') ? 'pcs' : ''; });
    row._info = null; delete row.dataset.auto; delete row.dataset.src; delete row.dataset.isnew;
    q('[data-meta]', row)[0].textContent = ''; q('[data-warns]', row)[0].innerHTML = ''; q('[data-dd]', row)[0].hidden = true; q('[data-pop]', row)[0].hidden = true; q('[data-clock]', row)[0].hidden = true;
    rows.appendChild(row); renumber(); row.querySelector('input').focus(); mark(); calc();
  };
  $('piRows').addEventListener('click', e => { const b = e.target.closest('[data-rm]'); if (!b) return; const rows = $('piRows'), row = b.closest('[data-row]'); if (rows.children.length > 1) row.remove(); else { q('input', row).forEach(i => { i.value = i.name.endsWith('[unit]') ? 'pcs' : ''; }); row._info = null; delete row.dataset.auto; delete row.dataset.src; delete row.dataset.isnew; q('[data-meta]', row)[0].textContent = ''; q('[data-warns]', row)[0].innerHTML = ''; q('[data-clock]', row)[0].hidden = true; } renumber(); mark(); calc(); });
  // schedule
  const instRow = (l, p) => { const w = document.createElement('div'); w.className = 'pi-sr'; w.setAttribute('data-inst', ''); w.innerHTML = '<input name="sched[0][label]" placeholder="e.g. Deposit" aria-label="Instalment"><div class="pi-suf"><input name="sched[0][percent]" class="r num" inputmode="decimal" aria-label="Share"><em>%</em></div><div class="r amt num" data-iamt>0.00</div><input type="date" name="sched[0][due]" aria-label="Due date"><button type="button" class="pi-rm" title="Remove" aria-label="Remove instalment" data-irm>×</button>'; const ins = q('input', w); ins[0].value = l || ''; ins[1].value = p || ''; return w; };
  $('addInst').onclick = () => { $('sched').appendChild(instRow('', '')); renumber(); mark(); calc(); };
  $('sched').addEventListener('click', e => { const b = e.target.closest('[data-irm]'); if (!b) return; b.closest('[data-inst]').remove(); renumber(); mark(); calc(); });
  q('#presets .pc').forEach(b => b.onclick = () => {
    const p = b.dataset.p; if (p === 'custom') return;
    const plan = p === '100' ? [['Full payment before shipment', 100]] : p.split(',').map((v, i) => [i ? 'Balance' : 'Deposit', +v]);
    $('sched').innerHTML = ''; plan.forEach(([l, v]) => $('sched').appendChild(instRow(l, v))); renumber(); mark(); calc();
  });
  $('matchTerms').onclick = () => {
    const rows = q('[data-inst]').map(r => q('input', r)).filter(i => num(i[1].value) > 0);
    $('terms').value = rows.length === 1 ? num(rows[0][1].value) + '% ' + (num(rows[0][1].value) === 100 ? 'before shipment' : (rows[0][0].value || 'payment').toLowerCase()) : rows.map((i, k) => num(i[1].value) + '% ' + (k === 0 ? (i[0].value || 'deposit').toLowerCase() + ' with the order' : (i[0].value || 'balance').toLowerCase() + (k === rows.length - 1 ? ' before shipment' : ''))).join(', ');
    mark();
  };
  // quick choices
  q('[data-lead]').forEach(b => b.onclick = () => { $('lead').value = b.dataset.lead; mark(); });
  q('[data-vu]').forEach(b => b.onclick = () => { const d = new Date(); d.setDate(d.getDate() + Number(b.dataset.vu)); $('vu').value = d.toISOString().slice(0, 10); mark(); calc(); });
  q('[data-buf]').forEach(b => { b.onclick = () => { $('fr_buf').value = b.dataset.buf === '0' ? '' : b.dataset.buf; mark(); calc(); }; });
  if ($('fr_use')) $('fr_use').onclick = () => { $('fr_amt').value = SHIP; mark(); calc(); };
  // bill to / bank details
  const syncBill = () => q('[data-bill]').forEach(dd => { const el = F.querySelector('[name="' + dd.dataset.bill + '"]'), v = el ? el.value.trim() : ''; dd.textContent = v || '— not set'; dd.className = v ? (/address/.test(dd.dataset.bill) ? 'pre' : '') : 'none'; });
  $('billEdit').addEventListener('input', syncBill);
  $('billBtn').onclick = () => { syncBill(); const on = !$('billEdit').hidden; $('billEdit').hidden = on; $('billView').hidden = !on; $('billBtn').textContent = on ? 'Edit' : 'Done'; };
  $('bankBtn').onclick = () => { const on = !$('bank').hidden; $('bank').hidden = on; $('bankView').hidden = !on; if (on) $('bankView').textContent = $('bank').value || 'No bank details — add them in Settings or press Edit.'; $('bankBtn').textContent = on ? 'Edit' : 'Done'; };
  // sending
  const confirmSend = (extra) => confirm((extra ? 'Some checks are not met:\n' + q('#ck li.no:not(.soft) span:last-child').map(s => '• ' + s.textContent).join('\n') + '\n\n' : '') + 'Send the proforma invoice to the client now?');
  let skip = false;
  $('sendBtn').addEventListener('click', e => { if (skip) { skip = false; sending = true; return; } if (!confirmSend(false)) e.preventDefault(); else sending = true; });
  $('sendAny').onclick = () => { if (!confirmSend(true)) return; skip = true; $('sendBtn').disabled = false; $('sendBtn').click(); };
  F.addEventListener('submit', () => { sending = true; });
  window.addEventListener('beforeunload', e => { if (dirty && !sending) { e.preventDefault(); e.returnValue = ''; } });
  // ---------- product picker, earlier prices, price checks ----------
  const MINM = Number(F.dataset.minmargin) || 20, ORG = F.dataset.org;
  let PF = null;
  const h = t => String(t == null ? '' : t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  const M = n => (PF ? PF.money(n) : Number(n).toFixed(2));
  const infoCache = new Map();
  const getInfo = (pid, fresh) => { if (fresh) infoCache.delete(pid); if (!infoCache.has(pid)) infoCache.set(pid, fetch('/admin/pi/price-info?product=' + pid + '&org=' + ORG + '&order=' + F.dataset.order + '&cur=' + CUR, { headers: { Accept: 'application/json' } }).then(r => (r.ok ? r.json() : null)).catch(() => null)); return infoCache.get(pid); };
  const priceEl = row => row.querySelector('[name$="[unit_price]"]'), qtyEl = row => row.querySelector('[name$="[quantity]"]');
  function setMeta(row) {
    const pid = row.querySelector('[data-pid]').value, sku = row.querySelector('[data-sku]').value, desc = row.querySelector('[data-desc]').value.trim(), parts = [];
    if (sku) parts.push('<span>' + h(sku) + '</span>');
    if (pid) parts.push(row.dataset.isnew ? '<span class="pi-badge new">New product · details incomplete</span>' : '<span class="pi-badge prod">Product</span>');
    else if (desc) parts.push('<span class="pi-badge">Custom line</span>');
    if (row.dataset.src) parts.push('<span>price from <b>' + h(row.dataset.src) + '</b></span>');
    row.querySelector('[data-meta]').innerHTML = parts.join('');
  }
  const fmtD = d => { const t = new Date(d + 'T00:00:00'); return t.getTime() !== t.getTime() ? d : t.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); };
  const srcs = i => [i.quote && { k: 'Quotation', ...i.quote, label: 'Quotation · ' + fmtD(i.quote.date) }, i.po && { k: 'Client PO', ...i.po, label: 'Client PO ' + i.po.ref + ' · ' + fmtD(i.po.date) }, ...(i.hist || []).slice(0, 1).map(x => ({ k: 'Last order', ...x, ref: x.order_no, label: 'Last order ' + x.order_no + ' · ' + fmtD(x.date) }))].filter(Boolean);
  const showClock = row => { const i = row._info; row.querySelector('[data-clock]').hidden = !i; };
  function renderWarns(row, flags) {
    row.querySelector('[data-warns]').innerHTML = flags.map(f => '<div class="pi-w ' + f.kind + '"><span>' + h(f.text) + '</span>' + (f.use != null ? '<button type="button" data-use="' + PF.trim4(f.use) + '">Use ' + PF.money(f.use) + '</button>' : '') + '</div>').join('');
  }
  function setPrice(row, v) { priceEl(row).value = v; delete row.dataset.auto; delete row.dataset.src; setMeta(row); showPop(row, false); mark(); calc(); }
  async function setProduct(row, p, isNew) {
    const pid = row.querySelector('[data-pid]'), sku = row.querySelector('[data-sku]');
    delete row.dataset.src; delete row.dataset.isnew;
    if (!p) { pid.value = ''; row._info = null; showClock(row); setMeta(row); mark(); calc(); return; }
    row.querySelector('[data-desc]').value = p.name; pid.value = p.id; sku.value = p.sku || ''; if (isNew) row.dataset.isnew = '1';
    const info = await getInfo(p.id, !!isNew); row._info = info; showClock(row);
    const first = info && srcs(info)[0];
    if (first && (!num(priceEl(row).value) || row.dataset.auto)) { priceEl(row).value = PF.trim4(first.price); row.dataset.auto = '1'; row.dataset.src = first.k === 'Quotation' ? 'quotation, ' + fmtD(first.date) : first.k === 'Client PO' ? 'client PO ' + first.ref : 'last order ' + first.ref + (first.cur_orig !== CUR ? ' (converted from ' + first.cur_orig + ')' : ''); }
    else if (!first && row.dataset.auto) { priceEl(row).value = ''; delete row.dataset.auto; }
    const lq = info && info.hist && info.hist[0];
    if (lq && !num(qtyEl(row).value)) qtyEl(row).value = lq.qty;
    setMeta(row); mark(); calc();
  }
  async function search(row, q) {
    const dd = row.querySelector('[data-dd]'); let list = [];
    try { const r = await fetch('/admin/pi/products?q=' + encodeURIComponent(q) + '&org=' + ORG + '&cur=' + CUR, { headers: { Accept: 'application/json' } }); list = r.ok ? await r.json() : []; } catch (e) { list = []; }
    row._opts = list; row._hi = -1;
    dd.innerHTML = list.map((p, k) => '<div class="pi-opt" data-k="' + k + '"><b>' + h(p.name) + '</b><small>' + h(p.sku || 'no SKU') + (p.last ? ' · last order ' + h(p.last.date) : ' · not ordered by this client') + '</small><span class="p">'
      + (p.last ? M(p.last.price) + ' ' + CUR + '<small>last price</small>' : '<small>no price yet</small>') + '</span></div>').join('')
      + (list.length ? '<hr>' : '') + '<div class="pi-opt act" data-act="new">+ Create new product' + (q ? ' “' + h(q) + '”' : '') + '</div><div class="pi-opt act plain" data-act="custom">Use as a custom line (no product)</div>';
    dd.hidden = false;
  }
  const rowsEl = $('piRows');
  rowsEl.addEventListener('input', e => {
    const el = e.target, row = el.closest('[data-row]');
    if (el.matches('[data-desc]')) { clearTimeout(row._t); row._t = setTimeout(() => search(row, el.value.trim()), 180); setMeta(row); }
    else if (el.name && /\[unit_price\]$/.test(el.name)) { delete row.dataset.auto; delete row.dataset.src; setMeta(row); }
  });
  rowsEl.addEventListener('focusin', e => { const el = e.target; if (el.matches('[data-desc]') && !el.value.trim()) search(el.closest('[data-row]'), ''); });
  rowsEl.addEventListener('keydown', e => {
    if (!e.target.matches('[data-desc]')) return;
    const row = e.target.closest('[data-row]'), dd = row.querySelector('[data-dd]');
    if (e.key === 'Escape') { dd.hidden = true; return; }
    if (dd.hidden || !row._opts || !row._opts.length) return;
    const opts = q('.pi-opt[data-k]', dd);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); row._hi = Math.max(0, Math.min(opts.length - 1, (row._hi ?? -1) + (e.key === 'ArrowDown' ? 1 : -1))); opts.forEach((o, i) => o.classList.toggle('hi', i === row._hi)); }
    else if (e.key === 'Enter' && row._hi >= 0) { e.preventDefault(); dd.hidden = true; setProduct(row, row._opts[row._hi]); }
  });
  rowsEl.addEventListener('mousedown', e => {
    const o = e.target.closest('.pi-opt'); if (!o) return; e.preventDefault();
    const row = o.closest('[data-row]'); row.querySelector('[data-dd]').hidden = true;
    if (o.dataset.act === 'new') openNew(row, row.querySelector('[data-desc]').value.trim());
    else if (o.dataset.act === 'custom') setProduct(row, null);
    else setProduct(row, row._opts[Number(o.dataset.k)]);
  });
  document.addEventListener('mousedown', e => { if (!e.target.closest('.pi-pb')) q('[data-dd]').forEach(d => { d.hidden = true; }); });
  rowsEl.addEventListener('click', e => { const b = e.target.closest('[data-use]'); if (b) setPrice(b.closest('[data-row]'), b.dataset.use); });
  // hover the price: earlier orders to this client, the supplier price and the margin (staff only)
  function popHtml(row) {
    const i = row._info; if (!i) return ''; const price = num(priceEl(row).value);
    const pill = pr => { const m = PF.marginAt(pr, i.cost); if (m == null) return ''; return '<span class="pill ' + (pr < i.cost ? 'b' : m < MINM ? 'a' : 'g') + '" title="Margin over supplier price">' + m.toFixed(0) + '%</span>'; };
    let t = '<h4>Price sources · this client</h4>';
    const have = srcs(i), line = x => '<div class="pi-l" data-use="' + PF.trim4(x.price) + '"><span><b>' + h(x.k) + '</b> <small>' + h(x.k === 'Last order' ? x.order_no + ' · ' + fmtD(x.date) : x.k === 'Client PO' ? x.ref + ' · ' + fmtD(x.date) : fmtD(x.date)) + '</small></span><span class="p">' + M(x.price) + (x.cur_orig !== CUR ? '<small> ≈ ' + M(x.price_orig) + ' ' + h(x.cur_orig) + '</small>' : '') + '</span>' + pill(x.price) + '</div>';
    t += ['Quotation', 'Client PO', 'Last order'].map(k => { const x = have.find(y => y.k === k); return x ? line(x) : '<div class="pi-l none"><span><b>' + k + '</b></span><span class="p">none</span><span></span></div>'; }).join('');
    if (i.cost != null) { const m = PF.marginAt(price, i.cost); t += '<div class="pi-cost"><span>Supplier price</span><b>' + M(i.cost) + ' ' + CUR + '</b></div>' + (m != null ? '<div class="pi-cost"><span>Margin at ' + M(price) + '</span><b>' + m.toFixed(0) + '%</b></div>' : ''); }
    return t + '<div class="pi-tip">Click a line to use that price. Staff only — never on the PDF.</div>';
  }
  function showPop(row, on) { const pop = row.querySelector('[data-pop]'), i = row._info; if (on && PF && i) { pop.innerHTML = popHtml(row); pop.hidden = false; } else pop.hidden = true; }
  rowsEl.addEventListener('mouseover', e => { const pc = e.target.closest('.pi-pc'); if (pc) showPop(pc.closest('[data-row]'), true); });
  rowsEl.addEventListener('mouseout', e => { const pc = e.target.closest('.pi-pc'); if (pc && !pc.contains(e.relatedTarget)) showPop(pc.closest('[data-row]'), false); });
  rowsEl.addEventListener('focusin', e => { if (e.target.name && /\[unit_price\]$/.test(e.target.name)) showPop(e.target.closest('[data-row]'), true); });
  rowsEl.addEventListener('focusout', e => { if (e.target.name && /\[unit_price\]$/.test(e.target.name)) { const row = e.target.closest('[data-row]'); setTimeout(() => { if (!row.querySelector('.pi-pc:hover')) showPop(row, false); }, 200); } });
  // create a product without leaving the invoice
  let npRow = null, npDup = null;
  function openNew(row, name) { npRow = row; npDup = null; $('npName').value = name || ''; ['npSku', 'npHs', 'npCost'].forEach(id => { $(id).value = ''; }); $('npErr').hidden = true; $('npOv').hidden = false; $('npName').focus(); }
  $('npCancel').onclick = () => { $('npOv').hidden = true; };
  $('npErr').addEventListener('click', e => { if (e.target.closest('[data-dup]') && npDup) { e.preventDefault(); $('npOv').hidden = true; setProduct(npRow, npDup); } });
  $('npSave').onclick = async () => {
    const name = $('npName').value.trim(); if (!name) { $('npName').focus(); return; }
    const err = t => { $('npErr').innerHTML = t; $('npErr').hidden = false; };
    $('npSave').disabled = true;
    try {
      const r = await fetch('/admin/pi/product-new', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ name, sku: $('npSku').value, hs_code: $('npHs').value, unit_cost: $('npCost').value, cost_currency: $('npCur').value }) });
      const j = await r.json();
      if (!r.ok) err(h(j.error || 'Could not save the product.'));
      else if (j.duplicate) { npDup = j.duplicate; err('“' + h(j.duplicate.name) + '” already exists. <a href="#" data-dup>Use the existing product</a>'); }
      else { $('npOv').hidden = true; await setProduct(npRow, j.product, true); }
    } catch (e) { err('Could not save the product — check your connection.'); } finally { $('npSave').disabled = false; }
  };
  // earlier prices of the products already on the invoice
  import('/js/price-flags.js').then(m => {
    PF = m;
    q('[data-row]').forEach(async row => { setMeta(row); const pid = row.querySelector('[data-pid]').value; if (pid) { row._info = await getInfo(pid); showClock(row); calc(); } });
    calc();
  }).catch(() => {});
  renumber(); calc();
})();
</script>
<%- include('../partials/foot') %>
