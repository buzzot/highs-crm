<%- include('../../partials/head') %>
<div class="pagehead"><div><a class="back" href="/admin/purchasing">← Purchasing</a><h1>New purchase order</h1>
  <p class="muted">A purchase order to one supplier — no client order needed. Link it to an order later, when the order is confirmed.</p></div></div>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<form method="post" action="/admin/purchasing/new-manual" class="poform manualpo" id="mpo">
  <div class="card">
    <h2>Supplier</h2>
    <div class="row">
      <label class="grow2">Supplier
        <select name="supplier_id" id="m_sup" required><option value="">— choose —</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= s.id === supplier_id ? 'selected' : '' %>><%= s.name %></option><% }) %><option value="__new">+ Add new supplier…</option></select></label>
      <label class="grow2">Label <span class="muted small">optional, for us — e.g. “Stock for November”</span><input name="title" maxlength="200"></label>
    </div>
    <div class="newsup" id="newSup" hidden>
      <strong>New supplier</strong> <span class="muted small">— just the basics; complete the rest later on the supplier page</span>
      <div class="row">
        <label class="grow2">Company name <input id="ns_name" maxlength="200"></label>
        <label>Contact person <input id="ns_contact"></label>
        <label>City <input id="ns_city"></label>
      </div>
      <div class="row">
        <label>Email <input type="email" id="ns_email"></label>
        <label>Phone <input id="ns_phone"></label>
        <label>WeChat <input id="ns_wechat"></label>
      </div>
      <div class="aiscan-msg err" id="ns_err" hidden></div>
      <div class="actions"><button type="button" class="btn small primary" id="ns_save">Add supplier</button><button type="button" class="btn small" id="ns_cancel">Cancel</button></div>
    </div>
    <div class="row">
      <label>Currency <select name="currency" id="m_cur"><% currencies.forEach(c => { %><option <%= c === 'CNY' ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>Required by <input type="date" name="required_date"></label>
      <label class="grow2">Link to an order <span class="muted small">optional — can be done later</span>
        <select name="order_id"><option value="">— not linked yet —</option><% orders.forEach(o => { %><option value="<%= o.id %>"><%= o.order_no %> · <%= o.organizations?.name || '' %></option><% }) %></select></label>
    </div>
  </div>
  <div class="card">
    <h2>Products</h2>
    <div class="tablewrap"><table class="tbl compact newspo" id="m_lines">
      <thead><tr><th>Product</th><th>Description on the PO</th><th>SKU</th><th class="right">Qty</th><th class="right">Unit price</th><th></th></tr></thead>
      <tbody></tbody>
    </table></div>
    <div class="actions"><button type="button" class="btn small primary" id="m_add">+ Add product</button><button type="button" class="btn small" id="m_free">+ Free line</button></div>
    <p class="muted small">“Add product” opens the catalogue: pick a product and it fills in the name, SKU and factory price — then enter the quantity. Use “Free line” for something that is not in the catalogue. Prices are what we pay the supplier, in the currency above.</p>
    <div class="actions"><button class="btn primary">Create purchase order</button><a class="btn" href="/admin/purchasing">Cancel</a></div>
  </div>
</form>
<dialog class="pickdlg" id="pickDlg">
  <div class="pickhead"><h2>Choose a product</h2><button type="button" class="link" id="pk_close" title="Close">×</button></div>
  <div class="pickbar"><input type="search" id="pk_q" placeholder="Search name, SKU, description…" autocomplete="off">
    <label class="small"><input type="checkbox" id="pk_only"> only this supplier's products</label></div>
  <div class="pickscroll"><table class="tbl picktbl"><thead><tr><th></th><th>Product</th><th>Description</th><th>Supplier</th><th class="right">Price</th><th></th></tr></thead><tbody id="pk_rows"></tbody></table>
    <p class="muted" id="pk_empty" hidden>No products match.</p></div>
</dialog>
<script type="application/json" id="mData"><%- JSON.stringify({ products: products.map(p => ({ id: p.id, name: p.name, sku: p.sku, supplier_id: p.supplier_id, unit_cost: p.unit_cost, cost_currency: p.cost_currency, description: p.description, moq: p.moq, photo: p.photo })), suppliers: suppliers.map(x => ({ id: x.id, name: x.name })) }).replace(/</g, '\\u003c') %></script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('mData').textContent), body = document.querySelector('#m_lines tbody'), sup = document.getElementById('m_sup'), cur = document.getElementById('m_cur');
  const dlg = document.getElementById('pickDlg'), $ = id => document.getElementById(id);
  const supName = id => (data.suppliers.find(x => x.id === id) || {}).name || '';
  let n = 0, target = null;
  const fmt = (v, c) => v == null || v === '' ? '—' : (c ? c + ' ' : '') + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
  function addRow(free) {
    const i = n++, tr = document.createElement('tr');
    tr.innerHTML = `<td class="prodcell"><input type="hidden" name="line[${i}][product_id]"><div class="prodpick"></div></td>
      <td><input name="line[${i}][description]" placeholder="Product name"></td><td><input name="line[${i}][sku]"></td>
      <td class="right"><input type="number" min="1" name="line[${i}][quantity]"></td><td class="right"><input type="number" step="0.0001" min="0" name="line[${i}][unit_price]"></td>
      <td><button type="button" class="link small danger" title="Remove line">×</button></td>`;
    const q = s => tr.querySelector(s);
    const box = q('.prodpick');
    const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'btn small'; btn.textContent = 'Choose product'; box.appendChild(btn);
    btn.addEventListener('click', () => openPicker(tr));
    q('button.danger').addEventListener('click', () => tr.remove());
    tr._set = p => {
      q('input[type=hidden]').value = p.id;
      q('[name$="[description]"]').value = p.name; q('[name$="[sku]"]').value = p.sku || ''; q('[name$="[unit_price]"]').value = p.unit_cost ?? '';
      box.innerHTML = '';
      if (p.photo) { const im = document.createElement('img'); im.src = '/admin/documents/' + p.photo + '/download'; im.alt = ''; box.appendChild(im); }
      const t = document.createElement('button'); t.type = 'button'; t.className = 'link small'; t.textContent = 'change'; t.addEventListener('click', () => openPicker(tr)); box.appendChild(t);
    };
    body.appendChild(tr);
    return tr;
  }
  function openPicker(tr) {
    target = tr; $('pk_q').value = ''; $('pk_only').checked = !!sup.value && sup.value !== '__new'; render(); dlg.showModal(); $('pk_q').focus();
  }
  function render() {
    const term = $('pk_q').value.trim().toLowerCase(), only = $('pk_only').checked && sup.value && sup.value !== '__new';
    const rows = data.products.filter(p => (!only || p.supplier_id === sup.value) && (!term || [p.name, p.sku, p.description, supName(p.supplier_id)].some(x => String(x || '').toLowerCase().includes(term))));
    const tb = $('pk_rows'); tb.innerHTML = '';
    rows.forEach(p => {
      const tr = document.createElement('tr'); tr.className = 'pickrow';
      const c0 = document.createElement('td'); c0.className = 'pthumbcell';
      if (p.photo) { const im = document.createElement('img'); im.src = '/admin/documents/' + p.photo + '/download'; im.loading = 'lazy'; im.alt = ''; c0.appendChild(im); } else { c0.textContent = '▫'; }
      const c1 = document.createElement('td'); const b = document.createElement('strong'); b.textContent = p.name; c1.appendChild(b);
      if (p.sku) { const sk = document.createElement('div'); sk.className = 'muted small'; sk.textContent = p.sku; c1.appendChild(sk); }
      const c2 = document.createElement('td'); c2.className = 'muted small'; c2.textContent = (p.description || '').slice(0, 140);
      const c3 = document.createElement('td'); c3.className = 'small'; c3.textContent = supName(p.supplier_id) || '—';
      const c4 = document.createElement('td'); c4.className = 'right'; c4.textContent = fmt(p.unit_cost, p.cost_currency) + (p.moq ? '' : '');
      const c5 = document.createElement('td'); const sb = document.createElement('button'); sb.type = 'button'; sb.className = 'btn small primary'; sb.textContent = 'Select'; c5.appendChild(sb);
      tr.append(c0, c1, c2, c3, c4, c5); tb.appendChild(tr);
      const pick = () => {
        if (target) { target._set(p); const firstEmpty = !target.querySelector('[name$="[quantity]"]').value; if (p.cost_currency && ![...body.querySelectorAll('[name$="[product_id]"]')].some(h => h.value && h !== target.querySelector('[name$="[product_id]"]'))) cur.value = p.cost_currency; if (!sup.value && p.supplier_id) { sup.value = p.supplier_id; sup.dispatchEvent(new Event('change')); } dlg.close(); if (firstEmpty) target.querySelector('[name$="[quantity]"]').focus(); }
      };
      tr.addEventListener('dblclick', pick); sb.addEventListener('click', pick);
    });
    $('pk_empty').hidden = rows.length > 0;
  }
  $('pk_q').addEventListener('input', render); $('pk_only').addEventListener('change', render);
  $('pk_close').addEventListener('click', () => dlg.close());
  dlg.addEventListener('close', () => { if (target && !target.querySelector('[name$="[product_id]"]').value && !target.querySelector('[name$="[description]"]').value) target.remove(); }); // closed without choosing: drop the empty line
  const blankRow = () => [...body.querySelectorAll('tr')].find(t => !t.querySelector('[name$="[product_id]"]').value && !t.querySelector('[name$="[description]"]').value);
  $('m_add').addEventListener('click', () => openPicker(blankRow() || addRow())); // reuse an empty line instead of stacking blanks
  $('m_free').addEventListener('click', () => { const tr = blankRow() || addRow(); tr.querySelector('[name$="[description]"]').focus(); });
  addRow();
})();
</script>
<script>
  // "+ Add new supplier…": create the supplier in place and select it (the PO itself is created with the normal button)
  (function () {
    const sel = document.getElementById('m_sup'), box = document.getElementById('newSup'); if (!sel || !box) return;
    const $ = id => document.getElementById(id); let prev = sel.value;
    const err = t => { const e = $('ns_err'); e.hidden = !t; e.textContent = t || ''; };
    const close = () => { box.hidden = true; err(''); if (sel.value === '__new') { sel.value = prev; sel.dispatchEvent(new Event('change')); } };
    sel.addEventListener('change', () => { if (sel.value === '__new') { box.hidden = false; $('ns_name').focus(); } else { prev = sel.value; box.hidden = true; } });
    $('ns_cancel').addEventListener('click', close);
    $('ns_save').addEventListener('click', async () => {
      const name = $('ns_name').value.trim(); if (!name) return err('Enter the supplier name.');
      const btn = $('ns_save'); btn.disabled = true; err('');
      try {
        const res = await fetch('/admin/products/quick-supplier', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, contact_name: $('ns_contact').value, city: $('ns_city').value, email: $('ns_email').value, phone: $('ns_phone').value, wechat: $('ns_wechat').value }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Could not add the supplier.');
        if (![...sel.options].some(o => o.value === j.id)) sel.insertBefore(new Option(j.name, j.id), sel.querySelector('option[value=__new]'));
        sel.value = j.id; prev = j.id; box.hidden = true; sel.dispatchEvent(new Event('change'));
        ['ns_name', 'ns_contact', 'ns_city', 'ns_email', 'ns_phone', 'ns_wechat'].forEach(i => { $(i).value = ''; });
      } catch (e) { err(e.message); } finally { btn.disabled = false; }
    });
    sel.form.addEventListener('submit', () => { if (sel.value === '__new') sel.value = prev; });
  })();
</script>
<%- include('../../partials/foot') %>
