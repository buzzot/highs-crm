<%- include('../../partials/head') %>
<div class="pagehead"><div><a class="back" href="/admin/purchasing">← Purchasing</a><h1>New purchase order</h1>
  <p class="muted">A purchase order to one supplier — no client order needed. Link it to an order later, when the order is confirmed.</p></div></div>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<form method="post" action="/admin/purchasing/new-manual" class="poform manualpo" id="mpo">
  <div class="card">
    <h2>Supplier</h2>
    <div class="row">
      <label class="grow2">Supplier
        <select name="supplier_id" id="m_sup" required><option value="">— choose —</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= s.id === supplier_id ? 'selected' : '' %>><%= s.name %></option><% }) %><option value="__new">+ Add new supplier…</option></select></label>
      <label class="grow2">Label <span class="muted small">optional, for us — e.g. “Stock for November”</span><input name="title" maxlength="200"></label>
    </div>
    <div class="newsup" id="newSup" hidden>
      <strong>New supplier</strong> <span class="muted small">— just the basics; complete the rest later on the supplier page</span>
      <div class="row">
        <label class="grow2">Company name <input id="ns_name" maxlength="200"></label>
        <label>Contact person <input id="ns_contact"></label>
        <label>City <input id="ns_city"></label>
      </div>
      <div class="row">
        <label>Email <input type="email" id="ns_email"></label>
        <label>Phone <input id="ns_phone"></label>
        <label>WeChat <input id="ns_wechat"></label>
      </div>
      <div class="aiscan-msg err" id="ns_err" hidden></div>
      <div class="actions"><button type="button" class="btn small primary" id="ns_save">Add supplier</button><button type="button" class="btn small" id="ns_cancel">Cancel</button></div>
    </div>
    <div class="row">
      <label>Currency <select name="currency" id="m_cur"><% currencies.forEach(c => { %><option <%= c === 'CNY' ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>Required by <input type="date" name="required_date"></label>
      <label class="grow2">Link to an order <span class="muted small">optional — can be done later</span>
        <select name="order_id"><option value="">— not linked yet —</option><% orders.forEach(o => { %><option value="<%= o.id %>"><%= o.order_no %> · <%= o.organizations?.name || '' %></option><% }) %></select></label>
    </div>
  </div>
  <div class="card">
    <h2>Products</h2>
    <div class="tablewrap"><table class="tbl compact newspo" id="m_lines">
      <thead><tr><th>Catalogue product</th><th>Description</th><th>SKU</th><th class="right">Qty</th><th class="right">Unit price</th><th></th></tr></thead>
      <tbody></tbody>
    </table></div>
    <div class="actions"><button type="button" class="btn small" id="m_add">+ Add line</button></div>
    <p class="muted small">Pick a product from the catalogue to fill in its name, SKU and factory price, or type a free line. Prices are what we pay the supplier, in the currency above.</p>
    <div class="actions"><button class="btn primary">Create purchase order</button><a class="btn" href="/admin/purchasing">Cancel</a></div>
  </div>
</form>
<script type="application/json" id="mData"><%- JSON.stringify({ products: products.map(p => ({ id: p.id, name: p.name, sku: p.sku, supplier_id: p.supplier_id, unit_cost: p.unit_cost, cost_currency: p.cost_currency })) }).replace(/</g, '\\u003c') %></script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('mData').textContent), body = document.querySelector('#m_lines tbody'), sup = document.getElementById('m_sup'), cur = document.getElementById('m_cur');
  let n = 0;
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const options = () => '<option value="">— free line —</option>' + data.products.filter(p => !sup.value || p.supplier_id === sup.value).map(p => `<option value="${p.id}">${esc(p.name)}${p.sku ? ' · ' + esc(p.sku) : ''}</option>`).join('');
  function addRow() {
    const i = n++, tr = document.createElement('tr');
    tr.innerHTML = `<td><select class="pick">${options()}</select><input type="hidden" name="line[${i}][product_id]"></td>
      <td><input name="line[${i}][description]" placeholder="Product name"></td><td><input name="line[${i}][sku]"></td>
      <td class="right"><input type="number" min="1" name="line[${i}][quantity]"></td><td class="right"><input type="number" step="0.0001" min="0" name="line[${i}][unit_price]"></td>
      <td><button type="button" class="link small danger" title="Remove line">×</button></td>`;
    const q = s => tr.querySelector(s);
    q('.pick').addEventListener('change', e => {
      const p = data.products.find(x => x.id === e.target.value);
      q('input[type=hidden]').value = p ? p.id : '';
      if (p) { q('[name$="[description]"]').value = p.name; q('[name$="[sku]"]').value = p.sku || ''; q('[name$="[unit_price]"]').value = p.unit_cost ?? ''; if (p.cost_currency && ![...body.querySelectorAll('[name$="[description]"]')].some((el, k) => el !== q('[name$="[description]"]') && el.value)) cur.value = p.cost_currency; }
    });
    q('button').addEventListener('click', () => { tr.remove(); });
    body.appendChild(tr);
  }
  sup.addEventListener('change', () => body.querySelectorAll('.pick').forEach(s => { const keep = s.value; s.innerHTML = options(); s.value = [...s.options].some(o => o.value === keep) ? keep : ''; }));
  document.getElementById('m_add').addEventListener('click', addRow);
  for (let k = 0; k < 3; k++) addRow();
})();
</script>
<script>
  // "+ Add new supplier…": create the supplier in place and select it (the PO itself is created with the normal button)
  (function () {
    const sel = document.getElementById('m_sup'), box = document.getElementById('newSup'); if (!sel || !box) return;
    const $ = id => document.getElementById(id); let prev = sel.value;
    const err = t => { const e = $('ns_err'); e.hidden = !t; e.textContent = t || ''; };
    const close = () => { box.hidden = true; err(''); if (sel.value === '__new') { sel.value = prev; sel.dispatchEvent(new Event('change')); } };
    sel.addEventListener('change', () => { if (sel.value === '__new') { box.hidden = false; $('ns_name').focus(); } else { prev = sel.value; box.hidden = true; } });
    $('ns_cancel').addEventListener('click', close);
    $('ns_save').addEventListener('click', async () => {
      const name = $('ns_name').value.trim(); if (!name) return err('Enter the supplier name.');
      const btn = $('ns_save'); btn.disabled = true; err('');
      try {
        const res = await fetch('/admin/products/quick-supplier', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, contact_name: $('ns_contact').value, city: $('ns_city').value, email: $('ns_email').value, phone: $('ns_phone').value, wechat: $('ns_wechat').value }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Could not add the supplier.');
        if (![...sel.options].some(o => o.value === j.id)) sel.insertBefore(new Option(j.name, j.id), sel.querySelector('option[value=__new]'));
        sel.value = j.id; prev = j.id; box.hidden = true; sel.dispatchEvent(new Event('change'));
        ['ns_name', 'ns_contact', 'ns_city', 'ns_email', 'ns_phone', 'ns_wechat'].forEach(i => { $(i).value = ''; });
      } catch (e) { err(e.message); } finally { btn.disabled = false; }
    });
    sel.form.addEventListener('submit', () => { if (sel.value === '__new') sel.value = prev; });
  })();
</script>
<%- include('../../partials/foot') %>
