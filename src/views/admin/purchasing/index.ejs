<%- include('../../partials/head') %>
<div class="pagehead"><div><h1>Purchasing</h1><p class="muted">Purchase orders to our suppliers. Create them from an order, send them by email, and see the supplier's confirmation and proforma invoice here.</p></div></div>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<div class="card">
  <div class="pay-kpis">
    <div><span class="muted small">Drafts</span><strong><%= kpi.drafts %></strong></div>
    <div><span class="muted small">Waiting for reply</span><strong><%= kpi.waiting %></strong></div>
    <div><span class="muted small">Replied — to check</span><strong class="<%= kpi.review ? 'bad' : '' %>"><%= kpi.review %></strong></div>
    <div><span class="muted small">Confirmed</span><strong><%= kpi.confirmed %></strong></div>
  </div>
  <div class="tabs">
    <a class="<%= status ? '' : 'on' %>" href="/admin/purchasing">All <%= kpi.total %></a>
    <% statuses.forEach(s => { %><a class="<%= status === s ? 'on' : '' %>" href="/admin/purchasing?status=<%= s %>"><%= labels[s].split(' — ')[0] %></a><% }) %>
  </div>
  <% if (!pos.length) { %><p class="muted">No purchase orders yet. Open an order and choose <strong>Create supplier POs</strong>.</p><% } else { %>
  <table class="tbl">
    <thead><tr><th>PO</th><th>Supplier</th><th>Order</th><th class="right">Total</th><th>Status</th><th>Sent</th><th>Last reply</th></tr></thead>
    <tbody>
    <% pos.forEach(p => { %>
      <tr>
        <td><a href="/admin/purchasing/<%= p.id %>"><strong><%= p.ref %></strong></a><div class="muted small"><%= (p.lines || []).length %> line<%= (p.lines || []).length === 1 ? '' : 's' %></div></td>
        <td><%= p.suppliers?.name || '—' %></td>
        <td><% if (p.orders) { %><a href="/admin/orders/<%= p.orders.id %>"><%= p.orders.order_no %></a><div class="muted small"><%= p.orders.organizations?.name || '' %></div><% } %></td>
        <td class="right"><%= fmt.money(p.total, p.currency) %></td>
        <td><span class="pill spo-<%= p.status %>"><%= labels[p.status] %></span></td>
        <td class="small"><%= p.sent_at ? fmt.datetime(p.sent_at) : '—' %></td>
        <td class="small"><%= p.last_reply_at ? fmt.datetime(p.last_reply_at) : '—' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../../partials/foot') %>
