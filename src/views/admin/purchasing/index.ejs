<%- include('../../partials/head') %>
<% const tab = (s, label, n) => `<a class="${(status === s && !unlinked) ? 'on' : ''}" href="/admin/purchasing${s ? '?status=' + s : ''}">${label}${n != null ? ' <span>' + n + '</span>' : ''}</a>`; %>
<div class="pagehead">
  <div><h1>Purchasing</h1><p class="muted">Purchase orders to our suppliers — send them, and keep the supplier's confirmation, proforma invoice and packing list together.</p></div>
  <div class="headactions"><a class="btn" href="/admin/rfqs">RFQs</a><a class="btn" href="/admin/orders">From an order</a><a class="btn primary" href="/admin/purchasing/new">+ New purchase order</a></div>
</div>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>

<div class="statgrid">
  <a class="stat <%= kpi.review ? 'attn' : '' %>" href="/admin/purchasing?status=replied"><span class="muted small">Needs your check</span><strong><%= kpi.review %></strong><span class="small muted">supplier replied</span></a>
  <a class="stat" href="/admin/purchasing?status=sent"><span class="muted small">Waiting for reply</span><strong><%= kpi.waiting %></strong><span class="small muted">sent, no answer yet</span></a>
  <a class="stat ok" href="/admin/purchasing?status=confirmed"><span class="muted small">Confirmed</span><strong><%= kpi.confirmed %></strong><span class="small muted">by the supplier</span></a>
  <a class="stat" href="/admin/purchasing?status=draft"><span class="muted small">Drafts</span><strong><%= kpi.drafts %></strong><span class="small muted">not sent yet</span></a>
  <a class="stat <%= unlinked ? 'sel' : '' %>" href="/admin/purchasing?order=none"><span class="muted small">Not linked to an order</span><strong><%= kpi.unlinked %></strong><span class="small muted">link when the order is confirmed</span></a>
</div>

<div class="card flush">
  <div class="toolbar">
    <div class="tabs">
      <%- tab('', 'All', kpi.total) %>
      <%- tab('draft', 'Draft', counts.draft) %><%- tab('sent', 'Sent', counts.sent) %><%- tab('replied', 'Replied', counts.replied) %><%- tab('confirmed', 'Confirmed', counts.confirmed) %><%- tab('declined', 'Declined', counts.declined) %><%- tab('cancelled', 'Cancelled', counts.cancelled) %>
    </div>
    <input type="search" class="searchbox" id="poSearch" placeholder="Search PO, supplier, order…" aria-label="Search purchase orders">
  </div>
  <% if (!pos.length) { %>
    <div class="emptybox">
      <strong><%= status || unlinked ? 'Nothing here' : 'No purchase orders yet' %></strong>
      <p class="muted"><%= status || unlinked ? 'No purchase order matches this filter.' : 'Create one for a client order — products are grouped by supplier — or start a purchase order without an order and link it later.' %></p>
      <div class="actions"><a class="btn primary" href="/admin/purchasing/new">+ New purchase order</a><a class="btn" href="/admin/orders">Choose an order</a></div>
    </div>
  <% } else { %>
  <div class="tablewrap"><table class="tbl purchtbl" id="poTable">
    <thead><tr><th>Purchase order</th><th>Supplier</th><th>Order</th><th class="right">Total</th><th>Status</th><th>Timeline</th></tr></thead>
    <tbody>
    <% pos.forEach(p => { const n = (p.lines || []).length; %>
      <tr class="click" data-href="/admin/purchasing/<%= p.id %>">
        <td><a href="/admin/purchasing/<%= p.id %>"><strong><%= p.ref %></strong></a><div class="muted small"><%= p.title ? p.title + ' · ' : '' %><%= n %> line<%= n === 1 ? '' : 's' %> · <%= fmt.date(p.created_at) %></div></td>
        <td><strong class="plain"><%= p.suppliers?.name || '—' %></strong><div class="muted small"><%= p.sent_to || '' %></div></td>
        <td><% if (p.orders) { %><a href="/admin/orders/<%= p.orders.id %>"><%= p.orders.order_no %></a><div class="muted small"><%= p.orders.organizations?.name || '' %></div><% } else { %><span class="tag warn">Not linked</span><% } %></td>
        <td class="right num"><strong><%= fmt.money(p.total, p.currency) %></strong></td>
        <td><span class="pill spo-<%= p.status %>"><%= labels[p.status] %></span></td>
        <td class="small"><%= p.sent_at ? 'Sent ' + fmt.date(p.sent_at) : 'Not sent' %><% if (p.last_reply_at) { %><div class="muted">Reply <%= fmt.date(p.last_reply_at) %></div><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <script>
  (function () {
    const rows = [...document.querySelectorAll('#poTable tbody tr')], q = document.getElementById('poSearch');
    q.addEventListener('input', () => { const t = q.value.trim().toLowerCase(); rows.forEach(r => { r.hidden = t && !r.textContent.toLowerCase().includes(t); }); });
    rows.forEach(r => r.addEventListener('click', e => { if (!e.target.closest('a,button,input,select')) location.href = r.dataset.href; }));
  })();
  </script>
  <% } %>
</div>
<%- include('../../partials/foot') %>
