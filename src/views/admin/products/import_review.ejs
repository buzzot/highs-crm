<%- include('../../partials/head') %>
<%
  const done = imp.status !== 'review';
  const sup = imp.supplier || {};
  const ms = imp.supplier_match?.status || 'new';
  const errRows = rows.filter(r => r.checks.some(c => c.level === 'error')).length;
  const flagged = rows.filter(r => r.checks.length || (r.ai_issues || []).length).length;
  const methodLabel = { ai: 'Read by AI', template: 'Lumi Trade template', spreadsheet: 'Column matching' }[imp.method] || imp.method;
  const v = x => (x == null ? '' : x);
%>
<div class="pagehead">
  <div><a class="back" href="/admin/products/import">← Imports</a>
    <h1>Review import · <%= imp.file_name %></h1>
    <p class="muted"><span class="tag"><%= methodLabel %></span> <%= rows.length %> product<%= rows.length === 1 ? '' : 's' %> found · uploaded <%= fmt.datetime(imp.created_at) %></p></div>
  <span class="pill lg <%= imp.status === 'committed' ? 'accepted' : imp.status === 'cancelled' ? 'cancelled' : 'reviewing' %>"><%= imp.status === 'review' ? 'Awaiting confirmation' : imp.status %></span>
</div>

<% if (imp.status === 'committed' && imp.result) { %>
  <div class="alert ok">Imported <%= fmt.datetime(imp.committed_at) %>: <%= imp.result.created %> new, <%= imp.result.updated %> updated, <%= imp.result.skipped %> skipped, <%= imp.result.photos %> photos. <a href="/admin/suppliers/<%= imp.result.supplier_id %>">Open supplier →</a></div>
<% } %>
<% if (imp.ai_notes) { %><div class="alert warn pre small"><%= imp.ai_notes %></div><% } %>

<form method="post" action="/admin/products/import/<%= imp.id %>" id="reviewForm">
<fieldset <%= done ? 'disabled' : '' %>>

<!-- ============ 1. supplier ============ -->
<div class="card">
  <h2><span class="stepno">1</span> Supplier</h2>
  <%
    const isNew = decision === 'new', isEx = !!decision && decision !== 'new';
    const exSup = isEx ? (suppliers.find(x => x.id === decision) || {}) : {};
  %>
  <div class="supgrid" id="supGrid">
    <div class="leftwrap <%= isEx && !sup._update_contacts ? 'inactive' : '' %>" id="supLeft">
      <p class="muted small supfrom">From the file — correct anything that was read wrongly.</p>
      <div class="supnote" id="supNote"><span id="supNoteText"></span></div>
      <fieldset class="supfields" id="supFields" <%= isEx && !sup._update_contacts ? 'disabled' : '' %>>
        <div class="row">
          <label class="grow2">Company name <input name="supplier[name]" value="<%= v(sup.name) %>" required></label>
        </div>
        <label>Address <input name="supplier[address]" value="<%= v(sup.address) %>"></label>
        <div class="row">
          <label>Contact person <input name="supplier[contact_name]" value="<%= v(sup.contact_name) %>"></label>
          <label>Email <input name="supplier[email]" value="<%= v(sup.email) %>"></label>
        </div>
        <div class="row">
          <label>Phone <input name="supplier[phone]" value="<%= v(sup.phone) %>"></label>
          <label>WeChat <input name="supplier[wechat]" value="<%= v(sup.wechat) %>"></label>
          <label>Website <input name="supplier[website]" value="<%= v(sup.website) %>"></label>
        </div>
      </fieldset>
    </div>

    <div class="modes">
      <div class="mode <%= isNew ? 'on' : '' %>" id="modeNew">
        <label class="mh"><input type="radio" name="supplier_mode" value="new" <%= isNew ? 'checked' : '' %> required><span>＋ New supplier</span></label>
        <div class="mb">
          <% if (candidates.length && ms !== 'match') { %>
            <p class="small warnline">⚠ <strong>Possible duplicate:</strong> the details look like <%= candidates.map(c => c.name).join(', ') %>. Pick it under “Assign to an existing supplier” — or confirm it is a different company.</p>
            <label class="check small confirmnew"><input type="checkbox" name="confirm_new" <%= sup._confirm_new ? 'checked' : '' %>> I checked — this is really a different company</label>
          <% } else if (ms === 'match') { %>
            <p class="small">This file looks like a supplier you already have — see the option below. Choose “New supplier” only if it is a different company.</p>
          <% } else { %>
            <p class="small">No similar supplier found (checked names, email, phone, WeChat). A new supplier will be created from the details on the left.</p>
          <% } %>
        </div>
      </div>

      <div class="mode <%= isEx ? 'on' : '' %>" id="modeEx">
        <label class="mh"><input type="radio" name="supplier_mode" value="existing" <%= isEx ? 'checked' : '' %> required><span>Assign to an existing supplier</span></label>
        <div class="mb">
          <select name="supplier_existing" id="supExisting" data-picker="Supplier">
            <option value="">Choose supplier…</option>
            <% suppliers.forEach(x => { %><option value="<%= x.id %>" <%= decision === x.id ? 'selected' : '' %>><%= x.name %></option><% }) %>
          </select>
          <% if (candidates.length) { %>
            <div class="sugg"><span class="muted small">Suggested:</span>
              <% candidates.forEach(c => { %><button type="button" class="chip <%= c.strong ? 'ok' : 'warn' %>" data-pick="<%= c.id %>" title="<%= c.reasons.join(', ') %>"><%= c.name %><% if (c.reasons.length) { %> <i>· <%= c.reasons[0] %></i><% } %></button><% }) %>
            </div>
          <% } %>
          <label class="check small updlabel"><input type="checkbox" name="update_contacts" id="supUpdate" <%= sup._update_contacts ? 'checked' : '' %>> <span>Update this supplier's contact details with the ones from the file <span class="muted">(otherwise only its empty fields are filled)</span></span></label>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 2. products ============ -->
<div class="card">
  <h2><span class="stepno">2</span> Products
    <span class="count"><%= rows.length %></span>
    <% if (flagged) { %><span class="badge warn"><%= flagged %> to check</span><% } %>
    <% if (errRows) { %><span class="badge bad"><%= errRows %> with errors</span><% } %>
    <span class="more small"><label class="check"><input type="checkbox" id="onlyFlagged"> show only rows to check</label></span>
  </h2>
  <p class="muted small">Weights in kg, sizes in cm (L × W × H). Edit any cell. Untick a row to leave it out. "Update" overwrites the existing product with the values here.</p>
  <div class="tblwrap">
  <table class="tbl imp">
    <thead><tr>
      <th><input type="checkbox" id="checkAll" checked title="Select all"></th>
      <th>Photo</th><th>Product</th><th>HS code</th><th>Unit kg · L×W×H cm</th><th>Carton pcs · kg · L×W×H cm</th><th>Price</th><th>MOQ</th><th>In catalogue</th>
    </tr></thead>
    <tbody>
    <% rows.forEach(p => {
         const i = p.i;
         const issues = [...p.checks.map(c => ({ sev: c.level === 'error' ? 'high' : 'medium', field: c.field, message: c.message, src: 'check' })),
                         ...(p.ai_issues || []).map(a => ({ sev: a.severity, field: a.field, message: a.message, suggestion: a.suggestion, src: 'AI' }))];
         const hasErr = p.checks.some(c => c.level === 'error');
         const badField = f => issues.some(x => x.field === f) ? 'flag' : '';
         const n = (f, step, w) => `<input class="${badField(f)}" name="rows[${i}][${f}]" value="${v(p[f])}" inputmode="decimal" style="width:${w || 56}px">`;
    %>
      <tr class="main <%= hasErr ? 'err' : issues.length ? 'warnrow' : '' %>" data-flag="<%= issues.length ? 1 : 0 %>">
        <td><input type="checkbox" class="inc" name="rows[<%= i %>][include]" <%= p.include !== false ? 'checked' : '' %>></td>
        <td class="phcell"><div class="phz" data-ph data-n="<%= i %>" data-count="<%= p.photos || 0 %>" tabindex="0" role="button" aria-label="Product photo: click to choose, or drop or paste a picture"><% if (p.photos) { %><img class="phimg" src="/admin/products/import/<%= imp.id %>/image/<%= i %>" alt=""><% } else { %><span class="phempty"><%- icon('plus') %></span><% } %></div></td>
        <td class="pcell">
          <input class="pname <%= badField('name') %>" name="rows[<%= i %>][name]" value="<%= v(p.name) %>" placeholder="Product name">
          <div class="sub2">
            <input name="rows[<%= i %>][supplier_sku]" value="<%= v(p.supplier_sku) %>" placeholder="Supplier SKU" style="width:120px">
            <input name="rows[<%= i %>][category]" value="<%= v(p.category) %>" placeholder="Category" style="width:120px">
          </div>
          <input class="notes" name="rows[<%= i %>][notes]" value="<%= v(p.notes) %>" placeholder="Notes">
          <span class="muted small">#<%= i + 1 %><%= p.source_row ? ' · row ' + p.source_row : '' %><%= p.page ? ' · page ' + p.page : '' %></span>
        </td>
        <td><input class="<%= badField('hs_code') %>" name="rows[<%= i %>][hs_code]" value="<%= v(p.hs_code) %>" style="width:96px"></td>
        <td class="nums">
          <div><%- n('unit_weight_kg', 0, 64) %> kg</div>
          <div><%- n('unit_length_cm') %>×<%- n('unit_width_cm') %>×<%- n('unit_height_cm') %></div>
        </td>
        <td class="nums">
          <div><%- n('carton_qty', 0, 56) %> pcs · <%- n('carton_weight_kg', 0, 60) %> kg</div>
          <div><%- n('carton_length_cm') %>×<%- n('carton_width_cm') %>×<%- n('carton_height_cm') %></div>
          <% if (p.cbm) { %><div class="muted small"><%= fmt.num(p.cbm, 4) %> cbm<%= p.carton_qty ? ' · ' + fmt.num(p.cbm / p.carton_qty * 1e6, 0) + ' cm³/pc' : '' %></div><% } %>
        </td>
        <td class="nums">
          <div><%- n('unit_price', 0, 70) %></div>
          <select name="rows[<%= i %>][currency]"><% currencies.forEach(c => { %><option <%= p.currency === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
        </td>
        <td><%- n('moq', 0, 64) %></td>
        <td class="incat">
          <% if (p.match.status !== 'none') { %>
            <input type="hidden" name="rows[<%= i %>][match_id]" value="<%= p.match.product.id %>">
            <input type="hidden" name="rows[<%= i %>][match_supplier_id]" value="<%= p.match.supplier_id %>">
            <span class="badge <%= p.match.status === 'sku' ? 'info' : 'warn' %>"><%= p.match.status === 'sku' ? 'Same SKU exists' : 'Possible duplicate' %></span>
            <div class="small"><a href="/admin/products/<%= p.match.product.id %>" target="_blank"><%= p.match.product.name %></a>
              <% if (p.match.product.unit_cost != null) { %><span class="muted">· now <%= fmt.money(p.match.product.unit_cost, p.match.product.cost_currency || 'CNY') %></span><% } %><% if (p.unit_price != null && p.unit_price !== '') { %><span class="muted"> · file <%= fmt.money(p.unit_price, p.currency || 'CNY') %></span><% } %></div>
            <select name="rows[<%= i %>][action]">
              <option value="skip" <%= (p.action || 'skip') === 'skip' ? 'selected' : '' %>>Keep existing (skip)</option>
              <option value="update" <%= p.action === 'update' ? 'selected' : '' %>>Update existing with file values</option>
              <option value="new" <%= p.action === 'new' ? 'selected' : '' %>>Add as new product</option>
            </select>
          <% } else { %>
            <span class="badge ok">New</span>
            <input type="hidden" name="rows[<%= i %>][action]" value="new">
          <% } %>
        </td>
      </tr>
      <% if (issues.length) { %>
      <tr class="issues-row <%= hasErr ? 'err' : 'warnrow' %>" data-flag="1"><td></td><td colspan="8">
        <ul class="rowissues">
          <% issues.forEach(x => { %><li class="<%= x.sev %>"><span class="src"><%= x.src %></span> <%= x.message %><% if (x.suggestion) { %> <button type="button" class="link small apply" data-target="rows[<%= i %>][<%= x.field %>]" data-value="<%= x.suggestion %>">use “<%= x.suggestion %>”</button><% } %></li><% }) %>
        </ul>
      </td></tr>
      <% } %>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<% if (!done) { %>
<div class="importbar">
  <span class="small"><strong id="selCount"><%= rows.filter(r => r.include !== false).length %></strong> of <%= rows.length %> products selected</span>
  <span class="grow"></span>
  <button class="btn" name="action" value="cancel" formnovalidate onclick="return confirm('Cancel this import? Nothing will be saved.')">Cancel import</button>
  <button class="btn" name="action" value="save" formnovalidate>Save changes</button>
  <button class="btn primary" name="action" value="commit">Confirm & import</button>
</div>
<% } %>
</fieldset>
</form>
<script>
  // product photos: the frame shows the first photo (read from the file or added here); click, drop or paste to add more
  (function () {
    const IMP = <%- JSON.stringify(imp.id) %>, zones = [...document.querySelectorAll('[data-ph]')]; if (!zones.length) return;
    const input = Object.assign(document.createElement('input'), { type: 'file', accept: 'image/jpeg,image/png,image/webp,image/gif', multiple: true, hidden: true });
    document.body.appendChild(input);
    let target = null, hover = null;
    const url = (z, k) => `/admin/products/import/${IMP}/image/${z.dataset.n}?k=${k}&v=${z.dataset.v || 0}`;
    const el = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt) e.textContent = txt; return e; };
    function render(z) {
      const n = Number(z.dataset.count), cell = z.parentElement;
      z.querySelectorAll('.phimg, .phempty, .phx, .phbadge').forEach(x => x.remove());
      if (n) {
        const img = el('img', 'phimg'); img.alt = ''; img.src = url(z, 0); z.appendChild(img);
        z.appendChild(rm(z, 0));
        if (n > 1) z.appendChild(el('span', 'phbadge', n + ' photos'));
      } else { const e = el('span', 'phempty'); e.innerHTML = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>'; z.appendChild(e); }
      z.title = n ? 'Click, drop or paste a picture to add another photo' : 'No photo — click, drop or paste a picture';
      cell.querySelectorAll('.phmore').forEach(x => x.remove());
      if (n > 1) {
        const more = el('div', 'phmore');
        for (let k = 1; k < n; k++) { const t = el('span', 'phthumb'); const im = el('img'); im.alt = ''; im.src = url(z, k); t.appendChild(im); t.appendChild(rm(z, k)); more.appendChild(t); }
        cell.appendChild(more);
      }
    }
    function rm(z, k) {
      const b = el('button', 'phx', '×'); b.type = 'button'; b.setAttribute('aria-label', 'Remove this photo');
      b.addEventListener('click', async e => {
        e.stopPropagation(); e.preventDefault();
        const r = await fetch(`/admin/products/import/${IMP}/photo/${z.dataset.n}/remove`, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ k }) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) return say(z, j.error || 'Could not remove the photo.');
        z.dataset.count = j.count; z.dataset.v = Date.now(); render(z);
      });
      return b;
    }
    function say(z, msg) {
      const cell = z.parentElement; cell.querySelectorAll('.pherr').forEach(x => x.remove());
      if (!msg) return; const e = el('div', 'pherr', msg); cell.appendChild(e); setTimeout(() => e.remove(), 6000);
    }
    async function send(z, files) {
      const list = [...files].filter(f => /^image\//.test(f.type));
      if (!list.length) return say(z, 'Only pictures can be added here (JPG, PNG, WebP or GIF).');
      const fd = new FormData(); list.forEach(f => fd.append('files', f, f.name || 'pasted.png'));
      z.classList.add('busy'); say(z, '');
      try {
        const r = await fetch(`/admin/products/import/${IMP}/photo/${z.dataset.n}`, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.error || 'Could not add the photo.');
        z.dataset.count = j.count; z.dataset.v = Date.now(); render(z);
        if (j.skipped && j.skipped.length) say(z, j.skipped[0]);
      } catch (e) { say(z, e.message); } finally { z.classList.remove('busy'); }
    }
    zones.forEach(z => {
      render(z);
      z.addEventListener('click', e => { if (e.target.closest('.phx')) return; target = z; input.value = ''; input.click(); });
      z.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); target = z; input.click(); } });
      z.addEventListener('mouseenter', () => { hover = z; });
      z.addEventListener('mouseleave', () => { if (hover === z) hover = null; });
      ['dragenter', 'dragover'].forEach(t => z.addEventListener(t, e => { e.preventDefault(); z.classList.add('over'); }));
      ['dragleave', 'drop'].forEach(t => z.addEventListener(t, () => z.classList.remove('over')));
      z.addEventListener('drop', e => { e.preventDefault(); send(z, e.dataTransfer.files); });
    });
    input.addEventListener('change', () => { if (target && input.files.length) send(target, input.files); });
    // paste a screenshot or copied picture: it goes to the frame under the mouse (or the one you clicked last), never while typing text
    document.addEventListener('paste', e => {
      const files = [...(e.clipboardData?.files || [])].filter(f => /^image\//.test(f.type)); if (!files.length) return;
      if (e.target.closest && e.target.closest('input, textarea') && e.clipboardData.getData('text/plain')) return;
      const z = hover || (document.activeElement && document.activeElement.closest && document.activeElement.closest('[data-ph]')) || target;
      if (!z) return; e.preventDefault(); send(z, files);
    });
  })();
  // supplier: new vs existing — the details from the file are locked while an existing supplier is used (unless you update it from the file)
  (function () {
    const rEx = document.querySelector('input[name=supplier_mode][value=existing]'), rNew = document.querySelector('input[name=supplier_mode][value=new]');
    if (!rEx || !rNew) return;
    const sel = document.getElementById('supExisting'), upd = document.getElementById('supUpdate'), fs = document.getElementById('supFields'), left = document.getElementById('supLeft'), note = document.getElementById('supNoteText');
    const sync = () => {
      const ex = rEx.checked, lock = ex && !upd.checked;
      document.getElementById('modeEx').classList.toggle('on', ex); document.getElementById('modeNew').classList.toggle('on', rNew.checked);
      fs.disabled = lock; left.classList.toggle('inactive', lock);
      const name = sel.selectedOptions[0] && sel.value ? sel.selectedOptions[0].text : '';
      note.innerHTML = '';
      if (ex) { const t = document.createElement('span'); t.append(name ? 'Products go to the existing supplier ' : 'Choose the existing supplier on the right.'); if (name) { const b = document.createElement('strong'); b.textContent = name; t.append(b, ' — the details below only fill its empty fields.'); } note.appendChild(t); }
      sel.required = ex;
    };
    rEx.addEventListener('change', sync); rNew.addEventListener('change', sync); upd.addEventListener('change', sync);
    sel.addEventListener('change', () => { if (sel.value) rEx.checked = true; sync(); });
    document.getElementById('modeEx').addEventListener('click', e => { if (!rEx.checked && !e.target.closest('a')) { rEx.checked = true; sync(); } });
    document.getElementById('modeNew').addEventListener('click', e => { if (!rNew.checked && !e.target.closest('a,input,label')) { rNew.checked = true; sync(); } });
    document.querySelectorAll('[data-pick]').forEach(b => b.addEventListener('click', () => { sel.value = b.dataset.pick; rEx.checked = true; sel.dispatchEvent(new Event('change', { bubbles: true })); }));
    sync();
  })();
  (function () {
    const f = document.getElementById('reviewForm'); if (!f) return;
    const incs = [...f.querySelectorAll('input.inc')];
    const count = () => { const c = document.getElementById('selCount'); if (c) c.textContent = incs.filter(x => x.checked).length; };
    incs.forEach(x => x.addEventListener('change', () => { x.closest('tr').classList.toggle('off', !x.checked); count(); }));
    incs.forEach(x => x.closest('tr').classList.toggle('off', !x.checked));
    const all = document.getElementById('checkAll');
    all && all.addEventListener('change', () => { incs.forEach(x => { x.checked = all.checked; x.dispatchEvent(new Event('change')); }); });
    const only = document.getElementById('onlyFlagged');
    only && only.addEventListener('change', () => f.querySelectorAll('tbody tr').forEach(tr => { tr.hidden = only.checked && tr.dataset.flag !== '1'; }));
    f.querySelectorAll('button.apply').forEach(b => b.addEventListener('click', () => {
      const el = f.querySelector(`[name="${b.dataset.target}"]`); if (el) { el.value = b.dataset.value; el.classList.remove('flag'); el.classList.add('fixed'); b.disabled = true; }
    }));
  })();
</script>
<%- include('../../partials/foot') %>
