<%- include('../../partials/head') %>
<div class="pagehead"><div><a class="back" href="/admin/products">← Products</a><h1>Supplier products</h1>
  <p class="muted">Products your suppliers filled in themselves. Nothing here appears in quotes or orders until you approve it.</p></div></div>
<div class="tabs">
  <% tabs.forEach(t => { %><a href="/admin/products/submissions?status=<%= t[0] %>" class="<%= status === t[0] ? 'on' : '' %>"><%= t[1] %> <span><%= counts[t[0]] || 0 %></span></a><% }) %>
</div>
<div class="card">
  <% if (!rows.length) { %><p class="muted">Nothing here.</p><% } else { %>
  <table class="tbl">
    <thead><tr><th>Product</th><th>Supplier</th><th class="right">Price</th><th>MOQ</th><th>Complete?</th><% if (status === 'all') { %><th>Status</th><% } %><th><%= ['submitted', 'edit_requested'].includes(status) ? 'Requested' : 'Updated' %></th></tr></thead>
    <tbody>
    <% rows.forEach(x => { const d = x.data || {}; const m = miss(x); %>
      <tr>
        <td><a href="/admin/products/submissions/<%= x.id %>"><strong><%= d.name || '(no name)' %></strong></a><div class="muted small"><%= [d.sku, d.category].filter(Boolean).join(' · ') %></div></td>
        <td><%= x.suppliers?.name || '—' %></td>
        <td class="right"><%= d.unit_price > 0 ? fmt.money(d.unit_price, d.currency || 'USD', 2) : '—' %></td>
        <td><%= d.moq ?? '—' %></td>
        <td><% if (!m.length) { %><span class="ok">Complete</span><% } else { %><span class="muted small">Missing <%= m.length %></span><% } %></td>
        <% if (status === 'all') { %><td><span class="pill <%= ({ submitted: 'quoted', edit_requested: 'reviewing', updated: 'quoted', unlocked: 'new', returned: 'declined', draft: 'draft', approved: 'delivered' })[x.status] %>"><%= labels[x.status] || x.status %></span></td><% } %>
        <td class="small muted"><%= fmt.date(['submitted', 'edit_requested'].includes(status) ? (x.submitted_at || x.updated_at) : x.updated_at) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../../partials/foot') %>
