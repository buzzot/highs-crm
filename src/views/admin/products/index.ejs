<%- include('../../partials/head') %>
<%
  const V = typeof view !== 'undefined' ? view : 'catalog', costing = V === 'costing';
  const cnt = typeof photoCount !== 'undefined' ? photoCount : {};
  const nMatch = typeof matched !== 'undefined' ? matched : products.length, pg = typeof page !== 'undefined' ? page : 1, pgs = typeof pages !== 'undefined' ? pages : 1, size = typeof pageSize !== 'undefined' ? pageSize : 100;
  const mayDelete = typeof canDelete !== 'undefined' ? canDelete : (user && (user.role === 'admin' || (user.role === 'staff' && user.staff_level !== 'manager')));
  const fxs = typeof fxList !== 'undefined' ? fxList : [];
  const nFilters = (query.category ? 1 : 0) + (query.supplier ? 1 : 0) + (query.issues ? 1 : 0), filtered = !!(query.q || nFilters);
  // every link keeps the current search, filters, view and sort
  const link = o => { const p = new URLSearchParams(Object.entries({ q: query.q, category: query.category, supplier: query.supplier, issues: query.issues, view: V === 'costing' ? 'costing' : '', sort: sort === 'name' ? '' : sort, ...o }).filter(e => e[1])); const x = p.toString(); return '/admin/products' + (x ? '?' + x : ''); };
  const exportUrl = '/admin/products/export.csv?' + new URLSearchParams(Object.fromEntries(['q', 'category', 'supplier', 'sort', 'issues'].filter(k => query[k]).map(k => [k, query[k]]))).toString();
  // sortable headers: first click ascending, second descending
  const PAIRS = { name: ['name', 'name_desc'], supplier: ['supplier', 'supplier_desc'], price: ['price', 'price_desc'], landed: ['landed', 'landed_desc'], wholesale: ['wholesale', 'wholesale_desc'], moq: ['moq', 'moq_desc'], units: ['per40_asc', 'per40'] };
  const th = (col, label, cls, tip, dc) => {
    const [asc, desc] = PAIRS[col] || [col, col]; const on = sort === asc || sort === desc, isAsc = sort === asc; const next = on && isAsc ? desc : asc;
    return `<th class="${cls || ''}" data-c="${dc || col}" aria-sort="${on ? (isAsc ? 'ascending' : 'descending') : 'none'}"><a class="sortlnk${on ? ' on' : ''}" href="${link({ sort: next === 'name' ? '' : next })}"${tip ? ' title="' + tip + '"' : ''}>${label}<i aria-hidden="true">${on ? (isAsc ? '▲' : '▼') : ''}</i></a></th>`;
  };
  const u = (v, cur) => v == null ? '—' : fmt.money(v, cur || 'USD', 3);   // unit amounts: 2 decimals, a third only where it matters ($0.142)
  const COLS = costing
    ? { sup: ['Supplier', false], cat: ['Category', false], freight: ['Freight / unit', true], moq: ['MOQ', true], units: ['Units / 40HQ', true], hs: ['HS code', true] }
    : { cat: ['Category', true], sup: ['Supplier', true], moq: ['MOQ', true], hs: ['HS code', false], units: ['Units / 40HQ', false], pcs: ['Pcs / carton', false] };
  const hidden = Object.entries(COLS).filter(e => !e[1][1]).map(e => 'h-' + e[0]).join(' ');
  const assump = container, margin = Math.round(assump.wholesale_markup_pct / (100 + Number(assump.wholesale_markup_pct)) * 1000) / 10;
  const here = link({ page: pg > 1 ? pg : '' });
  const EDIT = (p, f) => '/admin/products/' + p.id + '/edit' + (f ? '#f=' + f : '');
%>
<% if (typeof pendingSubs !== 'undefined' && pendingSubs > 0) { %><div class="alert warn"><strong><%= pendingSubs %></strong> product<%= pendingSubs === 1 ? '' : 's' %> from suppliers waiting for your review. <a href="/admin/products/submissions">Review →</a></div><% } %>
<div class="pagehead cl-head">
  <div><h1>Products <span class="cl-count" title="Products in the catalogue"><%= total %></span></h1></div>
  <div class="actions">
    <a class="btn" href="<%= exportUrl %>" title="Downloads the products that match the current search and filters">⇩ Export CSV</a>
    <a class="btn" href="/admin/products/import">⇪ Import from Excel / PDF</a>
    <a class="btn primary" href="/admin/products/new">+ New product</a>
  </div>
</div>

<nav class="sp-views pd-views" aria-label="Product views">
  <a href="<%= link({ view: '' }) %>" class="<%= costing ? '' : 'on' %>"<%= costing ? '' : ' aria-current="page"' %> title="Find and manage products">Catalog</a>
  <a href="<%= link({ view: 'costing' }) %>" class="<%= costing ? 'on' : '' %>"<%= costing ? ' aria-current="page"' : '' %> title="Compare supplier cost, freight and suggested wholesale">Costing</a>
</nav>

<div class="card cl-card pd-card">
  <form class="cl-bar" method="get" action="/admin/products" role="search" id="pdBar">
    <input type="search" name="q" id="pdq" value="<%= query.q || '' %>" placeholder="Search name, SKU, HS code, supplier…" aria-label="Search products" autocomplete="off">
    <% if (costing) { %><input type="hidden" name="view" value="costing"><% } %>
    <details class="sp-pop sp-filters"><summary class="btn<%= nFilters ? ' active' : '' %>" aria-label="Filters<%= nFilters ? ', ' + nFilters + ' applied' : '' %>">Filters<% if (nFilters) { %><span class="sp-badge"><%= nFilters %></span><% } %></summary>
      <div class="menu" role="group" aria-label="Filters">
        <label>Category<select name="category" onchange="this.form.submit()"><option value="">All categories</option><% categories.forEach(c => { %><option <%= query.category === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
        <label>Supplier<select name="supplier" onchange="this.form.submit()"><option value="">All suppliers</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= query.supplier === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
        <label>Data<select name="issues" onchange="this.form.submit()"><option value="">Any</option><option value="critical" <%= query.issues === 'critical' ? 'selected' : '' %>>Missing critical data</option><option value="1" <%= query.issues === '1' ? 'selected' : '' %>>Any missing data</option></select></label>
        <label>Sort by<select name="sort" onchange="this.form.submit()"><% Object.entries(sorts).forEach(([k, l]) => { %><option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
      </div>
    </details>
    <details class="sp-pop sp-cols" id="pdCols"><summary class="btn" title="Show or hide optional columns">Columns</summary>
      <div class="menu"><% Object.entries(COLS).forEach(([k, [l, on]]) => { %><label class="chk"><input type="checkbox" data-col="<%= k %>" <%= on ? 'checked' : '' %>> <%= l %></label><% }) %></div>
    </details>
    <details class="sp-pop sp-assume"><summary class="btn" title="How landed cost and the suggested wholesale price are estimated">Pricing basis</summary>
      <div class="menu pd-assume" role="group" aria-label="Pricing basis">
        <p><b>Estimates, not quotations.</b> Nothing here is a confirmed cost.</p>
        <dl>
          <dt>Landed cost</dt><dd>Factory price in USD + 40HQ freight ÷ units that fit in one container.</dd>
          <dt>Freight</dt><dd>$<%= Number(assump.freight_40hq_usd).toLocaleString('en-US') %> per 40HQ · usable <%= assump.container_cbm %> cbm / <%= Number(assump.container_max_kg).toLocaleString('en-US') %> kg.</dd>
          <dt>Suggested wholesale</dt><dd>Landed cost × (1 + <%= assump.wholesale_markup_pct %>%). That is a <b><%= assump.wholesale_markup_pct %>% markup</b> on cost, which is a gross margin of <b><%= margin %>%</b> on the wholesale price.</dd>
          <dt>Exchange rates</dt><dd><% if (!fxs.length) { %>All prices in view are in USD.<% } else { %><% fxs.forEach(([c, r], i) => { %><%= i ? ' · ' : '' %><%= c %> → USD <%= r ? r : 'no rate set' %><% }) %><% } %></dd>
          <dt>Missing data</dt><dd>No landed cost is shown without a price, pieces per carton and a carton size. Without a carton weight the load is counted by volume only, shown as “≈”.</dd>
        </dl>
        <% if (user.role === 'admin') { %><a class="small" href="/admin/pricing">Change freight, markup and rates →</a><% } %>
      </div>
    </details>
    <noscript><button class="btn" type="submit">Search</button></noscript>
    <% if (filtered || (sort !== 'name')) { %><a class="cl-clear" href="<%= link({ q: '', category: '', supplier: '', issues: '', sort: '' }) %>">Clear filters</a><% } %>
  </form>

  <form method="get" action="/admin/products/compare" id="cmpForm">
    <div class="pd-sel" id="pdSel" hidden role="toolbar" aria-label="Actions for the selected products">
      <span class="pd-selcount"><strong id="selCount">0</strong> selected</span>
      <button class="btn small" name="go" value="1" id="btnCompare" disabled title="Select 2 to 6 products to compare them side by side">Compare</button>
      <button class="btn small ai" name="ai" value="1" id="btnAi" disabled title="Select 2 to 6 products — the AI ranks them for you">✦ AI compare</button>
      <button class="btn small primary" id="btnQuote" formaction="/admin/pricing/quotes/multi" disabled>Create quote</button>
      <% if (mayDelete) { %><button type="button" class="btn small danger-outline" id="btnDelete">Delete…</button><% } %>
      <button type="button" class="link small" id="selClear">Clear selection</button>
      <span class="muted small" id="selHint"></span>
    </div>

    <% if (!total) { %>
      <p class="cl-empty"><strong>No products yet.</strong><br><span class="muted">Add a product by hand, or import a supplier’s price list.</span><br><a class="btn primary small" href="/admin/products/new">+ New product</a> <a class="btn small" href="/admin/products/import">Import</a></p>
    <% } else if (!products.length) { %>
      <p class="cl-empty"><strong>No products match.</strong><br><span class="muted">Try a different spelling, or</span> <a href="<%= link({ q: '', category: '', supplier: '', issues: '', sort: '' }) %>">clear filters</a>.</p>
    <% } else { %>
    <div class="tblwrap"><table class="cl-tbl pd-tbl <%= costing ? 'pd-costing' : 'pd-catalog' %> <%= hidden %>" id="pdTbl">
      <thead><tr>
        <th class="c-sel"><input type="checkbox" id="selAll" aria-label="Select all products on this page"></th>
        <%- th('name', 'Product', 'c-prod') %>
        <% if (!costing) { %>
          <%- th('category', 'Category', 'c-cat', '', 'cat') %>
          <%- th('supplier', 'Supplier', 'c-sup', '', 'sup') %>
          <%- th('price', 'Factory price', 'r c-price', 'Price per unit in the currency the supplier quoted, with its USD equivalent') %>
          <%- th('moq', 'MOQ', 'r c-moq', 'Minimum order quantity') %>
          <th class="r c-hs" data-c="hs">HS code</th><th class="r c-units" data-c="units" title="Units that fit in one 40HQ container">Units / 40HQ</th><th class="r c-pcs" data-c="pcs">Pcs / carton</th>
        <% } else { %>
          <th class="c-cat" data-c="cat">Category</th><th class="c-sup" data-c="sup">Supplier</th>
          <%- th('price', 'Factory cost', 'r c-price', 'Price per unit as quoted by the supplier, with the USD equivalent used for costing') %>
          <th class="r c-freight" data-c="freight" title="40HQ freight ÷ units per container">Freight / unit</th>
          <%- th('landed', 'Est. landed', 'r c-landed', 'Estimate: factory price in USD + freight per unit. Not a confirmed cost.') %>
          <%- th('wholesale', 'Sugg. wholesale', 'r c-whole', 'Estimate: landed cost + ' + assump.wholesale_markup_pct + '% markup (a ' + margin + '% gross margin on the wholesale price)') %>
          <%- th('moq', 'MOQ', 'r c-moq') %>
          <%- th('units', 'Units / 40HQ', 'r c-units', 'Units that fit in one 40HQ container, by volume and weight') %>
          <th class="r c-hs" data-c="hs">HS code</th>
        <% } %>
        <th class="c-data" title="Missing information — click a badge to see what and fix it">Data</th>
      </tr></thead>
      <tbody>
      <% products.forEach(p => { const m = p.m, cur = p.cost_currency || 'CNY'; %>
        <tr>
          <td class="c-sel"><input type="checkbox" name="ids" value="<%= p.id %>" class="sel" aria-label="Select <%= p.name %>"></td>
          <td class="c-prod c-name">
            <a class="pd-id" href="/admin/products/<%= p.id %>" aria-label="Open <%= p.name %>">
              <% if (thumb[p.id]) { %><img class="pd-img" loading="lazy" src="/admin/documents/<%= thumb[p.id] %>/download" alt=""><% } else { %><span class="pd-img none" aria-hidden="true"></span><% } %>
              <span class="pd-txt"><strong class="nm"><%= p.name %></strong>
              <span class="cl-sub"><%= [m.kind && !m.physical ? m.kind : '', p.supplier_sku, p.sku && p.sku !== p.supplier_sku ? 'SKU ' + p.sku : ''].filter(Boolean).join(' · ') || 'No SKU' %><span class="pd-mob"><%= p.suppliers ? ' · ' + p.suppliers.name : '' %></span></span></span>
            </a><span class="tip" role="tooltip"><%= p.name %></span>
          </td>
          <% const priceCell = () => { %>
            <td class="r c-price num"><%= p.unit_cost != null ? u(p.unit_cost, cur) : '—' %>
              <div class="cl-sub"><%= cur %><% if (cur !== 'USD' && p.unit_cost != null) { %> · <% if (m.priceUsd != null) { %><span title="Converted at 1 <%= cur %> = <%= m.fxRate %> USD">≈ <%= u(m.priceUsd) %></span><% } else { %><span class="warntext" title="No exchange rate to USD is set for <%= cur %>">no rate</span><% } %><% } %></div></td>
          <% }; %>
          <% if (!costing) { %>
            <td class="c-cat" data-c="cat"><span class="clip" title="<%= p.category || '' %>"><%= p.category || '—' %></span></td>
            <td class="c-sup" data-c="sup"><% if (p.suppliers) { %><a class="clip" href="/admin/suppliers/<%= p.suppliers.id %>" title="<%= p.suppliers.name %>"><%= p.suppliers.name %></a><% } else { %><span class="muted">No supplier</span><% } %></td>
            <% priceCell(); %>
            <td class="r c-moq num" data-c="moq"><%= p.moq != null ? Number(p.moq).toLocaleString('en-US') : '—' %></td>
            <td class="r c-hs num" data-c="hs"><%= p.hs_code || '—' %></td>
            <td class="r c-units num" data-c="units"><%= m.unitsPer40hq != null ? m.unitsPer40hq.toLocaleString('en-US') : '—' %></td>
            <td class="r c-pcs num" data-c="pcs"><%= p.carton_qty != null ? Number(p.carton_qty).toLocaleString('en-US') : '—' %></td>
          <% } else { %>
            <td class="c-cat" data-c="cat"><span class="clip" title="<%= p.category || '' %>"><%= p.category || '—' %></span></td>
            <td class="c-sup" data-c="sup"><% if (p.suppliers) { %><a class="clip" href="/admin/suppliers/<%= p.suppliers.id %>" title="<%= p.suppliers.name %>"><%= p.suppliers.name %></a><% } else { %><span class="muted">No supplier</span><% } %></td>
            <% priceCell(); %>
            <td class="r c-freight num" data-c="freight"><% if (m.freightPerUnit != null) { %><span title="$<%= Number(assump.freight_40hq_usd).toLocaleString('en-US') %> per 40HQ ÷ <%= m.unitsPer40hq.toLocaleString('en-US') %> units"><%= u(m.freightPerUnit) %></span><% } else { %>—<% } %></td>
            <td class="r c-landed num">
              <% if (m.landedUsd != null) { %><strong<%- m.landedBasis === 'volume' ? ' title="Carton weight is missing, so the container load is counted by volume only — the real figure may be higher"' : '' %>><%= m.landedBasis === 'volume' ? '≈ ' : '' %><%= u(m.landedUsd) %></strong><div class="cl-sub"><%= m.landedBasis === 'volume' ? 'volume only' : 'est. 40HQ' %></div>
              <% } else { %>—<div class="cl-sub"><%= !m.physical ? 'not applicable' : 'needs carton data' %></div><% } %>
            </td>
            <td class="r c-whole num"><% if (m.wholesaleUsd != null) { %><span title="Landed × <%= (1 + m.markupPct / 100).toFixed(2) %> — a <%= m.markupPct %>% markup, which is a <%= m.impliedMarginPct %>% gross margin"><%= u(m.wholesaleUsd) %></span><div class="cl-sub">+<%= m.markupPct %>% markup</div><% } else { %>—<% } %></td>
            <td class="r c-moq num" data-c="moq"><%= p.moq != null ? Number(p.moq).toLocaleString('en-US') : '—' %></td>
            <td class="r c-units num" data-c="units"><%= m.unitsPer40hq != null ? m.unitsPer40hq.toLocaleString('en-US') : '—' %></td>
            <td class="r c-hs num" data-c="hs"><%= p.hs_code || '—' %></td>
          <% } %>
          <td class="c-data">
            <% if (!m.gaps.length) { %><span class="pd-ok" title="Nothing missing">✓ Complete</span>
            <% } else { %>
            <details class="sp-relmenu pd-gap"><summary class="pd-badge <%= m.critical.length ? 'crit' : 'opt' %>" aria-label="<%= m.critical.length ? m.critical.length + ' critical' : m.optional.length + ' optional' %> missing — show details"><%= m.critical.length || m.optional.length %><span class="pd-w"> <%= m.critical.length ? 'critical' : 'optional' %></span></summary>
              <div class="menu" role="group" aria-label="Missing data for <%= p.name %>">
                <% if (m.critical.length) { %><div class="gh">Needed for costing and quotes</div><% m.critical.forEach(g => { %><a class="gi" href="<%= EDIT(p, g.field) %>"><span><b><%= g.label.replace(/^no /, 'Add ').replace(/^price is 0/, 'Check price') %></b><small><%= g.hint %></small></span><i>Edit ›</i></a><% }) %><% } %>
                <% if (m.optional.length) { %><div class="gh">Optional</div><% m.optional.forEach(g => { %><a class="gi" href="<%= EDIT(p, g.field) %>"><span><b><%= g.label.replace(/^no /, 'Add ') %></b><small><%= g.hint %></small></span><i>Edit ›</i></a><% }) %><% } %>
              </div>
            </details>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
    <div class="cl-foot">
      <span class="muted"><%= nMatch === total ? total + ' product' + (total === 1 ? '' : 's') : nMatch + ' of ' + total + ' products' %><%= pgs > 1 ? ' · showing ' + ((pg - 1) * size + 1) + '–' + Math.min(pg * size, nMatch) : '' %></span>
      <% if (pgs > 1) { %><span class="cl-pager"><% if (pg > 1) { %><a href="<%= link({ page: pg - 1 > 1 ? pg - 1 : '' }) %>" rel="prev">← Previous</a><% } %><span class="muted">Page <%= pg %> of <%= pgs %></span><% if (pg < pgs) { %><a href="<%= link({ page: pg + 1 }) %>" rel="next">Next →</a><% } %></span><% } %>
    </div>
    <% } %>
  </form>
</div>

<% if (mayDelete) { %><dialog class="modaldlg" id="delcfm" aria-labelledby="delcfmt">
  <div class="modalform"><h2 id="delcfmt">Delete selected products?</h2>
    <p class="muted" id="delcfmx"></p>
    <div class="actions"><button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn primary danger" id="delcfmok">Delete</button></div></div>
</dialog><% } %>

<script>
(function () {
  var form = document.getElementById('cmpForm'), bar = document.getElementById('pdBar'), q = document.getElementById('pdq');
  var boxes = [].slice.call(document.querySelectorAll('.sel')), all = document.getElementById('selAll'), tbl = document.getElementById('pdTbl');
  var SEL = 'lt.products.sel', COLK = 'lt.products.cols.<%= V %>';
  function load(k) { try { return JSON.parse(sessionStorage.getItem(k) || '[]'); } catch (e) { return []; } }
  var picked = new Set(load(SEL));
  function save() { try { sessionStorage.setItem(SEL, JSON.stringify(Array.from(picked))); } catch (e) {} }

  // ---- selection: kept while you switch view, search or change page; the toolbar only exists while something is selected ----
  function sync() {
    boxes.forEach(function (b) { if (b.checked) picked.add(b.value); else picked.delete(b.value); });
    save();
    var n = picked.size, ok = n >= 2 && n <= 6, tb = document.getElementById('pdSel');
    tb.hidden = n === 0;
    document.getElementById('selCount').textContent = n;
    document.getElementById('btnQuote').disabled = n < 1;
    document.getElementById('btnCompare').disabled = !ok; document.getElementById('btnAi').disabled = !ok;
    document.getElementById('selHint').textContent = n === 1 ? 'Select one more to compare.' : n > 6 ? 'Compare up to six at a time.' : '';
    boxes.forEach(function (b) { b.closest('tr').classList.toggle('picked', b.checked); });
    if (all) { var on = boxes.filter(function (b) { return b.checked; }).length; all.checked = on > 0 && on === boxes.length; all.indeterminate = on > 0 && on < boxes.length; }
  }
  boxes.forEach(function (b) { b.checked = picked.has(b.value); b.addEventListener('change', sync); });
  if (all) all.addEventListener('change', function () { boxes.forEach(function (b) { b.checked = all.checked; }); sync(); });
  document.getElementById('selClear').addEventListener('click', function () { picked.clear(); boxes.forEach(function (b) { b.checked = false; }); sync(); });
  // selected products that are not on this page still go along with the action
  function withHidden() { form.querySelectorAll('input.xtra').forEach(function (x) { x.remove(); }); var here = new Set(boxes.map(function (b) { return b.value; })); picked.forEach(function (id) { if (!here.has(id)) { var i = document.createElement('input'); i.type = 'hidden'; i.name = 'ids'; i.value = id; i.className = 'xtra'; form.appendChild(i); } }); }
  form.addEventListener('submit', withHidden);
  document.getElementById('btnAi').addEventListener('click', function () { this.textContent = '✦ AI is comparing…'; });

  // ---- delete: always confirmed, with the count ----
  var bd = document.getElementById('btnDelete'), dlg = document.getElementById('delcfm');
  if (bd) {
    bd.addEventListener('click', function () { var n = picked.size; document.getElementById('delcfmt').textContent = 'Delete ' + n + ' selected product' + (n === 1 ? '' : 's') + '?'; document.getElementById('delcfmx').textContent = 'Products used in orders, quotes or requests are kept — only unused ones are removed. This cannot be undone.'; dlg.showModal(); });
    document.getElementById('delcfmok').addEventListener('click', function () { withHidden(); form.method = 'post'; form.action = '/admin/products/delete'; try { sessionStorage.removeItem(SEL); } catch (e) {} form.submit(); });
    dlg.querySelector('[data-close]').addEventListener('click', function () { dlg.close(); });
  }
  sync();

  // ---- live search: wait for a pause in typing, then search; the cursor comes back to the box ----
  var t = null;
  if (q) {
    q.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { try { sessionStorage.setItem('lt.products.focus', '1'); } catch (e) {} bar.requestSubmit(); }, 400); });
    try { if (sessionStorage.getItem('lt.products.focus')) { sessionStorage.removeItem('lt.products.focus'); q.focus(); q.setSelectionRange(q.value.length, q.value.length); } } catch (e) {}
  }

  // ---- popovers: one open at a time; the missing-data menu is positioned so the table never clips it ----
  var pops = [].slice.call(document.querySelectorAll('details.sp-pop, details.sp-relmenu'));
  function place(d) { var m = d.querySelector('.menu'), s = d.querySelector('summary'); if (!m || !d.classList.contains('sp-relmenu')) return; var r = s.getBoundingClientRect(); m.style.left = Math.max(8, Math.min(r.left, innerWidth - m.offsetWidth - 8)) + 'px'; var h = m.offsetHeight, below = r.bottom + 4, top = (below + h + 8 > innerHeight && r.top > h + 12) ? r.top - h - 4 : below; m.style.top = Math.max(8, Math.min(top, innerHeight - h - 8)) + 'px'; }
  pops.forEach(function (d) { d.addEventListener('toggle', function () { if (!d.open) return; pops.forEach(function (o) { if (o !== d) o.open = false; }); place(d); }); });
  document.addEventListener('click', function (e) { pops.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') pops.forEach(function (d) { if (d.open) { d.open = false; d.querySelector('summary').focus(); } }); });
  window.addEventListener('scroll', function () { pops.forEach(function (d) { if (d.open && d.classList.contains('sp-relmenu')) d.open = false; }); }, true);
  window.addEventListener('resize', function () { pops.forEach(function (d) { d.open = false; }); });

  // ---- optional columns: a per-person preference for each view ----
  function stored() { try { return JSON.parse(localStorage.getItem(COLK) || '{}'); } catch (e) { return {}; } }
  document.querySelectorAll('#pdCols [data-col]').forEach(function (b) {
    var s = stored(); if (s[b.dataset.col] != null) b.checked = !!s[b.dataset.col];
    function apply() { if (tbl) tbl.classList.toggle('h-' + b.dataset.col, !b.checked); }
    apply();
    b.addEventListener('change', function () { var x = stored(); x[b.dataset.col] = b.checked; try { localStorage.setItem(COLK, JSON.stringify(x)); } catch (e) {} apply(); });
  });
  // names cut off by the column: full name on hover and on keyboard focus
  document.querySelectorAll('.c-name').forEach(function (td) {
    var a = td.querySelector('.nm'), tip = td.querySelector('.tip'); if (!a || !tip) return;
    if (a.scrollWidth > a.clientWidth + 1) { td.classList.add('cut'); td.querySelector('a.pd-id').setAttribute('aria-describedby', tip.id = 'tip' + Math.random().toString(36).slice(2, 8)); }
  });
})();
</script>
