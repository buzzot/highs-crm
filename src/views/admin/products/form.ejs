<%- include('../../partials/head') %>
<div class="card narrow-md">
  <a class="back" href="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>">← Back</a>
  <h1><%= title %></h1>
  <% if (error) { %><div class="alert err"><%= error %></div><% } %>
  <form method="post" action="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>" enctype="multipart/form-data">
    <div class="row">
      <label class="grow2">Name <input name="name" required value="<%= p.name || '' %>"></label>
      <label>Our SKU <input name="sku" value="<%= p.sku || '' %>"></label>
      <label>Supplier SKU <input name="supplier_sku" value="<%= p.supplier_sku || '' %>"></label>
      <label>Category <input name="category" value="<%= p.category || '' %>"></label>
    </div>
    <label>Description <textarea name="description" rows="3"><%= p.description || '' %></textarea></label>
    <h3>Photos</h3>
    <% if (photos.length) { %>
    <div class="pgrid">
      <% photos.forEach((ph, k) => { %>
        <label class="pthumb" title="<%= ph.title %>">
          <img src="/admin/documents/<%= ph.id %>/download" alt="" loading="lazy">
          <% if (k === 0) { %><span class="pmain">Main</span><% } %>
          <span class="prm"><input type="checkbox" name="remove_photo" value="<%= ph.id %>"> remove</span>
        </label>
      <% }) %>
    </div>
    <% } %>
    <div class="photodrop" id="photoDrop" tabindex="0">
      <input type="file" name="photos" id="photoInput" multiple accept="image/jpeg,image/png,image/webp,image/gif<%= typeof aiOn !== 'undefined' && aiOn ? ',application/pdf' : '' %>">
      <span class="dicon">🖼</span>
      <strong>Drag photos<%= typeof aiOn !== 'undefined' && aiOn ? ' or a PDF' : '' %> here, click to choose, or paste (Ctrl/⌘ V)</strong>
      <span class="muted small">JPG, PNG, WebP or GIF · up to 12 photos, 10 MB each<%= photos.length ? '' : ' · the first photo becomes the main one' %><%= typeof aiOn !== 'undefined' && aiOn ? ' · a PDF (catalogue page, datasheet) is only read by the AI scan, not saved' : '' %></span>
    </div>
    <div class="pgrid" id="photoPreview"></div>
    <% if (typeof aiOn !== 'undefined' && aiOn) { %>
    <div class="aiscan" id="aiScan">
      <div class="aiscan-head">
        <div><strong>✨ AI scan</strong> <span class="muted small">reads the files you added above and suggests name, model no., specs, size, weight, price… — you approve before anything is filled in.</span></div>
        <div class="aiscan-actions"><button type="button" class="btn small primary" id="aiRun" disabled>Scan with AI</button></div>
      </div>
      <div class="aiscan-msg" id="aiMsg" hidden></div>
      <div class="aiscan-review" id="aiReview" hidden>
        <p class="small"><strong>Review the suggestions.</strong> Tick what you want to use, then press “Use selected”. <span class="muted">Nothing is saved until you press Save below.</span></p>
        <table class="tbl compact"><thead><tr><th></th><th>Field</th><th>Now in the form</th><th>AI suggests</th></tr></thead><tbody id="aiRows"></tbody></table>
        <ul class="aiwarn small" id="aiWarn"></ul>
        <div class="actions"><button type="button" class="btn small primary" id="aiApply">Use selected</button><button type="button" class="btn small" id="aiCancel">Discard</button><span class="muted small" id="aiTok"></span></div>
      </div>
    </div>
    <% } %>

    <label>Specifications <span class="muted small">— one per line, "Key: value"</span>
      <textarea name="spec" rows="4" placeholder="Material: 304 stainless steel&#10;Capacity: 500 ml&#10;Colour: matte black"><%= specText || '' %></textarea></label>
    <h3>Supply</h3>
    <div class="row">
      <label class="grow2">Supplier <select name="supplier_id"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= p.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
      <label>Unit cost <input type="number" step="0.0001" name="unit_cost" value="<%= p.unit_cost ?? '' %>"></label>
      <label>Currency <select name="cost_currency"><% ['CNY','USD','EUR'].forEach(c => { %><option <%= (p.cost_currency || 'CNY') === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>MOQ <input type="number" name="moq" value="<%= p.moq ?? '' %>"></label>
    </div>
    <h3>Customs</h3>
    <div class="row">
      <label>HS code <input name="hs_code" value="<%= p.hs_code || '' %>" placeholder="9617.00"></label>
    </div>
    <h3>Unit (one piece incl. inner packaging)</h3>
    <div class="row">
      <label>Weight kg <input type="number" step="0.001" name="unit_weight_kg" value="<%= p.unit_weight_kg ?? '' %>"></label>
      <label>Length cm <input type="number" step="0.1" name="unit_length_cm" value="<%= p.unit_length_cm ?? '' %>"></label>
      <label>Width cm <input type="number" step="0.1" name="unit_width_cm" value="<%= p.unit_width_cm ?? '' %>"></label>
      <label>Height cm <input type="number" step="0.1" name="unit_height_cm" value="<%= p.unit_height_cm ?? '' %>"></label>
    </div>
    <h3>Export carton</h3>
    <div class="row">
      <label>Pcs / carton <input type="number" name="carton_qty" value="<%= p.carton_qty ?? '' %>"></label>
      <label>Gross weight kg <input type="number" step="0.01" name="carton_weight_kg" value="<%= p.carton_weight_kg ?? '' %>"></label>
      <label>Length cm <input type="number" step="0.1" name="carton_length_cm" value="<%= p.carton_length_cm ?? '' %>"></label>
      <label>Width cm <input type="number" step="0.1" name="carton_width_cm" value="<%= p.carton_width_cm ?? '' %>"></label>
      <label>Height cm <input type="number" step="0.1" name="carton_height_cm" value="<%= p.carton_height_cm ?? '' %>"></label>
      <label>CBM <span class="muted small">auto from size</span><input type="number" step="0.0001" name="carton_cbm" value="<%= p.carton_cbm ?? '' %>"></label>
    </div>
    <div class="actions"><button class="btn primary">Save</button></div>
  </form>
</div>
<script>
  // drag & drop / paste photos with previews; files are kept in the file input and uploaded on Save
  (function () {
    const drop = document.getElementById('photoDrop'), input = document.getElementById('photoInput'), prev = document.getElementById('photoPreview');
    if (!drop) return;
    const OK = ['image/jpeg', 'image/png', 'image/webp', 'image/gif', ...(document.getElementById('aiScan') ? ['application/pdf'] : [])];
    let files = [];
    const sync = () => {
      const dt = new DataTransfer(); files.forEach(f => dt.items.add(f)); input.files = dt.files;
      prev.innerHTML = '';
      files.forEach((f, i) => {
        const card = document.createElement('div'); card.className = 'pthumb new';
        const pdf = f.type === 'application/pdf';
        const img = document.createElement(pdf ? 'div' : 'img');
        if (pdf) { img.className = 'pdfthumb'; img.textContent = '📄'; card.title = f.name; } else { img.src = URL.createObjectURL(f); img.onload = () => URL.revokeObjectURL(img.src); }
        const x = document.createElement('button'); x.type = 'button'; x.className = 'pdel'; x.title = 'Remove'; x.textContent = '×';
        x.onclick = () => { files.splice(i, 1); sync(); };
        const cap = document.createElement('span'); cap.className = 'pcap'; cap.textContent = pdf ? 'PDF · AI scan only' : (f.size / 1048576).toFixed(1) + ' MB';
        if (f.size > 10 * 1048576) { card.classList.add('toobig'); cap.textContent = 'too large (max 10 MB)'; }
        card.append(img, x, cap); prev.appendChild(card);
      });
      drop.classList.toggle('has', files.length > 0);
      document.dispatchEvent(new CustomEvent('photofiles'));
    };
    window.__photoFiles = () => files;
    const add = list => { for (const f of list) if (OK.includes(f.type) && files.length < 12) files.push(f); sync(); };
    input.addEventListener('change', () => { const picked = [...input.files]; files = files.filter(f => !picked.includes(f)); add(picked); });
    ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
    ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
    drop.addEventListener('drop', e => add(e.dataTransfer.files));
    document.addEventListener('paste', e => { const imgs = [...(e.clipboardData?.files || [])].filter(f => OK.includes(f.type)); if (imgs.length) { e.preventDefault(); add(imgs); } });
    drop.closest('form').addEventListener('submit', e => { if (files.some(f => f.size > 10 * 1048576)) { e.preventDefault(); alert('Remove photos larger than 10 MB first.'); } });
  })();
</script>

<script>
  // AI scan: ask for suggestions, show them next to the current values, fill the form only for the ticked ones (nothing is saved here)
  (function () {
    const box = document.getElementById('aiScan'); if (!box) return;
    const $ = id => document.getElementById(id), form = box.closest('form');
    const LABELS = [['name', 'Name'], ['supplier_sku', 'Supplier SKU'], ['category', 'Category'], ['description', 'Description'], ['spec', 'Specifications'], ['hs_code', 'HS code (suggestion — verify)'],
      ['unit_cost', 'Unit cost'], ['cost_currency', 'Currency'], ['moq', 'MOQ'], ['unit_weight_kg', 'Unit weight kg'], ['unit_length_cm', 'Unit length cm'], ['unit_width_cm', 'Unit width cm'], ['unit_height_cm', 'Unit height cm'],
      ['carton_qty', 'Pcs / carton'], ['carton_weight_kg', 'Carton weight kg'], ['carton_length_cm', 'Carton length cm'], ['carton_width_cm', 'Carton width cm'], ['carton_height_cm', 'Carton height cm']];
    const field = k => form.elements[k];
    let card = null;
    const scanFiles = () => (window.__photoFiles ? window.__photoFiles() : []).filter(f => f.size <= 10 * 1048576).slice(0, 6);
    const refresh = () => { $('aiRun').disabled = !scanFiles().length; };
    document.addEventListener('photofiles', refresh); refresh();
    const msg = (t, err) => { const m = $('aiMsg'); m.hidden = !t; m.textContent = t || ''; m.className = 'aiscan-msg' + (err ? ' err' : ''); };
    $('aiRun').addEventListener('click', async () => {
      const all = scanFiles();
      if (!all.length) return msg('Add a photo or a PDF above first.', true);
      const fd = new FormData(); all.forEach(f => fd.append('files', f)); fd.append('name', field('name').value); fd.append('description', field('description').value);
      const btn = $('aiRun'); btn.disabled = true; btn.textContent = 'Reading…'; msg('Reading the files — about 10–20 seconds…'); $('aiReview').hidden = true;
      try {
        const res = await fetch('/admin/products/ai-scan', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Scan failed.');
        card = j.card; show(j);
      } catch (e) { msg(e.message, true); } finally { btn.textContent = 'Scan with AI'; refresh(); }
    });
    function show(j) {
      const rows = $('aiRows'); rows.innerHTML = ''; let n = 0;
      LABELS.forEach(([k, label]) => {
        const v = card[k]; if (v == null || v === '') return;
        const el = field(k), cur = el ? String(el.value || '').trim() : '', same = cur === String(v);
        if (same) return;
        n++;
        const tr = document.createElement('tr'), c0 = document.createElement('td'), cb = document.createElement('input');
        cb.type = 'checkbox'; cb.dataset.k = k; cb.checked = !cur; c0.appendChild(cb);   // fill empty fields by default; overwriting needs a tick
        const c1 = document.createElement('td'); c1.textContent = label;
        const c2 = document.createElement('td'); c2.className = 'muted'; c2.textContent = cur || '—'; c2.style.whiteSpace = 'pre-line';
        const c3 = document.createElement('td'); c3.textContent = String(v); c3.style.whiteSpace = 'pre-line';
        tr.append(c0, c1, c2, c3); rows.appendChild(tr);
      });
      const w = $('aiWarn'); w.innerHTML = ''; (card.warnings || []).forEach(t => { const li = document.createElement('li'); li.textContent = '⚠ ' + t; w.appendChild(li); });
      $('aiTok').textContent = j.tokens ? j.tokens.toLocaleString('en-US') + ' tokens' : '';
      if (!n) { msg('The AI found nothing new to add — the form already has these values.'); $('aiReview').hidden = !(card.warnings || []).length; return; }
      msg(''); $('aiReview').hidden = false;
    }
    $('aiApply').addEventListener('click', () => {
      let done = 0;
      $('aiRows').querySelectorAll('input[type=checkbox]:checked').forEach(cb => { const el = field(cb.dataset.k); if (el) { el.value = card[cb.dataset.k]; el.classList.add('aifilled'); done++; } });
      $('aiReview').hidden = true; msg(done ? done + ' field' + (done === 1 ? '' : 's') + ' filled in (highlighted). Check them, then press Save.' : 'Nothing selected.');
    });
    $('aiCancel').addEventListener('click', () => { $('aiReview').hidden = true; msg(''); });
    form.addEventListener('input', e => e.target.classList.remove('aifilled'));
  })();
</script>
<%- include('../../partials/foot') %>
