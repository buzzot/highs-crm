<%- include('../../partials/head') %>
<div class="card narrow-md">
  <a class="back" href="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>">← Back</a>
  <h1><%= title %></h1>
  <% if (error) { %><div class="alert err"><%= error %></div><% } %>
  <form method="post" action="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>" enctype="multipart/form-data">
    <div class="row">
      <label class="grow2">Name <input name="name" required value="<%= p.name || '' %>"></label>
      <label>Our SKU <input name="sku" value="<%= p.sku || '' %>"></label>
      <label>Supplier SKU <input name="supplier_sku" value="<%= p.supplier_sku || '' %>"></label>
      <label>Category <input name="category" value="<%= p.category || '' %>"></label>
    </div>
    <label>Description <textarea name="description" rows="3"><%= p.description || '' %></textarea></label>
    <h3>Photos</h3>
    <% if (photos.length) { %>
    <div class="pgrid">
      <% photos.forEach((ph, k) => { %>
        <label class="pthumb" title="<%= ph.title %>">
          <img src="/admin/documents/<%= ph.id %>/download" alt="" loading="lazy">
          <% if (k === 0) { %><span class="pmain">Main</span><% } %>
          <span class="prm"><input type="checkbox" name="remove_photo" value="<%= ph.id %>"> remove</span>
        </label>
      <% }) %>
    </div>
    <% } %>
    <div class="photodrop" id="photoDrop" tabindex="0">
      <input type="file" name="photos" id="photoInput" multiple accept="image/jpeg,image/png,image/webp,image/gif">
      <span class="dicon">🖼</span>
      <strong>Drag photos here, click to choose, or paste (Ctrl/⌘ V)</strong>
      <span class="muted small">JPG, PNG, WebP or GIF · up to 12 photos, 10 MB each<%= photos.length ? '' : ' · the first photo becomes the main one' %></span>
    </div>
    <div class="pgrid" id="photoPreview"></div>

    <label>Specifications <span class="muted small">— one per line, "Key: value"</span>
      <textarea name="spec" rows="4" placeholder="Material: 304 stainless steel&#10;Capacity: 500 ml&#10;Colour: matte black"><%= specText || '' %></textarea></label>
    <h3>Supply</h3>
    <div class="row">
      <label class="grow2">Supplier <select name="supplier_id"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= p.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
      <label>Unit cost <input type="number" step="0.0001" name="unit_cost" value="<%= p.unit_cost ?? '' %>"></label>
      <label>Currency <select name="cost_currency"><% ['CNY','USD','EUR'].forEach(c => { %><option <%= (p.cost_currency || 'CNY') === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>MOQ <input type="number" name="moq" value="<%= p.moq ?? '' %>"></label>
    </div>
    <h3>Customs</h3>
    <div class="row">
      <label>HS code <input name="hs_code" value="<%= p.hs_code || '' %>" placeholder="9617.00"></label>
    </div>
    <h3>Unit (one piece incl. inner packaging)</h3>
    <div class="row">
      <label>Weight kg <input type="number" step="0.001" name="unit_weight_kg" value="<%= p.unit_weight_kg ?? '' %>"></label>
      <label>Length cm <input type="number" step="0.1" name="unit_length_cm" value="<%= p.unit_length_cm ?? '' %>"></label>
      <label>Width cm <input type="number" step="0.1" name="unit_width_cm" value="<%= p.unit_width_cm ?? '' %>"></label>
      <label>Height cm <input type="number" step="0.1" name="unit_height_cm" value="<%= p.unit_height_cm ?? '' %>"></label>
    </div>
    <h3>Export carton</h3>
    <div class="row">
      <label>Pcs / carton <input type="number" name="carton_qty" value="<%= p.carton_qty ?? '' %>"></label>
      <label>Gross weight kg <input type="number" step="0.01" name="carton_weight_kg" value="<%= p.carton_weight_kg ?? '' %>"></label>
      <label>Length cm <input type="number" step="0.1" name="carton_length_cm" value="<%= p.carton_length_cm ?? '' %>"></label>
      <label>Width cm <input type="number" step="0.1" name="carton_width_cm" value="<%= p.carton_width_cm ?? '' %>"></label>
      <label>Height cm <input type="number" step="0.1" name="carton_height_cm" value="<%= p.carton_height_cm ?? '' %>"></label>
      <label>CBM <span class="muted small">auto from size</span><input type="number" step="0.0001" name="carton_cbm" value="<%= p.carton_cbm ?? '' %>"></label>
    </div>
    <div class="actions"><button class="btn primary">Save</button></div>
  </form>
</div>
<script>
  // drag & drop / paste photos with previews; files are kept in the file input and uploaded on Save
  (function () {
    const drop = document.getElementById('photoDrop'), input = document.getElementById('photoInput'), prev = document.getElementById('photoPreview');
    if (!drop) return;
    const OK = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    let files = [];
    const sync = () => {
      const dt = new DataTransfer(); files.forEach(f => dt.items.add(f)); input.files = dt.files;
      prev.innerHTML = '';
      files.forEach((f, i) => {
        const card = document.createElement('div'); card.className = 'pthumb new';
        const img = document.createElement('img'); img.src = URL.createObjectURL(f); img.onload = () => URL.revokeObjectURL(img.src);
        const x = document.createElement('button'); x.type = 'button'; x.className = 'pdel'; x.title = 'Remove'; x.textContent = '×';
        x.onclick = () => { files.splice(i, 1); sync(); };
        const cap = document.createElement('span'); cap.className = 'pcap'; cap.textContent = (f.size / 1048576).toFixed(1) + ' MB';
        if (f.size > 10 * 1048576) { card.classList.add('toobig'); cap.textContent = 'too large (max 10 MB)'; }
        card.append(img, x, cap); prev.appendChild(card);
      });
      drop.classList.toggle('has', files.length > 0);
    };
    const add = list => { for (const f of list) if (OK.includes(f.type) && files.length < 12) files.push(f); sync(); };
    input.addEventListener('change', () => { const picked = [...input.files]; files = files.filter(f => !picked.includes(f)); add(picked); });
    ['dragenter', 'dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
    ['dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
    drop.addEventListener('drop', e => add(e.dataTransfer.files));
    document.addEventListener('paste', e => { const imgs = [...(e.clipboardData?.files || [])].filter(f => OK.includes(f.type)); if (imgs.length) { e.preventDefault(); add(imgs); } });
    drop.closest('form').addEventListener('submit', e => { if (files.some(f => f.size > 10 * 1048576)) { e.preventDefault(); alert('Remove photos larger than 10 MB first.'); } });
  })();
</script>
<%- include('../../partials/foot') %>
