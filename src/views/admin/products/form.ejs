        var el = field(k); if (el) { el.value = v; el.classList.add('aifilled'); el.title = 'Filled by AI — not verified, please check'; done++; }
      });
      $('aiReview').hidden = true; msg(done ? done + ' field' + (done === 1 ? '' : 's') + ' filled in (highlighted). Check them, then press Save changes.' : 'Nothing selected.'); cbmState(); heading(); dirty();
    });
    $('aiCancel').addEventListener('click', function () { $('aiReview').hidden = true; msg(''); });
    form.addEventListener('input', function (e) { e.target.classList.remove('aifilled'); });
  })();

  // ---------- save workflow: unsaved-changes guard, checks, single submit ----------
  var stat = function (t) { $('peStat').textContent = t; };
  function snap() { var o = []; new FormData(form).forEach(function (v, k) { if (!(v instanceof File)) o.push(k + '=' + v); }); o.push('files=' + files.map(function (f) { return f.name + f.size; }).join('|')); o.push('docs=' + docFiles.map(function (f) { return f.name + f.size; }).join('|')); return o.join('&'); }
  var HAS_ERR = <%- nErr ? 'true' : 'false' %>, IS_NEW = <%- isNew ? 'true' : 'false' %>;
  var base = HAS_ERR ? '' : snap(), saving = false, isDirty = HAS_ERR;     // after a failed save the page is never "clean"
  function dirty() {
    isDirty = snap() !== base; if (!saving) stat(isDirty ? 'Unsaved changes' : 'No changes'); $('peStat').classList.toggle('on', isDirty);
    var sv = $('peSave'); if (sv && !saving) sv.disabled = !IS_NEW && !isDirty;
    heading();
  }
  // the page heading follows the name being typed; SKU, category and supplier sit under it
  function heading() {
    var n = $('nameIn').value.trim(); $('peTitle').textContent = n || (IS_NEW ? 'New Product' : 'Untitled product');
    var sup = form.elements.supplier_id, so = sup && sup.selectedOptions[0], sn = so && so.value && so.value !== '__new' ? so.textContent : '';
    $('peMeta').textContent = [$('skuIn').value.trim() ? 'SKU ' + $('skuIn').value.trim() : '', $('catIn').value.trim(), sn].filter(Boolean).join(' · ');
  }
  form.addEventListener('input', dirty); form.addEventListener('change', dirty);
  window.addEventListener('beforeunload', function (e) { if (isDirty && !saving) { e.preventDefault(); e.returnValue = ''; } });
  $('peCancel').addEventListener('click', function (e) { if (isDirty && !confirm('Discard your changes?')) e.preventDefault(); else saving = true; });
  function showErr(el, text) { var host = el.closest('label') || el.parentNode; var s = host.querySelector('.pe-err.js'); if (!text) { if (s) s.remove(); el.removeAttribute('aria-invalid'); return; } if (!s) { s = document.createElement('small'); s.className = 'pe-err js'; s.setAttribute('role', 'alert'); host.appendChild(s); } s.textContent = text; el.setAttribute('aria-invalid', 'true'); }
  function check() {
    var bad = [];
    var name = form.elements.name; showErr(name, name.value.trim() ? '' : 'Enter the product name.'); if (!name.value.trim()) bad.push(name);
    [].forEach.call(form.querySelectorAll('input[type=number]'), function (i) { var t = i.value.trim(), m = ''; if (t && (!isFinite(Number(t)) || Number(t) < 0)) m = 'Enter a number, zero or more.'; showErr(i, m); if (m) bad.push(i); });
    var cq = form.elements.carton_qty; if (cq && !nonPhysical()) { var q = cq.value.trim(); var m2 = q && (Number(q) < 1 || Math.floor(Number(q)) !== Number(q)) ? 'Pieces per carton must be a whole number, 1 or more.' : ''; showErr(cq, m2); if (m2) bad.push(cq); }
    var ks = window.__specRows().map(function (r) { return r[0].toLowerCase(); }), rowsBad = window.__specRows().some(function (r) { return !r[0] && r[1]; }) || ks.some(function (k) { return k.indexOf(':') >= 0; }) || ks.filter(Boolean).length !== new Set(ks.filter(Boolean)).size;
    if (rowsBad) { stat('Check the specification attributes: each needs a unique name without a colon.'); bad.push(rows); }
    return bad;
  }
  form.addEventListener('submit', function (e) {
    if (saving) { e.preventDefault(); return; }
    if (files.concat(docFiles).some(function (f) { return f.size > MAX; })) { e.preventDefault(); stat('Remove files larger than 10 MB first.'); return; }
    var bad = check(); if (bad.length) { e.preventDefault(); if (bad[0].focus) bad[0].focus(); if (bad[0].scrollIntoView) bad[0].scrollIntoView({ block: 'center' }); return; }
    saving = true; var b = $('peSave'); b.disabled = true; b.textContent = 'Saving…'; stat('Saving…');
  });
  window.addEventListener('pageshow', function () { saving = false; var b = $('peSave'); if (b) { b.disabled = !IS_NEW && !isDirty; b.textContent = <%- JSON.stringify(isNew ? 'Create product' : 'Save changes') %>; } });

  // ---------- info tooltips (hover, focus or tap) ----------
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.pe-i'); document.querySelectorAll('.pe-info.open').forEach(function (i) { if (!b || i !== b.parentNode) i.classList.remove('open'); });
    if (b) { b.parentNode.classList.toggle('open'); e.preventDefault(); }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('.pe-info.open').forEach(function (i) { i.classList.remove('open'); }); });

  // collapsed "More purchasing terms" keeps a one-line summary of what is filled in
  function unitLabels() { var u = form.elements.sold_per.value || 'pcs', k = (form.elements.package_type.value || 'Carton').toLowerCase(); document.querySelectorAll('[data-unit],#qtyPerLbl').forEach(function (e) { e.textContent = u; }); $('pkgLbl').textContent = k; }
  ['sold_per', 'package_type'].forEach(function (n) { form.elements[n].addEventListener('change', unitLabels); });
  function termsSum() { var inc = form.elements.src_incoterm.value, lead = form.elements.src_lead.value.trim(), val = form.elements.src_valid.value.trim(); $('moreSum').textContent = [inc, lead ? lead + ' days' : '', val ? 'valid until ' + val : ''].filter(Boolean).join(' · ') || 'none set'; }
  ['src_incoterm', 'src_lead', 'src_valid'].forEach(function (n) { form.elements[n].addEventListener('input', termsSum); form.elements[n].addEventListener('change', termsSum); });
  heading();

  // opened from a "missing data" link: #f=carton_qty jumps to that field
  var m = /^#f=([a-z_]+)$/.exec(location.hash);
  if (m) { var el = form.elements[m[1]]; if (el && el.closest && el.closest('details')) el.closest('details').open = true;
    if (el && el.focus) { el.scrollIntoView({ block: 'center' }); el.focus(); var l = el.closest('label'); if (l) l.classList.add('pd-flash'); } }
  else if (<%- nErr ? 'true' : 'false' %>) { var first = form.querySelector('.pe-err'); if (first) { var t = first.closest('label, section'); (t && t.scrollIntoView) && t.scrollIntoView({ block: 'center' }); } }
})();
</script>
