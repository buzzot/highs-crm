<%- include('../../partials/head') %>
<%
  const E = typeof errors !== 'undefined' && errors ? errors : {};
  const F = typeof f !== 'undefined' && f ? f : { type: '', incoterm: '', lead: '', valid: '', unit: '', pkg: '', rows: [] };
  const RT = typeof recordTypes !== 'undefined' ? recordTypes : [['', 'Physical product'], ['Sample', 'Sample'], ['Packaging', 'Packaging'], ['Service', 'Service'], ['Freight', 'Freight item']];
  const INC = typeof incoterms !== 'undefined' ? incoterms : ['EXW', 'FCA', 'FOB', 'CIF', 'CFR', 'DAP', 'DDP'];
  const CUR = typeof currencies !== 'undefined' ? currencies : ['CNY', 'USD', 'EUR'];
  const AI = typeof aiOn !== 'undefined' && aiOn;
  const HASP = typeof hasPrimary !== 'undefined' && hasPrimary;
  const KEEP = typeof keepCbm !== 'undefined' && keepCbm;
  const PH = typeof photos !== 'undefined' ? photos : [];
  const DOCS = typeof docs !== 'undefined' ? docs : [];
  const dtype = d => d.kind === 'certificate' ? 'Certificate' : ({ pdf: 'PDF', doc: 'Word', docx: 'Word', xls: 'Excel', xlsx: 'Excel', csv: 'CSV', txt: 'Text', dwg: 'Drawing', dxf: 'Drawing', png: 'Image', jpg: 'Image', jpeg: 'Image', gif: 'Image', webp: 'Image' }[String(d.title || d.storage_path || '').split('.').pop().toLowerCase()] || 'File');
  const dsize = n => { n = Number(n); return n > 0 ? (n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB') : ''; };
  const aiDoc = d => /pdf/i.test(d.mime_type || '') || /\.pdf$/i.test(d.title || '') || /^image\/(png|jpe?g|gif|webp)$/i.test(d.mime_type || '');
  const mainId = (p.primary_photo_id && PH.some(x => x.id === p.primary_photo_id)) ? p.primary_photo_id : (PH[0] && PH[0].id);
  const v = k => (p[k] ?? '');
  const isNew = !p.id;
  const typeOpts = RT.some(([x]) => x === F.type) ? RT : [...RT, [F.type, F.type]];
  const off = /^(service|services|freight|freight item|shipping)$/i.test(F.type || '');
  const CB = F.cbm || { supplier: v('carton_cbm'), use: 'entered' };
  let tipN = 0;
  const tip = (text) => { tipN++; return '<span class="pe-info"><button type="button" class="pe-i" aria-label="More information" aria-describedby="tip' + tipN + '">i</button><span class="pe-tipbox" role="tooltip" id="tip' + tipN + '">' + text + '</span></span>'; };
  const supName = ((typeof suppliers !== 'undefined' ? suppliers : []).find(x => x.id === p.supplier_id) || {}).name || '';
  const heading = String(p.name || '').trim() || (isNew ? 'New Product' : 'Untitled product');
  const meta = [p.sku ? 'SKU ' + p.sku : '', p.category || '', supName].filter(Boolean);
  const UN = typeof units !== 'undefined' ? units : ['pcs', 'm', 'kg'], PT = typeof packageTypes !== 'undefined' ? packageTypes : ['Carton'];
  const unitOpts = !F.unit || UN.includes(F.unit) ? UN : [...UN, F.unit], pkgOpts = !F.pkg || PT.includes(F.pkg) ? PT : [...PT, F.pkg];
  const U = F.unit || 'pcs';
  const incOpts = !F.incoterm || INC.includes(String(F.incoterm).toUpperCase()) ? INC : [...INC, F.incoterm];
  const curOpts = CUR.includes(p.cost_currency || 'CNY') ? CUR : [...CUR, p.cost_currency];
  const isoDate = /^\d{4}-\d{2}-\d{2}$/.test(F.valid || '');
  const nErr = Object.keys(E).length;
%>
<div class="pe">
  <nav class="pe-crumb" aria-label="Breadcrumb"><a href="/admin/products">Products</a><span aria-hidden="true"> / </span><span aria-current="page"><%= isNew ? 'New product' : 'Edit product' %></span></nav>
  <h1 class="pe-title" id="peTitle"><%= heading %></h1>
  <p class="pe-meta" id="peMeta"><%= meta.join(' · ') %></p>
  <% if (error) { %><div class="alert err" role="alert"><%= error %></div><% } %>

  <form method="post" id="pform" action="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>" enctype="multipart/form-data" novalidate>

  <div class="pe-cols">
    <div class="pe-col pe-left">
  <%# ---------------- 1. Product information (with the specifications) ---------------- %>
  <section class="pe-card" id="sec-basic">
    <h2>Product information</h2>
    <div class="pe-row">
      <label class="field--full">Product name <span class="req" title="Required">*</span>
        <input name="name" id="nameIn" required maxlength="300" value="<%= v('name') %>" aria-invalid="<%= E.name ? 'true' : 'false' %>"><% if (E.name) { %><small class="pe-err" role="alert"><%= E.name %></small><% } %></label>
      <label class="field--medium">Our SKU
        <input name="sku" id="skuIn" maxlength="100" value="<%= v('sku') %>"><% if (E.sku) { %><small class="pe-err" role="alert"><%= E.sku %></small><% } %></label>
      <label class="field--medium">Category
        <input name="category" id="catIn" maxlength="100" value="<%= v('category') %>"><% if (E.category) { %><small class="pe-err" role="alert"><%= E.category %></small><% } %></label>
      <label class="field--medium"><span>Record type <%- tip('Service and freight records do not use cartons or container costing, so the packing fields are locked (their values are kept). Samples and packaging are treated as physical items.') %></span>
        <select name="record_type" id="recType"><% typeOpts.forEach(([val, label]) => { %><option value="<%= val %>" <%= F.type === val ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
      <label class="field--full">Description
        <textarea name="description" id="descIn" rows="2" maxlength="5000"><%= v('description') %></textarea><% if (E.description) { %><small class="pe-err" role="alert"><%= E.description %></small><% } %></label>
    </div>

    <div class="pe-group" id="sec-spec">
      <div class="pe-h"><h3>Technical specifications <span class="cnt" id="specCount"><%= F.rows.length %></span> <%- tip('One attribute per row; put the unit in the value (10 W, 25 mm). Paste a list of “Key: value” lines into an attribute name field to turn it into rows. Names must be unique and cannot contain a colon.') %></h3>
        <div class="pe-tools"><button type="button" class="btn small" id="specAdd">+ Add attribute</button></div></div>
      <div id="specRows" class="pe-spec">
        <% F.rows.forEach(([k, val]) => { %>
          <div class="pe-sr"><input name="spec_k" value="<%= k %>" placeholder="Attribute" maxlength="80" aria-label="Attribute name"><input name="spec_v" value="<%= val %>" placeholder="Value, with unit" aria-label="Attribute value"><button type="button" class="iconbtn" data-rm title="Remove this attribute" aria-label="Remove this attribute">×</button></div>
        <% }) %>
      </div>
      <p class="pe-empty-s muted small" id="specEmpty" <%= F.rows.length ? 'hidden' : '' %>>No specifications yet.</p>
      <% if (E.spec) { %><small class="pe-err" role="alert"><%= E.spec %></small><% } %>
    </div>
  </section>

  <%# ---------------- Supplier & pricing ---------------- %>
  <section class="pe-card" id="sec-supply">
    <h2>Supplier &amp; pricing <%- tip('Supplier terms are kept apart from the product itself. Quotations and supplier purchase orders keep the price they were created with — editing the cost here only affects new ones. Price basis, lead time and quote validity are saved with the product\'s specification data.') %></h2>
    <div class="pe-row">
      <label class="field--wide">Supplier
        <select data-picker name="supplier_id"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= p.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %><option value="__new">+ Add new supplier…</option></select></label>
      <label class="field--medium">Supplier SKU
        <input name="supplier_sku" maxlength="100" value="<%= v('supplier_sku') %>"><% if (E.supplier_sku) { %><small class="pe-err" role="alert"><%= E.supplier_sku %></small><% } %></label>
    </div>
    <div class="newsup" id="newSup" hidden>
      <strong>New supplier</strong> <span class="muted small">— just the basics; complete the rest later on the supplier page</span>
      <div class="pe-grid">
        <label class="s2">Company name <input id="ns_name" maxlength="200"></label>
        <label>Contact person <input id="ns_contact"></label>
        <label>City <input id="ns_city"></label>
        <label>Email <input type="email" id="ns_email"></label>
        <label>Phone <input id="ns_phone"></label>
        <label>WeChat <input id="ns_wechat"></label>
      </div>
      <div class="aiscan-msg err" id="ns_err" hidden></div>
      <div class="actions"><button type="button" class="btn small primary" id="ns_save">Add supplier</button><button type="button" class="btn small" id="ns_cancel">Cancel</button></div>
    </div>
    <div class="pe-row pe-gap">
      <label class="field--compact">Unit cost
        <input type="number" min="0" step="0.0001" inputmode="decimal" name="unit_cost" value="<%= v('unit_cost') %>"><% if (E.unit_cost) { %><small class="pe-err" role="alert"><%= E.unit_cost %></small><% } %></label>
      <label class="field--compact">Currency
        <select name="cost_currency"><% curOpts.forEach(c => { %><option <%= (p.cost_currency || 'CNY') === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label class="field--compact">Sold per <%- tip('The unit the price and MOQ are quoted in — pcs, m, kg, sets… Optional; pcs when empty.') %>
        <select name="sold_per" id="soldPer"><option value="">pcs (default)</option><% unitOpts.filter(u => u !== 'pcs').forEach(u => { %><option <%= F.unit === u ? 'selected' : '' %>><%= u %></option><% }) %></select></label>
      <label class="field--compact">MOQ <span class="pe-unit" data-unit><%= U %></span>
        <input type="number" min="0" step="1" inputmode="numeric" name="moq" value="<%= v('moq') %>"><% if (E.moq) { %><small class="pe-err" role="alert"><%= E.moq %></small><% } %></label>
    </div>
    <details class="pe-more" id="moreTerms" <%= E.src_incoterm || E.src_lead || E.src_valid ? 'open' : '' %>>
      <summary><span>More purchasing terms</span><span class="pe-sum" id="moreSum"><%= [F.incoterm ? String(F.incoterm).toUpperCase() : '', F.lead ? F.lead + ' days' : '', F.valid ? 'valid until ' + F.valid : ''].filter(Boolean).join(' · ') || 'none set' %></span></summary>
      <div class="pe-row">
        <label class="field--medium">Price basis
          <select name="src_incoterm"><option value="">—</option><% incOpts.forEach(c => { %><option <%= String(F.incoterm).toUpperCase() === c.toUpperCase() ? 'selected' : '' %>><%= c %></option><% }) %></select>
          <% if (E.src_incoterm) { %><small class="pe-err" role="alert"><%= E.src_incoterm %></small><% } %></label>
        <label class="field--compact">Lead time <span class="pe-unit">days</span>
          <input name="src_lead" inputmode="numeric" maxlength="12" value="<%= F.lead %>" placeholder="30"><% if (E.src_lead) { %><small class="pe-err" role="alert"><%= E.src_lead %></small><% } %></label>
        <label class="field--medium">Quotation valid until
          <input name="src_valid" <%= isoDate || !F.valid ? 'type=date' : 'type=text' %> value="<%= F.valid %>"><% if (E.src_valid) { %><small class="pe-err" role="alert"><%= E.src_valid %></small><% } %></label>
      </div>
    </details>
  </section>

  <%# ---------------- 5. Customs & classification ---------------- %>
  <section class="pe-card" id="sec-customs">
    <h2>Customs &amp; classification</h2>
    <div class="pe-row pe-hsrow">
      <label class="field--medium">HS code <%- tip('Saved exactly as entered, including a code given by the supplier. LumiTrade does not check it against an import tariff, so confirm the classification for the destination country before relying on it.') %>
        <input name="hs_code" maxlength="20" value="<%= v('hs_code') %>" placeholder="9617.00" inputmode="decimal"><% if (E.hs_code) { %><small class="pe-err" role="alert"><%= E.hs_code %></small><% } %></label>
      <p class="pe-help pe-hsnote">Not verified — confirm for the destination country.</p>
    </div>
  </section>
    </div>
    <div class="pe-col pe-right">
  <%# ---------------- 2. Photos, documents & AI ---------------- %>
  <section class="pe-card" id="sec-photos">
    <div class="pe-h"><h2>Photos, documents &amp; AI</h2>
      <div class="pe-tools"><button type="button" class="btn small" id="fileAdd">+ Add files</button></div></div>
    <input type="file" id="fileInput" multiple hidden accept=".jpg,.jpeg,.png,.webp,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.dwg,.dxf">
    <p class="pe-empty" id="attEmpty" <%= PH.length || DOCS.length ? 'hidden' : '' %>>No files yet. Use <strong>+ Add files</strong> — or drop files here, or paste an image — for product photos, specification sheets and datasheets.</p>
    <div class="pe-attach">
      <div class="pe-attcol" id="phBlock" <%= PH.length ? '' : 'hidden' %>>
        <div class="pe-h"><h3>Product photos <span class="cnt" id="phCount"><%= PH.length %></span> <%- tip('JPG, PNG, WebP or GIF, up to 12 at a time, 10 MB each. Drop images on the gallery or paste one from the clipboard.' + (HASP ? '' : ' The first photo uploaded is the main one.') + ' Removing a stored photo only takes effect when you press Save changes.') %></h3>
</div>
        <input type="file" name="photos" id="photoInput" multiple hidden accept="image/jpeg,image/png,image/webp,image/gif">
    <div class="pe-gal" id="photoDrop" tabindex="0" aria-label="Product photos. Drop images here or paste from the clipboard.">
      <% PH.forEach((ph) => { %>
        <figure class="pe-ph <%= ph.id === mainId ? 'main' : '' %>" data-id="<%= ph.id %>">
          <button type="button" class="pe-pimg" data-preview="/admin/documents/<%= ph.id %>/download" data-title="<%= ph.title || '' %>" aria-label="View <%= ph.title || 'photo' %> full size"><img src="/admin/documents/<%= ph.id %>/download" alt="<%= ph.title || '' %>" loading="lazy" data-pimg></button>
          <% if (ph.id === mainId) { %><span class="pe-main-tag">Main</span><% } %>
          <button type="button" class="pe-x" data-rmphoto title="Remove this photo" aria-label="Remove <%= ph.title || 'photo' %>">&times;</button>
          <input type="checkbox" name="remove_photo" value="<%= ph.id %>" hidden>
          <div class="pe-rmnote" hidden><span>Removed when you save</span><button type="button" class="linkbtn" data-undo>Undo</button></div>
          <% if (HASP) { %><figcaption><label class="pe-radio" title="Use as the main photo"><input type="radio" name="primary_photo_id" value="<%= ph.id %>" <%= ph.id === mainId ? 'checked' : '' %>> <span><%= ph.id === mainId ? 'Main photo' : 'Make main' %></span></label></figcaption><% } %>
        </figure>
      <% }) %>
      <div id="photoPreview" class="pe-newwrap" style="display:contents"></div>
    </div>
      </div>

      <div class="pe-attcol" id="docPanel" <%= DOCS.length ? '' : 'hidden' %>>
        <div class="pe-h"><h3>Documents <span class="cnt" id="docCount"><%= DOCS.length %></span> <%- tip('Specification sheets, datasheets, catalogue pages, drawings and certificates (PDF, Word, Excel, CSV, text, DWG/DXF; 10 MB each, up to 10 at a time). They are saved with the product, kept internal (not shown to clients) and are never deleted by the AI. To replace one, add the new file and remove the old one, then save.') %></h3>
          </div>
        <input type="file" name="docs" id="docInput" multiple hidden accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.dwg,.dxf">
        <ul class="pe-docs" id="docList" aria-label="Product documents">
          <% DOCS.forEach(d => { %>
            <li class="pe-doc" data-id="<%= d.id %>" data-ai="<%= aiDoc(d) ? '1' : '' %>" data-title="<%= d.title || '' %>">
              <span class="pe-dtype"><%= dtype(d) %></span>
              <a class="pe-dname" href="/admin/documents/<%= d.id %>/download" target="_blank" rel="noopener" title="<%= d.title || '' %>"><%= d.title || 'Document' %></a>
              <span class="pe-dmeta"><%= String(d.created_at || '').slice(0, 10) %><%= dsize(d.size_bytes) ? ' · ' + dsize(d.size_bytes) : '' %><%= d.client_visible ? ' · visible to client' : '' %></span>
              <span class="pe-dact"><a href="/admin/documents/<%= d.id %>/download" target="_blank" rel="noopener">View</a><a href="/admin/documents/<%= d.id %>/download" download>Download</a><button type="button" class="pe-x2" data-rmdoc title="Remove this document" aria-label="Remove <%= d.title || 'document' %>">&times;</button></span>
              <input type="checkbox" name="remove_doc" value="<%= d.id %>" hidden>
              <span class="pe-rmnote2" hidden>Removed when you save · <button type="button" class="linkbtn" data-undo>Undo</button></span>
            </li>
          <% }) %>
        </ul>
        <div id="docNew"></div>
      </div>
    </div>
    <% if (AI) { %>
    <div class="pe-ai" id="aiScan">
      <div class="pe-h"><h3>AI product assistant <span class="pe-opt">optional</span> <%- tip('Reads the photos and PDFs you tick and suggests product details. Nothing is changed until you review the suggestions and press Use selected — and even then nothing is saved until you press Save changes. Spreadsheets and Word files are stored but not read by the AI.') %></h3>
        <div class="pe-tools"><button type="button" class="btn small" id="aiRun" disabled>✨ Extract product details</button></div></div>
      <div class="pe-aipick" id="aiPick"><span class="muted small">Add or tick a photo or PDF to read.</span></div>
      <div class="aiscan-msg" id="aiMsg" hidden></div>
      <div class="aiscan-review" id="aiReview" hidden>
        <p class="small"><strong>Review the suggestions.</strong> <span id="aiSrc" class="muted"></span> Edit a value if needed; fields that are already filled are not ticked — tick one only to replace it.</p>
        <div class="tblwrap"><table class="tbl compact"><thead><tr><th></th><th>Field</th><th>Now in the form</th><th>AI suggests (editable)</th></tr></thead><tbody id="aiRows"></tbody></table></div>
        <ul class="aiwarn small" id="aiWarn"></ul>
        <div class="actions"><button type="button" class="btn small primary" id="aiApply">Use selected</button><button type="button" class="btn small" id="aiCancel">Discard</button><span class="muted small" id="aiTok"></span></div>
      </div>
    </div>
    <% } %>
  </section>

  <%# ---------------- Dimensions & packaging ---------------- %>
  <section class="pe-card" id="sec-pack">
    <h2>Dimensions &amp; packaging</h2>
    <p class="pe-note" id="packOff" <%= off ? '' : 'hidden' %>>Not used for <%= (F.type || 'non-physical').toLowerCase() %> records — existing values are kept.</p>
    <div class="pe-dims <%= off ? 'is-off' : '' %>" id="packWrap">
      <div class="pe-sub">
        <h3>Individual product</h3>
        <div class="pe-row">
          <label class="field--compact">Weight <span class="pe-unit">kg</span><input type="number" min="0" step="0.001" inputmode="decimal" name="unit_weight_kg" value="<%= v('unit_weight_kg') %>"><% if (E.unit_weight_kg) { %><small class="pe-err"><%= E.unit_weight_kg %></small><% } %></label>
          <label class="field--compact">Length <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="unit_length_cm" value="<%= v('unit_length_cm') %>"></label>
          <label class="field--compact">Width <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="unit_width_cm" value="<%= v('unit_width_cm') %>"></label>
          <label class="field--compact">Height <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="unit_height_cm" value="<%= v('unit_height_cm') %>"></label>
        </div>
      </div>
      <div class="pe-sub">
        <h3>Export carton</h3>
        <div class="pe-row">
          <label class="field--medium">Package type <%- tip('How the goods are packed for export — carton, pallet, drum / reel, roll… Optional; the figures below are then read per package.') %>
            <select name="package_type" id="pkgType"><option value="">Carton (default)</option><% pkgOpts.filter(u => u !== 'Carton').forEach(u => { %><option <%= F.pkg === u ? 'selected' : '' %>><%= u %></option><% }) %></select></label>
          <label class="field--compact"><span id="qtyPerLbl"><%= U %></span> / <span id="pkgLbl"><%= (F.pkg || 'carton').toLowerCase() %></span><input type="number" min="1" step="1" inputmode="numeric" name="carton_qty" value="<%= v('carton_qty') %>"><% if (E.carton_qty) { %><small class="pe-err"><%= E.carton_qty %></small><% } %></label>
          <label class="field--compact">Gross wt <span class="pe-unit">kg</span><input type="number" min="0" step="0.01" inputmode="decimal" name="carton_weight_kg" value="<%= v('carton_weight_kg') %>"><% if (E.carton_weight_kg) { %><small class="pe-err"><%= E.carton_weight_kg %></small><% } %></label>
          <label class="field--compact">Length <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="carton_length_cm" value="<%= v('carton_length_cm') %>"></label>
          <label class="field--compact">Width <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="carton_width_cm" value="<%= v('carton_width_cm') %>"></label>
          <label class="field--compact">Height <span class="pe-unit">cm</span><input type="number" min="0" step="0.1" inputmode="decimal" name="carton_height_cm" value="<%= v('carton_height_cm') %>"></label>
        </div>
        <div class="pe-row pe-cbmrow" id="cbmBox">
          <label class="field--compact">Carton CBM <span class="pe-unit">m³</span><input type="number" min="0" step="0.0001" inputmode="decimal" name="carton_cbm" id="cbmIn" value="<%= CB.supplier %>"><% if (E.carton_cbm) { %><small class="pe-err"><%= E.carton_cbm %></small><% } %></label>
          <p class="pe-cbmline"><span id="cbmUse">—</span> <%- tip('Length × width × height ÷ 1,000,000 is worked out when all three carton sides are filled in. The CBM you type is the supplier-provided figure and is never overwritten.') %></p>
        </div>
        <fieldset class="pe-pick" id="cbmPick" hidden>
          <legend id="cbmLegend">The supplier's CBM and the calculated one differ — use which?</legend>
          <label><input type="radio" name="cbm_use" value="entered" <%= CB.use !== 'calc' ? 'checked' : '' %>> <span id="cbmPickEnt">Supplier-provided</span></label>
          <label><input type="radio" name="cbm_use" value="calc" <%= CB.use === 'calc' ? 'checked' : '' %>> <span id="cbmPickCalc">Calculated from size</span></label>
        </fieldset>
        <p class="pe-help" id="cbmNote"></p>
      </div>
    </div>
  </section>
    </div>
  </div>


  <div class="pe-foot" role="region" aria-label="Save">
    <span class="pe-stat" id="peStat" aria-live="polite"><%= nErr ? nErr + ' field' + (nErr === 1 ? '' : 's') + ' need attention' : 'No changes' %></span>
    <a class="btn" id="peCancel" href="<%= p.id ? '/admin/products/' + p.id : '/admin/products' %>">Cancel</a>
    <button class="btn primary" id="peSave" <%= !isNew && !nErr ? 'disabled' : '' %>><%= isNew ? 'Create product' : 'Save changes' %></button>
  </div>
  </form>
</div>

<dialog class="pdd-lb" id="peLb" aria-label="Photo preview">
  <div class="lbbar"><span class="lbcap" id="peLbCap"></span><button type="button" class="btn small" id="peLbX">Close ✕</button></div>
  <div class="lbstage"><img id="peLbImg" alt=""><div class="lbfail" id="peLbFail" hidden>This photo could not be loaded.</div></div>
</dialog>

<script>
(function () {
  var form = document.getElementById('pform'), $ = function (id) { return document.getElementById(id); };
  var MAX = 10 * 1048576, files = [], docFiles = [], PRODUCT_ID = <%- JSON.stringify(p.id || '') %>;

  // ---------- photos: gallery, add / drop / paste, preview, remove ----------
  var input = $('photoInput'), drop = $('photoDrop'), prev = $('photoPreview');
  var OK = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
