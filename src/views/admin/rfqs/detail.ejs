<%- include('../../partials/head') %>
<%
  const draft = rfq.status === 'draft';
  const unsent = rs.filter(s => s.status === 'draft').length;
  const answered = rs.filter(s => s.status === 'replied' || s.status === 'declined').length;
  const money = (v, c) => fmt.money(v, c, 2);
  const hasAnswers = rs.some(s => s.status === 'replied');
%>
<div class="pagehead">
  <div><a class="back" href="<%= rfq.requests ? '/admin/sourcing/' + rfq.requests.id : '/admin/rfqs' %>">← <%= rfq.requests ? rfq.requests.ref : 'RFQs' %></a>
    <h1><%= rfq.ref %> <span class="muted">· <%= rfq.title %></span></h1>
    <p class="muted"><%= rs.length %> supplier<%= rs.length === 1 ? '' : 's' %> · <%= answered %> answered · <%= rfq.items.length %> product<%= rfq.items.length === 1 ? '' : 's' %><%= rfq.deadline ? ' · answer by ' + rfq.deadline : '' %></p></div>
  <div class="headactions">
    <% if (rfq.status !== 'closed' && unsent) { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/send" class="inline"><button class="btn primary"<% if (sendWarn) { %> onclick="return confirm(<%= JSON.stringify(sendWarn) %>)"<% } %>><%- icon('mail') %> Send to <%= unsent %> supplier<%= unsent === 1 ? '' : 's' %></button></form><% } %>
    <span class="pill lg <%= rfq.status === 'open' ? 'quoted' : rfq.status === 'closed' ? 'closed' : 'new' %>"><%= labels[rfq.status] %></span>
  </div>
</div>
<%- include('../../partials/owner_box') %>
<% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>
<% if (err) { %><div class="alert err"><%= err %></div><% } %>

<% if (hasAnswers) { %>
<div class="card">
  <h2>Comparison <span class="muted small">prices in <%= rfq.currency %> per unit, lowest highlighted</span></h2>
  <div class="tablewrap"><table class="tbl cmp">
    <thead><tr><th>Product</th><th class="right">Qty <a href="#details" class="small" title="Edit quantities">✎ edit</a></th><% rs.forEach(s => { %><th class="right"><%= s.suppliers.name %><div class="muted small"><%= rsLabels[s.status] %></div></th><% }) %></tr></thead>
    <tbody>
    <% cmp.rows.forEach(row => { %>
      <tr><td><strong><%= row.item.description %></strong><% if (row.item.sku) { %><div class="muted small"><%= row.item.sku %></div><% } %></td>
        <td class="right num"><%= row.item.quantity ? Number(row.item.quantity).toLocaleString('en-US') : '—' %></td>
        <% row.cells.forEach(c => { %><td class="right num <%= c.best ? 'cmp-best' : '' %>">
          <% if (c.price == null) { %><span class="muted">—</span><% } else { %>
            <strong><%= money(c.converted, rfq.currency) %></strong><%= c.price_unit ? ' / ' + c.price_unit : '' %>
            <% if (c.currency !== rfq.currency) { %><div class="muted small">quoted <%= money(c.price, c.currency) %></div><% } %>
            <div class="muted small"><%= [c.moq ? 'MOQ ' + Number(c.moq).toLocaleString('en-US') : '', c.lead_days ? c.lead_days + ' d' : '', c.package_type ? c.package_type + (c.carton_qty ? ' of ' + c.carton_qty : '') : ''].filter(Boolean).join(' · ') %></div>
            <% (c.file_ids || []).forEach(id => { const d = docs.find(x => x.id === id); if (d) { %><div class="small"><a href="/admin/documents/<%= d.id %>/download" target="_blank" title="<%= d.title %>"><%- icon('file') %>&nbsp;<%= d.title.length > 22 ? d.title.slice(0, 20) + '…' : d.title %></a></div><% } }) %>
          <% } %></td><% }) %>
      </tr>
    <% }) %>
      <tr class="cmp-total"><td colspan="2"><strong>Total for the quantities</strong></td>
        <% cmp.totals.forEach(t => { %><td class="right num"><% if (t.quoted) { %><strong><%= money(t.total, rfq.currency) %></strong><% if (t.quoted < t.of) { %><div class="muted small">only <%= t.quoted %> of <%= t.of %> quoted</div><% } %><% } else { %><span class="muted">—</span><% } %></td><% }) %>
      </tr>
    </tbody>
  </table></div>
</div>
<% } %>

<div class="card" id="files">
  <h2>Files for suppliers <span class="count"><%= fileDocs.length %></span>
    <% if (aiOn && fileDocs.length) { %><span class="hactions"><form method="post" action="/admin/rfqs/<%= rfq.id %>/review" class="inline"><button class="btn small"><%- icon('sparkles') %> Check files with AI</button></form></span><% } %></h2>
  <% if (!fileDocs.length) { %><p class="muted small">No files attached. Suppliers only see the product list and your message.</p><% } else { %>
  <p class="muted small">Every supplier of this RFQ can open these files in the portal<%= rs.length ? '; they are also attached to the email when small enough' : '' %>.</p>
  <div class="chk-list">
  <% fileDocs.forEach(d => { const rv = fileReview[d.id] || { status: 'unchecked', issues: [], note: 'Not checked yet.' }; %>
    <div class="chk-row <%= rv.status %>">
      <% if ((d.mime_type || '').startsWith('image/')) { %><img class="chk-thumb" src="/admin/documents/<%= d.id %>/download" alt="" loading="lazy"><% } else { %><span class="fext chk-thumb"><%= ((d.title || '').split('.').pop() || 'file').slice(0, 4).toUpperCase() %></span><% } %>
      <div class="chk-body">
        <a href="/admin/documents/<%= d.id %>/download" target="_blank" rel="noopener"><strong><%= d.title %></strong></a>
        <span class="muted small"> · <%= d.entity_type === 'rfq' ? 'added by us' : "client's file" %><%= d.size_bytes ? ' · ' + (d.size_bytes > 1048576 ? (d.size_bytes / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(d.size_bytes / 1024)) + ' KB') : '' %><%= rv.language && rv.status !== 'unchecked' ? ' · ' + rv.language : '' %></span>
        <% if (rv.issues && rv.issues.length) { %><ul><% rv.issues.forEach(t => { %><li><%= t %></li><% }) %></ul><% } %>
        <% if (rv.note) { %><div class="muted small"><%= rv.note %></div><% } %>
      </div>
      <span class="chk-badge <%= rv.status %>"><%= rv.status === 'ok' ? 'No issues' : rv.status === 'warn' ? 'Check this' : 'Not checked' %></span>
      <% if (rfq.status !== 'closed') { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/files/remove" class="inline"><input type="hidden" name="doc" value="<%= d.id %>"><button class="link small danger" onclick="return confirm('Remove this file from the RFQ?')">Remove</button></form><% } %>
    </div>
  <% }) %>
  </div>
  <% } %>
  <% if (rfq.status !== 'closed' && fileDocs.length < maxFiles) { %>
  <form method="post" action="/admin/rfqs/<%= rfq.id %>/files" enctype="multipart/form-data" class="filesadd">
    <div class="dropwrap">
      <div class="filedrop" data-dropzone data-max="<%= maxFiles - fileDocs.length %>" data-max-mb="20" tabindex="0">
        <input type="file" name="files" multiple accept="image/*,.pdf,.xlsx,.xls,.docx,.doc,.csv" aria-label="Add files for the suppliers">
        <span class="dicon"><%- icon('upload') %></span>
        <strong data-drop-count>Drag files here or <span class="dlink">browse</span></strong>
        <span class="muted small dsub">photos, PDF, Excel, Word · 20 MB each</span>
      </div>
      <div class="fgrid" data-drop-list></div>
    </div>
    <button class="btn">Add files</button>
  </form>
  <% } %>
</div>

<div class="card">
  <h2>Suppliers <span class="count"><%= rs.length %></span></h2>
  <table class="tbl">
    <thead><tr><th>Supplier</th><th>Email</th><th>Status</th><th>Sent</th><th></th></tr></thead>
    <tbody>
    <% rs.forEach(s => { %>
      <tr>
        <td><a href="/admin/suppliers/<%= s.suppliers.id %>"><strong><%= s.suppliers.name %></strong></a></td>
        <td class="small"><% if (s.status === 'draft') { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/send" id="f<%= s.id %>" class="inline"><input type="hidden" name="rs" value="<%= s.id %>"><input name="to_<%= s.id %>" value="<%= s.sent_to || s.suppliers.email || '' %>" placeholder="email address" size="26"></form><% } else { %><%= s.sent_to || '—' %><% } %></td>
        <td><span class="pill <%= s.status === 'replied' ? 'accepted' : s.status === 'declined' ? 'declined' : s.status === 'sent' ? 'quoted' : 'new' %>"><%= rsLabels[s.status] %></span></td>
        <td class="small muted"><%= s.sent_at ? fmt.datetime(s.sent_at) : '—' %></td>
        <td class="right nowrap">
          <% if (s.status === 'draft' && rfq.status !== 'closed') { %><button class="btn small" form="f<%= s.id %>"<% if (sendWarn) { %> onclick="return confirm(<%= JSON.stringify(sendWarn) %>)"<% } %>>Send</button><% } %>
          <% if (s.status === 'sent' && rfq.status !== 'closed') { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/send" class="inline"><input type="hidden" name="rs" value="<%= s.id %>"><button class="btn small">Resend</button></form><% } %>
          <% if (s.status === 'draft') { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/suppliers" class="inline"><input type="hidden" name="remove" value="<%= s.id %>"><button class="link small danger">Remove</button></form><% } %>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% if (addable.length && rfq.status !== 'closed') { %>
  <form method="post" action="/admin/rfqs/<%= rfq.id %>/suppliers" class="row gap-top">
    <select name="supplier_ids" data-picker="Supplier" required><option value="">— add a supplier —</option><% addable.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %></select>
    <button class="btn small">Add</button>
  </form>
  <% } %>
</div>

<% rs.filter(s => s.status !== 'draft').forEach(s => { const resp = current[s.id]; %>
<div class="card">
  <h2><%= s.suppliers.name %> <span class="pill <%= s.status === 'replied' ? 'accepted' : s.status === 'declined' ? 'declined' : 'quoted' %>"><%= rsLabels[s.status] %></span><% if (resp && resp.status === 'confirmed') { %><span class="hactions"><a class="btn small" href="/admin/rfqs/<%= rfq.id %>/packing/<%= s.id %>"><%- icon('file') %> Draft packing list</a></span><% } %></h2>
  <% if (resp && resp.status === 'declined') { %><p class="muted">The supplier can't quote this.<%= resp.note ? ' “' + resp.note + '”' : '' %></p><% } %>
  <% if (resp && resp.status === 'confirmed') { %>
    <p class="small muted">Answered <%= fmt.datetime(resp.created_at) %> · via <%= ({ portal: 'supplier portal', email: 'email', manual: 'entered by staff' })[resp.source] %></p>
    <% const t = resp.terms || {}; const tl = [['Incoterm', t.incoterm], ['Port', t.fob_port], ['Payment', t.payment_terms], ['Valid until', t.valid_until]].filter(([, x]) => x); %>
    <% if (tl.length) { %><p class="small"><%= tl.map(([k, x]) => k + ': ' + x).join(' · ') %></p><% } %>
    <% if (resp.note) { %><p style="white-space:pre-line"><%= resp.note %></p><% } %>
    <% (resp.file_ids || []).forEach(id => { const d = docs.find(x => x.id === id); if (d) { %><a class="fchip" href="/admin/documents/<%= d.id %>/download" target="_blank"><%- icon('file') %>&nbsp;<%= d.title %></a> <% } }) %>
  <% } else if (s.status === 'sent') { %><p class="muted">Waiting for the answer.</p><% } %>
  <% if (rfq.status !== 'closed') { %>
  <details class="gap-top"><summary class="btn small"><%= resp ? 'Replace the answer' : 'Enter their answer' %></summary>
    <p class="muted small">For an answer that came by WeChat, phone or a file — type it in here.</p>
    <%- include('../../partials/rfq_answer', { action: `/admin/rfqs/${rfq.id}/answer/${s.id}`, rfq, resp, declineLabel: 'Mark as can\'t quote' }) %>
  </details>
  <% } %>
</div>
<% }) %>

<form method="post" action="/admin/rfqs/<%= rfq.id %>" class="stack">
<div class="card" id="details">
  <h2>RFQ details</h2>
  <div class="grid2">
    <label>Title<input name="title" value="<%= rfq.title %>" maxlength="200"></label>
    <div class="row">
      <label>Answer by<input type="date" name="deadline" value="<%= rfq.deadline || '' %>"></label>
      <label>Prices in<select name="currency" <%= draft ? '' : 'disabled' %>><% currencies.forEach(c => { %><option <%= c === rfq.currency ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
    </div>
  </div>
  <label>Message to suppliers<textarea name="message" rows="3"><%= rfq.message || '' %></textarea></label>
  <table class="tbl rfq-tbl" id="rfqItems">
    <colgroup><col><col class="c-sku"><col class="c-qty"><col class="c-notes"><col class="c-rm"></colgroup>
    <thead><tr><th>Product</th><th>SKU</th><th>Quantity</th><th>Notes</th><th></th></tr></thead>
    <tbody>
    <% rfq.items.forEach((it, i) => { %>
      <tr>
        <td><input type="hidden" name="item[<%= i %>][id]" value="<%= it.id %>"><input type="hidden" name="item[<%= i %>][request_item_id]" value="<%= it.request_item_id || '' %>"><input type="hidden" name="item[<%= i %>][spec]" value="<%= JSON.stringify(it.spec || {}) %>"><input name="item[<%= i %>][description]" value="<%= it.description %>" <%= draft ? '' : 'readonly' %>></td>
        <td><input name="item[<%= i %>][sku]" value="<%= it.sku || '' %>" <%= draft ? '' : 'readonly' %>></td>
        <td><div class="qtyunit"><input name="item[<%= i %>][quantity]" value="<%= it.quantity ?? '' %>" inputmode="decimal" class="right" aria-label="Quantity"><input name="item[<%= i %>][unit]" value="<%= it.unit || 'pcs' %>" list="rfqUnits" aria-label="Unit"></div></td>
        <td><input name="item[<%= i %>][notes]" value="<%= it.notes || '' %>" <%= draft ? '' : 'readonly' %>></td>
        <td><% if (draft) { %><button type="button" class="link small danger" data-rm>Remove</button><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
    <datalist id="rfqUnits"><option>pcs</option><option>sets</option><option>pairs</option><option>m</option><option>kg</option><option>tons</option><option>boxes</option></datalist>
  <% if (draft) { %><p><button type="button" class="btn small" id="addItem">+ Add product</button></p><% } else { %><p class="muted small">After sending you can still change the quantity and unit; the products themselves stay the same so every supplier answers the same list. Suppliers see a new quantity straight away, but prices they already gave are not changed — let them know.</p><% } %>
  <div class="actions"><button class="btn primary">Save</button></div>
</div>
</form>
<div class="actions">
  <% if (rfq.status !== 'draft') { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/status" class="inline"><input type="hidden" name="status" value="<%= rfq.status === 'closed' ? 'open' : 'closed' %>"><button class="btn"><%= rfq.status === 'closed' ? 'Reopen RFQ' : 'Close RFQ' %></button></form><% } %>
  <% if (rs.every(s => s.status === 'draft') && (typeof canDelete !== 'function' || canDelete(rfq))) { %><form method="post" action="/admin/rfqs/<%= rfq.id %>/delete" class="inline" onsubmit="return confirm('Delete this RFQ?')"><button class="btn danger">Delete</button></form><% } %>
</div>
<script src="/js/rfq-new.js?v=<%= typeof assetV === 'undefined' ? '' : assetV %>"></script>
<%- include('../../partials/foot') %>
