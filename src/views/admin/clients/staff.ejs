<%- include('../../partials/head') %>
<div class="pagehead"><h1>Staff</h1></div>
<div class="grid2">
  <div class="card">
    <h2>Team <span class="count"><%= staff.filter(m => m.state === 'accepted').length %> active</span></h2>
    <%- include('../../partials/members', { members: staff, inviteAction: '/admin/clients/staff/invite', showRole: true }) %>
  </div>
  <div class="card">
    <h2>Invite a team member</h2>
    <form method="post" action="/admin/clients/staff/invite">
      <label>Email <input type="email" name="email" required></label>
      <label>Role <select name="role"><option value="staff">Staff — full workspace, no settings</option><option value="admin">Admin — also staff & pricing settings</option></select></label>
      <button class="btn primary">Send invite</button>
    </form>
    <p class="muted small">The link in the email is valid for 14 days.</p>
  </div>
</div>
<%- include('../../partials/foot') %>
