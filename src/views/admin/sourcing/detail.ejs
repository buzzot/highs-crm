<%- include('../../partials/head') %>
<div class="pagehead">
  <div><a class="back" href="/admin/sourcing">← Sourcing</a><h1><%= request.ref %> · <%= request.title %><% if (String(request.ref).startsWith('IRQ-')) { %> <span class="tag" title="Started by staff, not by the client">staff</span><% } %></h1>
    <p class="muted"><a href="/admin/clients/<%= request.organizations.id %>"><%= request.organizations.name %></a> · submitted by <%= request.creator?.full_name || request.creator?.email || '—' %> · <%= fmt.date(request.created_at) %></p></div>
  <span class="pill lg <%= request.status %>"><%= fmt.status(request.status) %></span>
</div>
<% const rfqList = typeof rfqs !== 'undefined' ? rfqs : []; %>
<div class="card">
  <h2>Ask suppliers for a price <% if (rfqList.length) { %><span class="count"><%= rfqList.length %></span><% } %></h2>
  <% if (!rfqList.length) { %><p class="muted">Send this request to several suppliers at once and compare their prices side by side.</p><% } else { %>
  <table class="tbl compact"><tbody>
    <% rfqList.forEach(x => { const sup = x.rfq_suppliers || []; const done = sup.filter(v => v.status === 'replied' || v.status === 'declined').length; %>
    <tr><td><a href="/admin/rfqs/<%= x.id %>"><strong><%= x.ref %></strong></a> <span class="muted small"><%= x.title %></span></td><td class="small"><%= done %> of <%= sup.length %> answered</td>
      <td><span class="pill <%= x.status === 'open' ? 'quoted' : x.status === 'closed' ? 'closed' : 'new' %>"><%= x.status === 'open' ? 'Open' : x.status === 'closed' ? 'Closed' : 'Draft' %></span></td></tr>
    <% }) %>
  </tbody></table><% } %>
  <div class="actions"><a class="btn <%= rfqList.length ? '' : 'primary' %>" href="/admin/rfqs/new?request=<%= request.id %>">+ New RFQ</a></div>
</div>
<% const poList = typeof pos !== 'undefined' ? pos : []; %>
<% if (poList.length) { %>
  <div class="card <%= poList.some(x => x.status === 'submitted') ? 'pending' : '' %>">
    <h2>Purchase orders <span class="count"><%= poList.length %></span></h2>
    <table class="tbl compact"><tbody>
    <% poList.forEach(x => { %><tr>
      <td><a href="/admin/po/<%= x.id %>"><strong><%= x.po_no %></strong></a></td>
      <td class="right num"><%= fmt.money(x.lines.reduce((t, l) => t + Number(l.quantity || 0) * Number(l.unit_price || 0), 0), x.currency) %></td>
      <td><span class="pill <%= x.status %>"><%= ({ draft: 'Client draft', submitted: 'To approve', approved: 'Approved', rejected: 'Sent back' })[x.status] %></span></td>
      <td class="muted small"><%= x.submitted_at ? 'sent ' + fmt.datetime(x.submitted_at) : '' %></td>
      <td class="right"><a class="btn small <%= x.status === 'submitted' ? 'primary' : '' %>" href="/admin/po/<%= x.id %>"><%= x.status === 'submitted' ? 'Review & approve' : 'Open' %></a></td>
    </tr><% }) %>
    </tbody></table>
  </div>
<% } %>
<% const pend = typeof pending !== 'undefined' ? pending : null; %>
<% if (pend) { %>
  <div class="card pending">
    <h2><%- icon('clock') %> Client changed this request — approval needed <span class="pill pending">Pending</span></h2>
    <p class="muted"><%= pend.creator?.full_name || pend.creator?.email || 'Client' %> · <%= fmt.datetime(pend.updated_at || pend.created_at) %>.
      Approving applies the changes, marks outdated draft/sent quotes as <em>superseded</em> and moves the request to <em>reviewing</em> for an updated offer. Accepted quotes and orders are never touched.</p>
    <%- include('../../partials/request_diff', { d: pendingDiff, cur: pend.data.target_currency || request.target_currency }) %>
    <% if (pendingDocs.length) { %>
      <div class="rqthumbs">
        <% pendingDocs.forEach(d => { const url = '/admin/documents/' + d.id + '/download'; %>
          <% if ((d.mime_type || '').startsWith('image/')) { %><a href="<%= url %>" target="_blank" title="<%= d.title %>"><img src="<%= url %>" alt="<%= d.title %>" loading="lazy"></a>
          <% } else { %><a class="fchip" href="<%= url %>" target="_blank"><%- icon('file') %>&nbsp;<%= d.title %></a><% } %>
        <% }) %>
      </div>
    <% } %>
    <form method="post" action="/admin/sourcing/<%= request.id %>/changes/<%= pend.id %>">
      <label>Note to the client <span class="muted small">— optional, included in the email</span><input name="note" placeholder="e.g. New quantity noted — updated offer within 2 days"></label>
      <div class="actions">
        <button class="btn primary" name="decision" value="approve">Approve changes</button>
        <button class="btn" name="decision" value="reject">Reject</button>
      </div>
    </form>
  </div>
<% } %>
<div class="grid2">
  <div>
    <div class="card">
      <h2>Client request · <%= items.length || 1 %> product<%= items.length > 1 ? 's' : '' %></h2>
      <dl class="dl">
        <dt>Destination</dt><dd><%= [request.destination_city, request.destination_country].filter(Boolean).join(', ') || '—' %></dd>
        <dt>Needed by</dt><dd><%= fmt.date(request.needed_by) %></dd>
        <dt>Delivery</dt><dd><%= deliveryLabel(request.delivery_mode) %></dd>
        <dt>Price currency</dt><dd><%= request.target_currency || '—' %></dd>
      </dl>
      <%- include('../../partials/request_items', { request, items, docs, base: '/admin', quotes, staff: true }) %>
    </div>

    <div class="card">
      <h2>AI sourcing brief</h2>
      <% if (request.ai_brief) { %><div class="pre ai"><%= request.ai_brief %></div><% if (typeof briefUsage !== 'undefined' && briefUsage) { %><p class="muted small ailine"><%= aiLine(briefUsage) %> · <%= fmt.datetime(briefUsage.at) %></p><% } %><% } else { %><p class="muted">Turn the client's text into a spec checklist, likely HS chapter and questions to ask.</p><% } %>
      <form method="post" action="/admin/sourcing/<%= request.id %>/brief"><button class="btn"><%= request.ai_brief ? 'Regenerate' : 'Generate brief' %></button></form>
    </div>

    <div class="card">
      <h2>Quotes <a class="more" href="/admin/pricing/quotes/new?request_id=<%= request.id %>">+ new quote</a><% if (quotes.some(x => ['draft', 'sent', 'accepted'].includes(x.status))) { %> <a class="more" href="/admin/pricing/requests/<%= request.id %>/quote">Quotation total &amp; PDF</a><% } %></h2>
      <% const drafts = quotes.filter(x => x.status === 'draft'); %>
      <% if (drafts.length > 1) { %>
        <form method="post" action="/admin/pricing/requests/<%= request.id %>/send-all" class="sendall">
          <span><strong><%= drafts.length %></strong> draft lines ready to go out together.</span>
          <label class="check"><input type="checkbox" name="skip_ai"> without AI check</label>
          <% if (user.role === 'admin') { %><label class="check"><input type="checkbox" name="override"> margin override</label><input name="reason" placeholder="override reason" class="short"><% } %>
          <button class="btn primary" onclick="return confirm('Send all <%= drafts.length %> quote lines to the client now?')">Send all to client</button>
        </form>
      <% } %>
      <% if (!quotes.length) { %><p class="muted">No quotes yet.</p><% } %>
      <table class="tbl">
        <% if (quotes.length) { %><thead><tr><th>Product / supplier</th><th>Qty</th><th class="right">Unit price</th><th class="right">Landed</th><th>Margin</th><th>AI</th><th>Status</th><th></th></tr></thead><% } %>
        <tbody>
        <% quotes.forEach(q => { const ord = orders.find(o => o.quote_id === q.id); %>
          <tr>
            <% const qi = items.find(i => i.id === q.request_item_id); %><td><a href="/admin/pricing/quotes/<%= q.id %>"><%= qi?.name || q.products?.name || 'Custom item' %></a><% if (qi && q.products?.name && q.products.name !== qi.name) { %><div class="muted small">catalogue: <%= q.products.name %></div><% } %><div class="muted small"><%= q.suppliers?.name || '' %></div></td>
            <td><%= q.quantity %></td>
            <td class="right"><%= fmt.money(q.unit_price, q.sell_currency, 4) %></td>
            <td class="right"><%= fmt.money(q.landed_unit_price, q.sell_currency, 4) %></td>
            <td class="<%= q.margin_pct < 20 ? 'bad' : '' %>"><%= fmt.pct(q.margin_pct) %></td>
            <td><% if (q.ai_check) { %><span class="tag <%= q.ai_check.ok ? 'ok' : 'warn' %>"><%= q.ai_check.score %></span><% } else { %>—<% } %></td>
            <td><span class="pill <%= q.status %>"><%= fmt.status(q.status) %></span></td>
            <td class="right">
              <% if (ord) { %><a href="/admin/orders/<%= ord.id %>"><%= ord.order_no %></a>
              <% } else if (q.status === 'accepted' || (user.role === 'admin' && q.status === 'sent')) { %>
                <form method="post" action="/admin/sourcing/quotes/<%= q.id %>/convert" class="inline"><button class="btn small primary">Create order</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../../partials/docs', { docs, entityType: 'request', entityId: request.id, redirect: '/admin/sourcing/' + request.id, heading: 'Client files & sample photos', defaultKind: 'product_photo' }) %>
  </div>
  <div>
    <div class="card">
      <h2>Handling</h2>
      <form method="post" action="/admin/sourcing/<%= request.id %>">
        <div class="row">
          <label>Status <select name="status"><% statuses.forEach(s => { %><option value="<%= s %>" <%= request.status === s ? 'selected' : '' %>><%= fmt.status(s) %></option><% }) %></select></label>
          <label>Owner <select name="assigned_to"><option value="">—</option><% staff.forEach(s => { %><option value="<%= s.id %>" <%= request.assigned_to === s.id ? 'selected' : '' %>><%= s.full_name || s.email %></option><% }) %></select></label>
        </div>
        <label>Internal notes <span class="muted small">— never shown to the client</span><textarea name="internal_notes" rows="5"><%= request.internal_notes || '' %></textarea></label>
        <button class="btn primary">Save</button>
      </form>
    </div>
    <%- include('../../partials/timeline', { events, created: { at: request.created_at, label: 'request submitted' } }) %>
  </div>
</div>
<%- include('../../partials/foot') %>
