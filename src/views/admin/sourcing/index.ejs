<%- include('../../partials/head') %>
<div class="pagehead">
  <h1>Sourcing</h1>
  <% const mine = !!query.mine, mq = mine ? '&mine=1' : ''; %>
  <div class="headactions"><a class="btn primary" href="/admin/sourcing/new">+ New request</a>
  <a class="btn<%= mine ? ' primary' : '' %>" href="/admin/sourcing?status=<%= status %><%= mine ? '' : '&mine=1' %>" title="<%= mine ? 'Showing only requests assigned to you — click to show all' : 'Show only requests assigned to you' %>"><%= mine ? '✓ Assigned to me' : 'Assigned to me' %></a></div>
</div>
<div class="tabs">
  <a href="/admin/sourcing?status=open<%= mq %>" class="<%= status === 'open' ? 'on' : '' %>">Open <span><%= (byStatus.new||0)+(byStatus.reviewing||0)+(byStatus.quoted||0) %></span></a>
  <% statuses.filter(s => (byStatus[s] || 0) > 0 || status === s).forEach(s => { %><a href="/admin/sourcing?status=<%= s %><%= mq %>" class="<%= status === s ? 'on' : '' %>"><%= fmt.status(s) %> <span><%= byStatus[s] || 0 %></span></a><% }) %>
  <a href="/admin/sourcing?status=all<%= mq %>" class="<%= status === 'all' ? 'on' : '' %>">All</a>
</div>
<div class="card">
  <form class="row tight" method="get"><input type="hidden" name="status" value="<%= status %>"><% if (mine) { %><input type="hidden" name="mine" value="1"><% } %><input name="q" value="<%= query.q || '' %>" placeholder="Search title or ref…"><button class="btn">Search</button></form>
  <table class="tbl">
    <thead><tr><th>Ref</th><th>Request</th><th>Client</th><th>Qty</th><th>Target</th><th>Needed by</th><th>Quotes</th><th>Owner</th><th>Status</th></tr></thead>
    <tbody>
    <% if (!requests.length) { %><tr><td colspan="9" class="muted">Nothing here.</td></tr><% } %>
    <% requests.forEach(q => { const urgent = q.needed_by && new Date(q.needed_by) < new Date(Date.now() + 21*864e5) && ['new','reviewing'].includes(q.status); %>
      <tr>
        <td><a href="/admin/sourcing/<%= q.id %>"><%= q.ref %></a><% if (String(q.ref).startsWith('IRQ-')) { %> <span class="tag" title="Started by staff, not by the client">staff</span><% } %></td>
        <td><strong><%= q.title %></strong><% if (typeof pendingIds !== 'undefined' && pendingIds.includes(q.id)) { %> <span class="pill pending">Changes to approve</span><% } %><% if (typeof poIds !== 'undefined' && poIds.includes(q.id)) { %> <span class="pill pending">PO to approve</span><% } %><div class="muted small"><%= fmt.date(q.created_at) %></div></td>
        <td><a href="/admin/clients/<%= q.organizations?.id %>"><%= q.organizations?.name %></a></td>
        <td><%= q.quantity ?? '—' %></td>
        <td><%= q.target_unit_price ? fmt.money(q.target_unit_price, q.target_currency, 4) : '—' %></td>
        <td class="<%= urgent ? 'bad' : '' %>"><%= fmt.date(q.needed_by) %></td>
        <td><%= (q.quotes || []).length %><% const sent = (q.quotes||[]).filter(x => x.status === 'sent').length; if (sent) { %> <span class="muted small">(<%= sent %> sent)</span><% } %></td>
        <td class="small"><%= q.assignee?.full_name || q.assignee?.email || '—' %></td>
        <td><span class="pill <%= q.status %>"><%= fmt.status(q.status) %></span></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../partials/foot') %>
