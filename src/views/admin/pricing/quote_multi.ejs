<%- include('../../partials/head') %>
<div class="pagehead"><div><a class="back" href="/admin/products">← Products</a><h1>Quote <%= products.length %> product<%= products.length > 1 ? 's' : '' %></h1>
  <p class="muted">One request, one quote line per product. Suppliers can differ. Lines are saved as drafts — you review them, then send them together.</p></div></div>
<% if (error) { %><div class="alert err"><%= error %></div><% } %>
<form method="post" action="/admin/pricing/quotes/multi" class="poform">
  <div class="card">
    <h2>For whom</h2>
    <div class="row">
      <label class="grow2">Client <span class="muted small">a new internal request (IRQ-…) is created</span>
        <select name="org_id" id="m_org"><option value="">— choose a client —</option><% orgs.forEach(o => { %><option value="<%= o.id %>"><%= o.name %></option><% }) %></select></label>
      <label class="grow2">…or add to an existing request
        <select name="request_id" id="m_req"><option value="">— new internal request —</option><% requests.forEach(r => { %><option value="<%= r.id %>"><%= r.ref %> · <%= r.title %> · <%= r.organizations?.name || '' %></option><% }) %></select></label>
      <label class="grow2">Request title <span class="muted small">optional</span><input name="title" placeholder="defaults to the first product"></label>
    </div>
    <div class="row">
      <label>Selling currency <select name="sell_currency"><% currencies.forEach(c => { %><option <%= c === 'USD' ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      <label>Incoterm <select name="incoterm"><% incoterms.forEach(i => { %><option <%= i === 'FOB' ? 'selected' : '' %>><%= i %></option><% }) %></select></label>
      <label>Lead time (days) <input type="number" name="lead_time_days" min="0"></label>
      <label>Valid until <input type="date" name="valid_until" value="<%= valid_until %>"></label>
    </div>
  </div>
  <div class="card cargocard">
    <h2>Cargo estimate <span class="muted small">from the products' packing data and the quantities below</span></h2>
    <div class="pay-kpis">
      <div><span class="muted small">Cartons</span><strong id="t_cartons"><%= cargoTotal.cartons %></strong></div>
      <div><span class="muted small">Gross weight</span><strong id="t_kg"><%= cargoTotal.kg %> kg</strong></div>
      <div><span class="muted small">Volume</span><strong id="t_cbm"><%= cargoTotal.cbm %> m³</strong></div>
      <div><span class="muted small">Air chargeable weight</span><strong id="t_air"><%= cargoTotal.airChargeableKg %> kg</strong><span class="muted small" id="t_air_basis"><%= cargoTotal.airBasis === 'volume' ? 'charged by volume' : 'charged by weight' %></span></div>
      <div><span class="muted small">Share of a 40HQ container</span><strong id="t_pct"><%= cargoTotal.containerPct %>%</strong></div>
    </div>
    <table class="tbl compact cargotbl"><thead><tr><th>Product</th><th class="right">Cartons</th><th class="right">Gross kg</th><th class="right">Volume m³</th><th></th></tr></thead><tbody>
      <% products.forEach((p, i) => { const c = cargo[i]; %><tr id="cg<%= i %>"><td><%= p.name %></td><td class="right c"><%= c.cartons ?? '—' %></td><td class="right k"><%= c.kg ?? '—' %><%= c.kgNote ? ' *' : '' %></td><td class="right v"><%= c.cbm ?? '—' %></td><td class="muted small m"><%= c.missing.length ? 'missing: ' + c.missing.join(', ') : '' %></td></tr><% }) %>
    </tbody></table>
    <p class="muted small">Cartons are rounded up. Volumetric weight = volume × <%= airKgPerCbm %> kg per m³ (L×W×H cm ÷ 6000); air freight is charged on the greater of gross and volumetric weight, sea freight on volume (or weight if very dense). Total volumetric weight: <strong id="t_vol"><%= cargoTotal.volumetricKg %> kg</strong>. <span id="t_warn" <%= cargoTotal.incomplete ? '' : 'hidden' %>>Some products have no packing data, so the totals are incomplete. * = net weight without packing.</span></p>
  </div>
  <div class="card">
    <h2>Products</h2>
    <div class="freightbar">
      <div class="fb-title"><strong>Total freight</strong> <span class="muted small">one amount for the whole shipment, spread over the lines below</span></div>
      <div class="row">
        <label>Shipping by <select id="f_mode"><option value="sea">Sea — spread by volume</option><option value="air">Air — spread by chargeable weight</option></select></label>
        <label>Rate <span class="muted small" id="f_unit">per m³</span> <input type="number" step="0.01" min="0" id="f_rate" placeholder="optional"></label>
        <label>Total freight <span class="muted small" id="f_cur">USD</span> <input type="number" step="0.01" min="0" id="f_total" placeholder="0"></label>
        <label class="fb-btn"><span class="muted small">&nbsp;</span><button type="button" class="btn" id="f_reset" hidden>Spread again</button></label>
      </div>
      <p class="muted small" id="f_note">Type the forwarder's total, or a rate and it is calculated from the cargo above. You can still overwrite any line's freight; the other lines then share what is left.</p>
    </div>
    <table class="tbl compact multiq">
      <colgroup><col><col style="width:130px"><col style="width:140px"><col style="width:100px"><col style="width:110px"><col style="width:170px"></colgroup>
      <thead><tr><th>Product</th><th class="right">Quantity</th><th class="right">Factory price</th><th>Currency</th><th class="right">Margin %</th><th class="right">Freight (line)</th></tr></thead>
      <tbody>
      <% products.forEach((p, i) => { %><tr>
        <td><strong><%= p.name %></strong><input type="hidden" name="line[<%= i %>][product_id]" value="<%= p.id %>">
          <div class="muted small"><%= p.suppliers?.name || 'no supplier' %><%= p.sku ? ' · ' + p.sku : '' %></div></td>
        <td class="right"><input type="number" min="1" name="line[<%= i %>][quantity]" value="<%= p.moq || 1 %>" required></td>
        <td class="right"><input type="number" step="0.0001" min="0" name="line[<%= i %>][unit_cost]" value="<%= p.unit_cost ?? '' %>" required></td>
        <td><select name="line[<%= i %>][cost_currency]"><% currencies.forEach(c => { %><option <%= c === (p.cost_currency || 'CNY') ? 'selected' : '' %>><%= c %></option><% }) %></select></td>
        <td class="right"><input type="number" step="0.1" min="0" name="line[<%= i %>][margin_pct]" value="<%= settings.pricing.default_margin_pct %>"></td>
        <td class="right"><input type="number" step="0.01" min="0" name="line[<%= i %>][freight]" value="0"></td>
      </tr><% }) %>
      </tbody>
    </table>
    <p class="muted small">Margin is on the product cost only (minimum <%= settings.pricing.min_margin_pct %>%). Line freight (in the selling currency) is filled from the total above, or enter it yourself for that line's whole quantity. Open any line afterwards to add duties, notes or run the AI check.</p>
    <div class="actions"><button class="btn primary">Create quote lines</button><a class="btn" href="/admin/products">Cancel</a></div>
  </div>
</form>
<script type="application/json" id="cargoData"><%- JSON.stringify({ container_cbm: container.container_cbm, kgPerCbm: airKgPerCbm, products: products.map(p => ({ id: p.id, name: p.name, carton_qty: p.carton_qty, carton_weight_kg: p.carton_weight_kg, unit_weight_kg: p.unit_weight_kg, ctn_cbm: (() => { const g = Number(p.carton_cbm); if (g > 0) return g; const l = Number(p.carton_length_cm), w = Number(p.carton_width_cm), h = Number(p.carton_height_cm); return l > 0 && w > 0 && h > 0 ? l * w * h / 1e6 : null; })() })) }).replace(/</g, '\\u003c') %></script>
<script>
(function () {
  const data = JSON.parse(document.getElementById('cargoData').textContent);
  const rows = [...document.querySelectorAll('.multiq tbody tr')];
  const fmt = (n, d) => (n == null ? '—' : Number(n).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d }));
  function line(p, qty) {
    qty = Math.max(0, Math.floor(Number(qty) || 0));
    const per = Number(p.carton_qty) > 0 ? Number(p.carton_qty) : null, ckg = Number(p.carton_weight_kg) > 0 ? Number(p.carton_weight_kg) : null, ukg = Number(p.unit_weight_kg) > 0 ? Number(p.unit_weight_kg) : null;
    const cartons = per ? Math.ceil(qty / per) : null, miss = [];
    if (!per) miss.push('pcs per carton');
    let kg = null, note = '';
    if (cartons != null && ckg) kg = cartons * ckg; else if (ukg) { kg = qty * ukg; note = 'net'; if (cartons != null) miss.push('carton weight'); } else miss.push('weight');
    let cbm = null;
    if (cartons != null && p.ctn_cbm) cbm = cartons * p.ctn_cbm; else miss.push('carton size');
    return { cartons, kg, cbm, miss, note };
  }
  function render() {
    let tc = 0, tk = 0, tv = 0, incomplete = false;
    data.products.forEach((p, i) => {
      const qty = rows[i].querySelector('input[name$="[quantity]"]').value, l = line(p, qty), row = document.getElementById('cg' + i);
      row.querySelector('.c').textContent = fmt(l.cartons, 0);
      row.querySelector('.k').textContent = fmt(l.kg, 1) + (l.note ? ' *' : '');
      row.querySelector('.v').textContent = fmt(l.cbm, 3);
      row.querySelector('.m').textContent = l.miss.length ? 'missing: ' + l.miss.join(', ') : '';
      tc += l.cartons || 0; tk += l.kg || 0; tv += l.cbm || 0; if (l.miss.length) incomplete = true;
    });
    const vol = tv * data.kgPerCbm;
    const set = (id, t) => { document.getElementById(id).textContent = t; };
    set('t_cartons', fmt(tc, 0)); set('t_kg', fmt(tk, 1) + ' kg'); set('t_cbm', fmt(tv, 3) + ' m³');
    set('t_vol', fmt(vol, 1) + ' kg'); set('t_air', fmt(Math.max(tk, vol), 1) + ' kg'); set('t_air_basis', vol > tk ? 'charged by volume' : 'charged by weight');
    set('t_pct', fmt(tv / data.container_cbm * 100, 1) + '%');
    document.getElementById('t_warn').hidden = !incomplete;
  }
  document.querySelector('.multiq').addEventListener('input', render);
  render();
  // ---- total freight → per-line freight
  const AIR = data.kgPerCbm, $ = id => document.getElementById(id);
  const locked = {};
  const fIn = i => rows[i].querySelector('input[name$="[freight]"]');
  function allocate() {
    const mode = $('f_mode').value, ls = data.products.map((p, i) => {
      const qty = rows[i].querySelector('input[name$="[quantity]"]').value, l = line(p, qty), cost = Number(rows[i].querySelector('input[name$="[unit_cost]"]').value) || 0;
      return { cbm: l.cbm, kg: l.kg, value: (Math.floor(Number(qty)) || 0) * cost };
    });
    return { ls, mode };
  }
  function weights(ls, mode) { return ls.map(l => (mode === 'air' ? Math.max(l.kg || 0, (l.cbm || 0) * AIR) : l.cbm || 0)); }
  function spread(fromRate) {
    const { ls, mode } = allocate(), w = weights(ls, mode);
    if (fromRate) {
      const rate = Number($('f_rate').value) || 0, basis = w.reduce((a, b) => a + b, 0);
      $('f_total').value = rate && basis ? (rate * basis).toFixed(2) : '';
    }
    const T = Math.max(0, Number($('f_total').value) || 0);
    if (!T && !$('f_total').value) return;
    const free = ls.map((_, i) => i).filter(i => locked[i] == null);
    const left = Math.max(0, T - Object.values(locked).reduce((t, v) => t + v, 0));
    let basis = mode === 'air' ? 'chargeable weight' : 'volume', ws = free.map(i => w[i]);
    if (ws.some(x => !(x > 0))) { basis = 'goods value (some products have no packing data — estimate)'; ws = free.map(i => Math.max(0, ls[i].value)); }
    if (!(ws.reduce((a, b) => a + b, 0) > 0)) ws = free.map(() => 1);
    const sw = ws.reduce((a, b) => a + b, 0); let given = 0;
    free.forEach((i, k) => { const v = k === free.length - 1 ? Math.round((left - given) * 100) / 100 : Math.round(left * ws[k] / sw * 100) / 100; given += v; fIn(i).value = v; });
    $('f_note').textContent = 'Spread by ' + basis + (Object.keys(locked).length ? '; ' + Object.keys(locked).length + ' line(s) set by hand.' : '.');
  }
  function labels() {
    $('f_unit').textContent = $('f_mode').value === 'air' ? 'per chargeable kg' : 'per m³';
    $('f_cur').textContent = document.querySelector('select[name="sell_currency"]').value;
    $('f_reset').hidden = !Object.keys(locked).length;
  }
  $('f_mode').addEventListener('change', () => { labels(); spread($('f_rate').value !== ''); });
  $('f_rate').addEventListener('input', () => spread(true));
  $('f_total').addEventListener('input', () => { $('f_rate').value = ''; spread(false); });
  document.querySelector('select[name="sell_currency"]').addEventListener('change', labels);
  $('f_reset').addEventListener('click', () => { Object.keys(locked).forEach(k => delete locked[k]); labels(); spread($('f_rate').value !== ''); });
  rows.forEach((tr, i) => {
    fIn(i).addEventListener('input', () => { locked[i] = Number(fIn(i).value) || 0; labels(); spread(false); });
    tr.querySelectorAll('input[name$="[quantity]"],input[name$="[unit_cost]"]').forEach(el => el.addEventListener('input', () => { if ($('f_total').value !== '') spread($('f_rate').value !== ''); }));
  });
  labels();
})();
</script>
<%- include('../../partials/foot') %>
