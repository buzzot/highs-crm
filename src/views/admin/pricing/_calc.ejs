<%#
  Shared pricing calculator / quote form.
  locals: q (values), action (form url), settings, products, suppliers, requests, incoterms, currencies, [readonly], [submitLabel]
%>
<% const ro = typeof readonly !== 'undefined' && readonly; %>
<form method="post" action="<%= action %>" class="calc" id="calcForm" data-min-margin="<%= settings.pricing.min_margin_pct %>">
  <script type="application/json" id="pricingData"><%- JSON.stringify({ fx: settings.fx, products, requests: requests.map(r => ({ id: r.id, quantity: r.quantity, target_unit_price: r.target_unit_price, target_currency: r.target_currency, items: (r.request_items || []).sort((a, b) => a.position - b.position).map(i => ({ id: i.id, name: i.name, quantity: i.quantity, unit: i.unit, target_unit_price: i.target_unit_price })) })) }).replace(/</g, '\\u003c') %></script>
  <fieldset <%= ro ? 'disabled' : '' %>>
  <div class="calcgrid">
    <div class="inputs">
      <label>Client request <select name="request_id" id="f_request"><option value="">— none (calculator only) —</option><option value="__irq__" <%= q.request_id === '__irq__' ? 'selected' : '' %>>＋ New internal request (no client request)…</option><% requests.forEach(r => { %><option value="<%= r.id %>" <%= q.request_id === r.id ? 'selected' : '' %>><%= r.ref %> · <%= r.title %> · <%= r.organizations?.name || '' %></option><% }) %></select></label>
      <div id="irq_box" class="irqbox" <%= q.request_id === '__irq__' ? '' : 'hidden' %>>
        <p class="muted small">No client asked for this. A request numbered IRQ-… is created in Sourcing so the quote stays traceable.</p>
        <div class="row">
          <label class="grow2">Client <select name="irq_org"><option value="">— choose —</option><% (typeof orgs !== 'undefined' ? orgs : []).forEach(o => { %><option value="<%= o.id %>" <%= q.irq_org === o.id ? 'selected' : '' %>><%= o.name %></option><% }) %></select></label>
          <label class="grow2">Request title <span class="muted small">optional — defaults to the product</span><input name="irq_title" value="<%= q.irq_title || '' %>"></label>
        </div>
        <div class="row">
          <label class="grow2">Destination country <input name="irq_country" value="<%= q.irq_country || '' %>" placeholder="e.g. Germany"></label>
          <label class="grow2">Destination city / port <input name="irq_city" value="<%= q.irq_city || '' %>" placeholder="e.g. Hamburg"></label>
          <label>Needed by <input type="date" name="irq_needed" value="<%= q.irq_needed || '' %>"></label>
        </div>
      </div>
      <% const selReq = requests.find(r => r.id === q.request_id); const selItems = (selReq?.request_items || []).slice().sort((a, b) => a.position - b.position); %>
      <label id="f_item_wrap" <%= selItems.length ? '' : 'hidden' %>>Product in this request
        <select name="request_item_id" id="f_item"><option value="">— whole request —</option><% selItems.forEach(i => { %><option value="<%= i.id %>" <%= q.request_item_id === i.id ? 'selected' : '' %>><%= i.name %><%= i.quantity ? ' · ' + i.quantity + ' ' + (i.unit || 'pcs') : '' %></option><% }) %></select></label>
      <div class="row">
        <label class="grow2">Product <select name="product_id" id="f_product"><option value="">— custom —</option><option value="__new__">＋ New product…</option><% products.forEach(p => { %><option value="<%= p.id %>" <%= q.product_id === p.id ? 'selected' : '' %>><%= p.name %><%= p.sku ? ' · ' + p.sku : '' %></option><% }) %></select></label>
        <label class="grow2">Supplier <span class="muted small" id="f_supplier_note" hidden>from the product</span><select name="supplier_id" id="f_supplier"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" data-lead="<%= s.lead_time_days || '' %>" <%= q.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
      </div>
      <h3>Product cost</h3>
      <div class="row">
        <label>Quantity <input type="number" min="1" name="quantity" id="f_qty" required value="<%= q.quantity ?? '' %>"><span class="hint" id="moqHint"></span></label>
        <label>Supplier unit cost <input type="number" step="0.0001" name="unit_cost" id="f_cost" required value="<%= q.unit_cost ?? '' %>"></label>
        <label>Cost currency <select name="cost_currency" id="f_ccur"><% currencies.forEach(c => { %><option <%= q.cost_currency === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      </div>
      <div class="row">
        <label>Sell currency <select name="sell_currency" id="f_scur"><% currencies.forEach(c => { %><option <%= q.sell_currency === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
        <label>FX rate <input type="number" step="0.000001" name="fx_rate" id="f_fx" required value="<%= q.fx_rate ?? 1 %>"><span class="hint">cost → sell currency</span></label>
        <label>Margin % on cost <input type="number" step="0.1" name="margin_pct" id="f_margin" required value="<%= q.margin_pct ?? settings.pricing.default_margin_pct %>"><span class="hint">min <%= settings.pricing.min_margin_pct %>%</span></label>
      </div>
      <div class="row">
        <label>Or target unit price → margin <input type="number" step="0.0001" id="f_target" placeholder="solve for margin"></label>
      </div>
      <h3>Logistics estimate <span class="muted small">— passed through, not part of margin</span></h3>
      <details class="helper">
        <summary class="link small">Freight helper</summary>
        <div class="row">
          <label>Mode <select id="h_mode"><option value="cbm">Sea LCL (per cbm)</option><option value="fcl">Sea FCL (per container)</option><option value="kg">Air / express (per kg)</option></select></label>
          <label>Rate <input type="number" step="0.01" id="h_rate" placeholder="e.g. 85"></label>
          <label>Duty % <input type="number" step="0.1" id="h_duty" placeholder="destination duty"></label>
          <button type="button" class="btn small" id="h_apply">Apply</button>
        </div>
        <p class="hint" id="h_note">Uses the product's carton size/weight × quantity.</p>
      </details>
      <div class="row">
        <label>Freight total <input type="number" step="0.01" name="freight_estimate" id="f_freight" value="<%= q.freight_estimate ?? 0 %>"></label>
        <label>Duties & taxes total <input type="number" step="0.01" name="duties_estimate" id="f_duties" value="<%= q.duties_estimate ?? 0 %>"></label>
        <label>Other total <input type="number" step="0.01" name="other_costs" id="f_other" value="<%= q.other_costs ?? 0 %>"></label>
      </div>
      <h3>Terms</h3>
      <div class="row">
        <label>Incoterm <select name="incoterm"><% incoterms.forEach(i => { %><option <%= q.incoterm === i ? 'selected' : '' %>><%= i %></option><% }) %></select></label>
        <label>Lead time days <input type="number" name="lead_time_days" id="f_lead" value="<%= q.lead_time_days ?? '' %>"></label>
        <label>Valid until <input type="date" name="valid_until" value="<%= q.valid_until || '' %>"></label>
      </div>
      <label>Note to client <textarea name="notes" rows="2"><%= q.notes || '' %></textarea></label>
    </div>

    <div class="results card inset" id="results" aria-live="polite">
      <div class="big"><span class="l">Unit price ex-logistics</span><span class="n" id="r_unit">—</span></div>
      <div class="big"><span class="l">Landed unit price</span><span class="n" id="r_landed">—</span></div>
      <dl class="dl tight">
        <dt>Unit cost in sell ccy</dt><dd id="r_ucs">—</dd>
        <dt>Logistics / unit</dt><dd id="r_lpu">—</dd>
        <dt>Goods total</dt><dd id="r_goods">—</dd>
        <dt>Product cost total</dt><dd id="r_costtot">—</dd>
        <dt>Gross profit</dt><dd id="r_profit">—</dd>
        <dt>Landed total</dt><dd id="r_landedtot">—</dd>
        <dt>vs client target</dt><dd id="r_target">—</dd>
      </dl>
      <div id="r_margin" class="marginbadge">—</div>
      <ul id="r_warn" class="warnings"></ul>
      <div id="aiBox" class="ai hidden"></div>
    </div>
  </div>
  </fieldset>
  <% if (!ro) { %>
  <div class="actions sticky">
    <button type="button" class="btn" id="aiCheck">AI check</button>
    <button class="btn" name="action" value="save"><%= typeof submitLabel !== 'undefined' ? submitLabel : 'Save quote' %></button>
    <button class="btn primary" name="action" value="verify">Save & AI verify</button>
  </div>
  <% } %>
</form>
<% if (!ro) { %>
<dialog id="newProdDlg" class="bookdlg">
  <h2>New product</h2>
  <p class="muted small" style="margin-top:-6px">Quick add — you can complete the weights, sizes and photos later in Products.</p>
  <dl class="bookfacts">
    <dt>Product name</dt><dd><input id="np_name" maxlength="200"></dd>
    <dt>SKU / part no.</dt><dd><input id="np_sku" maxlength="80"></dd>
    <dt>Supplier</dt><dd><select id="np_supplier"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></dd>
    <dt>Unit cost</dt><dd><input type="number" step="0.0001" min="0" id="np_cost" style="width:120px"> <select id="np_ccur" style="width:auto"><% currencies.forEach(c => { %><option <%= c === 'CNY' ? 'selected' : '' %>><%= c %></option><% }) %></select></dd>
    <dt>MOQ</dt><dd><input type="number" min="1" id="np_moq" style="width:120px"></dd>
  </dl>
  <p class="bad small" id="np_err" hidden></p>
  <div class="actions"><button type="button" class="btn" id="np_cancel">Cancel</button><button type="button" class="btn primary" id="np_save">Add product</button></div>
</dialog>
<% } %>
<script type="module" src="/js/calc.js"></script>
