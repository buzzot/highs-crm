<%- include('../../partials/head') %>
<% const cur = combined.currency, m = (v, d) => fmt.money(v, cur, d); const sentCount = quotes.filter(q => q.status === 'sent').length, accCount = quotes.filter(q => q.status === 'accepted').length; %>
<div class="pagehead"><div><a class="back" href="/admin/sourcing/<%= request.id %>">← <%= request.ref %></a>
  <h1>Quotation <%= request.ref %> <span class="muted">· <%= combined.count %> product<%= combined.count === 1 ? '' : 's' %></span></h1>
  <p class="muted"><a href="/admin/clients/<%= org?.id %>"><%= org?.name %></a> · <%= request.title %><%= request.destination_city || request.destination_country ? ' · to ' + [request.destination_city, request.destination_country].filter(Boolean).join(', ') : '' %></p></div>
  <div class="actions"><a class="btn" href="/admin/pricing/requests/<%= request.id %>/quote.pdf" target="_blank">Quotation PDF</a></div></div>
<% if (combined.mixed) { %><div class="alert err">The lines use different selling currencies, so there is no single total. Edit the lines so they share one currency.</div><% } %>
<div class="card">
  <h2>What the client sees</h2>
  <table class="tbl quotesum">
    <thead><tr><th>Product</th><th class="right">Qty</th><th class="right">Unit price</th><th class="right">Goods</th><th class="right">Freight &amp; logistics</th><th class="right">Line total</th><th></th></tr></thead>
    <tbody>
    <% combined.lines.forEach(l => { const q = quotes.find(x => x.id === l.id) || {}; %>
      <tr>
        <td><strong><%= l.name %></strong><div class="muted small"><%= [l.sku, q.suppliers?.name].filter(Boolean).join(' · ') %></div></td>
        <td class="right"><%= l.quantity.toLocaleString('en-US') %></td>
        <td class="right"><%= m(l.shown.unit_price, 4) %><% if (l.shown.included) { %><div class="muted small">factory-sell <%= m(l.unit_price, 4) %> + freight <%= m(l.logistics) %></div><% } %></td>
        <td class="right"><%= m(l.shown.goods) %></td>
        <td class="right"><%= l.shown.included ? 'included' : m(l.shown.logistics) %></td>
        <td class="right"><strong><%= m(l.total) %></strong></td>
        <td class="right"><% if (q.ai_check) { %><span class="tag <%= q.ai_check.ok ? 'ok' : 'warn' %>" title="AI check score"><%= q.ai_check.score %></span> <% } %><span class="pill <%= q.status %>"><%= fmt.status(q.status || l.status) %></span> <a class="btn small" href="/admin/pricing/quotes/<%= q.id %>">Edit</a></td>
      </tr>
    <% }) %>
    </tbody>
    <tfoot>
      <tr><td colspan="3" class="right muted">Goods total</td><td class="right"><%= m(combined.shown.goodsTotal) %></td><td></td><td></td><td></td></tr>
      <tr><td colspan="4" class="right muted">Freight &amp; logistics<% if (combined.duties || combined.other) { %> <span class="small">(freight <%= m(combined.freight) %>, duties <%= m(combined.duties) %>, other <%= m(combined.other) %>)</span><% } %></td><td class="right"><%= combined.included ? 'included' : m(combined.shown.logisticsTotal) %></td><td></td><td></td></tr>
      <tr class="grand"><td colspan="5" class="right"><strong>Total quotation<%= combined.incoterm ? ' (' + combined.incoterm + ')' : '' %></strong></td><td class="right"><strong><%= combined.mixed ? '—' : m(combined.grandTotal) %></strong></td><td></td></tr>
    </tfoot>
  </table>
  <% if (drafts.length) { %>
  <form method="post" action="/admin/pricing/requests/<%= request.id %>/freight-mode" class="sendall freightmode">
    <span><strong>Freight on the quotation</strong> <span class="muted small">— one setting for all lines</span></span>
    <select name="freight_mode"><option value="separate" <%= !combined.included ? 'selected' : '' %>>Shown as a separate line</option><option value="included" <%= combined.included ? 'selected' : '' %>>Included in the unit prices</option></select>
    <button class="btn small">Apply</button>
  </form>
  <% } else if (combined.included) { %><p class="small"><span class="tag ok">Freight included in the prices</span> <span class="muted">the client sees all-in unit prices and no freight line.</span></p><% } %>
  <p class="muted small">Lead time <%= combined.lead_time_days ? combined.lead_time_days + ' days (the longest line)' : '—' %> · valid until <%= combined.valid_until ? fmt.date(combined.valid_until) : '—' %> (the earliest line). Freight is an estimate. The client accepts all lines in one click and sends one purchase order.</p>
</div>
<% if (combined.cost != null) { %>
<div class="card">
  <h2>Internal <span class="muted small">staff only — not shown to the client</span></h2>
  <div class="pay-kpis">
    <div><span class="muted small">Product cost</span><strong><%= m(combined.cost) %></strong></div>
    <div><span class="muted small">Gross profit</span><strong><%= m(combined.profit) %></strong></div>
    <div><span class="muted small">Margin on cost</span><strong class="<%= combined.marginPct < min ? 'bad' : '' %>"><%= fmt.pct(combined.marginPct) %></strong></div>
    <div><span class="muted small">Lines below <%= min %>%</span><strong class="<%= low ? 'bad' : '' %>"><%= low %></strong></div>
    <% if (combined.included) { %><div><span class="muted small">Freight &amp; logistics inside the prices</span><strong><%= m(combined.logisticsTotal) %></strong></div><% } %>
    <div><span class="muted small">Lines with AI check</span><strong><%= drafts.length - noAi %> / <%= drafts.length %></strong></div>
  </div>
</div>
<% } %>
<div class="card">
  <h2>Next step</h2>
  <% if (drafts.length) { %>
    <form method="post" action="/admin/pricing/requests/<%= request.id %>/verify-all" class="sendall aiall">
      <span><%= noAi ? `${noAi} of ${drafts.length} line${drafts.length === 1 ? ' has' : 's have'} no AI check yet.` : 'Every line has an AI check.' %> Scores show next to each line.</span>
      <% if (!noAi) { %><input type="hidden" name="again" value="1"><% } %>
      <button class="btn"><%= noAi ? 'Run AI check on all lines' : 'Run AI check again' %></button>
    </form>
    <form method="post" action="/admin/pricing/requests/<%= request.id %>/send-all" class="sendall">
      <span><strong><%= drafts.length %></strong> draft line<%= drafts.length === 1 ? '' : 's' %> go out as one quotation<%= combined.mixed ? '' : ' of ' + m(combined.grandTotal) %>, with the PDF attached.</span>
      <label class="check"><input type="checkbox" name="skip_ai"> without AI check</label>
      <% if (user.role === 'admin') { %><label class="check"><input type="checkbox" name="override"> margin override</label><input name="reason" placeholder="override reason" class="short"><% } %>
      <button class="btn primary" onclick="return confirm('Send this quotation to the client now?')">Send quotation to client</button>
    </form>
  <% } else if (sentCount) { %><p class="muted"><%= sentCount %> line<%= sentCount === 1 ? '' : 's' %> sent — waiting for the client to accept.</p>
  <% } else if (accCount) { %><p class="muted">Accepted by the client. The purchase order follows.</p>
  <% } else { %><p class="muted">No lines yet. <a href="/admin/pricing/quotes/new?request_id=<%= request.id %>">Add a quote line</a>.</p><% } %>
</div>
<%- include('../../partials/foot') %>
