<%- include('../partials/head') %>
<% const mon = (v, c) => fmt.money(v, c || defCur, 0); const trunc = (t, n) => { t = String(t || ''); return t.length > n ? t.slice(0, n - 1) + '…' : t; };
   const LV = { critical: 'Critical', overdue: 'Overdue', review: 'Review', pending: 'Pending' };
   const nCrit = attention.filter(a => a.level === 'critical').length, nOver = attention.filter(a => a.level === 'overdue').length;
   const shownAttn = attention.slice(0, 7), moreAttn = attention.slice(7);
   %>
<div class="db">
<header class="db-head">
  <div><h1>Dashboard</h1><p class="db-sub">Live snapshot · <time id="gen" datetime="<%= generatedAt %>"><%= fmt.date(today) %></time> <a class="db-refresh" href="/admin" title="Reload the latest data">↻ Refresh</a></p></div>
  <div class="db-tools">
    <a class="db-link" href="/admin/pricing/quotes/new">New quote</a>
    <a class="db-link" href="/admin/clients/new">New client</a>
    <a class="btn primary" href="/admin/orders/new">+ New order</a>
  </div>
</header>

<section class="db-kpis" aria-label="Key figures">
  <a class="db-kpi" href="/admin/orders"><span class="l">Open orders</span><span class="n"><%= kpi.openOrders %></span><span class="s"><%= kpi.shippingOrders %> shipped or in transit</span></a>
  <a class="db-kpi" href="/admin/sourcing"><span class="l">Requests to quote<% if (kpi.toPrice) { %><i class="dotk warn" title="Needs action"></i><% } %></span><span class="n"><%= kpi.toPrice %></span><span class="s"><%= kpi.rfqParsed %> RFQ <%= kpi.rfqParsed === 1 ? 'reply' : 'replies' %> to review</span></a>
  <a class="db-kpi" href="/admin/purchasing"><span class="l">POs awaiting supplier<% if (kpi.poReplied) { %><i class="dotk warn" title="Replies to review"></i><% } %></span><span class="n"><%= kpi.poWait + kpi.poReplied %></span><span class="s"><%= kpi.poWait %> waiting · <%= kpi.poReplied %> replied</span></a>
  <a class="db-kpi" href="/admin/purchasing"><span class="l">PIs to review<% if (kpi.piPending) { %><i class="dotk warn" title="Needs action"></i><% } %></span><span class="n"><%= kpi.piPending %></span><span class="s"><%= kpi.piPending ? 'Draft, not yet approved' : 'All approved' %></span></a>
  <a class="db-kpi" href="/admin/purchasing"><span class="l">Owed to suppliers</span><span class="n"><%= kpi.owingN ? mon(kpi.owingTotal) : mon(0) %></span><span class="s"><%= kpi.owingN %> approved PI<%= kpi.owingN === 1 ? '' : 's' %> unpaid</span></a>
  <a class="db-kpi" href="/admin/logistics"><span class="l">In transit</span><span class="n"><%= kpi.inTransit %></span><span class="s"><%= kpi.arriving %> arriving this week</span></a>
</section>

<div class="db-main">
<div class="db-col">
  <section class="db-card s-act" aria-labelledby="h-action">
    <div class="db-ch"><h2 id="h-action">Action center</h2>
      <% if (nCrit) { %><span class="chip crit"><%= nCrit %> critical</span><% } %><% if (nOver) { %><span class="chip over"><%= nOver %> overdue</span><% } %>
      <% if (!nCrit && !nOver && attention.length) { %><span class="chip"><%= attention.length %> open</span><% } %>
      <% if (canSwitch) { %><nav class="db-seg" aria-label="Task owner"><a href="/admin?scope=mine" class="<%= taskScope === 'mine' ? 'on' : '' %>" <%= taskScope === 'mine' ? 'aria-current=true' : '' %>>My tasks <b><%= scopeCounts.mine %></b></a><a href="/admin" class="<%= taskScope === 'all' ? 'on' : '' %>" <%= taskScope === 'all' ? 'aria-current=true' : '' %>>All tasks <b><%= scopeCounts.all %></b></a></nav><% } %></div>
    <% if (!attention.length) { %>
      <p class="db-empty"><span class="okmark">✓</span> <strong>All caught up.</strong> <%= taskScope === 'mine' ? 'Nothing is waiting on your records.' : 'Nothing is waiting for you.' %><br><span class="muted">Open <a href="/admin/sourcing">Requests</a> or <a href="/admin/rfqs">RFQs</a> to start something new.</span></p>
    <% } else { %>
    <ul class="db-act2">
      <% const row = a => { %>
        <li class="lv-<%= a.level %>"><a href="<%= a.href %>">
          <span class="lvl"><%= LV[a.level] %></span>
          <span class="main"><span class="t"><b><%= a.ref %></b><% if (a.party) { %> <span class="muted">· <%= trunc(a.party, 30) %></span><% } %></span><span class="a"><%= a.action %></span></span>
          <span class="w"><%= a.when %><span class="cta"><%= a.cta %> →</span></span></a></li>
      <% }; shownAttn.forEach(row) %>
    </ul>
    <% if (moreAttn.length) { %>
      <details class="db-moreact"><summary>Show <%= moreAttn.length %> more</summary><ul class="db-act2"><% moreAttn.forEach(row) %></ul></details>
    <% } %>
    <% } %>
  </section>

  <section class="db-card s-ship" aria-labelledby="h-ship">
    <div class="db-ch"><h2 id="h-ship">Shipments</h2><a class="more" href="/admin/logistics">View all<%= shipTotal > shipments.length ? ` (${shipTotal})` : '' %></a></div>
    <% if (!shipments.length) { %>
      <p class="db-empty">No shipments on the move.<br><a href="/admin/logistics">Open Logistics</a></p>
    <% } else { %>
    <div class="tblwrap"><table class="db-tbl">
      <thead><tr><th>Order</th><th class="c-cust">Customer</th><th>Status</th><th>ETA</th></tr></thead><tbody>
      <% shipments.forEach(s => { %>
        <tr>
          <td><a class="ref" href="/admin/logistics/shipments/<%= s.id %>"><%= s.orders?.order_no || 'Shipment' %></a><% if (s.mode) { %><div class="muted small"><%= fmt.status(s.mode).toUpperCase() %></div><% } %><div class="mob muted small"><%= trunc(s.orders?.organizations?.name, 24) %></div></td>
          <td class="clip c-cust" title="<%= s.orders?.organizations?.name %>"><%= s.orders?.organizations?.name || '—' %></td>
          <td><span class="pill <%= s.status %>"><%= fmt.status(s.status) %></span></td>
          <td class="nowrap"><%= s.eta ? fmt.date(s.eta) : '—' %>
            <% if (s.flag?.kind === 'late') { %><span class="flag bad">Late <%= s.flag.days %> d</span>
            <% } else if (s.flag?.kind === 'soon') { %><span class="flag warn">In <%= s.flag.days %> d</span>
            <% } else if (s.flag?.kind === 'notrack') { %><span class="flag info">No tracking</span><% } %></td>
        </tr>
      <% }) %>
      </tbody></table></div>
    <% } %>
  </section>
</div>
<div class="db-col">
  <section class="db-card s-ord" aria-labelledby="h-orders">
    <div class="db-ch"><h2 id="h-orders">Active orders</h2>
      <% if (openTotal) { %><span class="db-meta"><%= groups.production %> in production · <%= groups.shipping %> shipping</span><% } %>
      <a class="more" href="/admin/orders">View all<%= openTotal > 6 ? ` (${openTotal})` : '' %></a></div>
    <% if (!orders.length) { %>
      <p class="db-empty">No active orders.<br><a href="/admin/orders/new">Create an order</a> <span class="muted">or accept a quote to start one.</span></p>
    <% } else { %>
    <div class="tblwrap"><table class="db-tbl">
      <thead><tr><th>Order</th><th class="c-cust">Customer</th><th>Status</th><th class="r">Value</th><th class="c-exp">Expected</th><th class="c-upd">Updated</th></tr></thead>
      <tbody>
      <% orders.slice(0, 6).forEach(o => { const exp = o.latest_eta || o.expected_ship_date; %>
        <tr>
          <td><a class="ref" href="/admin/orders/<%= o.id %>"><%= o.order_no %></a><div class="mob muted small"><%= trunc(o.client_name, 26) %></div></td>
          <td class="clip c-cust" title="<%= o.client_name %>"><%= o.client_name %></td>
          <td><span class="pill <%= o.status %>"><%= fmt.status(o.status) %></span></td>
          <td class="r"><%= Number(o.subtotal) > 0 ? mon(o.subtotal, o.currency) : '—' %></td>
          <td class="nowrap c-exp <%= exp && exp < today && ['shipped','in_transit','customs'].includes(o.status) ? 'bad' : '' %>"><%= exp ? fmt.date(exp) : '—' %></td>
          <td class="muted nowrap c-upd"><%= o.updated_at ? ago(o.updated_at) : '—' %></td>
        </tr>
      <% }) %>
      </tbody></table></div>
    <% } %>
  </section>

  <section class="db-card s-feed" aria-labelledby="h-act">
    <div class="db-ch"><h2 id="h-act">Recent activity</h2></div>
    <% if (!activity.length) { %><p class="db-empty">No activity yet.</p><% } else { %>
    <ul class="db-feed">
      <% activity.forEach(e => { %>
        <li><span class="a"><% if (e.href) { %><a href="<%= e.href %>"><%= e.text %></a><% } else { %><%= e.text %><% } %><%= e.n > 1 ? ` ×${e.n}` : '' %><% if (e.record) { %><span class="muted"> · <%= e.record %></span><% } %></span>
          <span class="m"><%= e.who || 'System' %> · <%= ago(e.at) %></span></li>
      <% }) %>
    </ul>
    <% } %>
  </section>
</div>
</div>
</div>
<script>
(function () {
  var t = document.getElementById('gen');
  function stamp() { try { t.textContent = 'updated ' + new Date(t.getAttribute('datetime')).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); } catch (e) {} }
  stamp();
  // keep supplier replies and task states fresh: reload every 5 minutes while the tab is visible and nothing is being typed
  setInterval(function () { if (!document.hidden && !/INPUT|SELECT|TEXTAREA/.test((document.activeElement || {}).tagName || '')) location.reload(); }, 300000);
})();
</script>
<%- include('../partials/foot') %>
