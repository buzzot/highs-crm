<%- include('../../partials/head') %>
<div class="card narrow-md">
  <a class="back" href="/admin/orders">← Orders</a>
  <h1>New order</h1>
  <p class="muted">Most orders are created from an accepted quote on the Sourcing page. Use this for repeat orders or deals agreed offline — add items on the next screen.</p>
  <form method="post" action="/admin/orders">
    <div class="row">
      <label class="grow2">Client <select name="org_id" required><option value="">—</option><% clients.forEach(c => { %><option value="<%= c.id %>" <%= org === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %><option value="__new">+ Add new client…</option></select></label>
      <label>Currency <select name="currency"><% currencies.forEach(c => { %><option <%= c === defCur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
    </div>
    <div class="newsup" id="newClient" hidden>
      <strong>New client</strong> <span class="muted small">— just the basics; complete the rest on the client page, where you can also invite their users</span>
      <div class="row">
        <label class="grow2">Company name <input id="nc_name" maxlength="200"></label>
        <label>Country <input id="nc_country"></label>
        <label>City <input id="nc_city"></label>
      </div>
      <div class="row">
        <label>Email <input type="email" id="nc_email"></label>
        <label>Phone <input id="nc_phone"></label>
        <label>Currency <select id="nc_cur"><% currencies.forEach(c => { %><option <%= c === defCur ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
      </div>
      <div class="aiscan-msg err" id="nc_err" hidden></div>
      <div class="actions"><button type="button" class="btn small primary" id="nc_save">Add client</button><button type="button" class="btn small" id="nc_cancel">Cancel</button></div>
    </div>
    <div class="row">
      <label class="grow2">Supplier <select name="supplier_id" id="o_sup"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %><option value="__new">+ Add new supplier…</option></select></label>
      <label>Expected ship date <input type="date" name="expected_ship_date"></label>
    </div>
    <div class="newsup" id="newSup" hidden>
      <strong>New supplier</strong> <span class="muted small">— just the basics; complete the rest later on the supplier page</span>
      <div class="row">
        <label class="grow2">Company name <input id="ns_name" maxlength="200"></label>
        <label>Contact person <input id="ns_contact"></label>
        <label>City <input id="ns_city"></label>
      </div>
      <div class="row">
        <label>Email <input type="email" id="ns_email"></label>
        <label>Phone <input id="ns_phone"></label>
        <label>WeChat <input id="ns_wechat"></label>
      </div>
      <div class="aiscan-msg err" id="ns_err" hidden></div>
      <div class="actions"><button type="button" class="btn small primary" id="ns_save">Add supplier</button><button type="button" class="btn small" id="ns_cancel">Cancel</button></div>
    </div>
    <label>Note for client <textarea name="client_notes" rows="2"></textarea></label>
    <label>Internal notes <textarea name="internal_notes" rows="2"></textarea></label>
    <div class="actions"><button class="btn primary">Create order</button></div>
  </form>
</div>
<script>
  // "+ Add new client…": create the client in place, select it and use its currency
  (function () {
    const sel = document.querySelector('select[name=org_id]'), cur = document.querySelector('select[name=currency]'), box = document.getElementById('newClient'); if (!sel || !box) return;
    const $ = id => document.getElementById(id); let prev = sel.value;
    const err = t => { const e = $('nc_err'); e.hidden = !t; e.textContent = t || ''; };
    const close = () => { box.hidden = true; err(''); if (sel.value === '__new') sel.value = prev; };
    sel.addEventListener('change', () => { if (sel.value === '__new') { box.hidden = false; $('nc_cur').value = cur.value; $('nc_name').focus(); } else { prev = sel.value; box.hidden = true; } });
    $('nc_cancel').addEventListener('click', close);
    $('nc_save').addEventListener('click', async () => {
      const name = $('nc_name').value.trim(); if (!name) return err('Enter the client name.');
      const btn = $('nc_save'); btn.disabled = true; err('');
      try {
        const res = await fetch('/admin/orders/quick-client', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, country: $('nc_country').value, city: $('nc_city').value, email: $('nc_email').value, phone: $('nc_phone').value, default_currency: $('nc_cur').value }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Could not add the client.');
        if (![...sel.options].some(o => o.value === j.id)) sel.insertBefore(new Option(j.name, j.id), sel.querySelector('option[value=__new]'));
        sel.value = j.id; prev = j.id; box.hidden = true;
        const c = j.default_currency || $('nc_cur').value; if ([...cur.options].some(o => o.value === c || o.text === c)) cur.value = c;
        ['nc_name', 'nc_country', 'nc_city', 'nc_email', 'nc_phone'].forEach(i => { $(i).value = ''; });
      } catch (e) { err(e.message); } finally { btn.disabled = false; }
    });
    sel.form.addEventListener('submit', () => { if (sel.value === '__new') sel.value = prev; });
  })();
</script>
<script>
  // "+ Add new supplier…": create the supplier in place and select it (the PO itself is created with the normal button)
  (function () {
    const sel = document.getElementById('o_sup'), box = document.getElementById('newSup'); if (!sel || !box) return;
    const $ = id => document.getElementById(id); let prev = sel.value;
    const err = t => { const e = $('ns_err'); e.hidden = !t; e.textContent = t || ''; };
    const close = () => { box.hidden = true; err(''); if (sel.value === '__new') { sel.value = prev; } };
    sel.addEventListener('change', () => { if (sel.value === '__new') { box.hidden = false; $('ns_name').focus(); } else { prev = sel.value; box.hidden = true; } });
    $('ns_cancel').addEventListener('click', close);
    $('ns_save').addEventListener('click', async () => {
      const name = $('ns_name').value.trim(); if (!name) return err('Enter the supplier name.');
      const btn = $('ns_save'); btn.disabled = true; err('');
      try {
        const res = await fetch('/admin/products/quick-supplier', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, contact_name: $('ns_contact').value, city: $('ns_city').value, email: $('ns_email').value, phone: $('ns_phone').value, wechat: $('ns_wechat').value }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Could not add the supplier.');
        if (![...sel.options].some(o => o.value === j.id)) sel.insertBefore(new Option(j.name, j.id), sel.querySelector('option[value=__new]'));
        sel.value = j.id; prev = j.id; box.hidden = true;
        ['ns_name', 'ns_contact', 'ns_city', 'ns_email', 'ns_phone', 'ns_wechat'].forEach(i => { $(i).value = ''; });
      } catch (e) { err(e.message); } finally { btn.disabled = false; }
    });
    sel.form.addEventListener('submit', () => { if (sel.value === '__new') sel.value = prev; });
  })();
</script>
<%- include('../../partials/foot') %>
