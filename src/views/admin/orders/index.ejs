<%- include('../../partials/head') %>
<div class="pagehead">
  <h1>Orders</h1>
  <a class="btn primary" href="/admin/orders/new">+ New order</a>
</div>
<%- include('../../partials/viewtabs', { base: '/admin/orders', view: status, counts: vcounts, statuses, byStatus, label: s => fmt.status(s), keep: (query.client ? 'client=' + query.client : '') }) %>
<div class="card">
  <form class="row tight live-form" method="get" data-live>
    <input type="hidden" name="status" value="<%= status %>">
    <input name="q" value="<%= query.q || '' %>" placeholder="Order no, client, supplier…">
    <select data-picker="Client" name="client"><option value="">All clients</option><% clients.forEach(c => { %><option value="<%= c.id %>" <%= query.client === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
    <button class="btn live-hide">Filter</button>
  </form>
  <div data-live-results>
  <table class="tbl">
    <thead><tr><th>Order</th><th>Client</th><th>Supplier</th><th>Status</th><th class="right">Goods</th><th class="right">Cost</th><th class="right">Freight</th><th class="right">Margin</th><th class="right">Gross profit</th><th>Ship / ETA</th></tr></thead>
    <tbody>
    <% if (!orders.length) { %><tr><td colspan="10" class="muted"><%= status === 'open' && vcounts.closed && !query.q && !query.client ? 'No active orders — ' + vcounts.closed + ' closed (delivered or cancelled) are under Closed.' : 'No orders.' %></td></tr><% } %>
    <% let tg = 0, tp = 0; orders.forEach(o => { const cx = o.status === 'cancelled'; if (!cx) { tg += Number(o.subtotal||0); tp += Number(o.gross_profit||0); } %>
      <tr class="<%= cx ? 'dim' : '' %>">
        <td><a href="/admin/orders/<%= o.id %>"><strong><%= o.order_no %></strong></a><div class="muted small"><%= fmt.date(o.created_at) %></div></td>
        <td><%= o.client_name %></td>
        <td class="small"><%= o.supplier_name || '—' %></td>
        <td><span class="pill <%= o.status %>"><%= fmt.status(o.status) %></span></td>
        <td class="right"><%= fmt.money(o.subtotal, o.currency, 0) %></td>
        <td class="right muted"><%= fmt.money(o.cost_total, o.currency, 0) %></td>
        <td class="right muted"><%= fmt.money(o.freight_total, o.currency, 0) %></td>
        <td class="right <%= !cx && o.margin_pct != null && o.margin_pct < 20 ? 'bad' : '' %>"><%= cx ? '—' : fmt.pct(o.margin_pct) %></td>
        <td class="right" <%- o.profit_on_received ? 'title="Profit on money received (confirmed payments − cost − logistics)"' : '' %>><%= cx ? '—' : fmt.money(o.gross_profit, o.currency, 0) %></td>
        <td class="small"><%= o.latest_eta ? 'ETA ' + fmt.date(o.latest_eta) : (o.expected_ship_date ? 'ship ' + fmt.date(o.expected_ship_date) : '—') %></td>
      </tr>
    <% }) %>
    <% if (orders.length) { %><tr class="total"><td colspan="4"><%= orders.length %> orders<% if (totals.mixed) { %> <span class="muted small">· totals converted to <%= defCur %></span><% } %></td><td class="right"><%= fmt.money(totals.goods, defCur, 0) %></td><td colspan="3"></td><td class="right"><%= fmt.money(totals.profit, defCur, 0) %></td><td></td></tr><% } %>
    </tbody>
  </table>
  <% if (closedHits) { %><div class="vhint"><%= closedHits %> more match<%= closedHits === 1 ? 'es' : '' %> in Closed orders · <a href="/admin/orders?status=closed&q=<%= encodeURIComponent(query.q || '') %><%= query.client ? '&client=' + query.client : '' %>">Show them</a></div><% } %>
  </div>
</div>
<%- include('../../partials/foot') %>
