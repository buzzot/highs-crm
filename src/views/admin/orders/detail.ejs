<%- include('../../partials/head') %>
<% const steps = ['new','confirmed','deposit_paid','in_production','qc','packed','shipped','in_transit','customs','delivered','closed']; const idx = steps.indexOf(order.status); const cur = order.currency; %>
<div class="pagehead">
  <div><a class="back" href="/admin/orders">← Orders</a><h1>Order <%= order.order_no %></h1>
    <p class="muted"><a href="/admin/clients/<%= order.org_id %>"><%= order.client_name %></a>
      <% if (order.supplier_id) { %> · supplier <a href="/admin/suppliers/<%= order.supplier_id %>"><%= order.supplier_name %></a><% } %>
      <% if (order.request_id) { %> · <a href="/admin/sourcing/<%= order.request_id %>">request</a><% } %>
      <% if (order.quote_id) { %> · <a href="/admin/pricing/quotes/<%= order.quote_id %>">quote</a><% } %></p></div>
  <span class="pill lg <%= order.status %>"><%= fmt.status(order.status) %></span>
</div>

<div class="card">
  <ol class="steps"><% steps.forEach((s, i) => { %><li class="<%= i < idx ? 'done' : i === idx ? 'now' : '' %>"><%= fmt.status(s) %></li><% }) %></ol>
  <form method="post" action="/admin/orders/<%= order.id %>/status" class="row tight statusform">
    <select name="status"><% statuses.forEach(s => { %><option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= fmt.status(s) %></option><% }) %></select>
    <input name="note" placeholder="Update note (optional) — e.g. 'Production 60% done'">
    <label class="check"><input type="checkbox" name="client_visible" checked> show client</label>
    <button class="btn primary">Update</button>
  </form>
</div>

<div class="kpis five">
  <div class="kpi"><span class="n"><%= fmt.money(order.subtotal, cur) %></span><span class="l">Goods (client)</span></div>
  <div class="kpi"><span class="n"><%= fmt.money(order.cost_total, cur) %></span><span class="l">Product cost</span></div>
  <div class="kpi <%= order.margin_pct != null && order.margin_pct < 20 ? 'bad' : '' %>"><span class="n"><%= fmt.pct(order.margin_pct) %></span><span class="l">Margin on cost (min 20%)</span></div>
  <div class="kpi"><span class="n"><%= fmt.money(order.freight_total, cur) %></span><span class="l">Logistics (actual)</span></div>
  <div class="kpi"><span class="n"><%= fmt.money(order.gross_profit, cur) %></span><span class="l">Gross profit after logistics</span></div>
</div>

<div class="grid2">
  <div>
    <div class="card">
      <h2>Items</h2>
      <table class="tbl">
        <thead><tr><th>Description</th><th>HS</th><th>Qty</th><th class="right">Unit cost</th><th class="right">Unit price</th><th class="right">Landed / unit</th><th class="right">Total</th><th></th></tr></thead>
        <tbody>
        <% land.items.forEach(i => { %>
          <tr>
            <td><%= i.description %><% if (i.products) { %><div class="small"><a href="/admin/products/<%= i.products.id %>"><%= i.products.sku || 'product' %></a></div><% } %></td>
            <td class="small"><%= i.hs_code || '—' %></td>
            <td><%= i.quantity %></td>
            <td class="right muted"><%= fmt.money(i.unit_cost, cur, 4) %></td>
            <td class="right"><%= fmt.money(i.unit_price, cur, 4) %></td>
            <td class="right" title="client price + share of logistics"><%= fmt.money(i.landed_unit_price, cur, 4) %></td>
            <td class="right"><%= fmt.money(i.quantity * i.unit_price, cur) %></td>
            <td class="right"><form method="post" action="/admin/orders/<%= order.id %>/items/<%= i.id %>/delete" class="inline" onsubmit="return confirm('Remove item?')"><button class="link small danger">×</button></form></td>
          </tr>
        <% }) %>
        <tr class="total"><td colspan="6">Goods total · logistics spread <%= fmt.money(land.freightPerUnit, cur, 4) %>/unit over <%= land.qty %> units</td><td class="right"><%= fmt.money(order.subtotal, cur) %></td><td></td></tr>
        </tbody>
      </table>
      <details>
        <summary class="btn small">+ Add item</summary>
        <form method="post" action="/admin/orders/<%= order.id %>/items" class="sub">
          <div class="row">
            <label class="grow2">Product <select name="product_id"><option value="">— custom item —</option><% products.forEach(p => { %><option value="<%= p.id %>"><%= p.name %><%= p.sku ? ' · ' + p.sku : '' %></option><% }) %><option value="__new">+ Add new product…</option></select></label>
            <label class="grow2">Description <input name="description" placeholder="defaults to product name"></label>
          </div>
          <div class="newsup" id="newProd" hidden>
            <strong>New product</strong> <span class="muted small">— saved to the product list; add photos and details later on the product page</span>
            <div class="row">
              <label class="grow2">Product name <input id="np_name" maxlength="200"></label>
              <label>SKU <input id="np_sku" maxlength="80"></label>
              <label>HS code <input id="np_hs" maxlength="40"></label>
            </div>
            <div class="row">
              <label class="grow2">Supplier <select id="np_sup"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= order.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
              <label>Unit cost (<%= cur %>) <input type="number" step="0.0001" min="0" id="np_cost"></label>
            </div>
            <div class="aiscan-msg err" id="np_err" hidden></div>
            <div class="actions"><button type="button" class="btn small primary" id="np_save">Add product</button><button type="button" class="btn small" id="np_cancel">Cancel</button></div>
          </div>
          <div class="row">
            <label>Qty <input type="number" name="quantity" min="1" required></label>
            <label>Unit cost (<%= cur %>) <input type="number" step="0.0001" name="unit_cost"></label>
            <label>Unit price (<%= cur %>) <input type="number" step="0.0001" name="unit_price" required></label>
            <label>HS code <input name="hs_code"></label>
          </div>
          <button class="btn primary">Add</button>
        </form>
      </details>
    </div>

    <div class="card" id="purchasing">
      <% const _spos = typeof spos !== 'undefined' ? spos : []; const _lbl = { draft: 'Draft', sent: 'Waiting for reply', replied: 'Replied — check', confirmed: 'Confirmed', declined: 'Declined', cancelled: 'Cancelled' }; %>
      <h2>Purchasing <span class="count"><%= _spos.length %></span> <span class="hactions"><a class="btn small primary" href="/admin/purchasing/new?order=<%= order.id %>">Create supplier POs</a></span></h2>
      <% if (!_spos.length) { %><p class="muted">No purchase orders to suppliers yet. “Create supplier POs” groups this order's products by supplier — one PO each — and emails them with a request for confirmation, the proforma invoice and an estimated packing list.</p><% } else { %>
      <table class="tbl compact"><tbody>
        <% _spos.forEach(p => { %><tr><td><a href="/admin/purchasing/<%= p.id %>"><strong><%= p.ref %></strong></a></td><td><%= p.suppliers?.name || '—' %></td><td class="right"><%= fmt.money(p.total, p.currency) %></td><td><span class="pill spo-<%= p.status %>"><%= _lbl[p.status] %></span></td><td class="small muted"><%= p.last_reply_at ? 'reply ' + fmt.datetime(p.last_reply_at) : (p.sent_at ? 'sent ' + fmt.datetime(p.sent_at) : '') %></td></tr><% }) %>
      </tbody></table>
      <% } %>
      <% const _free = typeof freePos !== 'undefined' ? freePos : []; if (_free.length) { %>
      <form method="post" action="/admin/purchasing/link" class="linkpo">
        <input type="hidden" name="order_id" value="<%= order.id %>"><input type="hidden" name="redirect" value="/admin/orders/<%= order.id %>#purchasing">
        <span class="muted small">Link a PO made earlier:</span>
        <select name="po_id"><% _free.forEach(p => { %><option value="<%= p.id %>"><%= p.ref %> · <%= p.suppliers?.name || 'supplier' %> · <%= fmt.money(p.total, p.currency) %><%= p.title ? ' · ' + p.title : '' %></option><% }) %></select>
        <button class="btn small">Link to this order</button>
      </form>
      <% } %>
    </div>

    <div class="card">
      <h2>Shipments <a class="more" href="/admin/logistics/shipments/new?order_id=<%= order.id %>">+ shipment</a></h2>
      <% if (!shipments.length) { %><p class="muted">No shipment yet.</p><% } %>
      <table class="tbl"><tbody>
      <% shipments.forEach(s => { const fr = (s.freight_costs||[]).reduce((t,c)=>t+Number(c.amount)*Number(c.fx_to_order||1),0); %>
        <tr>
          <td><a href="/admin/logistics/shipments/<%= s.id %>"><%= fmt.status(s.mode).toUpperCase() %></a><div class="muted small"><%= s.forwarders?.name || 'no forwarder' %></div></td>
          <td class="small"><%= s.origin_port || '—' %> → <%= s.destination_port || '—' %></td>
          <td><span class="pill <%= s.status %>"><%= fmt.status(s.status) %></span></td>
          <td class="small">ETA <%= fmt.date(s.eta) %></td>
          <td class="small"><% if (s.export_declaration_no) { %>Export decl. <%= s.export_declaration_no %><% } else if (s.export_official) { %><span class="bad">no export decl. yet</span><% } else { %>unofficial<% } %></td>
          <td class="right"><%= fmt.money(fr, cur) %></td>
        </tr>
      <% }) %>
      </tbody></table>
    </div>

    <div class="card" id="packing">
      <% const pt = { cartons: 0, pcs: 0, gw: 0, cbm: 0 }; packing.forEach(p => { const c = Number(p.cartons || 1); pt.cartons += c; pt.pcs += (Number(p.quantity) || 0) * c; pt.gw += (Number(p.gross_weight_kg) || 0) * c; pt.cbm += (Number(p.cbm) || 0) * c; }); %>
      <h2>Packing list <span class="muted small"><%= pt.cartons %> cartons · <%= Number(pt.pcs).toLocaleString('en-US') %> pcs · <%= fmt.num(pt.gw, 1) %> kg · <%= fmt.num(pt.cbm, 3) %> cbm</span>
        <span class="hactions"><% if (packing.length) { %><a class="btn small" href="/admin/orders/<%= order.id %>/packing-list/edit">Edit lines</a> <a class="btn small primary" href="/admin/orders/<%= order.id %>/packing-list">Packing list &amp; freight quotes →</a><% } %></span></h2>
      <% if (packing.length) { %>
      <table class="tbl compact"><thead><tr><th>CTN No.</th><th class="right">Ctns</th><th>Contents</th><th class="right">Pcs/ctn</th><th>L×W×H cm</th><th class="right">GW/ctn</th><th class="right">CBM total</th><th></th></tr></thead><tbody>
      <% packing.forEach(p => { const c = Number(p.cartons || 1); %>
        <tr><td><%= p.carton_no %></td><td class="right"><%= c %></td><td><%= p.description %><% if (p.sku) { %> <span class="muted small"><%= p.sku %></span><% } %></td><td class="right"><%= p.quantity ?? '—' %></td>
          <td><%= p.length_cm ? Number(p.length_cm) + '×' + Number(p.width_cm) + '×' + Number(p.height_cm) : '—' %></td>
          <td class="right"><%= p.gross_weight_kg != null ? fmt.num(p.gross_weight_kg, 1) : '—' %></td><td class="right"><%= fmt.num((Number(p.cbm) || 0) * c, 3) %></td>
          <td><form method="post" action="/admin/orders/<%= order.id %>/packing/<%= p.id %>/delete" class="inline"><button class="link small danger" title="Remove line">×</button></form></td></tr>
      <% }) %>
      </tbody></table>
      <% } %>

      <form method="post" action="/admin/orders/<%= order.id %>/packing/import" enctype="multipart/form-data" class="packimport" id="packImport">
        <div class="dropwrap">
          <div class="filedrop compact" data-dropzone data-max="1" data-max-mb="20" tabindex="0">
            <input type="file" name="file" accept=".xlsx,.xlsm,.csv,.pdf,image/*" aria-label="Packing list file">
            <span class="dicon"><%- icon('upload') %></span>
            <strong data-drop-count>Drop the supplier's packing list here, or <span class="dlink">browse</span></strong>
            <span class="muted small dsub">Excel, CSV, PDF or a screenshot (paste with ⌘/Ctrl V) — AI turns it into a standard packing list you check before saving</span>
          </div>
          <div class="fgrid" data-drop-list></div>
        </div>
        <div class="actions"><button class="btn primary" id="packRead">✦ Read packing list</button>
          <details class="inline-details">
            <summary class="btn small">+ Add cartons by hand</summary>
          </details>
          <% if (packing.length) { %><button class="link small danger" formaction="/admin/orders/<%= order.id %>/packing-clear" formenctype="application/x-www-form-urlencoded" onclick="return confirm('Remove all packing lines?')">Clear packing list</button><% } %>
        </div>
      </form>
      <form method="post" action="/admin/orders/<%= order.id %>/packing" class="sub" id="packManual" hidden>
        <div class="row">
          <label>First carton no. <input name="carton_no" required value="<%= pt.cartons + 1 %>"></label>
          <label>Cartons <input type="number" name="copies" min="1" max="5000" value="1"></label>
          <label class="grow2">Contents <input name="description" value="<%= items[0]?.description || '' %>"></label>
          <label>Item / SKU <input name="sku"></label>
          <label>Pcs / carton <input type="number" name="quantity"></label>
        </div>
        <div class="row">
          <label>L cm <input type="number" step="0.1" name="length_cm"></label>
          <label>W cm <input type="number" step="0.1" name="width_cm"></label>
          <label>H cm <input type="number" step="0.1" name="height_cm"></label>
          <label>GW kg / carton <input type="number" step="0.01" name="gross_weight_kg"></label>
          <label>NW kg / carton <input type="number" step="0.01" name="net_weight_kg"></label>
        </div>
        <button class="btn primary">Add</button>
      </form>
      <script>
        (function () {
          const d = document.querySelector('#packImport details'), m = document.getElementById('packManual');
          d.addEventListener('toggle', () => { m.hidden = !d.open; });
          document.getElementById('packImport').addEventListener('submit', e => {
            if (e.submitter && e.submitter.id === 'packRead') {
              if (!e.target.querySelector('input[type=file]').files.length) { e.preventDefault(); alert('Drop or choose a packing list file first.'); return; }
              e.submitter.textContent = '✦ Reading…'; e.submitter.disabled = true;
            }
          });
        })();
      </script>
    </div>

    <% const payL = typeof payments !== 'undefined' ? payments : []; const pz = typeof pay !== 'undefined' ? pay : {}; const dueAmt = Number(pz.amount_due || 0); const toConfirm = payL.filter(x => x.status === 'submitted').length; %>
    <div class="card <%= toConfirm ? 'pending' : '' %>" id="payments">
      <h2>Payments <% if (dueAmt > 0) { %><span class="pill pay-<%= pz.payment_status %>"><%= ({ unpaid: 'Unpaid', partial: 'Partially paid', paid: 'Paid' })[pz.payment_status] %></span><% } %></h2>
      <% if (!dueAmt) { %><p class="muted small">The amount to pay is set when the proforma invoice is sent to the client.</p>
      <% } else { %>
        <div class="pay-kpis">
          <div><span class="muted small">Invoice total</span><strong><%= fmt.money(dueAmt, order.currency) %></strong></div>
          <div><span class="muted small">Reported / received</span><strong><%= fmt.money(pz.amount_paid, order.currency) %></strong></div>
          <div><span class="muted small">Open</span><strong class="<%= dueAmt - Number(pz.amount_paid) > 0.004 ? 'bad' : 'ok' %>"><%= fmt.money(Math.max(0, dueAmt - Number(pz.amount_paid)), order.currency) %></strong></div>
          <div><span class="muted small">Next due</span><strong><%= pz.payment_due_date ? fmt.date(pz.payment_due_date) : '—' %></strong></div>
        </div>
        <% (pz.payment_schedule || []).forEach(x => { %><div class="muted small"><%= x.label %> <%= Number(x.percent) %>% · <%= fmt.money(x.amount, order.currency) %><%= x.due ? ' · due ' + fmt.date(x.due) : '' %></div><% }) %>
      <% } %>
      <% payL.forEach(x => { %>
        <div class="quote">
          <div class="qhead"><strong><%= fmt.money(x.amount, x.currency) %></strong> <span class="muted small"><%= x.label || '' %> · paid <%= fmt.date(x.paid_on || x.created_at) %><%= x.reference ? ' · ref ' + x.reference : '' %></span>
            <span class="pill <%= ({ submitted: 'pending', confirmed: 'ok', rejected: 'bad' })[x.status] %>"><%= ({ submitted: 'To confirm', confirmed: 'Confirmed', rejected: 'Rejected' })[x.status] %></span></div>
          <% if (x.note) { %><p class="muted small">Client: <%= x.note %></p><% } %>
          <% if (x.admin_note) { %><p class="muted small">Note: <%= x.admin_note %></p><% } %>
          <% (x.proof_doc_ids || []).forEach(did => { const dd = docs.find(z => z.id === did); if (dd) { %><a class="fchip" href="/admin/documents/<%= dd.id %>/download" target="_blank"><%- icon('file') %>&nbsp;Proof of payment</a> <% } }) %>
          <% if (x.status === 'submitted') { %>
            <form method="post" action="/admin/orders/<%= order.id %>/payments/<%= x.id %>" class="actions">
              <input name="note" placeholder="Note to the client (required if rejecting)">
              <button class="btn primary" name="decision" value="confirm">Confirm received</button>
              <button class="btn" name="decision" value="reject">Reject</button>
            </form>
          <% } %>
        </div>
      <% }) %>
      <details><summary class="muted small">Record a payment received outside the portal</summary>
        <form method="post" action="/admin/orders/<%= order.id %>/payments" class="row">
          <label>Amount (<%= order.currency %>) <input name="amount" type="number" step="0.01" min="0.01" required></label>
          <label>Date <input name="paid_on" type="date" value="<%= new Date().toISOString().slice(0, 10) %>"></label>
          <label>Instalment <input name="label" placeholder="Deposit / Balance"></label>
          <label>Reference <input name="reference"></label>
          <button class="btn">Record</button>
        </form>
      </details>
    </div>

    <% const piList = typeof pis !== 'undefined' ? pis : []; const poL = typeof pos !== 'undefined' ? pos : []; %>
    <div class="card">
      <h2>Purchase order &amp; proforma invoice</h2>
      <% poL.forEach(x => { %><p>Client PO: <a href="/admin/po/<%= x.id %>"><strong><%= x.po_no %></strong></a></p><% }) %>
      <% if (piList.length) { %>
        <table class="tbl compact"><tbody><% piList.forEach(x => { %><tr><td><a href="/admin/pi/<%= x.id %>"><strong><%= x.pi_no %></strong></a></td><td><span class="pill <%= x.status === 'sent' ? 'ok' : '' %>"><%= x.status === 'sent' ? 'Sent ' + fmt.date(x.sent_at) : 'Draft' %></span></td><td class="right"><a class="btn small" href="/admin/pi/<%= x.id %>">Open</a></td></tr><% }) %></tbody></table>
      <% } else { %><p class="muted small">No proforma invoice yet. It starts from the order's lines and the client's PO — you can edit everything before sending.</p><% } %>
      <form method="post" action="/admin/pi/order/<%= order.id %>" class="inline"><% if (piList.length) { %><input type="hidden" name="another" value="1"><% } %><button class="btn <%= piList.length ? '' : 'primary' %>"><%= piList.length ? '+ Another proforma invoice' : 'Generate proforma invoice' %></button></form>
    </div>

    <%- include('../../partials/docs', { docs, entityType: 'order', entityId: order.id, redirect: '/admin/orders/' + order.id, heading: 'Product & packing photos, documents', defaultKind: 'product_photo' }) %>
  </div>
  <div>
    <div class="card">
      <h2>Order details</h2>
      <form method="post" action="/admin/orders/<%= order.id %>">
        <div class="row">
          <label class="grow2">Supplier <select name="supplier_id"><option value="">—</option><% suppliers.forEach(s => { %><option value="<%= s.id %>" <%= order.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></label>
          <label>Expected ship <input type="date" name="expected_ship_date" value="<%= order.expected_ship_date || '' %>"></label>
        </div>
        <label>Note for client <span class="muted small">— shown in their portal</span><textarea name="client_notes" rows="2"><%= order.client_notes || '' %></textarea></label>
        <label>Internal notes <textarea name="internal_notes" rows="3"><%= order.internal_notes || '' %></textarea></label>
        <button class="btn">Save</button>
      </form>
    </div>
    <%- include('../../partials/timeline', { events, created: { at: order.created_at, label: 'order created' } }) %>
  </div>
</div>
<script>
  // "+ Add new product…": create the product in place, select it and prefill cost and HS code
  (function () {
    const form = document.querySelector('form[action$="/items"]'); if (!form) return;
    const sel = form.querySelector('select[name=product_id]'), box = document.getElementById('newProd'); if (!sel || !box) return;
    const $ = id => document.getElementById(id), f = n => form.querySelector('[name=' + n + ']'); let prev = sel.value;
    const err = t => { const e = $('np_err'); e.hidden = !t; e.textContent = t || ''; };
    const close = () => { box.hidden = true; err(''); if (sel.value === '__new') sel.value = prev; };
    sel.addEventListener('change', () => { if (sel.value === '__new') { box.hidden = false; $('np_name').focus(); } else { prev = sel.value; box.hidden = true; } });
    $('np_cancel').addEventListener('click', close);
    $('np_save').addEventListener('click', async () => {
      const name = $('np_name').value.trim(); if (!name) return err('Enter the product name.');
      const btn = $('np_save'); btn.disabled = true; err('');
      try {
        const res = await fetch('/admin/products/quick', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, sku: $('np_sku').value, hs_code: $('np_hs').value, supplier_id: $('np_sup').value, unit_cost: $('np_cost').value, cost_currency: <%- JSON.stringify(cur) %> }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || 'Could not add the product.');
        sel.insertBefore(new Option(j.name + (j.sku ? ' · ' + j.sku : ''), j.id), sel.querySelector('option[value=__new]'));
        sel.value = j.id; prev = j.id; box.hidden = true;
        if (j.unit_cost != null && !f('unit_cost').value) f('unit_cost').value = j.unit_cost;
        if (j.hs_code && !f('hs_code').value) f('hs_code').value = j.hs_code;
        ['np_name', 'np_sku', 'np_hs', 'np_cost'].forEach(i => { $(i).value = ''; });
        f('quantity').focus();
      } catch (e) { err(e.message); } finally { btn.disabled = false; }
    });
    form.addEventListener('submit', () => { if (sel.value === '__new') sel.value = prev; });
  })();
</script>
<%- include('../../partials/foot') %>
