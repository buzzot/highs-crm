<%- include('../partials/head') %>
<%- include('../partials/auth_start') %>
  <%- include('../partials/auth_icon', { icon: 'lock' }) %>
  <h1>Enter your code</h1>
  <p class="lead">We sent a 6-digit code to <strong><%= email %></strong>. It expires in 15 minutes.</p>
  <% if (error) { %><div class="alert err"><%= error %></div><% } %>
  <% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>
  <form method="post" action="/login/verify" autocomplete="off">
    <input class="codeinput" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,12}" maxlength="12" required autofocus placeholder="000000" aria-label="Code from the email">
    <button class="btn primary wide lg">Verify & sign in</button>
  </form>
  <div class="authlinks">
    <form method="post" action="/login/resend"><button class="link small">Send a new code</button></form>
    <a class="small" href="/login">Use a different account</a>
  </div>
  <p class="hintline">Can't find it? Check spam. Each code works once.</p>
<%- include('../partials/auth_end') %>
<%- include('../partials/foot') %>
