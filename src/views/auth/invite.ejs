<%- include('../partials/head') %>
<%- include('../partials/auth_start') %>
  <% if (state === 'valid') { %>
    <% const isSup = inv.role === 'supplier'; %>
    <ol class="authsteps"><li class="<%= step === 'code' ? 'now' : 'done' %>">Confirm email</li><li class="<%= step === 'profile' ? 'now' : '' %>">Your profile & password</li><% if (isSup) { %><li>Company details</li><% } %></ol>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <% if (msg) { %><div class="alert ok"><%= msg %></div><% } %>

    <% if (step === 'code') { %>
      <% if (isSup) { %>
        <h1>Register as a supplier</h1>
        <p class="lead">Lumi Trade invited <% if (inv.supplier?.details_completed_at && inv.supplier?.name) { %><strong><%= inv.supplier.name %></strong><% } else { %>your company<% } %> to its supplier portal. Enter the 6-digit code from the email sent to <strong><%= inv.email %></strong>.</p>
      <% } else { %>
      <h1>You're invited</h1>
      <p class="lead">Join<% if (inv.organizations?.name) { %> the <strong><%= inv.organizations.name %></strong> portal<% } else { %> the Lumi Trade team<% } %>. Enter the 6-digit code from the invitation email sent to <strong><%= inv.email %></strong>.</p>
      <% } %>
      <form method="post" action="/invite/<%= inv.token %>/code" autocomplete="off">
        <input class="codeinput" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,12}" maxlength="12" required autofocus placeholder="000000" aria-label="Confirmation code">
        <button class="btn primary wide lg">Confirm email</button>
      </form>
      <form method="post" action="/invite/<%= inv.token %>/resend" class="resend">
        <span class="muted small">Code expired or not received?</span> <button class="link small">Email me a new code</button>
      </form>
      <form method="post" action="/invite/<%= inv.token %>/session" id="hashForm" hidden><input type="hidden" name="access_token"></form>
      <script>
        // older invitation emails confirm via the link itself — the tokens arrive in the URL fragment
        (function () { const h = new URLSearchParams(location.hash.slice(1)); const a = h.get('access_token');
          if (a) { const f = document.getElementById('hashForm'); f.access_token.value = a; history.replaceState(null, '', location.pathname); f.submit(); } })();
      </script>
    <% } else { %>
      <h1>Set up your account</h1>
      <p class="lead">Email confirmed ✓ — tell us who you are and choose a password.<% if (isSup) { %> Next you'll fill in your company details.<% } %></p>
      <form method="post" action="/invite/<%= inv.token %>">
        <label>Email <input type="email" value="<%= inv.email %>" disabled></label>
        <div class="row">
          <label>Full name <input name="full_name" required autofocus value="<%= form.full_name || '' %>"></label>
          <label>Job title <input name="job_title" value="<%= form.job_title || '' %>" placeholder="<%= isSup ? 'e.g. Sales manager' : 'e.g. Purchasing manager' %>"></label>
        </div>
        <div class="row">
          <label>Phone <input name="phone" value="<%= form.phone || '' %>" placeholder="+1 555 123 4567"></label>
          <label>WeChat / WhatsApp <input name="wechat" value="<%= form.wechat || '' %>"></label>
        </div>
        <div class="row">
          <label>Password <span class="pwfield"><input type="password" name="password" minlength="8" required autocomplete="new-password"><button type="button" class="pwtoggle" aria-label="Show password">Show</button></span><span class="hint">8+ characters, letters and a number</span></label>
          <label>Repeat password <input type="password" name="password2" minlength="8" required autocomplete="new-password"></label>
        </div>
        <button class="btn primary wide lg"><%= isSup ? 'Continue to company details' : 'Create my account' %></button>
      </form>
      <p class="hintline">Each time you sign in we'll also email you a one-time code.</p>
    <% } %>
    <p class="hintline">Invitation valid until <%= fmt.date(inv.expires_at) %>.</p>
  <% } else if (state === 'accepted') { %>
    <%- include('../partials/auth_icon', { icon: 'check' }) %>
    <h1>You're all set</h1>
    <p class="lead">This invitation has already been used — your account is active.</p>
    <a class="btn primary wide lg" href="/login">Sign in</a>
    <p class="hintline"><a href="/forgot">Forgot your password?</a></p>
  <% } else if (state === 'expired') { %>
    <%- include('../partials/auth_icon', { icon: 'warn' }) %>
    <h1>This invitation has expired</h1>
    <p class="lead">It was valid until <%= fmt.date(inv.expires_at) %> (invitations last 14 days). Please ask your Lumi Trade contact to send a new one.</p>
  <% } else if (state === 'revoked') { %>
    <%- include('../partials/auth_icon', { icon: 'mail' }) %>
    <h1>There's a newer invitation</h1>
    <p class="lead">A newer invitation was sent to <strong><%= inv.email %></strong>. Please use the link in the most recent email.</p>
  <% } else { %>
    <%- include('../partials/auth_icon', { icon: 'warn' }) %>
    <h1>Link not valid</h1>
    <p class="lead">This invitation link doesn't work. Check that you opened the whole link from the email, or ask for a new invitation.</p>
    <a class="btn wide lg" href="/login">Go to sign in</a>
  <% } %>
<%- include('../partials/auth_end') %>
<%- include('../partials/foot') %>
